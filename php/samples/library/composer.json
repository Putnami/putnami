{
  "name": "putnami-example/library",
  "description": "A library of the @putnami/php sample.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": { "PutnamiExample\\Library\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "PutnamiExample\\Library\\Tests\\": "tests/" }
  },
  "config": {
    "platform": { "php": "8.3.0" }
  }
}
