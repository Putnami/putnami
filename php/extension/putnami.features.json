{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "php",
  "features": [
    {
      "id": "php/stack-extension",
      "type": "feature",
      "name": "Run the components of a Composer repository as Putnami tasks",
      "outcome": "A team with a PHP or Symfony repository adds @putnami/php and runs putnami lint and test over its Composer components with Putnami's runner and cache, without rewriting its build: each component is a project with its edges, lint runs PHPStan and test runs PHPUnit after a PHP version check, the test task reads its JUnit and Clover reports, and a component overrides any profile value in its putnami.json",
      "owner": "php",
      "target": "coded",
      "requirements": [
        {
          "id": "components-become-projects",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-components-of-a-composer-repository-become-projects-with-their-edges"
            ]
          }
        },
        {
          "id": "tasks-run-the-profile",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-task-runs-the-profile-steps-after-the-toolchain-check"
            ]
          }
        },
        {
          "id": "reports-become-the-summary",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "junit-and-clover-become-the-test-and-coverage-summary"
            ]
          }
        },
        {
          "id": "inputs-per-task",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-test-only-change-leaves-the-lint-inputs-unchanged"
            ]
          }
        },
        {
          "id": "overrides-are-honored",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-putnami-json-override-changes-the-steps-and-the-inputs"
            ]
          }
        },
        {
          "id": "manifest-follows-the-profile",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
