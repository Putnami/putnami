{
  "$schema": "https://putnami.dev/schemas/putnami-extension.json",
  "name": "@putnami/php",
  "cliContract": 14,
  "extensionDependencies": {
    "@putnami/dev": ""
  },
  "runtime": {
    "executable": "compiled/putnami-php",
    "toolchains": {
      "runtimeCompiler": {
        "lock": "go",
        "candidates": [
          {
            "from": "environment",
            "environment": "GOROOT",
            "path": "bin/go"
          },
          {
            "from": "path",
            "path": "go"
          },
          {
            "from": "putnami-home",
            "path": "toolchains/go/go-{version}/go/bin/go"
          }
        ],
        "probe": {
          "args": [
            "env",
            "GOVERSION"
          ],
          "expect": "go{version}",
          "unset": [
            "GOROOT"
          ],
          "environment": {
            "GOTOOLCHAIN": "local"
          }
        },
        "environment": {
          "GOROOT": {
            "from": "ancestor",
            "levels": 2
          },
          "GOTOOLCHAIN": {
            "from": "literal",
            "value": "local"
          }
        },
        "prependPath": true
      },
      "php": {
        "lock": "php",
        "optional": true,
        "candidates": [
          {
            "from": "path",
            "path": "php"
          },
          {
            "from": "provisioned"
          }
        ],
        "probe": {
          "args": [
            "-r",
            "echo PHP_VERSION;"
          ],
          "expect": "{version}"
        },
        "environment": {
          "PUTNAMI_PHP_EXECUTABLE": {
            "from": "executable"
          }
        }
      }
    },
    "resolves": [
      "php"
    ],
    "prepare": {
      "command": "{extensionRoot}/bin/prepare",
      "args": [
        "--output",
        "{runtimeOutput}"
      ],
      "inputs": [
        "bin/prepare",
        "cmd/**",
        "go.mod",
        "go.sum",
        "*.go",
        "profile.json"
      ],
      "toolchains": [
        "runtimeCompiler"
      ]
    },
    "inputSelectors": [
      "php:lint",
      "php:test"
    ]
  },
  "workspace": {
    "markers": [
      "composer.json"
    ],
    "inputs": [
      "composer.json",
      ".php-version"
    ],
    "excludes": [
      "vendor"
    ],
    "language": "php",
    "installInputs": [
      "composer.lock"
    ]
  },
  "commands": {
    "workspace-fetch": {
      "description": "Download the packages each stack root's composer.lock names into the extension's Composer cache, running none of their code.",
      "quiet": true,
      "run": [
        {
          "id": "workspace-fetch",
          "task": "workspace-fetch-exec"
        }
      ]
    },
    "workspace-install": {
      "description": "Install the Composer dependencies of each stack root of the workspace.",
      "quiet": true,
      "flags": {
        "force": {
          "type": "boolean",
          "default": false,
          "description": "Install a stack root even when its last install is current"
        }
      },
      "run": [
        {
          "id": "workspace-install",
          "task": "workspace-install-exec"
        }
      ]
    },
    "lint": {
      "description": "Lint the Composer components with PHPStan.",
      "flags": {
        "docs-links": {
          "type": "boolean",
          "default": true,
          "description": "Check every relative link and anchor in the project's README.md files and doc/ trees; a broken one fails lint."
        }
      },
      "run": [
        {
          "id": "install",
          "task": "install-run"
        },
        {
          "id": "lint",
          "task": "lint-run",
          "dependsOn": [
            "install",
            "^lint"
          ]
        },
        {
          "id": "docs",
          "task": "lint-docs",
          "if": "params.docs-links"
        }
      ]
    },
    "test": {
      "description": "Test the Composer components with PHPUnit, and read their JUnit and Clover reports.",
      "flags": {
        "test": {
          "type": "string",
          "short": "-t",
          "description": "Test filter to run, passed to PHPUnit as --filter"
        }
      },
      "run": [
        {
          "id": "install",
          "task": "install-run"
        },
        {
          "id": "test",
          "heavy": true,
          "task": "test-run",
          "dependsOn": [
            "install",
            "^test"
          ]
        }
      ]
    },
    "serve": {
      "description": "Serve a PHP application with the PHP built-in server.",
      "traits": {
        "requiresRunnable": true,
        "workload": "serve"
      },
      "flags": {
        "port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the server"
        }
      },
      "run": [
        {
          "id": "install",
          "task": "install-run"
        },
        {
          "id": "serve",
          "task": "serve-run",
          "dependsOn": [
            "install"
          ]
        }
      ]
    },
    "run": {
      "description": "Run a PHP application once and forward its exit code.",
      "traits": {
        "requiresRunnable": true,
        "workload": "once"
      },
      "flags": {
        "entrypoint": {
          "type": "string",
          "description": "Entry point to run (defaults to bin/console)"
        },
        "args": {
          "type": "string",
          "description": "Additional arguments to pass to the entrypoint"
        }
      },
      "run": [
        {
          "id": "install",
          "task": "install-run"
        },
        {
          "id": "run",
          "task": "run-exec",
          "dependsOn": [
            "install"
          ]
        }
      ]
    },
    "deps-upgrade": {
      "description": "Update the Composer dependencies of each stack root of the workspace.",
      "visibility": "internal",
      "quiet": true,
      "run": [
        {
          "id": "deps-upgrade",
          "task": "deps-upgrade-exec"
        }
      ]
    },
    "package": {
      "description": "Assemble the image of an application for the docker publish channel.",
      "traits": {
        "injectPublishChannels": true
      },
      "flags": {
        "docker": {
          "type": "boolean",
          "default": false,
          "description": "Assemble the image"
        },
        "docker-tag": {
          "type": "string",
          "description": "Override the image tag"
        },
        "docker-base-image": {
          "type": "string",
          "description": "Replace the official PHP image with a base pinned by digest (image@sha256:...)"
        },
        "docker-load": {
          "type": "boolean",
          "default": false,
          "description": "Also load the assembled image into the local docker daemon"
        },
        "platform": {
          "type": "string",
          "default": "linux/amd64",
          "description": "Target platform of the image"
        },
        "dry-run": {
          "type": "boolean",
          "default": false,
          "description": "Plan the image without assembling it"
        },
        "port": {
          "type": "number",
          "default": 8080,
          "description": "Port the image exposes and sets as PORT"
        }
      },
      "run": [
        {
          "id": "docker",
          "task": "package-docker",
          "if": "params.docker"
        }
      ]
    },
    "publish": {
      "dependsOn": [
        "package"
      ],
      "traits": {
        "injectPublishChannels": true,
        "sideEffects": "registry"
      },
      "description": "Push the image of an application to its OCI registry. A library reaches Packagist through its tags.",
      "flags": {
        "docker": {
          "type": "boolean",
          "default": false,
          "description": "Push the image"
        },
        "docker-registry": {
          "type": "string",
          "description": "Registry to push the image to, above registries.oci.publish"
        },
        "dry-run": {
          "type": "boolean",
          "default": false,
          "description": "Push nothing; report what would be published"
        }
      },
      "run": [
        {
          "id": "docker",
          "task": "publish-docker",
          "if": "params.docker"
        }
      ]
    }
  },
  "tasks": {
    "install-run": {
      "description": "Run composer install at the component's stack root with the Composer the extension pins, unless its last successful install used the current composer.json and composer.lock.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "php"
      ],
      "args": [
        "install"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "cache": false,
      "declares": {
        "effects": [
          "network",
          "process",
          "toolchain-cache",
          "workspace-files"
        ]
      }
    },
    "lint-run": {
      "description": "Run the PHP profile's lint step, the stack root's vendor/bin/phpstan analyse on src, on one component in its directory, after the PHP version check. Its inputs are the files the php:lint selector answers from the resolved profile, and the stack-root files of the profile.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "php"
      ],
      "args": [
        "lint",
        "--report-dir",
        "{outputRoot}"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "inputs": {
        "sources": {
          "from": "project",
          "files": [
            "php:lint"
          ]
        },
        "stackRoot": {
          "from": "workspace",
          "files": [
            ".php-version",
            "composer.json",
            "composer.lock"
          ]
        },
        "extensionVersion": {
          "from": "runtime"
        }
      },
      "outputs": {
        "data": {
          "description": "The task result: the lint findings of the component."
        }
      },
      "cache": {
        "enabled": true
      },
      "declares": {
        "outputs": {
          "reports": {
            "kind": "directory",
            "root": "command-output",
            "path": "lint",
            "optionalEmpty": true,
            "description": "The reports the task wrote: the JUnit and Clover reports of a test task."
          }
        },
        "effects": [
          "toolchain-cache"
        ]
      }
    },
    "lint-docs": {
      "description": "Documentation link check: every relative link and anchor in the project's README.md files and doc/ trees must resolve, with the exact case of the file's name. The task body is the SDK's docslinks.Job, shared with every language extension. A link may name any file of the workspace, so the check reads the workspace's Git candidate cut (the tracked files and the untracked files no ignore rule excludes) and its key is the workspace input `git:**`, which holds that cut: deleting or renaming a link target, or editing a heading an anchor names, moves the key, and an ignored file is neither read nor keyed. The project input names the README.md the check starts from, so the key does not fold the project's ignored build output. Outside a Git work tree the check reads the disk and the task has no key. It needs neither PHP nor Composer.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "lint-docs"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 120000,
      "inputs": {
        "readme": {
          "from": "project",
          "files": [
            "README.md"
          ]
        },
        "repository": {
          "from": "workspace",
          "files": [
            "git:**"
          ]
        },
        "docs-links": {
          "from": "params"
        }
      },
      "outputs": {
        "data": {
          "description": "Documentation link result with diagnostics"
        }
      },
      "reads": [
        "sources"
      ],
      "cache": {
        "noOutput": true,
        "enabled": true
      },
      "declares": {}
    },
    "test-run": {
      "description": "Run the PHP profile's test step, the stack root's vendor/bin/phpunit on tests with JUnit and Clover reports, on one component in its directory, after the PHP version check; then read the reports, even when PHPUnit exits non-zero. A failed case, a step that exits non-zero, or a missing report fails the task.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "php"
      ],
      "args": [
        "test",
        "--report-dir",
        "{outputRoot}"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "inputs": {
        "test": {
          "from": "params"
        },
        "sources": {
          "from": "project",
          "files": [
            "php:test"
          ]
        },
        "stackRoot": {
          "from": "workspace",
          "files": [
            ".php-version",
            "composer.json",
            "composer.lock"
          ]
        },
        "extensionVersion": {
          "from": "runtime"
        }
      },
      "outputs": {
        "data": {
          "description": "The task result: the test and coverage totals of a test task."
        }
      },
      "cache": {
        "enabled": true
      },
      "declares": {
        "outputs": {
          "reports": {
            "kind": "directory",
            "root": "command-output",
            "path": "test",
            "optionalEmpty": true,
            "description": "The reports the task wrote: the JUnit and Clover reports of a test task."
          }
        },
        "effects": [
          "toolchain-cache"
        ]
      }
    },
    "workspace-fetch-exec": {
      "description": "Run composer install with no script and no plugin into a private vendor directory, which leaves the packages in the extension's Composer cache.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "php"
      ],
      "args": [
        "workspace-fetch"
      ],
      "cwd": "{workspaceRoot}",
      "cache": false,
      "timeoutMs": 1800000,
      "declares": {
        "effects": [
          "network",
          "process",
          "toolchain-cache"
        ]
      }
    },
    "workspace-install-exec": {
      "description": "Run composer install at each stack root of the workspace, except the projects disable.tags excludes and the roots whose last install is current. Offline, it installs from the extension's Composer cache with the network disabled.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "php"
      ],
      "args": [
        "workspace-install"
      ],
      "cwd": "{workspaceRoot}",
      "cache": false,
      "timeoutMs": 1800000,
      "declares": {
        "effects": [
          "network",
          "process",
          "toolchain-cache",
          "workspace-files"
        ]
      }
    },
    "serve-run": {
      "description": "Run php -S with public/ as document root until the user stops it. PHP reads its files on each request, so there is no watcher.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "php"
      ],
      "args": [
        "serve"
      ],
      "cwd": "{projectRoot}",
      "cache": false,
      "timeoutMs": -1,
      "declares": {
        "effects": [
          "network",
          "process"
        ]
      }
    },
    "run-exec": {
      "description": "Run php with the entrypoint in the application directory and forward its exit code.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "php"
      ],
      "args": [
        "run"
      ],
      "cwd": "{projectRoot}",
      "cache": false,
      "timeoutMs": -1,
      "declares": {
        "effects": [
          "network",
          "process",
          "workspace-files"
        ]
      }
    },
    "deps-upgrade-exec": {
      "description": "Run composer update at each stack root of the workspace with the pinned Composer and the selected PHP.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "php"
      ],
      "args": [
        "deps-upgrade"
      ],
      "cwd": "{workspaceRoot}",
      "cache": false,
      "timeoutMs": 1800000,
      "declares": {
        "effects": [
          "network",
          "process",
          "toolchain-cache",
          "workspace-files"
        ]
      }
    },
    "package-docker": {
      "description": "Assemble a local OCI image of an application from its production dependencies and its files, on a digest-pinned PHP Apache base. Sole owner of <command-output>/docker.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "php"
      ],
      "args": [
        "package-docker"
      ],
      "inputs": {
        "application": {
          "from": "project",
          "files": [
            "git:**/*",
            "**/*",
            ".*",
            "public/.*",
            "public/dist/**/*",
            "public/out/**/*",
            "public/vendor/**/*",
            "!../**",
            "!.gen/**",
            "!.phpunit.cache/**",
            "!vendor/**",
            "!var/**",
            "!tests/**",
            "!node_modules/**",
            "!auth.json",
            "!.env.local",
            "!.env.*.local",
            "!.env.local.php",
            "!**/*.decrypt.private.php"
          ]
        },
        "pathRepositories": {
          "from": "closure",
          "files": [
            "git:**/*",
            "**/*",
            ".*",
            "public/.*",
            "public/dist/**/*",
            "public/out/**/*",
            "public/vendor/**/*",
            "!../**",
            "!.gen/**",
            "!.phpunit.cache/**",
            "!vendor/**",
            "!var/**",
            "!tests/**",
            "!node_modules/**",
            "!auth.json",
            "!.env.local",
            "!.env.*.local",
            "!.env.local.php",
            "!**/*.decrypt.private.php"
          ]
        },
        "extensionVersion": {
          "from": "runtime"
        }
      },
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "cache": {
        "versionAware": true
      },
      "declares": {
        "outputs": {
          "docker": {
            "kind": "directory",
            "root": "command-output",
            "path": "docker",
            "optionalEmpty": true,
            "description": "Local OCI candidate layout, its manifest and the docker channel record."
          }
        },
        "effects": [
          "network",
          "toolchain-cache"
        ]
      }
    },
    "publish-docker": {
      "description": "Push the packaged image to the container registry through the shared publisher.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "publish-docker"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 300000,
      "cache": false,
      "declares": {
        "outputs": {
          "published-image": {
            "kind": "file",
            "root": "command-output",
            "path": "docker/published-image.json",
            "optionalEmpty": true,
            "description": "Verified remote image record, written after the registry digest is read back."
          }
        },
        "effects": [
          "network",
          "registry"
        ],
        "publishChannels": [
          "docker"
        ]
      }
    }
  },
  "uses": [
    "oci"
  ]
}
