{
  "$schema": "https://putnami.dev/schemas/putnami-ci.json",
  "version": 3,
  "commands": [
    "lint",
    "test",
    "build",
    "validate"
  ],
  "flags": [
    "--enforce-coverage",
    "--continue-on-error"
  ],
  "distribution": {
    "namespace": "putnami",
    "visibility": "private",
    "memberAttribution": true,
    "channels": {
      "canary": {
        "visibility": "private"
      },
      "latest": {
        "visibility": "private",
        "protected": true
      },
      "stable": {
        "visibility": "private"
      }
    },
    "members": [
      {
        "select": [
          "/cloud/...",
          "/protocols/...",
          "/tooling/...",
          "/integrations/...",
          "/intelligence/...",
          "/go/...",
          "/python/...",
          "/typescript/...",
          "/rust/...",
          "/java/...",
          "/swift/...",
          "/dart/...",
          "/dotnet/...",
          "/ruby/...",
          "/php/..."
        ],
        "visibility": "public"
      },
      {
        "select": [
          "/sites/...",
          "/go/samples/application",
          "/python/samples/application",
          "/rust/samples/...",
          "/java/samples/...",
          "/swift/samples/...",
          "/dart/samples/...",
          "/dotnet/samples/...",
          "/php/samples/..."
        ],
        "visibility": "private"
      }
    ]
  },
  "rules": [
    {
      "branches": "main",
      "publish": [
        "canary"
      ]
    }
  ],
  "envs": {
    "prod": {
      "channel": "latest",
      "workloads": [
        {
          "select": [
            "sites/putnami.dev",
            "sites/telemetry.putnami.dev"
          ]
        }
      ]
    }
  }
}
