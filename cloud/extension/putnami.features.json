{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "cloud",
  "features": [
    {
      "id": "cloud/cli-archive-publication",
      "type": "feature",
      "name": "Archive publication from the Cloud CLI",
      "outcome": "The Cloud CLI reports a published archive member only after Put accepted it, and the member names the archive by ecosystem and coordinate",
      "owner": "cloud",
      "target": "coded",
      "requirements": [
        {
          "id": "member-only-after-accepted-put-response",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "archive-publication-member-contract"
            ]
          }
        }
      ]
    },
    {
      "id": "cloud/cli-infra-plan",
      "type": "feature",
      "name": "Infrastructure plan from the Cloud CLI",
      "outcome": "putnami cloud infra plan lists the workspace workloads from the job context, with the output the core infra plan printed before the core deleted it, and refuses a context that does not give the project type",
      "owner": "cloud",
      "target": "coded",
      "requirements": [
        {
          "id": "plan-lists-workloads-from-job-context",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "infra-plan-output-matches-core",
              "infra-plan-refuses-untyped-context"
            ]
          }
        }
      ]
    },
    {
      "id": "cloud/local-session-reporting",
      "type": "feature",
      "name": "Gate sessions reported from a developer machine",
      "outcome": "A gate session run on a developer machine or in a local agent session reaches Delivery under the developer's stored login, and a hosted run keeps reporting under its run credential",
      "owner": "cloud",
      "target": "coded",
      "requirements": [
        {
          "id": "local-session-under-developer-login",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "local-session-route-and-bearer"
            ]
          }
        },
        {
          "id": "hosted-credential-wins",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "hosted-credential-precedence"
            ]
          }
        },
        {
          "id": "local-session-fails-closed",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "local-session-not-configured",
              "local-session-token-never-printed"
            ]
          }
        }
      ]
    },
    {
      "id": "cloud/compressed-session-reporting",
      "type": "feature",
      "name": "Session and log chunks sent compressed",
      "outcome": "The session reporter and the log reporter send each chunk gzip-compressed to a receiver that advertises it reads gzip, and the receiver stores the same bytes as for an uncompressed chunk",
      "owner": "cloud",
      "target": "coded",
      "requirements": [
        {
          "id": "gzip-only-after-an-advertising-answer",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "gzip-follows-an-advertising-answer",
              "no-gzip-without-an-advertising-answer"
            ]
          }
        },
        {
          "id": "the-chunk-bytes-are-what-the-receiver-stores",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-resent-sequence-compares-decoded",
              "empty-and-incompressible-chunks-go-as-is",
              "log-offset-and-digest-describe-the-chunk"
            ]
          }
        },
        {
          "id": "unadvertised-gzip-acceptance-fails-closed",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "gzip-accepted-without-advertisement-is-refused"
            ]
          }
        }
      ]
    },
    {
      "id": "cloud/secret-config-key",
      "type": "feature",
      "name": "Secrets stored under the config key the application reads",
      "outcome": "putnami cloud secrets set stores a secret under the config key the application reads, and warns when the published schema does not declare that key",
      "owner": "cloud",
      "target": "coded",
      "requirements": [
        {
          "id": "declared-key-stored",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "secrets-set-stores-declared-keys"
            ]
          }
        },
        {
          "id": "undeclared-key-stored-with-warning",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "secrets-set-undeclared-key-warning",
              "secrets-set-unreadable-schema-warning",
              "secrets-set-failed-write-no-warning"
            ]
          }
        }
      ]
    },
    {
      "id": "cloud/env-definition-drift",
      "type": "feature",
      "name": "A stale environment definition read from the Cloud CLI",
      "outcome": "putnami cloud env doctor reads a degraded environment-definition row and names its fix, and putnami cloud env enable accepts the default-branch head for that row or fails when the row stays degraded, and putnami cloud env status names env enable for a declared workload the accepted definition omits",
      "owner": "cloud",
      "target": "coded",
      "requirements": [
        {
          "id": "doctor-reads-a-degraded-definition",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "env-doctor-degraded-definition"
            ]
          }
        },
        {
          "id": "enable-accepts-a-degraded-definition",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "env-enable-degraded-definition"
            ]
          }
        },
        {
          "id": "enable-fails-on-a-definition-that-stays-degraded",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "env-enable-replaced-commit",
              "env-enable-stays-degraded",
              "env-enable-accepted-commit-differs"
            ]
          }
        },
        {
          "id": "status-names-enable-for-an-omitted-workload",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "env-status-omitted-workload",
              "env-status-reads-definition-workloads"
            ]
          }
        }
      ]
    },
    {
      "id": "cloud/cache-provider-configuration",
      "type": "feature",
      "name": "Remote cache configuration resolved by the Cloud cache provider",
      "outcome": "The Cloud cache provider resolves the remote cache configuration and the materialization mode of a session, and tells the core the mode it resolved",
      "owner": "cloud",
      "target": "coded",
      "requirements": [
        {
          "id": "provider-resolves-its-configuration",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-session-mode-is-the-intent-else-the-configured-mode-else-minimal-when-hosted-else-full"
            ]
          }
        },
        {
          "id": "a-files-restore-receives-downloads",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-minimal-session-negotiates-the-keys-core-reads-in-full"
            ]
          }
        }
      ]
    },
    {
      "id": "cloud/publication-uploader",
      "type": "feature",
      "name": "Publication uploads from the credential provider",
      "outcome": "A hosted run can upload each publication member to the Putnami registries from its credential provider session, under the plan's write bearer that session holds",
      "owner": "cloud",
      "target": "coded",
      "requirements": [
        {
          "id": "cloud-uploads-its-registries-in-the-provider-session",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "each-ecosystem-uploads-and-answers-the-stored-digest"
            ]
          }
        }
      ]
    },
    {
      "id": "cloud/publish-channels",
      "type": "feature",
      "name": "Publish channels of the Cloud publish command",
      "outcome": "A publishing run counts a project's declared channel as served only by a planned Cloud task that declares it, so the archive and site content uploads serve their channels and the other uploads serve none",
      "owner": "cloud",
      "target": "coded",
      "requirements": [
        {
          "id": "publish-tasks-declare-their-channels",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-cloud-extension-declares-its-publish-channels"
            ]
          }
        }
      ]
    }
  ]
}
