  "paths": {
    "/v1/workspaces/{workspace}/data/migrations/publish": {
      "post": {
        "description": "Validate and accept one migration bundle through Data after resolving the workspace-owned Distribution Put namespace.\n\nRequired scopes: platform.workspace.manage.",
        "operationId": "postV1_Workspaces_Workspace_Data_Migrations_Publish",
        "parameters": [
          {
            "in": "path",
            "name": "workspace",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedMigration"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "description": "Malformed or semantically invalid migration publication"
          },
          "403": {
            "description": "Caller is not authorized for the workspace or Put"
          },
          "409": {
            "description": "Authored member or immutable publication conflicts with owner authority"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "error",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Distribution authority or storage is unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-putnami-client": {
          "errors": [
            {
              "code": "http.bad_request",
              "status": 400
            },
            {
              "code": "forbidden",
              "status": 403
            },
            {
              "code": "conflict",
              "status": 409
            },
            {
              "code": "http.internal_server",
              "status": 500
            },
            {
              "code": "http.service_unavailable",
              "status": 503
            }
          ],
          "idempotency": {
            "kind": "non-idempotent"
          },
          "security": {
            "alternatives": [
              {
                "allOf": [
                  {
                    "profile": "user",
                    "scopes": [
                      "platform.workspace.manage"
                    ]
                  },
                  {
                    "profile": "migrationRegistry",
                    "scopes": [
                      "platform.workspace.manage"
                    ]
                  }
                ]
              }
            ]
          },
          "stream": "unary",
          "transports": [
            {
              "encoding": "json",
              "path": "/v1/workspaces/{workspace}/data/migrations/publish",
              "protocol": "rest-json"
            }
          ]
        }
      }
    },
    "/v1/workspaces/{workspace}/database-bindings": {
      "get": {
        "description": "List the authoritative, credential-free database capabilities declared by one project/environment. Unresolved declarations remain visible with ready=false and no database name. Returns only stable project, environment, logical datasource, database, and readiness identifiers; never connection coordinates, IAM identities, DSNs, or credentials. Requires platform.database.read resolved at the target workspace.\n\nRequired scopes: platform.database.read.",
        "operationId": "getV1_Workspaces_Workspace_Database-bindings",
        "parameters": [
          {
            "in": "path",
            "name": "workspace",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "environment",
            "required": true,
            "schema": {
              "maxLength": 63,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "project",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDatabaseBindingList"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "description": "Project and environment are required"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permissions or workspace scope mismatch"
          },
          "404": {
