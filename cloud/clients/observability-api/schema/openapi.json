                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "error",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permissions or workspace scope mismatch"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "error",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Authorization backend unavailable (IAM replica unbackfilled or stale); retry"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-putnami-client": {
          "errors": [
            {
              "code": "http.bad_request",
              "status": 400
            },
            {
              "code": "unauthorized",
              "status": 401
            },
            {
              "code": "forbidden",
              "status": 403
            },
            {
              "code": "http.internal_server",
              "status": 500
            },
            {
              "code": "http.service_unavailable",
              "status": 503
            }
          ],
          "idempotency": {
            "kind": "safe"
          },
          "messages": {
            "output": {
              "$ref": "#/components/schemas/LogEntry"
            }
          },
          "resilience": {
            "stream": {
              "heartbeatMs": 15000,
              "idleTimeoutMs": 45000
            }
          },
          "security": {
            "alternatives": [
              {
                "allOf": [
                  {
                    "profile": "user",
                    "scopes": [
                      "platform.observability.read"
                    ]
                  }
                ]
              }
            ]
          },
          "stream": "server",
          "transports": [
            {
              "encoding": "json",
              "path": "/v1/workspaces/{workspace}/logs/tail",
              "protocol": "sse"
            }
          ]
        }
      }
    },
