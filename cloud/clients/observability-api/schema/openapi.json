  "info": {
    "description": "Workspace telemetry ingest (OTLP/JSON logs, metrics, traces) and logs/metrics/traces reads. Consumers call it through the generated clients in clients/go and clients/ts.",
    "title": "Putnami Observability API",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/workspaces/{workspace}/logs": {
      "get": {
        "description": "List a bounded, cursor-paginated page of the workspace's logs filtered server-side by q text search, time window, level, and correlation query params, with secret-bearing fields redacted. Requires platform.observability.read resolved at the target workspace.\n\nRequired scopes: platform.observability.read.",
        "operationId": "getV1_Workspaces_Workspace_Logs",
        "parameters": [
          {
            "in": "path",
            "name": "workspace",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "deployment",
            "required": false,
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "environment",
            "required": false,
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "level",
            "required": false,
            "schema": {
              "maxLength": 16,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "revision",
            "required": false,
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "service",
            "required": false,
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogsPage"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid selector (bad timestamp, level, q, since, or limit)"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permissions or workspace scope mismatch"
          },
          "404": {
            "description": "Workspace not found"
          },
          "409": {
            "description": "Workspace not provisioned for telemetry"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "error",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "description": "Upstream telemetry credential/backend failure"
          },
          "503": {
            "description": "Authorization backend unavailable (IAM replica unbackfilled or stale); retry"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-putnami-client": {
          "errors": [
            {
              "code": "http.bad_request",
              "status": 400
            },
            {
              "code": "unauthorized",
              "status": 401
            },
            {
              "code": "forbidden",
              "status": 403
            },
            {
              "code": "not_found",
              "status": 404
            },
            {
              "code": "conflict",
              "status": 409
            },
            {
              "code": "http.internal_server",
              "status": 500
            },
            {
              "code": "http.bad_gateway",
              "status": 502
            },
            {
              "code": "http.service_unavailable",
              "status": 503
            }
          ],
          "idempotency": {
            "kind": "safe"
          },
          "security": {
            "alternatives": [
              {
                "allOf": [
                  {
                    "profile": "user",
                    "scopes": [
                      "platform.observability.read"
                    ]
                  }
                ]
              }
            ]
          },
          "stream": "unary",
          "transports": [
            {
              "encoding": "json",
              "path": "/v1/workspaces/{workspace}/logs",
              "protocol": "rest-json"
            }
          ]
        }
      }
    },
    "/v1/workspaces/{workspace}/logs/tail": {
