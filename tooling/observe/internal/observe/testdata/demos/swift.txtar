-- base/Packages/Networking/Sources/Networking/Client.swift --
import Foundation

public struct Client {
    public let baseURL: URL

    public init(baseURL: URL) {
        self.baseURL = baseURL
    }

    public func url(for path: String) -> URL {
        baseURL.appendingPathComponent(path)
    }
}
-- base/Packages/Networking/Tests/NetworkingTests/ClientTests.swift --
import XCTest
@testable import Networking

final class ClientTests: XCTestCase {
    let client = Client(baseURL: URL(string: "https://shop.example.com")!)

    func testURLAppendsThePath() {
        XCTAssertEqual(client.url(for: "quotes").absoluteString, "https://shop.example.com/quotes")
    }
}
-- head/Packages/Networking/Sources/Networking/Client.swift --
import Foundation

public struct Client {
    public let baseURL: URL

    public init(baseURL: URL) {
        self.baseURL = baseURL
    }

    public func url(for path: String) -> URL {
        baseURL.appendingPathComponent(path)
    }

    public func url(for path: String, query: [URLQueryItem]) -> URL {
        var components = URLComponents(url: url(for: path), resolvingAgainstBaseURL: false)!
        components.queryItems = query
        return components.url!
    }
}
-- head/Packages/Networking/Tests/NetworkingTests/ClientTests.swift --
import XCTest
@testable import Networking

final class ClientTests: XCTestCase {
    let client = Client(baseURL: URL(string: "https://shop.example.com")!)

    func testURLAppendsThePath() {
        XCTAssertEqual(client.url(for: "quotes").absoluteString, "https://shop.example.com/quotes")
    }

    func testURLCarriesTheQuery() {
        let url = client.url(for: "quotes", query: [URLQueryItem(name: "sku", value: "A1")])
        XCTAssertEqual(url.absoluteString, "https://shop.example.com/quotes?sku=A1")
    }
}
