-- base/Packages/Pricing/Package.swift --
// swift-tools-version:5.9
import PackageDescription

let package = Package(
    name: "Pricing",
    platforms: [.iOS(.v16), .macOS(.v13)],
    products: [
        .library(name: "Pricing", targets: ["Pricing"]),
    ],
    dependencies: [
        .package(path: "../Networking"),
        .package(url: "https://github.com/apple/swift-collections.git", from: "1.1.0"),
    ],
    targets: [
        .target(name: "Pricing", dependencies: ["Networking", .product(name: "Collections", package: "swift-collections")]),
        .testTarget(name: "PricingTests", dependencies: ["Pricing"]),
    ]
)
-- base/Packages/Pricing/Sources/Pricing/PriceCalculator.swift --
import Networking

public struct PriceCalculator {
    public let client: Client

    public init(client: Client) {
        self.client = client
    }

    public func total(_ amounts: [Decimal], taxRate: Decimal) -> Decimal {
        let net = amounts.reduce(0, +)
        return net + net * taxRate
    }

    public func quoteURL(for sku: String) -> URL {
        client.url(for: "quotes/\(sku)")
    }
}
-- base/Packages/Pricing/Tests/PricingTests/PriceCalculatorTests.swift --
import Networking
import XCTest
@testable import Pricing

final class PriceCalculatorTests: XCTestCase {
    let calculator = PriceCalculator(client: Client(baseURL: URL(string: "https://shop.example.com")!))

    func testTotalAddsTax() {
        XCTAssertEqual(calculator.total([10, 20], taxRate: 0.2), 36)
    }

    func testTotalOfNothingIsZero() {
        XCTAssertEqual(calculator.total([], taxRate: 0.2), 0)
    }

    func testQuoteURLNamesTheSKU() {
        XCTAssertEqual(calculator.quoteURL(for: "A1").absoluteString, "https://shop.example.com/quotes/A1")
    }
}
