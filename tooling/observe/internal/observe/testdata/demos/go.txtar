-- head/pricing/pricing.go --
// Package pricing computes order totals in cents.
package pricing

import "errors"

// ErrNegative reports a negative quantity or price.
var ErrNegative = errors.New("pricing: negative value")

// Line is one order line.
type Line struct {
	SKU       string
	UnitCents int64
	Quantity  int64
}

// Subtotal returns the sum of the lines, before tax.
func Subtotal(lines []Line) (int64, error) {
	var total int64
	for _, l := range lines {
		if l.UnitCents < 0 || l.Quantity < 0 {
			return 0, ErrNegative
		}
		total += l.UnitCents * l.Quantity
	}
	return total, nil
}

// WithTax adds a tax rate, in basis points, rounded half up.
func WithTax(cents int64, basisPoints int64) int64 {
	return cents + (cents*basisPoints+5000)/10000
}

// Discount removes a percentage, in basis points, rounded half down in favor
// of the customer.
func Discount(cents int64, basisPoints int64) int64 {
	if basisPoints <= 0 {
		return cents
	}
	if basisPoints >= 10000 {
		return 0
	}
	return cents - (cents*basisPoints+4999)/10000
}
-- head/pricing/pricing_test.go --
package pricing

import "testing"

func TestSubtotal(t *testing.T) {
	got, err := Subtotal([]Line{{SKU: "a", UnitCents: 250, Quantity: 2}, {SKU: "b", UnitCents: 100, Quantity: 1}})
	if err != nil {
		t.Fatal(err)
	}
	if got != 600 {
		t.Fatalf("Subtotal = %d, want 600", got)
	}
}

func TestSubtotalRejectsNegative(t *testing.T) {
	if _, err := Subtotal([]Line{{SKU: "a", UnitCents: -1, Quantity: 1}}); err != ErrNegative {
		t.Fatalf("err = %v, want ErrNegative", err)
	}
}

func TestWithTax(t *testing.T) {
	if got := WithTax(1000, 2000); got != 1200 {
		t.Fatalf("WithTax = %d, want 1200", got)
	}
}

func TestDiscount(t *testing.T) {
	cases := []struct{ cents, bp, want int64 }{
		{1000, 1000, 900},
		{1000, 0, 1000},
		{1000, 12000, 0},
	}
	for _, c := range cases {
		if got := Discount(c.cents, c.bp); got != c.want {
			t.Fatalf("Discount(%d, %d) = %d, want %d", c.cents, c.bp, got, c.want)
		}
	}
}
