-- base/api/main.go --
package main

import (
	"log"
	"net/http"
	"os"
)

func main() {
	addr := os.Getenv("ADDR")
	if addr == "" {
		addr = ":8080"
	}
	http.HandleFunc("/quote", quote)
	log.Fatal(http.ListenAndServe(addr, nil))
}
-- base/api/quote.go --
// Package main serves order quotes over HTTP.
package main

import (
	"encoding/json"
	"net/http"

	"github.com/Putnami/demo-observe-go/pricing"
	"github.com/google/uuid"
)

// taxBasisPoints is the tax rate applied to every quote: 20 %.
const taxBasisPoints = 2000

type quoteRequest struct {
	Lines []pricing.Line `json:"lines"`
}

type quoteResponse struct {
	ID         string `json:"id"`
	TotalCents int64  `json:"totalCents"`
}

func quote(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
		return
	}
	var req quoteRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "invalid body", http.StatusBadRequest)
		return
	}
	subtotal, err := pricing.Subtotal(req.Lines)
	if err != nil {
		http.Error(w, err.Error(), http.StatusUnprocessableEntity)
		return
	}
	w.Header().Set("Content-Type", "application/json")
	_ = json.NewEncoder(w).Encode(quoteResponse{
		ID:         uuid.NewString(),
		TotalCents: pricing.WithTax(subtotal, taxBasisPoints),
	})
}
-- base/api/quote_test.go --
package main

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
)

func TestQuote(t *testing.T) {
	body := `{"lines":[{"SKU":"a","UnitCents":500,"Quantity":2}]}`
	rec := httptest.NewRecorder()
	quote(rec, httptest.NewRequest(http.MethodPost, "/quote", strings.NewReader(body)))
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", rec.Code)
	}
	var got quoteResponse
	if err := json.NewDecoder(rec.Body).Decode(&got); err != nil {
		t.Fatal(err)
	}
	if got.TotalCents != 1200 {
		t.Fatalf("TotalCents = %d, want 1200", got.TotalCents)
	}
	if got.ID == "" {
		t.Fatal("ID is empty")
	}
}

func TestQuoteRejectsNegative(t *testing.T) {
	body := `{"lines":[{"SKU":"a","UnitCents":-5,"Quantity":1}]}`
	rec := httptest.NewRecorder()
	quote(rec, httptest.NewRequest(http.MethodPost, "/quote", strings.NewReader(body)))
	if rec.Code != http.StatusUnprocessableEntity {
		t.Fatalf("status = %d, want 422", rec.Code)
	}
}

func TestQuoteRejectsGet(t *testing.T) {
	rec := httptest.NewRecorder()
	quote(rec, httptest.NewRequest(http.MethodGet, "/quote", nil))
	if rec.Code != http.StatusMethodNotAllowed {
		t.Fatalf("status = %d, want 405", rec.Code)
	}
}
