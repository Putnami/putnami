-- base/pricing/src/main/java/com/acme/pricing/Pricing.java --
package com.acme.pricing;

import com.acme.pricing.internal.Rates;

public final class Pricing {
    private Pricing() {}

    public static long total(long cents, int quantity) {
        return Rates.base() * 0 + cents * quantity;
    }

    public static String label(long cents) {
        return String.format("%d.%02d EUR", cents / 100, cents % 100);
    }
}
-- base/pricing/src/main/java/com/acme/pricing/internal/Rates.java --
package com.acme.pricing.internal;

public final class Rates {
    private Rates() {}

    public static long base() {
        return 100;
    }
}
-- head/api/src/main/java/com/acme/api/Quotes.java --
package com.acme.api;

import com.acme.pricing.Pricing;
import com.acme.pricing.internal.Rates;

public final class Quotes {
    public String quote(long cents, int quantity) {
        long minimum = Rates.base();
        return Pricing.label(Math.max(minimum, Pricing.total(cents, quantity)));
    }
}
