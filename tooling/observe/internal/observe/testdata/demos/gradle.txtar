-- head/pricing/src/main/kotlin/com/acme/pricing/Pricing.kt --
package com.acme.pricing

import org.apache.commons.lang3.StringUtils

object Pricing {
    fun total(cents: Long, quantity: Int): Long {
        require(quantity >= 0) { "quantity must not be negative" }
        return cents * quantity
    }

    fun discounted(cents: Long, percent: Int): Long {
        require(percent in 0..100) { "percent must be between 0 and 100" }
        return cents - cents * percent / 100
    }

    fun label(cents: Long): String {
        val euros = cents / 100
        val rest = StringUtils.leftPad((cents % 100).toString(), 2, '0')
        return "$euros.$rest EUR"
    }
}
-- head/pricing/src/test/kotlin/com/acme/pricing/PricingTest.kt --
package com.acme.pricing

import org.junit.jupiter.api.Assertions.assertEquals
import org.junit.jupiter.api.Test
import org.junit.jupiter.api.assertThrows

class PricingTest {
    @Test
    fun totalMultipliesByTheQuantity() {
        assertEquals(1500, Pricing.total(500, 3))
    }

    @Test
    fun aNegativeQuantityIsRefused() {
        assertThrows<IllegalArgumentException> { Pricing.total(500, -1) }
    }

    @Test
    fun discountedTakesThePercentOff() {
        assertEquals(900, Pricing.discounted(1000, 10))
    }

    @Test
    fun aDiscountOverOneHundredPercentIsRefused() {
        assertThrows<IllegalArgumentException> { Pricing.discounted(1000, 120) }
    }

    @Test
    fun labelPadsTheCents() {
        assertEquals("12.05 EUR", Pricing.label(1205))
    }
}
