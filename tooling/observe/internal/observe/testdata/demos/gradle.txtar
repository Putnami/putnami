The gradle demo: a Gradle 8.14.3 build in the Kotlin DSL, with the type-safe project accessors and the version catalog gradle/libs.versions.toml. The Kotlin library :pricing locks its dependencies in pricing/gradle.lockfile; :api depends on it through projects.pricing, and :app, an Android library, through project(":pricing"). The change adds a function to pricing and bumps commons-lang3 from 3.17.0 to 3.18.0 in the catalog and the lockfile. The lockfiles and the reports of pricing and api are the output of gradle :pricing:dependencies --write-locks and gradle test with the jacoco plugin, OpenJDK 21 and Kotlin 2.0.21. The Android plugin needs the Android SDK, so the build file of app, the root build file and the Android entries of the catalog are hand-written for it, and the reports of app come from the same sources built with the Kotlin JVM plugin, placed where the Android plugin writes its unit test results and coverage.
-- base/api/build.gradle.kts --
plugins {
    alias(libs.plugins.kotlin.jvm)
    jacoco
}

dependencies {
    implementation(projects.pricing)
    testImplementation(platform(libs.junit.bom))
    testImplementation(libs.junit.jupiter)
    testRuntimeOnly(libs.junit.platform.launcher)
}

kotlin {
    jvmToolchain(21)
}

tasks.test {
    useJUnitPlatform()
    finalizedBy(tasks.jacocoTestReport)
}

tasks.jacocoTestReport {
    reports {
        xml.required = true
    }
}
-- base/api/src/main/kotlin/com/acme/api/Quotes.kt --
package com.acme.api

import com.acme.pricing.Pricing

class Quotes {
    fun quote(cents: Long, quantity: Int): String {
        return Pricing.label(Pricing.total(cents, quantity))
    }
}
-- base/api/src/test/kotlin/com/acme/api/QuotesTest.kt --
package com.acme.api

import org.junit.jupiter.api.Assertions.assertEquals
import org.junit.jupiter.api.Test

class QuotesTest {
    @Test
    fun quoteLabelsTheTotal() {
        assertEquals("15.00 EUR", Quotes().quote(500, 3))
    }

    @Test
    fun anEmptyQuoteIsZero() {
        assertEquals("0.00 EUR", Quotes().quote(500, 0))
    }
}
-- base/app/build.gradle.kts --
plugins {
    alias(libs.plugins.android.library)
    alias(libs.plugins.kotlin.android)
    jacoco
}

android {
    namespace = "com.acme.app"
    compileSdk = 35

    defaultConfig {
        minSdk = 26
    }

    buildTypes {
        debug {
            enableUnitTestCoverage = true
        }
    }
}

kotlin {
    jvmToolchain(21)
}

dependencies {
    implementation(project(":pricing"))
    testImplementation(platform(libs.junit.bom))
    testImplementation(libs.junit.jupiter)
    testRuntimeOnly(libs.junit.platform.launcher)
}

tasks.withType<Test> {
    useJUnitPlatform()
}
