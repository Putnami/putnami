namespace Demo\Pricing;

final readonly class Line
{
    public function __construct(
        public string $sku,
        public string $unitPrice,
        public int $quantity,
    ) {
    }
}
-- base/packages/pricing/tests/CalculatorTest.php --
<?php

namespace Demo\Pricing\Tests;

use Demo\Pricing\Calculator;
use Demo\Pricing\Line;
use PHPUnit\Framework\TestCase;

final class CalculatorTest extends TestCase
{
    public function testSubtotalSumsTheLines(): void
    {
        $lines = [new Line('a', '2.50', 2), new Line('b', '1.00', 1)];

        self::assertSame('6.00', (new Calculator())->subtotal($lines));
    }

    public function testSubtotalRejectsANegativePrice(): void
    {
        $this->expectException(\InvalidArgumentException::class);

        (new Calculator())->subtotal([new Line('a', '-1', 1)]);
    }

    public function testWithTaxAddsTwentyPercent(): void
    {
        self::assertSame('12.00', (new Calculator())->withTax('10.00', '0.2'));
    }
}
-- base/src/Kernel.php --
<?php

namespace App;

use Symfony\Bundle\FrameworkBundle\Kernel\MicroKernelTrait;
use Symfony\Component\HttpKernel\Kernel as BaseKernel;

class Kernel extends BaseKernel
{
    use MicroKernelTrait;

    /**
     * @return list<string> An array of allowed values for APP_ENV
     */
    private function getAllowedEnvs(): array
    {
        return ['prod', 'dev', 'test'];
    }
}
-- base/src/Controller/QuoteController.php --
<?php

namespace App\Controller;

use Demo\Pricing\Calculator;
use Demo\Pricing\Line;
use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;
use Symfony\Component\Uid\Uuid;

final class QuoteController
{
    /** Tax rate applied to every quote: 20 %. */
    private const string TAX_RATE = '0.2';

    public function __construct(private readonly Calculator $calculator)
    {
    }

    #[Route('/quote', name: 'quote', methods: ['POST'])]
    public function __invoke(Request $request): JsonResponse
    {
        try {
            $body = json_decode($request->getContent(), true, flags: \JSON_THROW_ON_ERROR);
            $lines = array_map(
                static fn (array $line): Line => new Line((string) $line['sku'], (string) $line['unitPrice'], (int) $line['quantity']),
                $body['lines'] ?? [],
            );
            $total = $this->calculator->withTax($this->calculator->subtotal($lines), self::TAX_RATE);
        } catch (\JsonException|\InvalidArgumentException|\TypeError) {
            return new JsonResponse(['error' => 'invalid quote request'], Response::HTTP_UNPROCESSABLE_ENTITY);
        }

        return new JsonResponse(['id' => (string) Uuid::v7(), 'total' => $total]);
    }
}
-- base/tests/Controller/QuoteControllerTest.php --
<?php

namespace App\Tests\Controller;

use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;

final class QuoteControllerTest extends WebTestCase
{
    public function testQuotePricesTheLinesWithTax(): void
    {
        $client = static::createClient();
        $client->request('POST', '/quote', content: '{"lines":[{"sku":"a","unitPrice":"5.00","quantity":2}]}');

        self::assertResponseIsSuccessful();
        $body = json_decode($client->getResponse()->getContent(), true);
        self::assertSame('12.00', $body['total']);
        self::assertNotEmpty($body['id']);
    }

    public function testQuoteRejectsAnInvalidLine(): void
    {
        $client = static::createClient();
        $client->request('POST', '/quote', content: '{"lines":[{"sku":"a","unitPrice":"-5","quantity":1}]}');

        self::assertResponseStatusCodeSame(422);
    }

    public function testQuoteRejectsAnInvalidBody(): void
    {
        $client = static::createClient();
        $client->request('POST', '/quote', content: 'not json');

        self::assertResponseStatusCodeSame(422);
    }
}
