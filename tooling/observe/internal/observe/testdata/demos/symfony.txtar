    public function subtotal(array $lines): string
    {
        $total = BigDecimal::zero();
        foreach ($lines as $line) {
            $price = BigDecimal::of($line->unitPrice);
            if ($price->isNegative() || $line->quantity < 0) {
                throw new \InvalidArgumentException(sprintf('Invalid line %s.', $line->sku));
            }
            $total = $total->plus($price->multipliedBy($line->quantity));
        }

        return (string) $total->toScale(2);
    }

    /**
     * Adds a tax rate given as a fraction, for example "0.2", rounded half up.
     */
    public function withTax(string $amount, string $rate): string
    {
        $value = BigDecimal::of($amount);

        return (string) $value->plus($value->multipliedBy($rate))->toScale(2, RoundingMode::HALF_UP);
    }

    /**
     * Removes a percentage given as a fraction, rounded in favor of the customer.
     */
    public function discount(string $amount, string $rate): string
    {
        $value = BigDecimal::of($amount);
        $off = BigDecimal::of($rate);
        if ($off->isNegativeOrZero()) {
            return (string) $value->toScale(2);
        }
        if ($off->isGreaterThanOrEqualTo(1)) {
            return '0.00';
        }

        return (string) $value->minus($value->multipliedBy($off)->toScale(2, RoundingMode::HALF_DOWN))->toScale(2);
    }
}
-- head/packages/pricing/tests/CalculatorTest.php --
<?php

namespace Demo\Pricing\Tests;

use Demo\Pricing\Calculator;
use Demo\Pricing\Line;
use PHPUnit\Framework\TestCase;

final class CalculatorTest extends TestCase
{
    public function testSubtotalSumsTheLines(): void
    {
        $lines = [new Line('a', '2.50', 2), new Line('b', '1.00', 1)];

        self::assertSame('6.00', (new Calculator())->subtotal($lines));
    }

    public function testSubtotalRejectsANegativePrice(): void
    {
        $this->expectException(\InvalidArgumentException::class);

        (new Calculator())->subtotal([new Line('a', '-1', 1)]);
    }

    public function testWithTaxAddsTwentyPercent(): void
    {
        self::assertSame('12.00', (new Calculator())->withTax('10.00', '0.2'));
    }

    public function testDiscountRemovesTenPercent(): void
    {
        self::assertSame('9.00', (new Calculator())->discount('10.00', '0.1'));
    }

    public function testDiscountKeepsTheAmountWithoutARate(): void
    {
        self::assertSame('10.00', (new Calculator())->discount('10', '0'));
    }

    public function testDiscountNeverGoesBelowZero(): void
    {
        self::assertSame('0.00', (new Calculator())->discount('10.00', '1.5'));
    }
}
