-- head/packages/pricing/pubspec.yaml --
name: pricing
description: Prices, VAT and discounts of the shop.
version: 1.0.0
publish_to: none
resolution: workspace

environment:
  sdk: ^3.7.0

dependencies:
  intl: ^0.20.2

dev_dependencies:
  flutter_test:
    sdk: flutter
-- head/packages/pricing/lib/src/price.dart --
import 'package:intl/intl.dart';

final _euros = NumberFormat.currency(locale: 'en_IE', symbol: '€');

/// The price of [cents], formatted in euros.
String formatPrice(int cents) => _euros.format(cents / 100);

/// The price of [cents] with the VAT [rate] added, rounded to the cent.
int withVat(int cents, {double rate = 0.2}) => (cents * (1 + rate)).round();

/// The price of [cents] less a [percent] discount, rounded to the cent.
int discounted(int cents, int percent) {
  if (percent < 0 || percent > 100) {
    throw ArgumentError.value(percent, 'percent', 'must be between 0 and 100');
  }
  return (cents * (100 - percent) / 100).round();
}
-- head/packages/pricing/test/price_test.dart --
import 'package:flutter_test/flutter_test.dart';
import 'package:pricing/pricing.dart';

void main() {
  test('formats euros', () => expect(formatPrice(1999), '€19.99'));
  test('adds the VAT', () => expect(withVat(1000), 1200));
  test('applies a discount', () => expect(discounted(2000, 15), 1700));
  test('refuses a discount above 100 percent', () {
    expect(() => discounted(100, 101), throwsArgumentError);
  });
}
