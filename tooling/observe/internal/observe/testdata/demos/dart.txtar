-- sbom/base.cdx.json --
{
  "$schema": "http://cyclonedx.org/schema/bom-1.5.schema.json",
  "bomFormat": "CycloneDX",
  "specVersion": "1.5",
  "version": 1,
  "components": [
    {
      "bom-ref": "pkg:pub/intl@0.19.0",
      "type": "library",
      "name": "intl",
      "version": "0.19.0",
      "licenses": [
