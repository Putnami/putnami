-- base/apps/mobile/pubspec.yaml --
name: mobile
description: The shop's mobile app.
publish_to: none
version: 1.0.0+1
resolution: workspace

environment:
  sdk: ^3.7.0
  flutter: ">=3.29.0"

dependencies:
  flutter:
    sdk: flutter
  pricing:
    path: ../../packages/pricing
  ui:
    path: ../../packages/ui

dev_dependencies:
  flutter_test:
    sdk: flutter

flutter:
  uses-material-design: true
-- base/apps/mobile/lib/main.dart --
import 'package:flutter/material.dart';
import 'package:pricing/pricing.dart';
import 'package:ui/ui.dart';

void main() => runApp(const ShopApp());

class ShopApp extends StatelessWidget {
  const ShopApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      home: Scaffold(
        body: Center(child: PriceTag(label: formatPrice(1999))),
      ),
    );
  }
}
-- base/apps/mobile/test/widget_test.dart --
import 'package:flutter_test/flutter_test.dart';
import 'package:mobile/main.dart';

void main() {
  testWidgets('shows the price tag', (tester) async {
    await tester.pumpWidget(const ShopApp());
    expect(find.text('€19.99'), findsOneWidget);
  });
}
-- base/packages/pricing/pubspec.yaml --
name: pricing
description: Prices, VAT and discounts of the shop.
version: 1.0.0
publish_to: none
resolution: workspace

environment:
  sdk: ^3.7.0

dependencies:
  intl: ^0.19.0

dev_dependencies:
  flutter_test:
    sdk: flutter
-- base/packages/pricing/lib/pricing.dart --
export 'src/price.dart';
-- base/packages/pricing/lib/src/price.dart --
import 'package:intl/intl.dart';

final _euros = NumberFormat.currency(locale: 'en_IE', symbol: '€');

/// The price of [cents], formatted in euros.
String formatPrice(int cents) => _euros.format(cents / 100);

/// The price of [cents] with the VAT [rate] added, rounded to the cent.
int withVat(int cents, {double rate = 0.2}) => (cents * (1 + rate)).round();
-- base/packages/pricing/test/price_test.dart --
import 'package:flutter_test/flutter_test.dart';
import 'package:pricing/pricing.dart';

void main() {
  test('formats euros', () => expect(formatPrice(1999), '€19.99'));
  test('adds the VAT', () => expect(withVat(1000), 1200));
}
-- base/packages/ui/pubspec.yaml --
name: ui
description: The shop's design system.
version: 1.0.0
publish_to: none
resolution: workspace

environment:
  sdk: ^3.7.0
  flutter: ">=3.29.0"

dependencies:
  flutter:
    sdk: flutter

dev_dependencies:
  flutter_test:
    sdk: flutter
-- base/packages/ui/lib/ui.dart --
export 'src/price_tag.dart';
-- base/packages/ui/lib/src/price_tag.dart --
import 'package:flutter/widgets.dart';

/// A price, set in the shop's price style.
class PriceTag extends StatelessWidget {
  const PriceTag({super.key, required this.label});

  final String label;

  @override
  Widget build(BuildContext context) {
    return Text(label, style: const TextStyle(fontWeight: FontWeight.w600));
  }
}
-- base/packages/ui/test/price_tag_test.dart --
import 'package:flutter/widgets.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:ui/ui.dart';

void main() {
  testWidgets('shows its label', (tester) async {
    await tester.pumpWidget(const Directionality(
      textDirection: TextDirection.ltr,
      child: PriceTag(label: '€1.00'),
    ));
    expect(find.text('€1.00'), findsOneWidget);
  });
}
