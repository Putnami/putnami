The bazel demo: a Bzlmod workspace whose //api depends on //pricing, beside //web; its base, the files its change rewrites, the query export its CI wrote, and the outputs of bazel test and bazel coverage under bazel/, which the demo links as bazel-testlogs and bazel-out.
-- base/MODULE.bazel --
module(name = "shop", version = "0.1.0")

bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "aspect_rules_js", version = "2.1.0")
-- base/.bazelrc --
coverage --combined_report=lcov
-- base/.gitignore --
/bazel-*
-- base/pricing/BUILD.bazel --
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "pricing",
    srcs = ["pricing.go"],
    importpath = "example.com/shop/pricing",
    visibility = ["//visibility:public"],
)

go_test(
    name = "pricing_test",
    srcs = ["pricing_test.go"],
    embed = [":pricing"],
)
-- base/pricing/pricing.go --
package pricing

// Quote returns the price of qty units at unit cents.
func Quote(unit, qty int) int {
	total := unit * qty
	return total
}
-- base/pricing/pricing_test.go --
package pricing

import "testing"

func TestQuote(t *testing.T) {
	if got := Quote(250, 2); got != 500 {
		t.Fatalf("Quote(250, 2) = %d", got)
	}
}
-- base/api/BUILD.bazel --
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = ["api.go"],
    importpath = "example.com/shop/api",
    deps = ["//pricing"],
)

go_test(
    name = "api_test",
    srcs = ["api_test.go"],
    embed = [":api"],
)
-- base/api/api.go --
package api

import "example.com/shop/pricing"

// Price answers the price of an order.
func Price(unit, qty int) int {
	return pricing.Quote(unit, qty)
}
-- base/api/api_test.go --
package api

import "testing"

func TestPrice(t *testing.T) {
	if got := Price(100, 3); got != 300 {
		t.Fatalf("Price(100, 3) = %d", got)
	}
}

func TestPriceOfNothing(t *testing.T) {
	if got := Price(100, 0); got != 0 {
		t.Fatalf("Price(100, 0) = %d", got)
	}
}
-- base/web/BUILD.bazel --
load("@aspect_rules_js//js:defs.bzl", "js_library")

js_library(
    name = "web",
    srcs = ["index.js"],
)
-- base/web/index.js --
export const title = "shop";
-- head/pricing/pricing.go --
package pricing

// Quote returns the price of qty units at unit cents, ten percent off
// from ten units.
func Quote(unit, qty int) int {
	total := unit * qty
	if qty >= 10 {
		total -= total / 10
	}
	return total
}
-- head/pricing/pricing_test.go --
package pricing

import "testing"

func TestQuote(t *testing.T) {
	if got := Quote(250, 2); got != 500 {
		t.Fatalf("Quote(250, 2) = %d", got)
	}
}

func TestQuoteDiscount(t *testing.T) {
	if got := Quote(100, 10); got != 900 {
		t.Fatalf("Quote(100, 10) = %d", got)
	}
}

func TestQuoteOfNothing(t *testing.T) {
	if got := Quote(100, 0); got != 0 {
		t.Fatalf("Quote(100, 0) = %d", got)
	}
}
