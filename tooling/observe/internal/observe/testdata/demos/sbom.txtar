The sbom demo: a Node package that upgrades lodash, drops minimist and adds zod, and the SBOMs osv-scanner 2.7.0 wrote for its base and its head (see tooling/evidence-readers/testdata/SOURCES.md).
-- base/package.json --
{
  "name": "demo",
  "version": "1.0.0",
  "dependencies": {"lodash": "4.17.20", "minimist": "1.2.5"}
}
-- base/package-lock.json --
{
  "name": "demo",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {"name": "demo", "version": "1.0.0", "dependencies": {"lodash": "4.17.20", "minimist": "1.2.5"}},
    "node_modules/lodash": {"version": "4.17.20", "resolved": "https://registry.npmjs.org/lodash/-/lodash-4.17.20.tgz", "license": "MIT"},
    "node_modules/minimist": {"version": "1.2.5", "resolved": "https://registry.npmjs.org/minimist/-/minimist-1.2.5.tgz", "license": "MIT"}
  }
}
-- head/package.json --
{
