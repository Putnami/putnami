-- base/pricing/src/main/java/com/acme/pricing/Pricing.java --
package com.acme.pricing;

public final class Pricing {
    private Pricing() {
    }

    public static long total(long cents, int quantity) {
        if (quantity < 0) {
            throw new IllegalArgumentException("quantity must not be negative");
        }
        return cents * quantity;
    }

    public static String label(long cents) {
        return String.format("%d.%02d EUR", cents / 100, cents % 100);
    }
}
-- base/pricing/src/test/java/com/acme/pricing/PricingTest.java --
package com.acme.pricing;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;

import org.junit.jupiter.api.Test;

class PricingTest {
    @Test
    void totalMultipliesByTheQuantity() {
        assertEquals(1500, Pricing.total(500, 3));
    }

    @Test
    void aNegativeQuantityIsRefused() {
        assertThrows(IllegalArgumentException.class, () -> Pricing.total(500, -1));
    }

    @Test
    void labelPadsTheCents() {
        assertEquals("12.05 EUR", Pricing.label(1205));
    }
}
-- head/pricing/src/main/java/com/acme/pricing/Pricing.java --
package com.acme.pricing;

public final class Pricing {
    private Pricing() {
    }

    public static long total(long cents, int quantity) {
        if (quantity < 0) {
            throw new IllegalArgumentException("quantity must not be negative");
        }
        return cents * quantity;
    }

    public static long discounted(long cents, int percent) {
        if (percent < 0 || percent > 100) {
            throw new IllegalArgumentException("percent must be between 0 and 100");
        }
        return cents - cents * percent / 100;
    }

    public static String label(long cents) {
        return String.format("%d.%02d EUR", cents / 100, cents % 100);
    }
}
-- head/pricing/src/test/java/com/acme/pricing/PricingTest.java --
package com.acme.pricing;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;

import org.junit.jupiter.api.Test;

class PricingTest {
    @Test
    void totalMultipliesByTheQuantity() {
        assertEquals(1500, Pricing.total(500, 3));
    }

    @Test
    void aNegativeQuantityIsRefused() {
        assertThrows(IllegalArgumentException.class, () -> Pricing.total(500, -1));
    }

    @Test
    void discountedTakesThePercentOff() {
        assertEquals(900, Pricing.discounted(1000, 10));
    }

    @Test
    void aDiscountOverOneHundredPercentIsRefused() {
        assertThrows(IllegalArgumentException.class, () -> Pricing.discounted(1000, 120));
    }

    @Test
    void labelPadsTheCents() {
        assertEquals("12.05 EUR", Pricing.label(1205));
    }
}
