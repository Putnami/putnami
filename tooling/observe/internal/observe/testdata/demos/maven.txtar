The maven demo: a Maven 3.9.11 build whose aggregator pom.xml lists the modules pricing and api, where api depends on pricing through ${project.groupId}. The change adds a method to pricing. The reports are the output of mvn verify with maven-surefire-plugin 3.5.2, jacoco-maven-plugin 0.8.13, OpenJDK 21 and JUnit 5.11.4: the Surefire reports of each module, with their properties block, which lists the Java system properties of the machine, emptied, and the jacoco.xml of each module.
-- base/api/pom.xml --
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acme</groupId>
    <artifactId>shop</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>api</artifactId>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>pricing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
-- base/api/src/main/java/com/acme/api/Quotes.java --
package com.acme.api;

import com.acme.pricing.Pricing;

public final class Quotes {
    public String quote(long cents, int quantity) {
        return Pricing.label(Pricing.total(cents, quantity));
    }
}
-- base/api/src/test/java/com/acme/api/QuotesTest.java --
package com.acme.api;

import static org.junit.jupiter.api.Assertions.assertEquals;

import org.junit.jupiter.api.Nested;
import org.junit.jupiter.api.Test;

class QuotesTest {
    @Test
    void quoteLabelsTheTotal() {
        assertEquals("15.00 EUR", new Quotes().quote(500, 3));
    }

    @Nested
    class Empty {
        @Test
        void anEmptyQuoteIsZero() {
            assertEquals("0.00 EUR", new Quotes().quote(500, 0));
        }
    }
}
-- base/pom.xml --
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.acme</groupId>
  <artifactId>shop</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <modules>
    <module>pricing</module>
    <module>api</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.11.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
