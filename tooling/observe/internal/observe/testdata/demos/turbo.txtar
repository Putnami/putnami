-- base/turbo.json --
{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["reports/**"]
    }
  }
}
-- base/packages/pricing/package.json --
{
  "name": "@demo/pricing",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "3.23.8"
  }
}
-- base/packages/pricing/src/index.ts --
import { z } from 'zod';

export const lineSchema = z.object({
  sku: z.string().min(1),
  unitCents: z.number().int().nonnegative(),
  quantity: z.number().int().nonnegative(),
});

export type Line = z.infer<typeof lineSchema>;

/** Sum of the lines, before tax, in cents. Throws on an invalid line. */
export function subtotal(lines: unknown[]): number {
  return lines
    .map((line) => lineSchema.parse(line))
    .reduce((total, line) => total + line.unitCents * line.quantity, 0);
}

/** Adds a tax rate in basis points, rounded half up. */
export function withTax(cents: number, basisPoints: number): number {
  return cents + Math.floor((cents * basisPoints + 5000) / 10000);
}
-- base/packages/pricing/src/index.test.ts --
import { describe, expect, it } from 'vitest';
import { subtotal, withTax } from './index.js';

describe('subtotal', () => {
  it('sums the lines', () => {
    expect(
      subtotal([
        { sku: 'a', unitCents: 250, quantity: 2 },
        { sku: 'b', unitCents: 100, quantity: 1 },
      ]),
    ).toBe(600);
  });

  it('rejects a negative price', () => {
    expect(() => subtotal([{ sku: 'a', unitCents: -1, quantity: 1 }])).toThrow();
  });
});

describe('withTax', () => {
  it('adds 20 %', () => {
    expect(withTax(1000, 2000)).toBe(1200);
  });
});
-- base/apps/api/package.json --
{
  "name": "@demo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@demo/pricing": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
-- base/apps/api/src/quote.ts --
import { randomUUID } from 'node:crypto';
import { subtotal, withTax } from '@demo/pricing';

/** Tax rate applied to every quote: 20 %. */
const TAX_BASIS_POINTS = 2000;

export interface Quote {
  id: string;
  totalCents: number;
}

export type QuoteResult = { ok: true; quote: Quote } | { ok: false; error: string };

export function quote(body: unknown): QuoteResult {
  if (typeof body !== 'object' || body === null || !Array.isArray((body as { lines?: unknown }).lines)) {
    return { ok: false, error: 'lines must be an array' };
  }
  try {
    const cents = subtotal((body as { lines: unknown[] }).lines);
    return { ok: true, quote: { id: randomUUID(), totalCents: withTax(cents, TAX_BASIS_POINTS) } };
  } catch {
    return { ok: false, error: 'invalid line' };
  }
}
-- base/apps/api/src/quote.test.ts --
import { describe, expect, it } from 'vitest';
import { quote } from './quote.js';

describe('quote', () => {
  it('prices the lines with tax', () => {
    const result = quote({ lines: [{ sku: 'a', unitCents: 500, quantity: 2 }] });
    expect(result.ok && result.quote.totalCents).toBe(1200);
  });

  it('rejects a body without lines', () => {
    expect(quote({})).toEqual({ ok: false, error: 'lines must be an array' });
  });

  it('rejects an invalid line', () => {
    expect(quote({ lines: [{ sku: '', unitCents: 1, quantity: 1 }] })).toEqual({ ok: false, error: 'invalid line' });
  });
});
