The turbo demo: its base, the files its change rewrites, and the reports its CI wrote.
-- base/package.json --
{
  "name": "demo-observe-turbo",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0"
  }
}
-- base/pnpm-workspace.yaml --
packages:
  - apps/*
  - packages/*
onlyBuiltDependencies:
  - esbuild
-- base/pnpm-lock.yaml --
lockfileVersion: '9.0'

settings:
  autoInstallPeers: true
  excludeLinksFromLockfile: false

importers:

  .:
    devDependencies:
      '@vitest/coverage-v8':
        specifier: ^3.2.0
        version: 3.2.7(vitest@3.2.7(@types/node@22.20.5))
      turbo:
        specifier: ^2.5.0
        version: 2.11.10
      typescript:
        specifier: ^5.6.0
        version: 5.9.3
      vitest:
        specifier: ^3.2.0
        version: 3.2.7(@types/node@22.20.5)

  apps/api:
    dependencies:
      '@demo/pricing':
        specifier: workspace:*
        version: link:../../packages/pricing
    devDependencies:
      '@types/node':
        specifier: ^22.20.5
        version: 22.20.5

  packages/pricing:
    dependencies:
      zod:
        specifier: 3.23.8
        version: 3.23.8

packages:

  '@vitest/coverage-v8@3.2.7':
    resolution: {integrity: sha512-NEGWJS2XNu2PfRLQwOO3CTKj1tTETxNBdk454vDxVBhxJYhPaA/eS0nAI0c+1El1P7a60z8+i+ZrQoGESweGKg==}
    peerDependencies:
      '@vitest/browser': 3.2.7
      vitest: 3.2.7
    peerDependenciesMeta:
      '@vitest/browser':
        optional: true

  vitest@3.2.7:
    resolution: {integrity: sha512-KrxIJ62Fd89gfysR4WotlgZABiz2dqFPgqGzX7s+CwsqLFomRH7777ZcrOD6+WVAh7khPQP41A+BKbpcJFrdEg==}
    engines: {node: ^18.0.0 || ^20.0.0 || >=22.0.0}
    hasBin: true
    peerDependencies:
      '@edge-runtime/vm': '*'
      '@types/debug': ^4.1.12
      '@types/node': ^18.0.0 || ^20.0.0 || >=22.0.0
      '@vitest/browser': 3.2.7
      '@vitest/ui': 3.2.7
      happy-dom: '*'
      jsdom: '*'
