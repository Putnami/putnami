The pants demo: a Pants 2.25 repository with the source root src/python, where api imports pricing and web stands alone, and third-party requirements in 3rdparty/python with the python-default resolve. The change adds a function to pricing and bumps fastapi in the resolve lockfile. The files are hand-written in the shape Pants 2.25 writes them: pants-graph.json as pants peek :: writes it, the JUnit reports of pants test --test-report under dist/test/reports, the coverage.xml of pants test --use-coverage under dist/coverage/python, and default.lock as a PEX JSON lock with its Pants header.
-- base/pants.toml --
[GLOBAL]
pants_version = "2.25.0"
backend_packages = ["pants.backend.python"]

[source]
root_patterns = ["/src/python"]

[python]
enable_resolves = true
interpreter_constraints = ["CPython==3.12.*"]

[python.resolves]
python-default = "3rdparty/python/default.lock"

[test]
report = true
use_coverage = true

[coverage-py]
report = ["xml"]
-- base/3rdparty/python/BUILD --
python_requirements(name="reqs")
-- base/3rdparty/python/requirements.txt --
fastapi==0.115.5
pytest==8.3.4
pytest-cov==6.0.0
