-- base/src/python/api/BUILD --
python_sources()

python_tests(name="tests")
-- base/src/python/api/main.py --
from fastapi import FastAPI

from pricing.pricing import total

app = FastAPI()


@app.post("/quotes")
def quote(lines: list[tuple[int, int]]) -> dict[str, int]:
    return {"total": total(lines)}
-- base/src/python/api/main_test.py --
from api.main import quote


def test_quote():
    assert quote([(3, 100)]) == {"total": 300}


def test_empty_quote():
    assert quote([]) == {"total": 0}
-- base/src/python/pricing/BUILD --
python_sources()

python_tests(name="tests")
-- base/src/python/pricing/pricing.py --
def total(lines: list[tuple[int, int]]) -> int:
    return sum(quantity * unit for quantity, unit in lines)
-- base/src/python/pricing/pricing_test.py --
from pricing.pricing import total


def test_total():
    assert total([(2, 150), (1, 50)]) == 350


def test_empty_total():
    assert total([]) == 0
-- base/src/python/web/BUILD --
python_sources()

python_tests(name="tests")
-- base/src/python/web/pages.py --
def title(name: str) -> str:
    return f"{name} | Shop"
-- base/src/python/web/pages_test.py --
from web.pages import title


def test_title():
    assert title("Cart") == "Cart | Shop"
