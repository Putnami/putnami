-- head/src/python/pricing/pricing.py --
def total(lines: list[tuple[int, int]]) -> int:
    return sum(quantity * unit for quantity, unit in lines)


def discount(amount: int, percent: int) -> int:
    if not 0 <= percent <= 100:
        raise ValueError("percent is out of range")
    return amount - amount * percent // 100
-- head/src/python/pricing/pricing_test.py --
import pytest

from pricing.pricing import discount, total


def test_total():
    assert total([(2, 150), (1, 50)]) == 350


def test_empty_total():
    assert total([]) == 0


def test_discount():
    assert discount(1000, 10) == 900


def test_discount_out_of_range():
    with pytest.raises(ValueError):
        discount(1000, 120)
