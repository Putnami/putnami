The codeowners demo: a repository no detector recognizes, split by its CODEOWNERS, with a change in billing.
-- base/.github/CODEOWNERS --
# Each team owns its directory.
*            @acme/maintainers
/billing/    @acme/billing
/catalog/**  @acme/catalog
web/         @acme/web
*.md         @acme/docs
/missing/    @acme/nobody
-- base/README.md --
# Shop
-- base/docs/guide.md --
# Guide
-- base/billing/invoice.py --
def total(lines):
    return sum(lines)
-- base/billing/test_invoice.py --
from invoice import total


def test_total():
    assert total([1, 2]) == 3
-- base/catalog/catalog.py --
ITEMS = ["book"]
-- base/web/app.js --
export const title = "Shop";
-- head/billing/invoice.py --
def total(lines):
    return round(sum(lines), 2)
