global using Xunit;
-- base/tests/Pricing.Tests/PriceCalculatorTests.cs --
using Pricing;

namespace Pricing.Tests;

public class PriceCalculatorTests
{
    [Fact]
    public void TotalMultipliesTheUnitPrice() => Assert.Equal(29.97m, PriceCalculator.Total(9.99m, 3));

    [Theory]
    [InlineData(100, 0.2, 120)]
    [InlineData(10, 0, 10)]
    public void WithTaxAddsTheRate(decimal amount, decimal rate, decimal expected) =>
        Assert.Equal(expected, PriceCalculator.WithTax(amount, rate));
}
