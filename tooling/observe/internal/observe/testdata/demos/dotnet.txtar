-- base/src/Pricing/PriceCalculator.cs --
namespace Pricing;

public static class PriceCalculator
{
    public static decimal Total(decimal unitPrice, int quantity) => unitPrice * quantity;

    public static decimal WithTax(decimal amount, decimal rate) => Math.Round(amount * (1 + rate), 2);
}
