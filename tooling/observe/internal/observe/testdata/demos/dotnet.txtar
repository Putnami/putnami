using Pricing;

namespace Api;

public static class QuoteEndpoint
{
    public static Quote Handle(string sku, decimal unitPrice, int quantity) =>
        new(sku, PriceCalculator.WithTax(PriceCalculator.Total(unitPrice, quantity), 0.2m));
}
