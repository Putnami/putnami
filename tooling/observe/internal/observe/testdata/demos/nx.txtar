-- base/apps/api/src/quote.ts --
import { randomUUID } from 'node:crypto';
import { Line, subtotal, withTax } from '@demo/pricing';

/** Tax rate applied to every quote: 20 %. */
const TAX_RATE = '0.2';

export interface Quote {
  id: string;
  total: string;
}

export function quote(lines: Line[]): Quote {
  return { id: randomUUID(), total: withTax(subtotal(lines), TAX_RATE) };
}
-- base/apps/api/src/quote.spec.ts --
import { quote } from './quote';

describe('quote', () => {
  it('prices the lines with tax', () => {
    const result = quote([{ sku: 'a', unitPrice: '5.00', quantity: 2 }]);
    expect(result.total).toBe('12.00');
    expect(result.id).toMatch(/^[0-9a-f-]{36}$/);
  });

  it('rejects an invalid line', () => {
    expect(() => quote([{ sku: 'a', unitPrice: '-5', quantity: 1 }])).toThrow(RangeError);
  });
});
