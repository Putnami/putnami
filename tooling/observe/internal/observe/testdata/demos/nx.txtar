The nx demo: its base, the files its change rewrites, and the reports its CI wrote.
-- base/nx.json --
{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/reports"],
      "cache": true
    }
  }
}
-- base/package.json --
{
  "name": "demo-observe-nx",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test"
