/** @type {import('jest').Config} */
module.exports = {
  preset: 'ts-jest',
  testEnvironment: 'node',
  testMatch: ['<rootDir>/src/**/*.spec.ts'],
  reporters: ['default', ['jest-junit', { outputDirectory: 'reports', outputName: 'junit.xml' }]],
  collectCoverage: true,
  collectCoverageFrom: ['src/**/*.ts', '!src/**/*.spec.ts', '!src/server.ts'],
  coverageDirectory: 'reports/coverage',
  coverageReporters: ['text', 'cobertura'],
};
-- base/packages/pricing/src/index.ts --
import Decimal from 'decimal.js';

export interface Line {
  sku: string;
  unitPrice: string;
  quantity: number;
}

/** Sum of the lines, before tax, as a decimal string with two places. */
export function subtotal(lines: Line[]): string {
  const total = lines.reduce((sum, line) => {
    const price = new Decimal(line.unitPrice);
    if (price.isNegative() || line.quantity < 0) {
      throw new RangeError(`invalid line ${line.sku}`);
    }
    return sum.plus(price.times(line.quantity));
  }, new Decimal(0));
  return total.toFixed(2);
}

/** Adds a tax rate given as a fraction, for example "0.2", rounded half up. */
export function withTax(amount: string, rate: string): string {
  const value = new Decimal(amount);
  return value.plus(value.times(rate)).toDecimalPlaces(2, Decimal.ROUND_HALF_UP).toFixed(2);
}
-- base/packages/pricing/src/index.spec.ts --
import { subtotal, withTax } from './index';

describe('subtotal', () => {
  it('sums the lines', () => {
    expect(
      subtotal([
        { sku: 'a', unitPrice: '2.50', quantity: 2 },
        { sku: 'b', unitPrice: '1.00', quantity: 1 },
      ]),
    ).toBe('6.00');
  });

  it('rejects a negative price', () => {
    expect(() => subtotal([{ sku: 'a', unitPrice: '-1', quantity: 1 }])).toThrow(RangeError);
  });
});

describe('withTax', () => {
  it('adds 20 %', () => {
    expect(withTax('10.00', '0.2')).toBe('12.00');
  });
});
