<testsuites>
  <testsuite id="1" package="" name="Controller" hostname="localhost" tests="1" failures="2" skipped="0" errors="0" time="0">
    <testcase name="Controller - App\Controller\QuoteController" classname="App\Controller\QuoteController" time="0">
      <failure message="App\Controller\QuoteController:7 must not depend on App\Repository\QuoteRepository (Controller on Repository)" type="WARNING"/>
      <failure message="App\Controller\QuoteController:12 must not depend on App\Repository\QuoteRepository (Controller on Repository)" type="WARNING"/>
    </testcase>
  </testsuite>
  <testsuite id="2" package="" name="Service" hostname="localhost" tests="1" failures="0" skipped="0" errors="0" time="0">
    <testcase name="Service - App\Service\QuoteService" classname="App\Service\QuoteService" time="0"/>
  </testsuite>
  <testsuite id="3" package="" name="Pricing" hostname="localhost" tests="1" failures="2" skipped="0" errors="0" time="0">
    <testcase name="Pricing - Acme\Pricing\Calculator" classname="Acme\Pricing\Calculator" time="0">
      <failure message="Acme\Pricing\Calculator:7 must not depend on App\Service\QuoteService (Pricing on Service)" type="WARNING"/>
      <failure message="Acme\Pricing\Calculator:16 must not depend on App\Service\QuoteService (Pricing on Service)" type="WARNING"/>
    </testcase>
  </testsuite>
</testsuites>
