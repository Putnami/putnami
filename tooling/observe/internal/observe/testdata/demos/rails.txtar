-- head/packs/pricing/app/models/pricing/calculator.rb --
module Pricing
  class Calculator
    def total(lines)
      lines.sum { |unit, quantity| unit * quantity }
    end

    def discount(amount, percent)
      raise ArgumentError, "percent must lie in 0..100" unless (0..100).cover?(percent)

      amount - (amount * percent / 100)
    end
  end
end
-- head/packs/pricing/spec/models/pricing/calculator_spec.rb --
RSpec.describe Pricing::Calculator do
  subject(:calculator) { described_class.new }

  it "sums the lines" do
    expect(calculator.total([[100, 3], [50, 2]])).to eq(400)
  end

  it "totals no line as zero" do
    expect(calculator.total([])).to eq(0)
  end

  it "takes a percent off an amount" do
    expect(calculator.discount(400, 25)).to eq(300)
  end

  it "refuses a percent out of range" do
    expect { calculator.discount(400, 120) }.to raise_error(ArgumentError)
  end
end
