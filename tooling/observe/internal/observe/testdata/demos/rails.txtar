-- base/app/services/order_summary.rb --
class OrderSummary
  def initialize(cart)
    @cart = cart
  end

  def to_s
    "#{@cart.lines.size} lines, #{Money.new(@cart.total, "USD").format}"
  end
end
-- base/config/application.rb --
require_relative "boot"

require "rails"
require "active_model/railtie"
require "action_controller/railtie"

Bundler.require(*Rails.groups)

module Demo
  class Application < Rails::Application
    config.load_defaults 7.2
    config.eager_load = false
    config.logger = Logger.new(nil)
    # Each pack's app/ directories are autoloaded, as packs-rails does.
    Dir[root.join("packs/*/app/*")].each { |dir| config.autoload_paths << dir }
  end
end
-- base/config/boot.rb --
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

require "bundler/setup"
-- base/config/environment.rb --
require_relative "application"

Rails.application.initialize!
-- base/config/initializers/money.rb --
Money.locale_backend = :currency
Money.rounding_mode = BigDecimal::ROUND_HALF_UP
-- base/engines/admin/admin.gemspec --
Gem::Specification.new do |spec|
  spec.name        = "admin"
  spec.version     = "0.1.0"
  spec.summary     = "The back office of the demo application."
  spec.authors     = ["Putnami"]
  spec.files       = Dir["lib/**/*"]
  spec.required_ruby_version = ">= 3.2"

  spec.add_dependency "rails", ">= 7.2"
end
-- base/engines/admin/lib/admin.rb --
require "admin/engine"
require "admin/report"

module Admin
end
-- base/engines/admin/lib/admin/engine.rb --
module Admin
  class Engine < ::Rails::Engine
    isolate_namespace Admin
  end
end
-- base/engines/admin/lib/admin/report.rb --
module Admin
  class Report
    def initialize(totals)
      @totals = totals
    end

    def revenue
      @totals.sum
    end
  end
end
-- base/engines/admin/spec/admin/report_spec.rb --
RSpec.describe Admin::Report do
  it "sums the revenue" do
    expect(described_class.new([400, 250]).revenue).to eq(650)
  end
end
-- base/package.yml --
enforce_dependencies: true
enforce_privacy: false
-- base/packs/checkout/app/models/checkout/cart.rb --
module Checkout
  class Cart
    attr_reader :lines

    def initialize
      @lines = []
    end

    def add(unit, quantity)
      @lines << [unit, quantity]
      self
    end

    def total
      Pricing::Calculator.new.total(@lines)
    end
  end
end
-- base/packs/checkout/package.yml --
enforce_dependencies: true
enforce_privacy: true
dependencies:
  - packs/pricing
-- base/packs/checkout/spec/models/checkout/cart_spec.rb --
RSpec.describe Checkout::Cart do
  it "totals its lines" do
    expect(described_class.new.add(100, 3).add(50, 2).total).to eq(400)
  end

  it "starts empty" do
    expect(described_class.new.lines).to be_empty
  end
end
-- base/packs/pricing/app/models/pricing/calculator.rb --
module Pricing
  class Calculator
    def total(lines)
      lines.sum { |unit, quantity| unit * quantity }
    end
  end
end
-- base/packs/pricing/package.yml --
enforce_dependencies: true
enforce_privacy: true
-- base/packs/pricing/spec/models/pricing/calculator_spec.rb --
RSpec.describe Pricing::Calculator do
  subject(:calculator) { described_class.new }

  it "sums the lines" do
    expect(calculator.total([[100, 3], [50, 2]])).to eq(400)
  end

  it "totals no line as zero" do
    expect(calculator.total([])).to eq(0)
  end
end
-- base/packwerk.yml --
include:
  - "{app,packs/*/app}/**/*.rb"
package_paths:
  - "."
  - "packs/*"
-- base/spec/services/order_summary_spec.rb --
RSpec.describe OrderSummary do
  it "states the lines and the total" do
    cart = Checkout::Cart.new
    cart.add(250, 2)
    expect(described_class.new(cart).to_s).to eq("1 lines, $5.00")
  end
end
