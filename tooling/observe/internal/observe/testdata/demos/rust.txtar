-- base/Cargo.toml --
[workspace]
resolver = "2"
members = ["crates/*"]

[workspace.package]
version = "0.1.0"
edition = "2021"

[workspace.dependencies]
pricing = { path = "crates/pricing" }
itoa = "1"
-- base/crates/api/Cargo.toml --
[package]
name = "api"
version.workspace = true
edition.workspace = true

[dependencies]
pricing = { workspace = true }
-- base/crates/api/src/lib.rs --
use pricing::{format, total};

/// Quotes the lines of an order.
pub fn quote(lines: &[(u64, u64)]) -> String {
    format(total(lines))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn quote_lines() {
        assert_eq!(quote(&[(3, 100)]), "3.00 EUR");
    }

    #[test]
    fn empty_quote() {
        assert_eq!(quote(&[]), "0.00 EUR");
    }
}
-- base/crates/pricing/Cargo.toml --
[package]
name = "pricing"
version.workspace = true
edition.workspace = true

[dependencies]
itoa.workspace = true
-- base/crates/pricing/src/lib.rs --
//! Amounts in cents.

/// Sums quantity times unit price, in cents.
pub fn total(lines: &[(u64, u64)]) -> u64 {
    lines.iter().map(|(quantity, price)| quantity * price).sum()
}

/// Formats an amount in cents as euros.
pub fn format(cents: u64) -> String {
    let mut buffer = itoa::Buffer::new();
    let euros = buffer.format(cents / 100).to_owned();
    format!("{euros}.{:02} EUR", cents % 100)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn empty() {
        assert_eq!(total(&[]), 0);
    }

    #[test]
    fn lines() {
        assert_eq!(total(&[(2, 150), (1, 99)]), 399);
    }
}
-- base/crates/pricing/tests/format.rs --
use pricing::format;

#[test]
fn formats_euros() {
    assert_eq!(format(399), "3.99 EUR");
}
-- base/crates/worker/Cargo.toml --
[package]
name = "worker"
version.workspace = true
edition.workspace = true

[dependencies]
pricing = { path = "../pricing" }
-- base/crates/worker/src/lib.rs --
use pricing::total;

/// Totals a batch of orders.
pub fn batch_total(orders: &[Vec<(u64, u64)>]) -> u64 {
    orders.iter().map(|lines| total(lines)).sum()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn batch() {
        assert_eq!(batch_total(&[vec![(1, 100)], vec![(2, 50)]]), 200);
    }
}
