-- head/crates/pricing/src/lib.rs --
//! Amounts in cents.

/// Sums quantity times unit price, in cents.
pub fn total(lines: &[(u64, u64)]) -> u64 {
    lines.iter().map(|(quantity, price)| quantity * price).sum()
}

/// Takes a discount in percent off an amount in cents, rounding down.
pub fn discount(cents: u64, percent: u64) -> u64 {
    cents - cents * percent.min(100) / 100
}

/// Formats an amount in cents as euros.
pub fn format(cents: u64) -> String {
    let mut buffer = itoa::Buffer::new();
    let euros = buffer.format(cents / 100).to_owned();
    format!("{euros}.{:02} EUR", cents % 100)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn empty() {
        assert_eq!(total(&[]), 0);
    }

    #[test]
    fn lines() {
        assert_eq!(total(&[(2, 150), (1, 99)]), 399);
    }

    #[test]
    fn discounts() {
        assert_eq!(discount(399, 10), 360);
        assert_eq!(discount(399, 150), 0);
    }
}
