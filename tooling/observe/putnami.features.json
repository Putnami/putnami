{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "tooling",
  "features": [
    {
      "id": "tooling/observe",
      "type": "feature",
      "name": "Observe a change in a repository that keeps its own CI",
      "outcome": "A CI job in a repository without a Putnami workspace runs putnami observe after its own build and tests, and learns which CI and repository it runs in, which commit the change is measured against even on a shallow clone, which files changed, and which test and coverage reports it can read, without changing its pipeline and without failing on a missing report, and can keep it as a change evidence document",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "runs-without-a-workspace",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-manifest-declares-a-workspace-optional-command",
              "observe-runs-in-a-repository-without-a-workspace"
            ]
          }
        },
        {
          "id": "ci-detection",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-github-actions-pull-request",
              "a-gitlab-merge-request",
              "a-generic-ci-takes-its-base-and-head-from-flags",
              "the-repository-key-is-the-numeric-project-id"
            ]
          }
        },
        {
          "id": "diff-base",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "an-explicit-base-wins",
              "a-shallow-clone-deepens-to-the-merge-base",
              "an-unresolved-base-is-a-diagnostic",
              "changed-files-are-measured-from-the-merge-base",
              "a-pull-request-merge-commit-is-measured-as-built"
            ]
          }
        },
        {
          "id": "report-discovery",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "reports-are-found-by-their-content",
              "explicit-report-paths-replace-discovery",
              "a-missing-or-malformed-report-is-a-diagnostic"
            ]
          }
        },
        {
          "id": "evidence-document",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-evidence-document-validates",
              "an-invalid-evidence-document-is-not-written"
            ]
          }
        },
        {
          "id": "caller-directory-writes",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "observe-writes-only-git-history-in-the-caller-directory"
            ]
          }
        }
      ]
    },
    {
      "id": "tooling/observe-composer",
      "type": "feature",
      "name": "Find the Composer components and areas of a Symfony application",
      "outcome": "putnami observe reads the composer.json manifests of a PHP repository without running Composer and knows its components, the edges its path repositories create, the src/ directories that are areas of a component, and the lockfile, test directories and PHPUnit report outputs each component carries, so each changed file maps to its component or area",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "components-from-manifests",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "one-component-per-composer-json",
              "the-answer-is-a-valid-probe-result"
            ]
          }
        },
        {
          "id": "path-repository-edges",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-required-path-repository-package-is-an-edge",
              "a-registry-package-is-not-an-edge"
            ]
          }
        },
        {
          "id": "areas",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "autoload-directories-are-areas",
              "the-symfony-demo-maps-each-changed-file"
            ]
          }
        },
        {
          "id": "analysis-inputs",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-lockfile-and-report-outputs-are-exposed",
              "a-malformed-manifest-is-a-diagnostic"
            ]
          }
        }
      ]
    },
    {
      "id": "tooling/observe-nx",
      "type": "feature",
      "name": "Read the projects and dependency graph of an Nx workspace",
      "outcome": "putnami observe learns the Nx projects of a repository, which directory each one owns, which projects each one depends on, where its tests write their reports and which lockfile pins its dependencies, from the graph export the CI wrote when there is one and from the Nx configuration otherwise, without running nx",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "graph-export",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-graph-export-gives-the-projects-and-their-edges",
              "a-malformed-graph-export-falls-back-to-the-configuration"
            ]
          }
        },
        {
          "id": "configuration",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "project-json-and-workspace-package-json-are-projects",
              "edges-come-from-implicit-dependencies-and-package-dependencies",
              "a-repository-without-nx-has-no-nx-project"
            ]
          }
        },
        {
          "id": "change-inputs",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-project-names-its-test-outputs-and-its-lockfile"
            ]
          }
        },
        {
          "id": "probe-wire",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-answer-is-a-valid-probe-result",
              "the-nx-demo-maps-changed-files-with-and-without-a-graph-export"
            ]
          }
        }
      ]
    },
    {
      "id": "tooling/observe-analyses",
      "type": "feature",
      "name": "Explain what a change touches in a repository that keeps its own CI",
      "outcome": "putnami observe tells the CI log, and the evidence document, which components a change touched and which depend on them, the tests and coverage of each one, the coverage of the changed lines and the dependency versions the change moved, from the detectors, the git diff, the reports and the lockfiles, without running a build",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "components",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-detectors-combine-by-precedence",
              "changed-files-give-changed-and-dependent-components",
              "a-repository-without-detected-components-is-one-component"
            ]
          }
        },
        {
          "id": "tests-and-coverage",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-test-goes-to-the-component-of-its-file-else-of-its-report",
              "coverage-goes-to-the-component-of-each-file"
            ]
          }
        },
        {
          "id": "changed-line-coverage",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "changed-lines-are-measured-against-line-coverage"
            ]
          }
        },
        {
          "id": "dependency-changes",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "each-lockfile-format-gives-its-package-changes"
            ]
          }
        },
        {
          "id": "summary",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-summary-shows-the-analyses",
              "a-changed-component-names-the-changed-components-it-depends-on",
              "the-demo-evidence-documents-validate"
            ]
          }
        }
      ]
    },
    {
      "id": "tooling/observe-node-workspaces",
      "type": "feature",
      "name": "Detect the packages of a Node workspace",
      "outcome": "putnami observe names the packages of an npm, pnpm or yarn workspace, Turborepo and Lerna on those workspaces included, as components with the packages each one depends on, the lockfile whose diff is the dependency change, and where each package writes its test and coverage reports, from the repository's own files and without running a package manager",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "workspace-members",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "npm-and-yarn-workspaces-name-the-members",
              "a-pnpm-workspace-names-the-members",
              "a-negated-pattern-excludes-a-member",
              "a-repository-without-a-workspace-is-not-detected",
              "a-brace-pattern-names-each-alternative"
            ]
          }
        },
        {
          "id": "internal-edges",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "workspace-protocol-dependencies-are-edges",
              "a-satisfied-version-range-is-an-edge",
              "pnpm-links-a-range-only-when-configured"
            ]
          }
        },
        {
          "id": "probe-answer",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-answer-validates-on-the-probe-wire",
              "the-turborepo-demo-layout"
            ]
          }
        },
        {
          "id": "lockfile-and-reports",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-manager-and-the-lockfile-are-named",
              "standard-report-locations-are-named"
            ]
          }
        },
        {
          "id": "malformed-manifests",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-malformed-manifest-is-a-diagnostic",
              "a-bounded-walk-is-a-diagnostic"
            ]
          }
        }
      ]
    },
    {
      "id": "tooling/observe-go",
      "type": "feature",
      "name": "Find the Go modules of a repository that keeps its own CI",
      "outcome": "putnami observe, in a Go repository without a Putnami workspace, knows its modules from go.work and go.mod, which module owns each file, which modules depend on which, which module and file a Go test or coverage report names, and which dependency versions each module locks, without running go",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "go-modules-are-components",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "go-work-members-are-workspace-components",
              "a-go-mod-outside-go-work-is-a-manifest-component",
              "a-file-belongs-to-its-innermost-module",
              "an-unreadable-manifest-is-a-diagnostic"
            ]
          }
        },
        {
          "id": "go-module-edges",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-require-of-a-repository-module-is-an-edge",
              "a-local-replace-is-an-edge",
              "an-outside-module-is-no-edge"
            ]
          }
        },
        {
          "id": "go-report-paths",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "an-import-path-names-its-file-and-module"
            ]
          }
        },
        {
          "id": "go-locked-versions",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "go-mod-requires-are-the-locked-versions",
              "a-repository-module-is-not-a-locked-dependency"
            ]
          }
        },
        {
          "id": "go-probe-answer",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-detection-is-a-valid-probe-answer"
            ]
          }
        }
      ]
    },
    {
      "id": "tooling/observe-upload",
      "type": "feature",
      "name": "Hand the change evidence document to a reporter",
      "outcome": "A CI job adds --upload to putnami observe and its change evidence document reaches the reporter it selected, Putnami Cloud by default, and an upload that fails is a diagnostic that never fails the job",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "upload-hands-the-document-to-the-reporter",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "upload-runs-the-selected-reporter-with-the-document",
              "an-unset-selector-picks-putnami-cloud"
            ]
          }
        },
        {
          "id": "upload-fails-open",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-failed-upload-is-a-diagnostic"
            ]
          }
        }
      ]
    }
  ]
}
