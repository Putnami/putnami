{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "cli",
  "features": [
    {
      "id": "cli/workspace-model",
      "type": "feature",
      "name": "CLI workspace model",
      "outcome": "Every consumer of the CLI's workspace model sees one deterministic answer for what a target expression selects, what depends on what, and what a change reaches — from a pure library the engine cannot reach back into",
      "owner": "tooling",
      "target": "coded",
      "requirements": [
        {
          "id": "target-expression-grammar",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "exact-ids-and-paths-resolve",
              "wildcards-resolve",
              "aliases-and-groups-resolve",
              "unions-preserve-order-and-dedupe",
              "subtraction-removes-its-operand",
              "an-unknown-target-is-an-error"
            ]
          }
        },
        {
          "id": "selection-filters",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "name-and-tag-filters-compose",
              "explicit-excludes-always-apply",
              "direct-targets-and-includes-override-default-excludes"
            ]
          }
        },
        {
          "id": "dependency-graph",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "transitive-closures-are-deterministic",
              "a-declared-cycle-is-reported",
              "a-cycle-among-delegated-projects-loads"
            ]
          }
        },
        {
          "id": "change-impact",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "owners-resolve-by-project-and-asset-paths",
              "nearest-project-owns-a-nested-path",
              "impact-includes-the-transitive-dependent-closure",
              "implicit-scope-edges-order-without-propagating-impact",
              "a-scope-config-selects-every-project-that-inherits-it",
              "extension-consumers-run-the-changed-extension-tasks",
              "an-extension-reaches-only-the-consumers-it-may-plan-in",
              "a-change-selects-only-the-tasks-that-read-it",
              "workspace-input-patterns-widen-to-every-project"
            ]
          }
        },
        {
          "id": "a-verdict-policy-selects-only-the-tasks-that-name-it",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-verdict-policy-alone-selects-no-project",
              "a-task-that-names-a-verdict-policy-is-selected",
              "a-verdict-policy-is-no-changed-file-of-its-project"
            ]
          }
        },
        {
          "id": "canonical-identity",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "ids-derive-from-workspace-relative-paths",
              "grouped-paths-resolve-to-logical-ids",
              "legacy-names-resolve-as-a-fallback"
            ]
          }
        },
        {
          "id": "model-purity",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-module-requires-only-protocol-modules",
              "no-source-imports-the-cli"
            ]
          }
        },
        {
          "id": "import-visibility",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "an-edge-carries-the-manifest-family-it-came-from",
              "an-import-inside-one-scope-is-allowed",
              "a-cross-scope-import-of-a-scope-private-project-is-reported",
              "a-project-nested-in-the-project-it-imports-crosses-no-boundary",
              "a-public-project-a-generated-client-and-a-contract-edge-are-allowed"
            ]
          }
        },
        {
          "id": "a-dependent-takes-only-the-step-references-it-may-run",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "an-edge-carries-into-each-dependent-what-it-may-run",
              "a-dependent-that-may-run-nothing-reached-is-not-selected"
            ]
          }
        },
        {
          "id": "a-checking-task-moves-no-extension-runtime",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-file-only-checking-tasks-read-selects-no-consumer"
            ]
          }
        }
      ]
    },
    {
      "id": "cli/job-model",
      "type": "feature",
      "name": "CLI job model",
      "outcome": "Every consumer of the CLI's job model sees one deterministic answer for what traits, side effects, kind and verification outputs a job has, from a pure library the engine cannot reach back into",
      "owner": "tooling",
      "target": "coded",
      "requirements": [
        {
          "id": "extension-verb-vocabulary",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "two-vocabularies-declaring-one-verb-warn"
            ]
          }
        },
        {
          "id": "vocabulary-default-traits",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "traits-alone-give-a-job-its-side-effects"
            ]
          }
        },
        {
          "id": "command-kinds-and-traits",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-job-without-declared-traits-takes-its-verbs-kind-and-workload",
              "declared-traits-replace-the-verbs-kind-wholesale"
            ]
          }
        },
        {
          "id": "declared-verification-producers",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-producer-is-a-declaring-task-of-a-command-of-its-kind"
            ]
          }
        }
      ]
    }
  ]
}
