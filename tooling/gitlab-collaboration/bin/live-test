#!/usr/bin/env bash
# Runs the GitLab collaboration provider's contract scenarios against a real
# GitLab project, with the credential GITLAB_TOKEN or glab provides.
#
# The project must be a disposable test project whose description carries
# putnami-collaboration-live-test: the run opens, edits and closes issues
# there, and deletes the issues it opened when it ends, or closes them when
# the account may not delete issues. It also creates branches one commit
# ahead of the default branch, opens and reviews merge requests from them,
# and closes those merge requests and deletes the branches when it ends. The
# test refuses any project without that marker.
set -euo pipefail

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  printf '%s\n' "usage: live-test <project path> [host]" \
    "Runs TestLiveGitLab against the named disposable project (description carries putnami-collaboration-live-test); host defaults to gitlab.com." >&2
  [ "$#" -eq 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; } && exit 0
  exit 2
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cli=putnami
if [ -x "$root/putnamiw" ]; then
  cli="$root/putnamiw"
fi
cd "$root"
PUTNAMI_GITLAB_COLLAB_LIVE_PROJECT="$1" PUTNAMI_GITLAB_COLLAB_LIVE_HOST="${2:-}" exec "$cli" test --projects @putnami/gitlab-collaboration \
  --no-cache --count 1 --run '^TestLiveGitLab$' --no-enforce-coverage --test-verbose
