{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/cli",
  "tags": [
    "go"
  ],
  "extensions": [
    "/go/extension",
    "/tooling/sdd-extension"
  ],
  "publish": [
    "archives"
  ],
  "tasks": {
    "test~test": {
      "timeoutMs": 1200000
    },
    "test~test-race": {
      "timeoutMs": 1200000
    }
  },
  "options": {
    "lint": {
      "fix": false
    },
    "test": {
      "coverage-threshold": 80,
      "filePatterns": [
        "doc/**",
        "scripts/**",
        "../../**/putnami.json",
        "../*/putnami.json",
        "../../decisions.json",
        "../../**/decisions.json",
        "../../typescript/samples/recipes.json",
        "../../go/samples/recipes.json",
        "../../python/samples/recipes.json",
        "../../.agents/constraints.md",
        "../../putnami.support.json",
        "../../putnami.workspace.json",
        "../../putnami.lock.json",
        "../../putnami.ci.json",
        "../../putnamiw",
        "../../protocols/ci/fixtures/change-plan/**",
        "../../protocols/ci/fixtures/impact-plan/**",
        "../../go/framework/config/*.go",
        "../../**/putnami.extension.json",
        "../local-collaboration/**",
        "../../typescript/extension/cmd/**",
        "../../typescript/extension/internal/**",
        "../../typescript/extension/go.mod",
        "../../typescript/extension/go.sum",
        "../../go/extension/cmd/**",
        "../../go/extension/internal/**",
        "../../go/extension/go.mod",
        "../../go/extension/go.sum",
        "../../.agents/skills/**",
        "../../.claude/skills/**",
        "../../.claude/agents/**",
        "../../.codex/agents/**",
        "../contributor/putnami.json",
        "../contributor/putnami.extension.json",
        "../contributor/bin/**",
        "../contributor/cmd/**",
        "../contributor/internal/**",
        "../contributor/go.mod",
        "../contributor/go.sum",
        "../contributor/src/**",
        "../dev/cmd/**",
        "../dev/internal/**",
        "../dev/go.mod",
        "../dev/go.sum",
        "../../monorepo/pants/**",
        "../../monorepo/bazel/**",
        "../../monorepo/nx/**",
        "../../monorepo/moon/**",
        "../stacks/**",
        "../evidence-readers/**",
        "../observe/go.mod",
        "../observe/go.sum",
        "../observe/detect/**",
        "../observe/internal/toml/**",
        "../observe/internal/observe/testdata/demos/pants.txtar",
        "../observe/internal/observe/testdata/demos/bazel.txtar",
        "../observe/internal/observe/testdata/demos/nx.txtar",
        "../observe/internal/observe/testdata/demos/moon.txtar",
        "../../protocols/evidence/**",
        "../../protocols/codehost/**",
        "git:../../**/client.putnami.json",
        "git:../../**/schema/openapi.json",
        "command-surface.json"
      ]
    },
    "package": {
      "archives": true
    },
    "publish": {
      "archives": true,
      "binary-name": "putnami"
    },
    "@putnami/go": {
      "entrypoint": "./cmd/putnami",
      "install": ".putnami/bin/putnami-go-dev",
      "version-var": "go.putnami.dev/tooling/cli/internal/cli.Version"
    },
    "@putnami/go:validate": {
      "command-surface": "command-surface.json"
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
