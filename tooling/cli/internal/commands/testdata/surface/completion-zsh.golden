#compdef putnami
# zsh completion for putnami
#
# Install:
#   oh-my-zsh:  putnami completion zsh > ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/completions/_putnami
#   manual:     putnami completion zsh > ~/.zfunc/_putnami
#               echo 'fpath=(~/.zfunc $fpath)' >> ~/.zshrc
#
# Then restart your shell: exec zsh

_putnami_subcommands_for() {
    reply=()
    case "$1" in
        'cache')
            reply=(
                'clean'
                'gc'
                'verify'
            )
            ;;
        'cli')
            reply=(
                'list'
                'use'
            )
            ;;
        'completion')
            reply=(
                'bash'
                'fish'
                'zsh'
            )
            ;;
        'config')
            reply=(
                'set'
                'show'
            )
            ;;
        'context')
            reply=(
                'generate'
                'map'
                'pack'
            )
            ;;
        'deps')
            reply=(
                'add'
                'install'
                'prune'
                'remove'
                'rm'
            )
            ;;
        'extensions')
            reply=(
                'install'
                'list'
                'prepare'
                'remove'
                'update'
                'validate'
            )
            ;;
        'migrate')
            reply=(
                'vnext'
            )
            ;;
        'projects')
            reply=(
                'create'
                'deps'
                'describe'
                'list'
                'owner'
                'sync'
                'tag'
                'why'
            )
            ;;
        'scopes')
            reply=(
                'list'
            )
            ;;
        'sessions')
            reply=(
                'export'
                'inspect'
                'list'
                'replay'
                'summary'
            )
            ;;
        'telemetry')
            reply=(
                'off'
                'on'
                'show'
                'status'
            )
            ;;
        'templates')
            reply=(
                'install'
                'list'
                'package'
                'remove'
                'test'
                'update'
                'validate'
            )
            ;;
        'tree')
            reply=(
                'fingerprint'
            )
            ;;
        'workspace')
            reply=(
                'describe'
                'init'
            )
            ;;
    esac
}

_putnami_path_known() {
    case "$1" in
        'cache') return 0 ;;
        'cache clean') return 0 ;;
        'cache gc') return 0 ;;
        'cache verify') return 0 ;;
        'cli') return 0 ;;
        'cli list') return 0 ;;
        'cli use') return 0 ;;
        'completion') return 0 ;;
        'completion bash') return 0 ;;
        'completion fish') return 0 ;;
        'completion zsh') return 0 ;;
        'config') return 0 ;;
        'config set') return 0 ;;
        'config show') return 0 ;;
        'context') return 0 ;;
        'context generate') return 0 ;;
        'context map') return 0 ;;
        'context pack') return 0 ;;
        'deps') return 0 ;;
        'deps add') return 0 ;;
        'deps install') return 0 ;;
        'deps prune') return 0 ;;
        'deps remove') return 0 ;;
        'deps rm') return 0 ;;
        'doctor') return 0 ;;
        'extensions') return 0 ;;
        'extensions install') return 0 ;;
        'extensions list') return 0 ;;
        'extensions prepare') return 0 ;;
        'extensions remove') return 0 ;;
        'extensions update') return 0 ;;
        'extensions validate') return 0 ;;
        'help') return 0 ;;
        'impact-plan') return 0 ;;
        'init') return 0 ;;
        'install') return 0 ;;
        'migrate') return 0 ;;
        'migrate vnext') return 0 ;;
        'pin') return 0 ;;
        'projects') return 0 ;;
        'projects create') return 0 ;;
        'projects deps') return 0 ;;
        'projects describe') return 0 ;;
        'projects list') return 0 ;;
        'projects owner') return 0 ;;
        'projects sync') return 0 ;;
        'projects tag') return 0 ;;
        'projects why') return 0 ;;
        'report') return 0 ;;
        'scopes') return 0 ;;
        'scopes list') return 0 ;;
        'sessions') return 0 ;;
        'sessions export') return 0 ;;
        'sessions inspect') return 0 ;;
        'sessions list') return 0 ;;
        'sessions replay') return 0 ;;
        'sessions summary') return 0 ;;
        'telemetry') return 0 ;;
        'telemetry off') return 0 ;;
        'telemetry on') return 0 ;;
        'telemetry show') return 0 ;;
        'telemetry status') return 0 ;;
        'templates') return 0 ;;
        'templates install') return 0 ;;
        'templates list') return 0 ;;
        'templates package') return 0 ;;
        'templates remove') return 0 ;;
        'templates test') return 0 ;;
        'templates update') return 0 ;;
        'templates validate') return 0 ;;
        'tree') return 0 ;;
        'tree fingerprint') return 0 ;;
        'upgrade') return 0 ;;
        'workspace') return 0 ;;
        'workspace describe') return 0 ;;
        'workspace init') return 0 ;;
        *) return 1 ;;
    esac
}

_putnami_core_root() {
    case "$1" in
        'cache') return 0 ;;
        'cli') return 0 ;;
        'completion') return 0 ;;
        'config') return 0 ;;
        'context') return 0 ;;
        'deps') return 0 ;;
        'doctor') return 0 ;;
        'extensions') return 0 ;;
        'help') return 0 ;;
        'impact-plan') return 0 ;;
        'init') return 0 ;;
        'install') return 0 ;;
        'migrate') return 0 ;;
        'pin') return 0 ;;
        'projects') return 0 ;;
        'report') return 0 ;;
        'scopes') return 0 ;;
        'sessions') return 0 ;;
        'telemetry') return 0 ;;
        'templates') return 0 ;;
        'tree') return 0 ;;
        'upgrade') return 0 ;;
        'workspace') return 0 ;;
        *) return 1 ;;
    esac
}

# help and its aliases read the command they describe from their next words.
_putnami_is_help() {
    case "$1" in
        'help') return 0 ;;
        *) return 1 ;;
    esac
}

_putnami_takes_project() {
    case "$1" in
        *) return 1 ;;
    esac
}

_putnami_flags_for() {
    reply=()
    case "$1" in
        'cache verify')
            reply=(
                '--continue-on-error[Don'\''t abort a verified run on the first failure]'
                '--cpu-policy[CPU ceiling policy: critical-path | measured]:policy:(critical-path measured)'
                '--exclude[Leave these projects out of the verified runs]:names:'
                '--impacted-strict[Fail when the --impacted baseline can'\''t be resolved]'
                '--profile[Deployment profile the verified runs use: dev | test | production]:profile:(dev production test)'
                '--retry[Retry transient failures in the verified runs]:n:'
                '--trace-profile[Write the trace events of the last verified run (Chrome trace format)]:path:'
            )
            ;;
        'cli list')
            reply=(
                '--global[List binaries in ~/.putnami/bin instead of the workspace (alias: -g)]'
            )
            ;;
        'cli use')
            reply=(
                '--global[Switch the binary in ~/.putnami/bin instead of the workspace (alias: -g)]'
            )
            ;;
        'context generate')
            reply=(
                '--force[Rewrite a guidance block that was edited or written by an older release]'
            )
            ;;
        'context pack')
            reply=(
                '--project[Project ID, path, or name; default is every workspace project]:selector:'
            )
            ;;
        'deps add')
            reply=(
                '--dry-run[Print the planned edit and change nothing]'
            )
            ;;
        'deps prune')
            reply=(
                '--dry-run[List the edges to remove and change nothing]'
            )
            ;;
        'deps remove')
            reply=(
                '--dry-run[Print the planned edit and change nothing]'
            )
            ;;
        'deps rm')
            reply=(
                '--dry-run[Print the planned edit and change nothing]'
            )
            ;;
        'doctor')
            reply=(
                '--machine[Report the one-minute load per logical CPU, or unknown, instead of the readiness preflight; takes neither --profile nor --project]'
                '--profile[Deployment profile to evaluate under (dev|test|production); production is strictest]:profile:'
                '--project[Project ID, path, or name (comma-separated); default is every workspace project]:selector:'
            )
            ;;
        'extensions install')
            reply=(
                '--dest[Materialize into this artifact-store root instead of the machine-global one]:dir:'
                '--latest[Ignore the lock file and resolve the latest versions]'
                '--platform[Materialize artifacts for another platform (skips install hooks and the lock write)]:os/arch:'
                '--user[Pin one registry extension in the user scope (~/.putnami/user) so its commands run outside any workspace]'
            )
            ;;
        'extensions list')
            reply=(
                '--user[List the extensions pinned in the user scope (~/.putnami/user) instead of the workspace]'
            )
            ;;
        'extensions remove')
            reply=(
                '--user[Remove the extension from the user scope (~/.putnami/user) instead of the workspace]'
            )
            ;;
        'help')
            reply=(
                '--man[Render the full reference as a man page]'
                '--markdown[Render the full reference as Markdown]'
            )
            ;;
        'impact-plan')
            reply=(
                '--base[Required base commit or ref; emitted as its full immutable commit SHA]:commit:'
                '--head[Optional head commit or ref; it must resolve to the checked-out HEAD]:commit:'
            )
            ;;
        'init')
            reply=(
                '--channel[Resolve the extensions, the template and the starter dependencies on one release channel (default: PUTNAMI_CHANNEL, then the channel the CLI was installed from, then latest)]:channel:'
                '--extension[Default extension to install]:ts|go|py:(go py ts)'
                '--force[Reinitialize an existing workspace]'
                '--project[Create an initial project]:name:'
                '--project-path[Workspace-relative path for the initial project]:path:'
                '--workspace[Workspace name override]:name:'
            )
            ;;
        'install')
            reply=(
                '--latest[Ignore the lock file and resolve the latest extension and template versions]'
            )
            ;;
        'migrate vnext')
            reply=(
                '--apply[Perform the migration, atomically and idempotently]'
                '--check[Report the pending migration without writing (default); exits non-zero when a migration is needed]'
            )
            ;;
        'pin')
            reply=(
                '--remove[Remove the CLI version pin]'
            )
            ;;
        'projects create')
            reply=(
                '--channel[Resolve the template, the project setup and the dependency install on one release channel (default: PUTNAMI_CHANNEL, then the channel the CLI was installed from, then latest)]:channel:'
                '--force[Overwrite an existing project directory]'
                '--path[Workspace-relative project path]:path:'
                '--template[Template to scaffold from]:template:'
            )
            ;;
        'projects deps')
            reply=(
                '--dependents[List the projects that depend on the project instead of the ones it depends on]'
                '--transitive[Follow the edges transitively instead of listing direct ones]'
            )
            ;;
        'projects sync')
            reply=(
                '--dry-run[Show the changes without applying them]'
                '--prune[Drop config entries whose project directory no longer exists]'
                '--skip-install[Do not run dependency installation after syncing]'
            )
            ;;
        'projects tag')
            reply=(
                '--remove[Remove the given tags from the project]'
                '--set[Replace the project'\''s tags with the given list]'
            )
            ;;
        'report')
            reply=(
                '--session[Report to read, by session ID (default: the newest CLI-driven run'\''s)]:id:'
            )
            ;;
        'sessions export')
            reply=(
                '--since[Keep only records whose recorded start time is at or after this RFC 3339 timestamp; a record with no readable start time is not emitted]:timestamp:'
            )
            ;;
        'sessions inspect')
            reply=(
                '--run[Inspect the session of a remote attempt by its attempt reference or submission key, resuming the attempt first when it was never imported]:ref:'
            )
            ;;
        'sessions list')
            reply=(
                '--revision[Keep only sessions whose recorded tree sat on this commit; a lowercase hex prefix of the commit id, never a ref name]:sha:'
            )
            ;;
        'sessions replay')
            reply=(
                '--session[Exact retained session id; latest is not accepted]:id:'
            )
            ;;
        'sessions summary')
            reply=(
                '--by-digest[Group the selected sessions'\'' task records by input digest: records per digest, and how many executed, reused or failed]'
                '--command[Keep only top-level sessions whose recorded command set is exactly this comma-separated list, in any order; a nested run never matches]:list:'
                '--since[Keep only records whose recorded start time is at or after this RFC 3339 timestamp; a record with no readable start time is not listed]:timestamp:'
            )
            ;;
        'templates install')
            reply=(
                '--latest[Ignore the lock file and resolve the latest versions]'
            )
            ;;
        'templates package')
            reply=(
                '--stable[Publish under a stable version instead of a prerelease]'
                '--version[Version to stamp on the produced archive]:version:'
            )
            ;;
        'templates test')
            reply=(
                '--channel[Install the template'\''s extension and create the project on one release channel (default: PUTNAMI_CHANNEL, then the channel the CLI was installed from, then latest)]:channel:'
                '--keep[Keep the rendered temporary workspace for inspection]'
                '--skip-build[Render the template without running build and test on it]'
            )
            ;;
        'upgrade')
            reply=(
                '--channel[Resolve a release channel (stable by default; canary for latest prerelease)]:channel:(canary stable)'
                '--cli[Only upgrade the CLI binary]'
                '--continue-on-error[Run the remaining upgrade phases after one fails]'
                '--deps[Only upgrade framework dependencies]'
                '--dry-run[Resolve and print the upgrade plan without modifying files]'
                '--extensions[Only upgrade extensions and templates]'
                '--from-source[Build the CLI from this workspace'\''s source and install it as the active binary, bypassing the download channel (self-host escape hatch; combine with --global to replace the global CLI)]'
                '--global[Upgrade the global CLI in ~/.putnami/bin instead of the workspace pin; inside a workspace the other phases still run, outside one only the CLI is upgraded (alias: -g)]'
                '--namespace[Release-set namespace that published the --release id; accepted only with --release]:namespace:'
                '--release[Use one immutable release-set snapshot for npm and Go dependencies (needs --namespace)]:rs_id:'
                '--version[Use an exact Putnami release version]:version:'
            )
            ;;
        'workspace init')
            reply=(
                '--channel[Resolve the extensions, the template and the starter dependencies on one release channel (default: PUTNAMI_CHANNEL, then the channel the CLI was installed from, then latest)]:channel:'
                '--extension[Default extension to install]:ts|go|py:(go py ts)'
                '--force[Reinitialize an existing workspace]'
                '--project[Create an initial project]:name:'
                '--project-path[Workspace-relative path for the initial project]:path:'
                '--workspace[Workspace name override]:name:'
            )
            ;;
    esac
}

# _putnami_global_flag_values sets reply to the values of the global flag $1
# and succeeds when $1 takes a value that is neither a project target nor a
# project name. A flag whose value is free sets no word, and neither does a
# job-only flag when $2 is 1, on a core command, which refuses it.
_putnami_global_flag_values() {
    reply=()
    case "$1" in
        '--tag') reply=(); return 0 ;;
        '--exclude-tag') reply=(); return 0 ;;
        '--baseline') reply=(); return 0 ;;
        '--credential-fd') reply=(); return 0 ;;
        '--output') reply=(text json jsonl cloud-logging); return 0 ;;
        *) return 1 ;;
    esac
}

_putnami() {
    local -a commands structured_commands global_flags job_global_flags projects project_basenames

    commands=(
    )

    structured_commands=(
        'cache:Manage cache'
        'cli:Installed CLI binaries'
        'completion:Generate shell completions (bash, zsh, fish)'
        'config:Manage configuration'
        'context:Manage AI context'
        'deps:Manage dependencies'
        'doctor:Preflight production readiness under a deployment profile'
        'extensions:Manage extensions'
        'help:Show help for a command'
        'impact-plan:Emit the impacted plan of a change for a command list'
        'init:Initialize a new workspace'
        'install:Install extensions and dependencies'
        'migrate:Migrate Putnami workspace files forward'
        'pin:Pin the CLI version this workspace uses'
        'projects:Manage projects'
        'report:Read back a run'\''s report'
        'scopes:List workspace scopes'
        'sessions:Inspect execution sessions'
        'telemetry:Manage anonymous telemetry'
        'templates:Manage templates'
        'tree:Identify the worktree the CLI runs in'
        'upgrade:Upgrade CLI, extensions, and dependencies'
        'workspace:Manage workspace'
    )

    global_flags=(
        '--verbose[Show job results and diagnostics]'
        '--debug[Stream all events in real-time]'
        '--help[Show help]'
        '--all[All projects]'
        '--impacted[Projects affected by git changes]'
        '--projects[Comma-separated project names]:list:'
        '--tag[Filter by tags]:tags:'
        '--exclude-tag[Exclude by tags]:tags:'
        '--baseline[Custom git baseline for --impacted; a job command with no target or --all implies --impacted]:branch:'
        '--credential-fd[Read the run credential from descriptor <n>; keeps it out of every environment and file; custody level 2]:n:'
        '--no-cache[Force re-execution (skip cache)]'
        '--output[Output format: text | json | jsonl | cloud-logging]:format:(text json jsonl cloud-logging)'
        '--json[Shorthand for --output=json]'
        '--quiet[Suppress non-error output]'
        '--color[Force color output]'
        '--no-color[Disable color output]'
        '--version[Show version]'
    )

    job_global_flags=(
    )

    _arguments -C \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe -t commands 'job commands' commands
            _describe -t structured 'structured commands' structured_commands
            ;;
        args)
            # zsh hands completion each word as the user typed it: (Q) removes
            # the quotes and backslashes, and expands nothing.
            local cur="${words[CURRENT]}"
            local prev="${(Q)words[CURRENT-1]}"
            local path="${(Q)words[1]}"
            # A flag goes after the command: the CLI refuses a command line
            # whose first word is a flag, so nothing completes after it.
            if [[ "${path}" == -* ]]; then
                return 1
            fi
            # help, or an alias of it, reads the command it describes from its
            # next two words, and the CLI refuses a flag before either of them:
            # the first word completes the command names, the second the
            # subcommands of the first, and nothing else, since help takes no
            # project target. Its flags and the value of a global flag other
            # than --projects and --exclude, such as --output, complete below.
            local on_core_root=0
            if _putnami_core_root "${path}"; then
                on_core_root=1
            fi
            if _putnami_is_help "${path}" && [[ "${cur}" != -* ]] && ! _putnami_global_flag_values "${prev}" "${on_core_root}"; then
                if (( CURRENT == 2 )); then
                    _describe -t commands 'job commands' commands
                    _describe -t structured 'structured commands' structured_commands
                    return
                fi
                if (( CURRENT == 3 )) && [[ "${words[2]}" != -* ]]; then
                    local -a described_subcmds
                    _putnami_subcommands_for "${words[2]}"
                    described_subcmds=("${reply[@]}")
                    _describe -t subcmds 'subcommand' described_subcmds
                    return
                fi
                return 1
            fi
            # A core command takes a job-only flag only as one of its own flags.
            if (( ! on_core_root )); then
                global_flags=("${global_flags[@]}" "${job_global_flags[@]}")
            fi
            local i=2
            while (( i < CURRENT )); do
                local word="${(Q)words[i]}"
                if [[ "${word}" == -* ]]; then
                    break
                fi
                local candidate="${path} ${word}"
                if _putnami_path_known "${candidate}"; then
                    path="${candidate}"
                    (( i++ ))
                else
                    break
                fi
            done

            local -a nested_subcmds
            _putnami_subcommands_for "${path}"
            nested_subcmds=("${reply[@]}")
            if (( ${#nested_subcmds} > 0 )) && [[ "${cur}" != -* ]] && (( i == CURRENT )); then
                _describe -t subcmds 'subcommand' nested_subcmds
                if _putnami_takes_project "${path}"; then
                    _describe -t project-ids 'project ID' project_ids
                fi
            else
                # The word after a flag of the command that takes a value is a
                # value slot: it offers the values of that flag, which may be none.
                local -a cmd_values
                local value_slot=0
                case "${path} ${prev}" in
                    'cache verify --cpu-policy')
                        cmd_values=(
                            'critical-path'
                            'measured'
                        )
                        value_slot=1
                        ;;
                    'cache verify --exclude')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'cache verify --profile')
                        cmd_values=(
                            'dev'
                            'production'
                            'test'
                        )
                        value_slot=1
                        ;;
                    'cache verify --retry')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'cache verify --trace-profile')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'context pack --project')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'doctor --profile')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'doctor --project')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'extensions install --dest')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'extensions install --platform')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'impact-plan --base')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'impact-plan --head')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'init --channel')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'init --extension')
                        cmd_values=(
                            'go'
                            'py'
                            'ts'
                        )
                        value_slot=1
                        ;;
                    'init --project')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'init --project-path')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'init --workspace')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'projects create --channel')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'projects create --path')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'projects create --template')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'report --session')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'sessions export --since')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'sessions inspect --run')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'sessions list --revision')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'sessions replay --session')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'sessions summary --command')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'sessions summary --since')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'templates package --version')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'templates test --channel')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'upgrade --channel')
                        cmd_values=(
                            'canary'
                            'stable'
                        )
                        value_slot=1
                        ;;
                    'upgrade --namespace')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'upgrade --release')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'upgrade --version')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'workspace init --channel')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'workspace init --extension')
                        cmd_values=(
                            'go'
                            'py'
                            'ts'
                        )
                        value_slot=1
                        ;;
                    'workspace init --project')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'workspace init --project-path')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                    'workspace init --workspace')
                        cmd_values=(
                        )
                        value_slot=1
                        ;;
                esac

                if (( value_slot )); then
                    if (( ${#cmd_values} > 0 )); then
                        _describe -t values 'value' cmd_values
                    fi
                elif [[ "${prev}" == "--projects" ]]; then
                        _describe -t project-ids 'project ID' project_ids
                        _describe -t project-names 'project name' projects
                        _describe -t project-names 'project name' project_basenames
                    elif _putnami_global_flag_values "${prev}" "${on_core_root}"; then
                        # The values the catalog lists for the flag, or none
                        # when they are free.
                        if (( ${#reply} > 0 )); then
                            compadd -- "${reply[@]}"
                        fi
                    elif [[ "${cur}" == -* ]]; then
                        local -a cmd_flags
                        _putnami_flags_for "${path}"
                        cmd_flags=("${reply[@]}")
                        _values 'flags' $cmd_flags $global_flags
                    else
                        _describe -t project-ids 'project ID' project_ids
                        _describe -t project-names 'project name' projects
                        _describe -t project-names 'project name' project_basenames
                        _values 'flags' $global_flags
                    fi
            fi
            ;;
    esac
}

_putnami "$@"
