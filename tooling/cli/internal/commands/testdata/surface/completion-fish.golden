complete -c putnami -n '__putnami_seen_path sessions export' -l 'since' -d 'Keep only records whose recorded start time is at or after this RFC 3339 timestamp; a record with no readable start time is not emitted' -r
complete -c putnami -n '__putnami_seen_path sessions inspect' -l 'run' -d 'Inspect the session of a remote attempt by its attempt reference or submission key, resuming the attempt first when it was never imported' -r
complete -c putnami -n '__putnami_seen_path sessions list' -l 'revision' -d 'Keep only sessions whose recorded tree sat on this commit; a lowercase hex prefix of the commit id, never a ref name' -r
complete -c putnami -n '__putnami_seen_path sessions replay' -l 'session' -d 'Exact retained session id; latest is not accepted' -r
complete -c putnami -n '__putnami_seen_path sessions summary' -l 'by-digest' -d 'Group the selected sessions\' task records by input digest: records per digest, and how many executed, reused or failed'
complete -c putnami -n '__putnami_seen_path sessions summary' -l 'command' -d 'Keep only top-level sessions whose recorded command set is exactly this comma-separated list, in any order; a nested run never matches' -r
complete -c putnami -n '__putnami_seen_path sessions summary' -l 'since' -d 'Keep only records whose recorded start time is at or after this RFC 3339 timestamp; a record with no readable start time is not listed' -r
