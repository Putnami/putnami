complete -c putnami -n '__putnami_seen_path upgrade' -l 'version' -d 'Use an exact Putnami release version' -r
complete -c putnami -n '__putnami_seen_path version get' -l 'scope' -d 'Report only this version line, by its scope path' -r
complete -c putnami -n '__putnami_seen_path version list' -l 'global' -d 'List binaries in ~/.putnami/bin instead of the workspace (alias: -g)'
complete -c putnami -n '__putnami_seen_path version tag' -l 'dry-run' -d 'Print the proposed tag and changelog without writing anything'
complete -c putnami -n '__putnami_seen_path version tag' -l 'push' -d 'Push the release commit and the tag to origin'
complete -c putnami -n '__putnami_seen_path version tag' -l 'scope' -d 'The version line to release, by its scope path (required when the workspace declares several)' -r
complete -c putnami -n '__putnami_seen_path version tag' -l 'yes' -d 'Skip the confirmation and create the release commit and tag'
complete -c putnami -n '__putnami_seen_path version use' -l 'global' -d 'Switch the binary in ~/.putnami/bin instead of the workspace (alias: -g)'
complete -c putnami -n '__putnami_seen_path workspace init' -l 'channel' -d 'Resolve the extensions, the template and the starter dependencies on one release channel (default: PUTNAMI_CHANNEL, then the channel the CLI was installed from, then latest)' -r
complete -c putnami -n '__putnami_seen_path workspace init' -l 'extension' -d 'Default extension to install' -a 'go py ts' -r
complete -c putnami -n '__putnami_seen_path workspace init' -l 'force' -d 'Reinitialize an existing workspace'
complete -c putnami -n '__putnami_seen_path workspace init' -l 'project' -d 'Create an initial project' -r
complete -c putnami -n '__putnami_seen_path workspace init' -l 'project-path' -d 'Workspace-relative path for the initial project' -r
complete -c putnami -n '__putnami_seen_path workspace init' -l 'workspace' -d 'Workspace name override' -r

# Output format values
complete -c putnami -n '__fish_seen_subcommand_from --output' -a 'text json jsonl cloud-logging'
