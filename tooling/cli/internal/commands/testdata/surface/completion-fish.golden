complete -c putnami -n '__putnami_seen_path upgrade' -l 'continue-on-error' -d 'Run the remaining upgrade phases after one fails'
complete -c putnami -n '__putnami_seen_path upgrade' -l 'deps' -d 'Only upgrade framework dependencies'
complete -c putnami -n '__putnami_seen_path upgrade' -l 'dry-run' -d 'Resolve and print the upgrade plan without modifying files'
complete -c putnami -n '__putnami_seen_path upgrade' -l 'extensions' -d 'Only upgrade extensions and templates'
complete -c putnami -n '__putnami_seen_path upgrade' -l 'from-source' -d 'Build the CLI from this workspace\'s source and install it as the active binary, bypassing the download channel (self-host escape hatch; combine with --global to replace the global CLI)'
complete -c putnami -n '__putnami_seen_path upgrade' -l 'global' -d 'Upgrade the global CLI in ~/.putnami/bin instead of the workspace pin; inside a workspace the other phases still run, outside one only the CLI is upgraded (alias: -g)'
complete -c putnami -n '__putnami_seen_path upgrade' -l 'namespace' -d 'Release-set namespace that published the --release id; accepted only with --release' -r
complete -c putnami -n '__putnami_seen_path upgrade' -l 'release' -d 'Use one immutable release-set snapshot for npm and Go dependencies (needs --namespace)' -r
complete -c putnami -n '__putnami_seen_path upgrade' -l 'version' -d 'Use an exact Putnami release version' -r
