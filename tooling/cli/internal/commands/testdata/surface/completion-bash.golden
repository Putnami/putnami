# bash completion for putnami
# Install: putnami completion bash > /etc/bash_completion.d/putnami
#      or: putnami completion bash >> ~/.bashrc

# _putnami_subcommands_for and _putnami_flags_for set the array _putnami_words,
# which _putnami_completions declares local.
_putnami_subcommands_for() {
    _putnami_words=()
    case "$1" in
        'cache') _putnami_words=(clean gc verify) ;;
        'cli') _putnami_words=(list use) ;;
        'completion') _putnami_words=(bash fish zsh) ;;
        'config') _putnami_words=(set show) ;;
        'context') _putnami_words=(generate map pack) ;;
        'deps') _putnami_words=(add install prune remove rm) ;;
        'extensions') _putnami_words=(install list prepare remove update validate) ;;
        'mcp') _putnami_words=(install) ;;
        'migrate') _putnami_words=(vnext) ;;
        'projects') _putnami_words=(create describe list sync tag) ;;
        'scopes') _putnami_words=(list) ;;
        'sessions') _putnami_words=(export inspect list replay summary) ;;
        'telemetry') _putnami_words=(off on show status) ;;
        'templates') _putnami_words=(install list package remove test update validate) ;;
        'tree') _putnami_words=(fingerprint) ;;
        'workspace') _putnami_words=(describe init) ;;
    esac
}

_putnami_path_known() {
    case "$1" in
        'cache') return 0 ;;
        'cache clean') return 0 ;;
        'cache gc') return 0 ;;
        'cache verify') return 0 ;;
        'cli') return 0 ;;
        'cli list') return 0 ;;
        'cli use') return 0 ;;
        'completion') return 0 ;;
        'completion bash') return 0 ;;
        'completion fish') return 0 ;;
        'completion zsh') return 0 ;;
        'config') return 0 ;;
        'config set') return 0 ;;
        'config show') return 0 ;;
        'context') return 0 ;;
        'context generate') return 0 ;;
        'context map') return 0 ;;
        'context pack') return 0 ;;
        'deps') return 0 ;;
        'deps add') return 0 ;;
        'deps install') return 0 ;;
        'deps prune') return 0 ;;
        'deps remove') return 0 ;;
        'deps rm') return 0 ;;
        'doctor') return 0 ;;
        'extensions') return 0 ;;
        'extensions install') return 0 ;;
        'extensions list') return 0 ;;
        'extensions prepare') return 0 ;;
        'extensions remove') return 0 ;;
        'extensions update') return 0 ;;
        'extensions validate') return 0 ;;
        'help') return 0 ;;
        'impact-plan') return 0 ;;
        'init') return 0 ;;
        'install') return 0 ;;
        'mcp') return 0 ;;
        'mcp install') return 0 ;;
        'migrate') return 0 ;;
        'migrate vnext') return 0 ;;
        'pin') return 0 ;;
        'projects') return 0 ;;
        'projects create') return 0 ;;
        'projects describe') return 0 ;;
        'projects list') return 0 ;;
        'projects sync') return 0 ;;
        'projects tag') return 0 ;;
        'report') return 0 ;;
        'scopes') return 0 ;;
        'scopes list') return 0 ;;
        'sessions') return 0 ;;
        'sessions export') return 0 ;;
        'sessions inspect') return 0 ;;
        'sessions list') return 0 ;;
        'sessions replay') return 0 ;;
        'sessions summary') return 0 ;;
        'telemetry') return 0 ;;
        'telemetry off') return 0 ;;
        'telemetry on') return 0 ;;
        'telemetry show') return 0 ;;
        'telemetry status') return 0 ;;
        'templates') return 0 ;;
        'templates install') return 0 ;;
        'templates list') return 0 ;;
        'templates package') return 0 ;;
        'templates remove') return 0 ;;
        'templates test') return 0 ;;
        'templates update') return 0 ;;
        'templates validate') return 0 ;;
        'tree') return 0 ;;
        'tree fingerprint') return 0 ;;
        'upgrade') return 0 ;;
        'workspace') return 0 ;;
        'workspace describe') return 0 ;;
        'workspace init') return 0 ;;
        *) return 1 ;;
    esac
}

_putnami_takes_project() {
    case "$1" in
        *) return 1 ;;
    esac
}

_putnami_core_root() {
    case "$1" in
        'cache') return 0 ;;
        'cli') return 0 ;;
        'completion') return 0 ;;
        'config') return 0 ;;
        'context') return 0 ;;
        'deps') return 0 ;;
        'doctor') return 0 ;;
        'extensions') return 0 ;;
        'help') return 0 ;;
        'impact-plan') return 0 ;;
        'init') return 0 ;;
        'install') return 0 ;;
        'mcp') return 0 ;;
        'migrate') return 0 ;;
        'pin') return 0 ;;
        'projects') return 0 ;;
        'report') return 0 ;;
        'scopes') return 0 ;;
        'sessions') return 0 ;;
        'telemetry') return 0 ;;
        'templates') return 0 ;;
        'tree') return 0 ;;
        'upgrade') return 0 ;;
        'workspace') return 0 ;;
        *) return 1 ;;
    esac
}

_putnami_flags_for() {
    _putnami_words=()
    case "$1" in
        'cache verify') _putnami_words=(--continue-on-error --cpu-policy --exclude --impacted-strict --profile --retry --trace-profile) ;;
        'cli list') _putnami_words=(--global) ;;
        'cli use') _putnami_words=(--global) ;;
        'context generate') _putnami_words=(--force) ;;
        'context pack') _putnami_words=(--project) ;;
        'deps add') _putnami_words=(--dry-run) ;;
        'deps prune') _putnami_words=(--dry-run) ;;
        'deps remove') _putnami_words=(--dry-run) ;;
        'deps rm') _putnami_words=(--dry-run) ;;
        'doctor') _putnami_words=(--machine --profile --project) ;;
        'extensions install') _putnami_words=(--dest --latest --platform --user) ;;
        'extensions list') _putnami_words=(--user) ;;
        'extensions remove') _putnami_words=(--user) ;;
        'help') _putnami_words=(--man --markdown) ;;
        'impact-plan') _putnami_words=(--base --head) ;;
        'init') _putnami_words=(--channel --extension --force --project --project-path --workspace) ;;
        'install') _putnami_words=(--latest) ;;
        'migrate vnext') _putnami_words=(--apply --check) ;;
        'pin') _putnami_words=(--remove) ;;
        'projects create') _putnami_words=(--channel --force --path --template) ;;
        'projects sync') _putnami_words=(--dry-run --prune --skip-install) ;;
        'projects tag') _putnami_words=(--remove --set) ;;
        'report') _putnami_words=(--session) ;;
        'sessions export') _putnami_words=(--since) ;;
        'sessions inspect') _putnami_words=(--run) ;;
        'sessions list') _putnami_words=(--revision) ;;
        'sessions replay') _putnami_words=(--session) ;;
        'sessions summary') _putnami_words=(--by-digest --command --since) ;;
        'templates install') _putnami_words=(--latest) ;;
        'templates package') _putnami_words=(--stable --version) ;;
        'templates test') _putnami_words=(--channel --keep --skip-build) ;;
        'upgrade') _putnami_words=(--channel --cli --continue-on-error --deps --dry-run --extensions --from-source --global --namespace --release --version) ;;
        'workspace init') _putnami_words=(--channel --extension --force --project --project-path --workspace) ;;
    esac
}

# _putnami_reply offers each argument that starts with the current word. It
# matches in bash, not with compgen, whose replies a newline in a name would
# split. Each reply is quoted, so the command line reads it back as the same
# word. Bash 3.2 leaves a leading "~" bare, which the command line would expand
# to a home directory.
_putnami_reply() {
    COMPREPLY=()
    local word quoted
    for word in "$@"; do
        if [[ "${word}" != "${cur}"* ]]; then
            continue
        fi
        printf -v quoted '%q' "${word}"
        if [[ "${quoted}" == \~* ]]; then
            quoted="\\${quoted}"
        fi
        COMPREPLY+=("${quoted}")
    done
}

_putnami_completions() {
    local cur prev words cword
    _init_completion || return

    local -a _putnami_words
    local -a commands=(cache cli completion config context deps doctor extensions help impact-plan init install mcp migrate pin projects report scopes sessions telemetry templates tree upgrade workspace)
    local -a structured=(cache cli completion config context deps doctor extensions help impact-plan init install mcp migrate pin projects report scopes sessions telemetry templates tree upgrade workspace)
    local -a global_flags=(--verbose --debug --help --all --impacted --projects --tag --exclude-tag --baseline --credential-fd --no-cache --output --json --quiet --color --no-color --version)
    local -a job_global_flags=()
    local -a projects=()
    local -a project_ids=()
    local -a project_basenames=()
    local -a project_aliases=()
    # Every form ResolveTarget accepts for a positional/--projects target.
    local -a project_targets=("${project_ids[@]}" "${projects[@]}" "${project_basenames[@]}" "${project_aliases[@]}")

    # First argument: command name
    if [[ ${cword} -eq 1 ]]; then
        _putnami_reply "${commands[@]}"
        return
    fi

    local cmd="${words[1]}"
    # A flag goes after the command: the CLI refuses a command line whose
    # first word is a flag, so nothing completes after it.
    if [[ "${cmd}" == -* ]]; then
        COMPREPLY=()
        return
    fi
    # A core command takes a job-only flag only as one of its own flags.
    if ! _putnami_core_root "${cmd}"; then
        global_flags+=("${job_global_flags[@]}")
    fi

    local path="${cmd}"
    local i=2
    while [[ ${i} -lt ${cword} ]]; do
        local word="${words[${i}]}"
        if [[ "${word}" == -* ]]; then
            break
        fi
        local candidate="${path} ${word}"
        if _putnami_path_known "${candidate}"; then
            path="${candidate}"
            ((i++))
        else
            break
        fi
    done

    _putnami_subcommands_for "${path}"
    local -a nested_subcommands=("${_putnami_words[@]}")
    if [[ ${#nested_subcommands[@]} -gt 0 && "${cur}" != -* && ${i} -eq ${cword} ]]; then
        if _putnami_takes_project "${path}"; then
            nested_subcommands+=("${project_ids[@]}")
        fi
        _putnami_reply "${nested_subcommands[@]}"
        return
    fi

    # Flags and project names
    local -a structured_values=()
    case "${path} ${prev}" in
        'workspace init --extension')
            structured_values=(go py ts)
            ;;
    esac

    if [[ ${#structured_values[@]} -gt 0 ]]; then
        _putnami_reply "${structured_values[@]}"
    elif [[ "${cur}" == -* ]]; then
        _putnami_flags_for "${path}"
        _putnami_reply "${_putnami_words[@]}" "${global_flags[@]}"
    elif [[ "${prev}" == "--projects" ]]; then
        _putnami_reply "${project_targets[@]}"
    elif [[ "${prev}" == "--output" ]]; then
        _putnami_reply text json jsonl cloud-logging
    elif [[ "${prev}" == "--tag" || "${prev}" == "--exclude-tag" ]]; then
        # Tags are dynamic — no static completion
        :
    else
        # Positional project target: IDs, names, basenames, and aliases
        _putnami_reply "${project_targets[@]}" "${global_flags[@]}"
    fi
}

complete -F _putnami_completions putnami
