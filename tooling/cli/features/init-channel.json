{
  "$schema": "https://putnami.dev/schemas/putnami-feature.json",
  "protocolVersion": 2,
  "namespace": "cli",
  "feature": {
    "id": "cli/init-channel",
    "type": "feature",
    "name": "Init resolves on one channel",
    "outcome": "A user who runs putnami init or putnami projects create on a release channel gets extensions, a template and starter dependencies that all come from that channel, and the workspace pins no channel",
    "owner": "tooling",
    "target": "coded",
    "requirements": [
      {
        "id": "one-channel-choice",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-flag-wins-over-the-variable-and-the-install-record",
            "the-install-record-is-the-channel-in-the-installed-name",
            "init-defaults-to-the-install-record",
            "an-unsafe-name-or-a-version-is-refused-before-anything-is-written"
          ]
        }
      },
      {
        "id": "every-resolution-reads-the-channel",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "every-stage-of-init-receives-the-channel",
            "the-installers-receive-the-channel-as-a-job-option",
            "the-typescript-installer-receives-the-channel-and-its-registries",
            "project-setup-receives-the-channel",
            "the-fallback-template-install-resolves-on-the-channel",
            "a-candidate-channel-resolves-only-its-release-set-while-latest-is-older",
            "a-candidate-channel-resolves-while-latest-is-empty"
          ]
        }
      },
      {
        "id": "no-choice-is-unchanged",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "no-choice-hands-every-stage-bare-names-and-no-option",
            "no-choice-asks-every-registry-for-latest"
          ]
        }
      },
      {
        "id": "projects-create-takes-a-channel",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "create-resolves-on-the-channel-init-would",
            "create-without-a-choice-installs-on-latest",
            "the-create-to-run-again-names-the-channel"
          ]
        }
      },
      {
        "id": "the-workspace-pins-no-channel",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-config-keeps-bare-names-and-the-lock-records-exact-versions",
            "upgrade-follows-latest-by-default",
            "upgrade-in-the-new-workspace-asks-for-latest"
          ]
        }
      },
      {
        "id": "release-smokes-hand-the-channel-to-init",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-shell-smoke-hands-its-channel-to-init",
            "the-powershell-smoke-hands-its-channel-to-init"
          ]
        }
      },
      {
        "id": "templates-test-builds-the-rendered-project",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-temporary-workspace-lists-the-extension-and-no-project-or-language-manifest",
            "the-extension-installs-on-the-channel-the-run-chose",
            "the-project-is-created-on-the-channel-the-run-chose",
            "phase-3-runs-only-the-verbs-the-extension-declares"
          ]
        }
      }
    ]
  }
}
