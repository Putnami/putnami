{
  "$schema": "https://putnami.dev/schemas/putnami-feature.json",
  "protocolVersion": 2,
  "namespace": "cli",
  "feature": {
    "id": "cli/collaboration-providers",
    "type": "feature",
    "name": "Collaboration provider routing",
    "outcome": "A workspace binds its task, change-proposal, memory and missions backends independently, and a user, a script or an extension calls the same versioned operations through the CLI or the extension host channel without knowing which backend answers, while a missing binding or capability, a refused precondition and an uncertain write are stated rather than hidden",
    "owner": "tooling",
    "target": "coded",
    "requirements": [
      {
        "id": "explicit-binding",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "an-unbound-contract-is-unsupported-and-names-the-binding",
            "an-ambiguous-binding-is-refused",
            "a-missing-or-disabled-provider-is-unavailable",
            "candidates-are-reported-never-selected"
          ]
        }
      },
      {
        "id": "capability-discovery",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "capabilities-report-every-operation-and-its-support",
            "an-unsupported-version-or-incomplete-provider-is-refused"
          ]
        }
      },
      {
        "id": "one-route-two-entry-paths",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-cli-and-the-host-channel-return-the-same-envelope",
            "provider-operations-are-reachable-only-through-the-binding",
            "settings-and-selection-reach-the-provider"
          ]
        }
      },
      {
        "id": "host-only-operations",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-cli-and-the-host-channel-route-a-host-only-operation",
            "capabilities-mark-a-host-only-operation"
          ]
        }
      },
      {
        "id": "contract-names-never-shadow-commands",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "no-contract-name-is-a-built-in-command"
          ]
        }
      }
    ]
  }
}
