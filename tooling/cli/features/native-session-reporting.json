{
  "$schema": "https://putnami.dev/schemas/putnami-feature.json",
  "protocolVersion": 2,
  "namespace": "cli",
  "feature": {
    "id": "cli/native-session-reporting",
    "type": "feature",
    "name": "Native execution session reporting",
    "outcome": "Each explicitly selected reporter receives live execution facts, the session reporter also receives the persisted terminal session, and each resumes delivery without rebuilding work",
    "owner": "tooling",
    "target": "modeled",
    "requirements": [
      {
        "id": "engine-lifecycle",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "live-events-and-finalized-success-failure-cancellation",
            "stream-subscribers-leave-recorded-bytes-unchanged",
            "a-killed-subscriber-keeps-the-verdict-and-records-partial-evidence",
            "reporting-capabilities-deliver-and-fail-independently",
            "plan-precedes-every-other-frame",
            "an-omitted-plan-leaves-delivery-and-the-verdict-unchanged"
          ]
        }
      },
      {
        "id": "durable-replay",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "outage-retains-identical-frame-and-replay-runs-no-workload",
            "replay-resumes-only-undelivered-capabilities",
            "replay-sends-an-undelivered-plan-first",
            "a-checkpoint-without-a-plan-cursor-stays-valid",
            "a-crash-mid-plan-resumes-at-its-pending-frame"
          ]
        }
      },
      {
        "id": "credential-boundary",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "explicit-secret-is-withheld-from-hooks-and-tasks",
            "each-token-reaches-only-its-own-provider",
            "hosted-run-ignores-reporter-tokens"
          ]
        }
      },
      {
        "id": "bounded-transport",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "writes-reads-retries-and-finalization-are-bounded",
            "pending-retention-honors-session-policy-and-active-locks",
            "live-chunks-wait-for-a-full-frame-or-the-interval",
            "log-reporter-chunks-wait-for-a-full-frame-or-two-seconds",
            "plan-is-bounded-and-omitted-past-its-bound"
          ]
        }
      },
      {
        "id": "spec-verification-record",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "spec-verification-leaves-last-after-the-events-final-marker",
            "the-engine-writes-spec-verification-before-reporting-ends",
            "an-omitted-spec-verification-leaves-delivery-complete",
            "spec-verification-is-bounded-and-omitted-past-its-bound",
            "a-checkpoint-without-a-spec-verification-cursor-stays-valid"
          ]
        }
      },
      {
        "id": "trimmed-upload",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "progress-events-and-the-debug-lines-of-a-passing-task-are-not-sent",
            "a-failing-task-sends-its-held-lines-in-order-before-its-end",
            "a-shared-batch-line-leaves-at-its-first-failing-member",
            "a-record-split-across-raw-frames-is-decided-once",
            "session-end-and-the-final-marker-release-what-is-held",
            "held-records-past-the-cap-release-the-task-that-holds-the-most",
            "view-frames-keep-their-bytes-after-a-retry-a-reporter-restart-and-an-engine-restart",
            "the-view-final-marker-reads-delivered",
            "a-version-1-checkpoint-that-sent-events-keeps-raw-framing",
            "the-log-reporter-sends-the-raw-stream"
          ]
        }
      },
      {
        "id": "unavailable-provider",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "an-unloaded-selected-provider-is-named",
            "an-unavailable-provider-echoes-no-other-cause"
          ]
        }
      }
    ]
  }
}
