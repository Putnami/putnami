{
  "$schema": "https://putnami.dev/schemas/putnami-feature.json",
  "protocolVersion": 2,
  "namespace": "cli",
  "feature": {
    "id": "cli/credential-provider",
    "type": "feature",
    "name": "Credential provider for registry downloads",
    "outcome": "A user who turns on --providers install gets the archive downloads of that process authenticated by the workspace's one credential provider, asked once per purpose and sent only to the hosts its credential names, while a workspace without a provider behaves as before",
    "owner": "tooling",
    "target": "modeled",
    "requirements": [
      {
        "id": "providers-are-opt-in",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "flag-off-launches-nothing",
            "flag-wins-over-the-environment",
            "bound-request-decides-alone",
            "choice-holds-for-one-process",
            "remote-providers-need-the-capability"
          ]
        }
      },
      {
        "id": "one-provider-or-none",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "absent-provider-stays-native",
            "errors-name-their-source"
          ]
        }
      },
      {
        "id": "bearer-only-for-its-hosts",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "bearer-reaches-only-its-hosts"
          ]
        }
      },
      {
        "id": "refusal-never-falls-back",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "late-answer-before-exit-is-heard",
            "exit-is-seen-while-a-child-holds-output"
          ]
        }
      }
    ]
  }
}
