{
  "$schema": "https://putnami.dev/schemas/putnami-feature.json",
  "protocolVersion": 2,
  "namespace": "cli",
  "feature": {
    "id": "cli/provider-publication",
    "type": "feature",
    "name": "Publication through providers",
    "outcome": "A user who publishes, locally or on a hosted runner, gets a run whose ancestry and publish credential are fixed before any repository code runs, whose uploads and channel release go through one credential provider session, and in which neither the engine nor a repository process holds a publish credential, while a run or a bound request that only gates starts no publication",
    "owner": "tooling",
    "target": "modeled",
    "requirements": [
      {
        "id": "ancestry-is-read-before-repository-code",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-snapshot-precedes-the-first-hook",
            "replace-refs-and-grafts-change-no-answer",
            "a-shallow-clone-is-named",
            "a-history-above-the-limit-contains-nothing",
            "a-gate-only-run-reads-no-ancestry",
            "the-publish-purpose-starts-its-provider-before-the-first-hook",
            "the-snapshot-precedes-the-install"
          ]
        }
      },
      {
        "id": "gate-only-launches-no-publication",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "a-publishing-request-without-the-block-is-refused-before-any-provider",
            "a-request-without-the-block-enables-no-publish-purpose",
            "a-request-without-the-block-starts-no-publish-provider",
            "a-gate-only-request-plans-no-publish-job"
          ]
        }
      },
      {
        "id": "open-credential-release-through-one-provider",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "resolve-runs-through-the-session",
            "open-follows-every-barrier-leaf-once",
            "a-refused-release-moves-no-channel",
            "without-the-echo-the-legacy-path-runs",
            "real-extensions-open-once-and-release-forward-only",
            "a-local-and-a-hosted-run-open-the-same-plan"
          ]
        }
      },
      {
        "id": "uploads-go-to-the-credential-provider",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "a-publication-job-holds-no-credential",
            "a-hostile-publication-job-finds-no-credential",
            "each-packed-member-goes-to-the-session",
            "the-engine-asks-no-publish-credential",
            "the-answered-digest-must-be-the-packed-one",
            "a-tampered-artifact-is-refused-by-digest",
            "a-member-the-plan-does-not-select-is-refused",
            "a-reused-publication-job-fails-the-release",
            "real-extension-jobs-pack-and-the-session-uploads",
            "a-probe-during-an-upload-finds-no-credential",
            "put-registry-members-go-to-the-session",
            "a-refused-upload-fails-the-member",
            "a-put-member-the-engine-did-not-upload-fails-the-release",
            "every-put-registry-kind-uploads-with-no-bearer-in-the-repository",
            "an-upload-is-bounded-by-its-declared-size",
            "an-unanswered-upload-ends-the-session",
            "a-session-without-uploader-v1-fails-before-the-first-hook",
            "the-core-requires-no-registry-client"
          ]
        }
      },
      {
        "id": "bound-requests-publish-through-the-provider",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-expected-plan-is-the-legacy-plan",
            "a-bound-request-opens-uploads-and-releases-the-local-plan"
          ]
        }
      }
    ]
  }
}
