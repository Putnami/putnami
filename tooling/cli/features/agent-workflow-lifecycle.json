        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "an-absent-declaration-skips-the-phase"
          ]
        }
      },
      {
        "id": "legacy-declarations-refused",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "every-pass-refuses-a-legacy-entry",
            "install-and-upgrade-refuse-legacy-state-with-nothing-written"
          ]
        }
      },
      {
        "id": "record-last",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
