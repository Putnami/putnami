{
  "$schema": "https://putnami.dev/schemas/putnami-feature.json",
  "protocolVersion": 2,
  "namespace": "cli",
  "feature": {
    "id": "cli/impact-plan",
    "type": "feature",
    "name": "Impact plan",
    "outcome": "An extension asks the engine for the impacted plan of a change, for the commands it names, and reads it with the protocol package alone",
    "owner": "tooling",
    "target": "modeled",
    "requirements": [
      {
        "id": "one-projection",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-projection-is-canonical"
          ]
        }
      },
      {
        "id": "pinned-revisions",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "a-dirty-worktree-is-refused-before-planning",
            "the-range-is-refused-before-planning",
            "planning-that-changes-the-checkout-is-refused",
            "no-remote-is-needed"
          ]
        }
      },
      {
        "id": "named-commands",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-command-list-is-required",
            "aliases-resolve-to-one-command-each",
            "the-planner-plans-the-named-commands",
            "an-undeclared-command-is-refused"
          ]
        }
      },
      {
        "id": "one-structured-result",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-render-writes-one-envelope",
            "the-command-writes-one-envelope"
          ]
        }
      }
    ]
  }
}
