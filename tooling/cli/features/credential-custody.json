{
  "$schema": "https://putnami.dev/schemas/putnami-feature.json",
  "protocolVersion": 2,
  "namespace": "cli",
  "feature": {
    "id": "cli/credential-custody",
    "type": "feature",
    "name": "Credential custody on hosted runs",
    "outcome": "A hosted runner that passes the run credential on --credential-fd gets a run in which no repository-controlled process can read a credential, and a cold install of a private pin that works from an empty store, while a run without the flag behaves as before",
    "owner": "tooling",
    "target": "modeled",
    "requirements": [
      {
        "id": "credential-on-a-descriptor",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "descriptor-read-once-and-closed",
            "unusable-descriptor-is-a-usage-error",
            "relaunch-keeps-the-descriptor",
            "bound-request-accepts-only-the-descriptor",
            "older-pin-is-refused",
            "bootstrap-provider-serves-only-the-locked-downloads"
          ]
        }
      },
      {
        "id": "providers-receive-it-over-rpc",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "credential-provider-initialize-carries-it",
            "cache-provider-authenticates-after-the-capability",
            "reporters-authenticate-after-initialize",
            "a-reporter-that-cannot-hold-it-gets-none"
          ]
        }
      },
      {
        "id": "fetch-before-repository-code",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "fetch-completes-before-install",
            "only-fetch-gets-the-job-credential",
            "every-other-job-runs-offline",
            "path-extension-fetch-runs-after-custody"
          ]
        }
      },
      {
        "id": "hostile-process-finds-nothing",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "hostile-hook-and-test-find-nothing",
            "hosted-run-runs-only-store-and-path-extensions",
            "path-extension-serves-no-provider",
            "hosted-run-ignores-the-workspace-registry",
            "hosted-run-probes-no-workspace-toolchain",
            "no-credential-after-repository-code"
          ]
        }
      },
      {
        "id": "source-built-providers",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "a-source-workspace-path-extension-keeps-its-providers-on-a-hosted-run",
            "extensions-prepare-prepares-the-source-built-runtimes",
            "a-hosted-run-loads-a-source-built-runtime-from-the-store-without-preparing-it",
            "a-source-built-runtime-the-store-lacks-fails-the-launch",
            "a-hosted-source-workspace-run-authenticates-the-prepared-provider-before-repository-code"
          ]
        }
      },
      {
        "id": "needed-provider-only-on-a-path-extension",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "a-hosted-run-fails-when-the-ci-needs-a-path-extension-provider"
          ]
        }
      },
      {
        "id": "cold-install-leaves-locks-unchanged",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "private-pin-installs-cold",
            "hosted-install-writes-no-lock"
          ]
        }
      },
      {
        "id": "flag-off-changes-nothing",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "flag-off-job-env-unchanged",
            "flag-off-reporter-frames-unchanged"
          ]
        }
      }
    ]
  }
}
