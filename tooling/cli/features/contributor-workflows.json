    "target": "coded",
    "requirements": [
      {
        "id": "one-contributor-extension",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "every-skill-and-worker-renders-on-both-hosts",
            "the-repository-runs-the-content-it-distributes"
          ]
        }
      },
      {
        "id": "explicit-only-invocation",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
