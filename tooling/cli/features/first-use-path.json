{
  "$schema": "https://putnami.dev/schemas/putnami-feature.json",
  "protocolVersion": 2,
  "namespace": "cli",
  "feature": {
    "id": "cli/first-use-path",
    "type": "feature",
    "name": "First-use path on a bare machine",
    "outcome": "A new user on macOS or Linux pastes the documented block into a shell that holds only Bash, curl, tar and a SHA-256 tool, and gets a served starter; each release proves that block, the checks and the Go path in an image that holds nothing else",
    "owner": "tooling",
    "target": "modeled",
    "requirements": [
      {
        "id": "pasted-block-reaches-the-command",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-footer-starts-with-the-path-line-only-when-the-command-is-not-reachable"
          ]
        }
      },
      {
        "id": "first-use-smoke-machine",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-block-is-the-first-bash-block-of-the-page",
            "the-image-holds-only-what-the-installer-needs",
            "the-smoke-refuses-an-image-that-is-not-bare"
          ]
        }
      },
      {
        "id": "first-use-smoke-legs",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-smoke-runs-the-documented-block-then-the-checks-and-the-go-path",
            "a-candidate-channel-is-selected-through-the-environment",
            "the-smoke-fails-under-the-leg-that-broke"
          ]
        }
      },
      {
        "id": "first-use-smoke-stop",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "the-stop-leg-fails-on-a-process-of-the-smoke-that-outlives-the-stop",
            "the-stop-leg-fails-on-a-process-that-runs-in-the-tree-of-the-smoke",
            "the-stop-leg-ignores-another-listener-on-the-freed-port"
          ]
        }
      },
      {
        "id": "init-lists-members-once",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "init-lists-the-created-project-once",
            "init-writes-no-root-package-json"
          ]
        }
      },
      {
        "id": "no-install-provider-nothing-to-install",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "an-implicit-install-prints-nothing-when-no-extension-provides-workspace-install",
            "an-explicit-command-prints-one-line-when-no-extension-provides-workspace-install",
            "a-declared-extension-that-does-not-load-fails-the-install",
            "a-failed-install-records-no-install-marker"
          ]
        }
      }
    ]
  }
}
