{
  "$schema": "https://putnami.dev/schemas/putnami-feature.json",
  "protocolVersion": 2,
  "namespace": "cli",
  "feature": {
    "id": "cli/version-from-git",
    "type": "feature",
    "name": "Versions derived from git",
    "outcome": "A user gets the exact version every version line is at, derived from the line's git tags and the conventional commits that touch it",
    "owner": "tooling",
    "target": "modeled",
    "requirements": [
      {
        "id": "tag-sets-the-version",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "tagged-commit-uses-the-tag-version"
          ]
        }
      },
      {
        "id": "conventional-advance",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "docs-commit-still-advances-a-patch",
            "feat-advances-patch-before-one-minor-after",
            "breaking-advances-minor-before-one-major-after",
            "bump-follows-the-support-catalog"
          ]
        }
      },
      {
        "id": "last-release-is-the-baseline",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "a-tag-that-is-not-a-release-is-no-baseline",
            "an-older-release-of-a-merged-branch-is-no-baseline",
            "a-release-reached-through-a-merge-of-main-is-the-baseline"
          ]
        }
      },
      {
        "id": "full-clone-required",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "shallow-clone-is-refused"
          ]
        }
      },
      {
        "id": "a-client-line-follows-its-contract",
        "stage": "coded",
        "evidenceKinds": [
          "attestation"
        ],
        "verification": {
          "kind": "acceptance",
          "checks": [
            "a-contract-only-commit-advances-the-clients-line",
            "a-contract-inside-the-line-adds-no-pathspec"
          ]
        }
      }
    ]
  }
}
