{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "tooling",
  "features": [
    {
      "id": "tooling/specification-driven-development",
      "type": "feature",
      "name": "Specification-driven development",
      "outcome": "A workspace that opts in can author features, specs and architecture contracts, have them checked as ordinary DAG jobs in the same gate as build and test, and read them from a terminal or an agent through one shared engine \u2014 while a workspace that does not opt in carries none of it",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "opt-in-activation",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "validation-commands-carry-the-settled-activations",
              "every-authoring-project-declares-the-extension"
            ]
          }
        },
        {
          "id": "declared-inputs-cover-the-read-set",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-cache-policy-matches-the-declared-read-set",
              "worktree-validation-reads-no-git-history"
            ]
          }
        },
        {
          "id": "architecture-adoption-policy",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "automatic-architecture-policy-controls-admission",
              "report-never-hides-structural-errors",
              "off-skips-automatic-architecture-evaluation",
              "architecture-policy-is-part-of-cache-key"
            ]
          }
        },
        {
          "id": "one-engine-two-surfaces",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-rendered-payload-is-the-builder-result",
              "features-list-renders-both-surfaces-from-one-value",
              "spec-commands-render-both-surfaces-from-one-value"
            ]
          }
        },
        {
          "id": "refuse-rather-than-widen",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "an-unresolved-interactive-selection-is-refused",
              "a-selection-only-view-fails-closed-for-workspace-evaluation"
            ]
          }
        },
        {
          "id": "predictable-spec-scaffolding",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "init-uses-the-feature-leaf-with-dry-run-parity",
              "init-refuses-a-leaf-collision-without-overwriting"
            ]
          }
        },
        {
          "id": "settled-decisions-are-enforced",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-project-registry-judges-only-its-directory",
              "a-violated-decision-fails-naming-it",
              "an-absent-registry-is-adoption",
              "an-unusable-registry-fails-closed"
            ]
          }
        },
        {
          "id": "recipe-indexes-are-checked",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-dangling-sample-fails-naming-it",
              "a-duplicate-intention-fails",
              "an-absent-index-is-adoption"
            ]
          }
        },
        {
          "id": "codeowners-follow-declared-owners",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-file-follows-the-declarations",
              "a-single-maintainer-gets-one-rule",
              "an-unchanged-file-is-not-rewritten",
              "a-declaration-without-a-catch-all-fails",
              "an-invalid-owner-fails-without-writing",
              "no-declaration-is-adoption"
            ]
          }
        },
        {
          "id": "every-document-has-working-links",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-broken-link-fails-naming-it",
              "working-links-pass",
              "a-link-into-another-project-is-checked",
              "a-project-opt-out-is-honored"
            ]
          }
        },
        {
          "id": "squash-keeps-the-breaking-marker",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-dropped-marker-fails-naming-the-commit",
              "a-title-with-the-marker-passes",
              "no-breaking-commit-passes-any-title",
              "a-footer-counts-only-in-a-body",
              "a-non-conventional-title-declares-nothing",
              "base-commits-merged-in-do-not-count",
              "an-unset-message-passes-with-a-note",
              "a-missing-baseline-fails",
              "a-shallow-clone-fails",
              "the-step-is-never-served-from-cache"
            ]
          }
        },
        {
          "id": "squash-names-no-agent",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-signature-fails-naming-the-line",
              "technical-text-passes",
              "an-allowing-workspace-passes-with-a-note",
              "an-unset-message-passes-with-a-note",
              "an-invalid-option-fails",
              "the-step-is-never-served-from-cache"
            ]
          }
        },
        {
          "id": "verify-names-an-empty-evaluation",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "an-empty-record-names-no-requirement",
              "a-record-with-a-diagnostic-keeps-the-session-message"
            ]
          }
        },
        {
          "id": "authoring-never-grants-a-permission",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "init-scaffolds-only-what-was-stated",
              "init-refuses-an-already-declared-domain",
              "sync-removes-a-stale-project-and-a-stale-binding",
              "sync-refuses-to-grant-an-undeclared-relation",
              "sync-rejects-project-selection"
            ]
          }
        },
        {
          "id": "spec-findings-name-file-positions",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-spec-finding-names-the-entry-position-in-the-file",
              "an-unresolved-decision-names-its-file-position"
            ]
          }
        },
        {
          "id": "feature-findings-name-file-positions",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-feature-finding-names-the-entry-position-in-the-file"
            ]
          }
        },
        {
          "id": "features-name-their-surface",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-project-without-a-manifest-resolves-nothing",
              "an-unserved-surface-name-fails-features-validate",
              "features-list-and-inspect-return-the-declared-surface"
            ]
          }
        },
        {
          "id": "every-project-carries-feature-coverage",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-covered-debt-entry-fails",
              "a-malformed-list-fails-closed",
              "a-project-without-putnami-json-is-judged",
              "an-absent-option-is-adoption",
              "an-ignored-document-covers-nothing",
              "an-uncovered-project-fails-naming-it",
              "an-unknown-debt-entry-fails",
              "an-unresolvable-owner-does-not-cover"
            ]
          }
        }
      ],
      "surface": {
        "commands": [
          "architecture init",
          "architecture inspect",
          "architecture snapshot",
          "architecture sync",
          "architecture validate",
          "contracts check",
          "contracts generate",
          "features diff",
          "features inspect",
          "features list",
          "features snapshot",
          "features validate",
          "specs baseline",
          "specs init",
          "specs inspect",
          "specs list",
          "specs validate",
          "specs verify",
          "validate",
          "validate-workspace"
        ]
      }
    }
  ]
}
