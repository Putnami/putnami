{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/cli-documents",
  "tags": [
    "go"
  ],
  "extensions": [
    "/go/extension",
    "/tooling/sdd-extension"
  ],
  "disable": {
    "jobs": [
      "serve"
    ]
  },
  "options": {
    "lint": {
      "fix": false
    },
    "test": {
      "coverage": false,
      "coverage-threshold": 0,
      "filePatterns": [
        "git:**"
      ]
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
