{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/cli-documents",
  "tags": [
    "go"
  ],
  "extensions": [
    "/go/extension"
  ],
  "disable": {
    "jobs": [
      "serve"
    ]
  },
  "options": {
    "lint": {
      "fix": false
    },
    "test": {
      "coverage": false,
      "coverage-threshold": 0,
      "filePatterns": [
        "../repository-checks/putnami.json"
      ]
    }
  },
  "featureAuthority": {
    "none": "A test surface that proves the cache key of the repository checks against the CLI's collector; it ships nothing a user runs."
  }
}
