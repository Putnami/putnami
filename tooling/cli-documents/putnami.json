{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/cli-documents",
  "tags": [
    "go"
  ],
  "extensions": [
    "/go/extension",
    "/tooling/sdd-extension"
  ],
  "disable": {
    "jobs": [
      "serve"
    ]
  },
  "options": {
    "lint": {
      "fix": false
    },
    "test": {
      "coverage": false,
      "coverage-threshold": 0,
      "filePatterns": [
        "../cli/internal/cli/testdata/release-plan.json",
        "../cli/internal/cli/testdata/public-cut-baseline.tsv",
        "../cli/internal/cli/testdata/public-cut-allowlist.tsv",
        "../../.github/workflows/whole-tree-gates.yml"
      ],
      "envInputs": [
        "PUTNAMI_WHOLE_TREE_GATES"
      ]
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
