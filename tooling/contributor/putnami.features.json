{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "tooling",
  "features": [
    {
      "id": "tooling/contributor-executable",
      "type": "feature",
      "name": "Contributor executable",
      "outcome": "A contributor verifies a native workflow record, finalizes a squash-ready proposal and evaluates the language rule with the putnami change verify, change finalize and change language commands that the @putnami/contributor executable serves",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "provider-neutral-publication",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-finalizer-publishes-through-the-contracts",
              "partial-delivery-never-closes-parent",
              "the-read-back-carries-what-the-upsert-answered",
              "an-unresolved-write-stops-without-a-retry",
              "a-settled-proposal-of-the-branch-opens-no-replacement"
            ]
          }
        },
        {
          "id": "repository-policy",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-policy-selects-the-delivered-state-reference-and-language"
            ]
          }
        },
        {
          "id": "squash-ready-publication",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-draft-opens-before-the-first-edit",
              "the-body-is-the-squash-message",
              "no-publication-names-an-agent",
              "an-explicit-hosted-gate-waits-without-local-execution",
              "hosted-parent-workflow-completeness",
              "a-featureless-partial-needs-no-workflow",
              "a-partial-without-an-eligible-unit-publishes-without-a-receipt"
            ]
          }
        },
        {
          "id": "native-workflow-validation",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "workflow-versions-and-references",
              "native-requirement-check-coverage",
              "relevant-artifact-invalidation",
              "delivery-receipts-and-parent-completeness",
              "experiment-and-handoff-inputs",
              "hosted-workflow-readiness-bound-to-required-checks"
            ]
          }
        },
        {
          "id": "change-language-parity",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "change-language-reports-what-contributor-language-reports",
              "the-language-check-pages-tasks-through-the-call-seam",
              "tasks-reach-the-provider-through-the-host-channel",
              "other-modes-never-dial-the-host",
              "tasks-without-a-channel-exit-2"
            ]
          }
        },
        {
          "id": "change-verify-parity",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "change-verify-prints-what-tree-verify-prints",
              "a-restored-report-is-read-through-the-host-channel",
              "without-a-channel-only-a-restored-report-is-not-verified",
              "no-process-receives-the-host-channel",
              "change-verify-runs-with-and-without-a-workspace"
            ]
          }
        },
        {
          "id": "change-finalize-parity",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "ownership-comes-from-the-host-channel",
              "one-host-channel-serves-the-run",
              "a-usage-error-never-dials-the-host",
              "no-git-command-receives-the-host-channel"
            ]
          }
        },
        {
          "id": "local-evidence-verification",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-bare-call-is-a-not-verified-verdict-on-stdout-alone",
              "evidence-is-read-strictly-against-the-git-top-level"
            ]
          }
        }
      ]
    },
    {
      "id": "tooling/agent-session-hooks",
      "type": "feature",
      "name": "Agent session hooks",
      "outcome": "A Claude Code or Codex session publishes its state, plan, delivered messages, decisions and replies to its mission through the hooks @putnami/contributor declares, and receives the owner's messages and answers",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "session-start-sheet",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "session-start-syncs-and-prints-the-mission-sheet",
              "the-sheet-quotes-agent-text-within-4-kib",
              "the-sheet-carries-the-mission-checkpoint",
              "waiting-messages-arrive-whole-within-the-context-bound"
            ]
          }
        },
        {
          "id": "tool-use-capture",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "post-tool-use-records-the-plan-without-git-or-provider",
              "a-subagent-plan-is-not-the-session-plan",
              "a-busy-session-spools-the-tool-call",
              "an-asked-decision-binds-on-the-next-sync",
              "a-recorded-reply-wins-over-an-ack-line"
            ]
          }
        },
        {
          "id": "stop-publication",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "stop-publishes-in-one-sync",
              "a-waiting-message-continues-the-turn-once",
              "codex-waits-for-an-open-decision",
              "stop-failure-publishes-the-error",
              "a-refused-reply-is-dropped"
            ]
          }
        },
        {
          "id": "idle-wake",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-idle-wake-exits-75-only-on-a-waiting-message",
              "the-idle-wake-ends-after-its-window"
            ]
          }
        },
        {
          "id": "fail-open",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "every-failure-exits-0-with-a-log-line",
              "a-run-without-a-channel-exits-0",
              "a-transport-error-redials-and-keeps-the-queue"
            ]
          }
        },
        {
          "id": "bounded-calls",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-budgets-fit-the-declared-timeouts"
            ]
          }
        },
        {
          "id": "mission-target",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "attach-declares-the-mission-of-the-branch",
              "the-repository-comes-from-origin-without-host-or-credential"
            ]
          }
        },
        {
          "id": "host-channel",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-hook-reaches-the-provider-through-the-host-channel"
            ]
          }
        }
      ],
      "surface": {
        "commands": [
          "agent attach",
          "agent hook"
        ]
      }
    }
  ]
}
