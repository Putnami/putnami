{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Putnami change plan",
  "description": "The plan putnami change estimate reads: the issue a change delivers and its slices in order. The contributor's strict decoder applies the same members and bounds, and refuses a repeated member.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "issue", "slices"],
  "properties": {
    "protocolVersion": {
      "description": "Version of this format.",
      "type": "integer",
      "const": 1
    },
    "issue": {
      "description": "Id of the issue the change delivers, as its tracker writes it; it names the folder .putnami/<issue>.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "slices": {
      "description": "The slices of the change, in the order they run.",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/slice" }
    }
  },
  "$defs": {
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "projects", "files", "endpoints", "screens", "sensitiveZones"],
      "properties": {
        "key": {
          "description": "Token that names the slice, unique in the plan.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "title": {
          "description": "One line that says what the slice delivers.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "projects": {
          "description": "Ids of the workspace projects the slice changes.",
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 214,
            "pattern": "^[!-~]+$"
          }
        },
        "files": {
          "description": "Expected count of files the slice touches.",
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "endpoints": {
          "description": "Count of HTTP or RPC endpoints the slice adds or changes.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "screens": {
          "description": "Count of user interface screens the slice adds or changes.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "sensitiveZones": {
          "description": "Sensitive zones the slice touches, such as a data migration or a public API.",
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        },
        "effort": {
          "description": "Model and reasoning level the slice is planned for.",
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "reasoning"],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
            },
            "reasoning": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
            }
          }
        }
      }
    }
  }
}
