{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/dev",
  "tags": ["tooling", "go", "extension"],
  "extensions": ["/go/extension", "/tooling/sdd-extension"],
  "disable": {
    "jobs": ["serve"]
  },
  "options": {
    "@putnami/go": {
      "entrypoint": "./cmd/putnami-dev",
      "version-var": "main.runtimeVersion"
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    },
    "test": {
      "filePatterns": [
        "putnami.extension.json",
        "bin/prepare",
        "../../go/extension/putnami.extension.json",
        "../../typescript/extension/putnami.extension.json",
        "../../python/extension/putnami.extension.json"
      ]
    },
    "package": {
      "archives": true
    },
    "publish": {
      "archives": true
    }
  }
}
