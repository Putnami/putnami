{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "tooling",
  "features": [
    {
      "id": "tooling/development-verbs",
      "type": "feature",
      "name": "Development verb vocabulary",
      "outcome": "A workspace that installs a language extension also loads @putnami/dev, and reads from it the order, descriptions, aliases, related commands and default traits of the eleven development verbs, which the language extensions keep running",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "eleven-ordered-verbs",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-manifest-declares-the-eleven-verbs-in-order",
              "the-manifest-passes-strict-validation-at-contract-15",
              "each-verb-declares-its-presentation"
            ]
          }
        },
        {
          "id": "dev-is-the-sole-declarer",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "each-verb-declares-its-default-traits"
            ]
          }
        },
        {
          "id": "language-extensions-depend",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "each-language-extension-names-the-dev-extension"
            ]
          }
        },
        {
          "id": "handshake-only-runtime",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-runtime-answers-the-handshake",
              "every-other-invocation-is-refused",
              "a-handshake-it-cannot-write-fails"
            ]
          }
        }
      ],
      "surface": {
        "commands": [
          "build",
          "deploy",
          "format",
          "generate",
          "lint",
          "package",
          "publish",
          "run",
          "serve",
          "test",
          "validate"
        ]
      }
    },
    {
      "id": "tooling/version-commands",
      "type": "feature",
      "name": "Version commands",
      "outcome": "A user reads the version every version line is at with putnami version get, and releases one line with putnami version tag, which writes its changelog, its release commit and its tag, from the versions the core computes",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "get-prints-every-line",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "get-prints-each-line-the-host-answers",
              "get-prints-one-envelope-under-structured-output"
            ]
          }
        },
        {
          "id": "recorded-graph-reads-only",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "get-answers-from-a-recorded-graph-and-says-so",
              "tag-refuses-a-recorded-graph"
            ]
          }
        },
        {
          "id": "release-commit-then-tag",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "changelog-is-in-the-tagged-commit",
              "push-sends-the-commit-and-the-tag",
              "the-changelog-matches-the-golden"
            ]
          }
        },
        {
          "id": "release-is-reviewable-first",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "dry-run-prints-the-proposal-and-the-changelog",
              "without-yes-nothing-is-written",
              "an-explicit-tag-replaces-the-proposal"
            ]
          }
        },
        {
          "id": "release-refusals",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "several-lines-need-a-scope",
              "tagged-head-is-refused",
              "dirty-tree-is-refused",
              "existing-tag-is-refused",
              "a-run-bound-to-another-commit-is-refused",
              "an-off-pattern-tag-is-refused",
              "a-line-without-a-proposed-release-is-refused",
              "structured-output-is-refused"
            ]
          }
        },
        {
          "id": "usage-and-host-errors",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "usage-errors-exit-2",
              "host-refusals-keep-their-exit-codes",
              "no-channel-names-the-interactive-launch"
            ]
          }
        },
        {
          "id": "version-group-runs-the-executable",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-manifest-declares-the-version-group",
              "the-executable-dispatches-the-version-commands"
            ]
          }
        }
      ],
      "surface": {
        "commands": [
          "version get",
          "version tag"
        ]
      }
    },
    {
      "id": "tooling/workload-qualification",
      "type": "feature",
      "name": "Workload qualification",
      "outcome": "A user or agent runs a changed workload the way it is shipped, with the workloads and databases it needs, from one command, and proves with one derived smoke contract and one fail-closed verdict that it boots and serves real requests on the tree or deployed build it names",
      "owner": "tooling",
      "target": "modeled",
      "requirements": [
        {
          "id": "runs-with-closure-served-behind-stable-proxies",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-closure-is-transitive-runs-with-in-topological-order",
              "a-provider-reported-runs-with-composes-its-provider",
              "an-unserveable-member-is-refused-before-anything-starts",
              "the-proxy-answers-unavailable-until-the-backend-is-known",
              "dependants-reach-a-provider-through-its-injected-proxy-url"
            ]
          }
        },
        {
          "id": "ephemeral-databases-per-composition",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "each-datasource-gets-a-database-created-and-dropped-with-the-composition",
              "a-provided-server-is-shared-and-reported-as-isolation-none"
            ]
          }
        },
        {
          "id": "typed-readiness-bounds-every-member",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-member-starts-only-after-the-one-before-it-announced-readiness",
              "a-member-that-never-announces-readiness-fails-naming-member-and-phase",
              "a-claim-without-an-endpoint-keeps-the-backend"
            ]
          }
        },
        {
          "id": "ungraceful-death-is-reaped-by-the-next-invocation",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "an-orphan-is-reaped-only-when-its-lock-is-free-and-its-owner-dead",
              "a-killed-composition-leaves-a-lease-the-next-invocation-reaps"
            ]
          }
        },
        {
          "id": "injected-configuration-never-reaches-output",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-document-carries-urls-and-bindings-and-the-status-carries-section-names-only"
            ]
          }
        },
        {
          "id": "smoke-is-derived-from-the-route-inventory",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "exact-public-read-only-routes-sorted-and-capped",
              "platform-and-reserved-paths-are-never-requested",
              "the-platform-prefix-is-read-from-the-inventory"
            ]
          }
        },
        {
          "id": "no-derivable-request-is-unsupported-not-success",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-missing-inventory-is-unsupported-with-a-build-remedy",
              "an-empty-contract-never-passes"
            ]
          }
        },
        {
          "id": "remote-verdict-binds-to-the-deployed-sha",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-matching-sha-passes",
              "a-wrong-or-missing-sha-is-digest-mismatch",
              "a-url-target-without-expect-sha-is-a-usage-error"
            ]
          }
        },
        {
          "id": "local-verdict-binds-to-the-exact-worktree",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-local-verdict-names-the-worktree-it-composed-and-a-clean-teardown",
              "a-worktree-that-changes-before-the-workload-is-ready-is-digest-mismatch",
              "a-composition-failure-names-the-member-and-still-tears-down",
              "canceling-a-local-run-tears-the-composition-down",
              "expect-sha-with-a-local-target-is-a-usage-error"
            ]
          }
        },
        {
          "id": "local-target-reads-the-local-config",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-local-target-reads-the-local-config-of-its-production-build"
            ]
          }
        },
        {
          "id": "local-readiness-is-completed-startup",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-member-records-completed-startup-from-a-workload-claim-alone",
              "a-member-that-exits-before-completed-startup-fails-the-wait",
              "a-local-target-without-a-readiness-route-passes-on-completed-startup",
              "completed-startup-that-never-arrives-times-out-without-smoke",
              "a-declared-readiness-route-is-polled"
            ]
          }
        },
        {
          "id": "every-non-pass-state-exits-non-zero",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "passed-exits-zero-and-every-other-state-exits-one",
              "the-verdict-rides-the-failure-envelope",
              "a-server-error-fails-the-smoke"
            ]
          }
        },
        {
          "id": "each-member-is-an-ordinary-serve-run",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-member-starts-as-a-serve-run-of-the-cli-with-its-environment-on-stdin",
              "the-lease-records-the-serve-run-and-each-serve-step-with-its-leader-start",
              "members-stop-in-reverse-start-order",
              "a-failed-preparation-is-prepare-failed-with-the-output-tail",
              "the-ready-timeout-counts-from-the-serve-step-start",
              "a-watched-target-follows-its-serve-step-across-restarts",
              "a-killed-composition-leaves-both-groups-of-each-member-to-the-reap",
              "the-environment-document-reaches-no-session-file",
              "the-start-exit-and-verdict-documents-keep-their-bytes",
              "each-serve-run-takes-the-invocations-output-flags",
              "a-caller-without-serve-logs-sees-only-a-failed-preparation",
              "qualify-shows-the-serve-logs-only-in-a-verbose-human-run",
              "qualify-reports-a-failed-preparation-on-stderr"
            ]
          }
        },
        {
          "id": "the-dev-extension-runs-compose-and-qualify",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-manifest-declares-the-compose-and-qualify-groups",
              "the-executable-dispatches-the-compose-and-qualify-commands",
              "the-executable-reads-the-output-flags-from-the-job-context"
            ]
          }
        }
      ],
      "surface": {
        "commands": [
          "compose up",
          "qualify run"
        ]
      }
    }
  ]
}
