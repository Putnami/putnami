{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/windows-vet",
  "tags": [
    "go"
  ],
  "extensions": [
    "/go/extension"
  ],
  "disable": {
    "jobs": [
      "serve"
    ]
  },
  "options": {
    "lint": {
      "fix": false
    },
    "test": {
      "coverage": false,
      "coverage-threshold": 0,
      "filePatterns": [
        "git:../../**/*.go",
        "git:../../**/*.s",
        "git:../../**/go.mod",
        "git:../../**/go.sum",
        "../../go.work"
      ]
    }
  },
  "featureAuthority": {
    "owner": "cli/windows-consumers"
  }
}
