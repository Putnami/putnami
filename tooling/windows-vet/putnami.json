{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/windows-vet",
  "tags": [
    "go"
  ],
  "extensions": [
    "/go/extension"
  ],
  "disable": {
    "jobs": [
      "serve"
    ]
  },
  "options": {
    "lint": {
      "fix": false
    },
    "test": {
      "coverage": false,
      "coverage-threshold": 0,
      "filePatterns": [
        "../../.github/workflows/whole-tree-gates.yml"
      ],
      "envInputs": [
        "PUTNAMI_WHOLE_TREE_GATES"
      ]
    }
  },
  "featureAuthority": {
    "owner": "cli/windows-consumers"
  }
}
