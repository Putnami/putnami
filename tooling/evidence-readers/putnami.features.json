{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "evidence-readers",
  "features": [
    {
      "id": "evidence-readers/report-readers",
      "type": "feature",
      "name": "Test and coverage report readers",
      "outcome": "A tool that observes a CI it does not run reads the JUnit, LCOV, Cobertura, Clover, JaCoCo and Go cover reports and the CycloneDX and SPDX documents that CI already wrote into typed test cases, line-level file coverage and packages with their licences and known vulnerabilities, and a report it cannot read becomes a diagnostic, never a crash.",
      "owner": "tooling",
      "target": "coded",
      "requirements": [
        {
          "id": "junit-reads-every-case",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "real-junit-reports-read-to-their-expected-cases",
              "the-file-attribute-is-kept",
              "an-error-element-fails-the-case"
            ]
          }
        },
        {
          "id": "coverage-reads-every-instrumented-line",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "real-coverage-reports-read-to-their-expected-lines",
              "a-repeated-line-keeps-its-largest-count",
              "stated-totals-stand-when-the-report-lists-none"
            ]
          }
        },
        {
          "id": "go-cover-blocks-become-lines",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-line-takes-the-largest-count-of-its-blocks",
              "a-repeated-block-sums-its-counts",
              "concatenated-profiles-read-as-one"
            ]
          }
        },
        {
          "id": "jacoco-reads-source-files",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "real-jacoco-reports-read-to-their-expected-lines",
              "jacoco-groups-and-the-default-package-are-read"
            ]
          }
        },
        {
          "id": "paths-as-the-report-states",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "paths-are-kept-as-stated"
            ]
          }
        },
        {
          "id": "malformed-reports-are-diagnostics",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "every-malformed-fixture-returns-its-code",
              "arbitrary-bytes-never-panic"
            ]
          }
        },
        {
          "id": "cyclonedx-reads-components",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-real-cyclonedx-document-reads-to-its-expected-packages",
              "a-vulnerability-goes-to-the-components-it-affects",
              "an-unsupported-sbom-is-malformed"
            ]
          }
        },
        {
          "id": "spdx-reads-packages",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-real-spdx-document-reads-to-its-expected-packages"
            ]
          }
        }
      ]
    }
  ]
}
