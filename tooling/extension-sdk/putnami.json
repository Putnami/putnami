{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "putnami-extension-sdk",
  "visibility": "public",
  "tags": [
    "go"
  ],
  "extensions": [
    "/go/extension",
    "/tooling/sdd-extension"
  ],
  "publish": ["go"],
  "disable": {
    "jobs": [
      "serve"
    ]
  },
  "options": {
    "test": {
      "filePatterns": ["registrycred/testdata/recorded/**", "recorded/testdata/**"]
    },
    "publish": {
      "archives": false
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
