{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/cli-document-set",
  "tags": [
    "go"
  ],
  "extensions": [
    "/go/extension"
  ],
  "disable": {
    "jobs": [
      "serve"
    ]
  },
  "options": {
    "lint": {
      "fix": false
    },
    "test": {
      "coverage": false,
      "coverage-threshold": 0,
      "filePatterns": [
        "git:../../**/putnami.json",
        "git:../../**/schema/config.json",
        "../../CONTRIBUTING.md",
        "../../putnami.ci.json",
        "../../putnami.workspace.json"
      ]
    }
  },
  "featureAuthority": {
    "none": "A test surface over the repository's contributor recipe, CI document and manifests, run against the CLI; it ships nothing a user runs."
  }
}
