import SwiftUI

@main
struct ShopApp: App {
    var body: some Scene {
        WindowGroup { Text("Shop") }
    }
}
-- App/Shop/Checkout.swift --
import Pricing

struct Checkout {
    let calculator: PriceCalculator

    func total(of amounts: [Decimal]) -> Decimal {
        calculator.total(amounts, taxRate: 0.2)
    }
}
-- App/ShopTests/CheckoutTests.swift --
import Networking
import Pricing
import XCTest
@testable import Shop

final class CheckoutTests: XCTestCase {
    let checkout = Checkout(calculator: PriceCalculator(client: Client(baseURL: URL(string: "https://shop.example.com")!)))

    func testTotalAddsTax() {
        XCTAssertEqual(checkout.total(of: [10, 20]), 36)
    }

    func testEmptyCartIsFree() {
        XCTAssertEqual(checkout.total(of: []), 0)
    }
}
