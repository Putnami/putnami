<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\library\Putnami.Example.Library.csproj" />
  </ItemGroup>

  <!-- Putnami's files are no content of the application: the Web SDK would copy them into its output. -->
  <ItemGroup>
    <Content Remove="putnami.json;global.json;schema/**" />
  </ItemGroup>

</Project>
