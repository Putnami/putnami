            ]
          }
        },
        {
          "id": "a-moved-task-does-what-its-script-did",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "an-imported-task-does-what-its-script-did"
            ]
          }
        },
        {
          "id": "a-moved-lint-only-checks",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-moved-lint-with-no-write-flag-only-checks"
            ]
          }
        },
        {
          "id": "an-import-declares-only-what-moves",
