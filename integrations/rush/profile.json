{
  "id": "rush",
  "delegated": true,
  "markers": ["package.json"],
  "toolchain": {
    "command": ["rush", "--help"],
    "pattern": "Rush Multi-Project Build Tool (?<version>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?)",
    "files": [
      { "path": "rush.json", "pattern": "\"rushVersion\"\\s*:\\s*\"(?<version>[^\"]+)\"" }
    ]
  },
  "inputs": {
    "sources": ["**"]
  },
  "excludes": ["node_modules", "lib", "dist", "temp"],
  "tasks": {
    "lint": {
      "steps": [
        ["rush", "lint", "--only", "{component}"]
      ],
      "inputs": ["sources"],
      "dir": "root"
    },
    "test": {
      "steps": [
        ["rush", "test", "--only", "{component}"]
      ],
      "inputs": ["sources"],
      "dir": "root"
    },
    "build": {
      "steps": [
        ["rush", "build", "--to", "{component}"]
      ],
      "inputs": ["sources"],
      "dir": "root"
    }
  }
}
