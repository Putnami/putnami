{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "monorepo",
  "features": [
    {
      "id": "monorepo/moon-adoption",
      "type": "feature",
      "name": "Adopt a moon repository by import or by delegation",
      "outcome": "A team with a moon repository reaches Putnami's runner and verdict in the mode it picks: its moon projects become Putnami projects with their edges, and each task runs either the Putnami extension of the project's language, when it runs the task's own tool, or moon itself, which then keeps its own cache",
      "owner": "tooling",
      "target": "coded",
      "requirements": [
        {
          "id": "projects-and-tasks-are-read",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-moon-projects-and-their-inherited-tasks-are-read"
            ]
          }
        },
        {
          "id": "inferred-tasks-are-read",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-sync-reads-the-tasks-moon-infers",
              "without-moon-the-sync-says-it-cannot-read-the-inferred-tasks",
              "a-failing-moon-project-graph-fails-the-sync"
            ]
          }
        },
        {
          "id": "sync-writes-each-project",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-sync-writes-each-moon-project-putnami-json"
            ]
          }
        },
        {
          "id": "the-root-project-is-named",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-sync-names-the-root-project-it-does-not-adopt"
            ]
          }
        },
        {
          "id": "import-maps-to-language-extensions",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "import-mode-maps-a-project-to-its-language-extension"
            ]
          }
        },
        {
          "id": "import-keeps-the-tool-that-checks-the-code",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-task-that-runs-another-tool-keeps-running-through-moon"
            ]
          }
        },
        {
          "id": "import-adopts-typescript-conventions",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "an-import-adds-source-exports-and-a-tsconfig"
            ]
          }
        },
        {
          "id": "tasks-delegate-to-moon",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-task-runs-moon-on-its-project-and-records-the-delegation"
            ]
          }
        },
        {
          "id": "reports-from-options",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-test-task-reads-the-reports-the-project-options-name"
            ]
          }
        },
        {
          "id": "validate-fails-on-a-stale-graph",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-stale-moon-graph-fails-validate"
            ]
          }
        },
        {
          "id": "manifest-follows-the-profile",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-moon-manifest-conforms-to-the-stack-core"
            ]
          }
        }
      ]
    }
  ]
}
