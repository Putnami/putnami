{
  "id": "pants",
  "cpuEnv": ["PANTS_PROCESS_EXECUTION_LOCAL_PARALLELISM", "PANTS_RULE_THREADS_CORE"],
  "cpuConfig": [{"file": "{root}/pants.toml", "pattern": "(?m)^\\s*(process_execution_local_parallelism|rule_threads_core)\\s*="}],
  "delegated": true,
  "markers": ["BUILD", "BUILD.pants"],
  "toolchain": {
    "command": ["pants", "--version"],
    "pattern": "(?m)^(?<version>[0-9]+\\.[0-9]+\\.[0-9]+\\S*)\\s*$",
    "files": [
      { "path": "pants.toml", "key": "GLOBAL.pants_version" }
    ]
  },
  "inputs": {
    "sources": ["**"]
  },
  "tasks": {
    "lint": {
      "steps": [
        ["pants", "lint", "{component}:"]
      ],
      "batch": {
        "steps": [
          ["pants", "lint", "{component}:"]
        ]
      },
      "inputs": ["sources"],
      "dir": "root"
    },
    "test": {
      "steps": [
        ["pants", "--test-report", "--test-use-coverage", "--coverage-py-report=[\"xml\"]", "test", "{component}:"]
      ],
      "batch": {
        "steps": [
          ["pants", "--test-report", "--test-use-coverage", "--coverage-py-report=[\"xml\"]", "--test-show-rerun-command", "test", "{component}:"]
        ]
      },
      "inputs": ["sources"],
      "dir": "root",
      "reports": {
        "junit": ["{root}/dist/test/reports/*.xml"],
        "coverage": [{ "format": "cobertura", "paths": ["{root}/dist/coverage/python/coverage.xml"] }]
      }
    },
    "build": {
      "steps": [
        ["pants", "package", "{component}:"]
      ],
      "batch": {
        "steps": [
          ["pants", "package", "{component}:"]
        ]
      },
      "inputs": ["sources"],
      "dir": "root"
    }
  }
}
