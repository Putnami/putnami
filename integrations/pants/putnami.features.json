{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "monorepo",
  "features": [
    {
      "id": "monorepo/pants-delegated-stack",
      "type": "feature",
      "name": "Run the packages of a Pants repository through Pants",
      "outcome": "A team with a Pants repository reaches Putnami's runner and verdict without leaving Pants: each BUILD package is a Putnami project with its edges, each task runs pants on that package and reads its reports, and Pants keeps its own cache and remote execution",
      "owner": "tooling",
      "target": "coded",
      "requirements": [
        {
          "id": "packages-become-projects",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["the-packages-of-a-pants-repository-become-projects-with-their-edges"]
          }
        },
        {
          "id": "sync-writes-the-package-graph",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["the-sync-writes-each-package-putnami-json-from-the-export"]
          }
        },
        {
          "id": "validate-fails-on-a-stale-graph",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["a-stale-package-graph-fails-validate"]
          }
        },
        {
          "id": "tasks-delegate-to-pants",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["a-task-runs-pants-on-its-package-and-records-the-delegation"]
          }
        },
        {
          "id": "reports-become-the-summary",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["the-pants-junit-and-coverage-become-the-test-and-coverage-summary"]
          }
        },
        {
          "id": "manifest-follows-the-profile",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["the-manifest-conforms-to-the-stack-core"]
          }
        }
      ]
    }
  ]
}
