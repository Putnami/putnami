{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "go",
  "features": [
    {
      "id": "go/library-template",
      "type": "feature",
      "name": "Go library template",
      "outcome": "A project created from the go-library template is the smallest Go library that works: an exported function and a test beside it pass go vet, go build, go test and the linters putnami lint runs as created",
      "owner": "go",
      "target": "modeled",
      "relations": [
        {
          "kind": "parent",
          "target": "tooling/project-scaffolding"
        }
      ],
      "requirements": [
        {
          "id": "a-rendered-project-builds",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "go-vet-and-go-build-pass"
            ]
          }
        },
        {
          "id": "a-rendered-project-passes-its-tests",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "go-test-passes"
            ]
          }
        },
        {
          "id": "a-rendered-project-passes-lint",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-linters-putnami-lint-runs-report-nothing"
            ]
          }
        }
      ]
    }
  ]
}
