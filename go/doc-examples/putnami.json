{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "go.putnami.dev/doc-examples",
  "tags": [
    "go"
  ],
  "featureAuthority": {
    "owner": "putnami-dev/public-documentation"
  },
  "extensions": [
    "/go/extension"
  ],
  "disable": {
    "jobs": [
      "serve"
    ]
  },
  "options": {
    "test": {
      "coverage-threshold": 60,
      "filePatterns": [
        "examples.json",
        "../../go.work",
        "../../go.work.sum",
        "../doc/**",
        "../extension/AI.md",
        "../extension/README.md",
        "../extension/doc/**",
        "!../extension/doc/adr/**",
        "../../sites/putnami.dev/doc/**",
        "!../../sites/putnami.dev/doc/adr/**",
        "../../tooling/doc/**",
        "../../tooling/sdd-extension/doc/**",
        "!../../tooling/sdd-extension/doc/adr/**",
        "../../tooling/observe/doc/**",
        "!../../tooling/observe/doc/adr/**",
        "../framework/**/AI.md",
        "../framework/**/README.md",
        "../framework/**/doc/**",
        "!../framework/**/adr/**",
        "../framework/**/*.go",
        "../framework/**/go.mod",
        "../framework/**/go.sum",
        "!../framework/**/*_test.go",
        "!../framework/**/testdata/**",
        "../../protocols/**/*.go",
        "../../protocols/**/go.mod",
        "../../protocols/**/go.sum",
        "!../../protocols/**/*_test.go",
        "!../../protocols/**/testdata/**",
        "../../protocols/events/fixtures/managed-publish/v1/**",
        "../../protocols/features/gherkin/locales/*.json",
        "../../protocols/features/unicode/ascii-fold.json",
        "../../protocols/transaction/conformance/manifest.json",
        "../../cloud/runtime/go/**/*.go",
        "../../cloud/runtime/go/**/go.mod",
        "../../cloud/runtime/go/**/go.sum",
        "!../../cloud/runtime/go/**/*_test.go",
        "!../../cloud/runtime/go/**/testdata/**",
        "../../tooling/extension-sdk/**/*.go",
        "../../tooling/extension-sdk/**/go.mod",
        "../../tooling/extension-sdk/**/go.sum",
        "../../tooling/extension-sdk/doc/**",
        "!../../tooling/extension-sdk/**/*_test.go",
        "!../../tooling/extension-sdk/**/testdata/**",
        "!../../tooling/extension-sdk/doc/adr/**"
      ]
    }
  }
}
