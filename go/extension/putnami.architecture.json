        {
          "kind": "project-dependency",
          "consumerProject": "/tooling/clientgen-extension",
          "producerProject": "/go/framework/http"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/tooling/clientgen-extension",
          "producerProject": "/go/framework/inject"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/tooling/clientgen-extension",
          "producerProject": "/go/framework/logger"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/tooling/clientgen-extension",
          "producerProject": "/go/framework/migration"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/tooling/clientgen-extension",
          "producerProject": "/go/framework/schema"
        }
      ],
      "justification": "The workspace client extension packages the Go framework's own generator command and invokes that pinned emitter; it does not maintain a second Go emitter or resolve source from the consumer checkout."
    },
