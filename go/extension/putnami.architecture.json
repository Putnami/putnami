{
  "$schema": "https://putnami.dev/schemas/putnami-architecture.json",
  "protocolVersion": 1,
  "domain": "extension-providers",
  "owner": "extension-providers",
  "projects": [
    "/go/extension",
    "/python/extension",
    "/tooling/clientgen-extension",
    "/tooling/github-collaboration",
    "/tooling/local-collaboration",
    "/tooling/memory-store",
    "/tooling/scaffold",
    "/typescript/extension"
  ],
  "owns": [
    {
      "id": "extension-providers.probe-answers",
      "kind": "fact",
      "description": "Workspace probe answers: each provider's authoritative statement of the projects it owns and their dependency edges."
    },
    {
      "id": "extension-providers.python-surface-documentation",
      "kind": "fact",
      "description": "The authored Python surface documentation tree under /python/doc/framework. The Python surface is the extension and its templates only, and this domain decides what that reference claims about it; no Putnami Python framework package family ships today."
    },
    {
      "id": "extension-providers.verification-observations",
      "kind": "fact",
      "description": "Per-session feature-verification observation reports emitted by the language test jobs; the executable-spec gate consumes them, it never fabricates one."
    }
  ],
  "exports": [
    {
      "id": "extension-providers.probe-answers.v1",
      "version": 1,
      "status": "active",
      "description": "Merged probe answers: project identity and dependency edges. The recorded workspace index is a local projection of this authority; the providers remain the only source of truth.",
      "facts": [
        {
          "name": "dependency_edges",
          "authority": "extension-providers",
          "classification": "internal",
          "personalData": "none"
        },
        {
          "name": "project_identity",
          "authority": "extension-providers",
          "classification": "internal",
          "personalData": "none"
        }
      ],
      "modes": [
        "projection"
      ],
      "compatibility": {
        "strategy": "additive",
        "minimumConsumerVersion": 1
      }
    },
    {
      "id": "extension-providers.python-surface-documentation.v1",
      "version": 1,
      "status": "active",
      "description": "The authored Python surface documentation tree (/python/doc/framework): the markdown a publisher copies verbatim, addressed by a deterministic digest over its sorted (relative path, content digest) pairs. The carrier contract is putnami.documentation-tree.v1. The Python surface is experimental and opt-in, and publishing this tree next to the Go and TypeScript references does not promote it.",
      "facts": [
        {
          "name": "python_surface_documentation",
          "authority": "extension-providers",
          "classification": "public",
          "personalData": "none"
        }
      ],
      "modes": [
        "snapshot"
      ],
      "compatibility": {
        "strategy": "additive",
        "minimumConsumerVersion": 1
      }
    },
    {
      "id": "extension-providers.verification-observations.v1",
      "version": 1,
      "status": "active",
      "description": "The putnami-feature-verification artifacts a test run produces: which spec requirements each project's tests proved, with provenance bound to the emitting project.",
      "facts": [
        {
          "name": "feature_verification_observations",
          "authority": "extension-providers",
          "classification": "internal",
          "personalData": "none"
        }
      ],
      "modes": [
        "snapshot"
      ],
      "compatibility": {
        "strategy": "additive",
        "minimumConsumerVersion": 1
      }
    }
  ],
  "imports": [
    {
      "id": "extension-providers.extension-runtime.v1",
      "version": 1,
      "from": {
        "domain": "extension-sdk",
        "export": "extension-sdk.extension-runtime.v1"
      },
      "as": "extension-providers.extension-runtime",
      "mode": "reference",
      "status": "active",
      "facts": [
        "extension_runtime_api"
      ],
      "bindings": [
        {
          "kind": "project-dependency",
          "consumerProject": "/go/extension",
          "producerProject": "/tooling/extension-sdk"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/python/extension",
          "producerProject": "/tooling/extension-sdk"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/tooling/clientgen-extension",
          "producerProject": "/tooling/extension-sdk"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/tooling/local-collaboration",
          "producerProject": "/tooling/extension-sdk"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/tooling/memory-store",
          "producerProject": "/tooling/extension-sdk"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/tooling/scaffold",
          "producerProject": "/tooling/extension-sdk"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/extension",
          "producerProject": "/tooling/extension-sdk"
        }
      ],
      "justification": "Every provider in this domain is an extension binary: it parses its job context, emits phases, progress, diagnostics and artifacts, and serves its workspace probe through the SDK runtime rather than writing the JSONL wire itself. One shared runtime is what keeps three language providers and the template packager answering the orchestrator identically. The collaboration and memory stores take their cross-process file lock from the same SDK, so every Putnami binary locks one way on every platform."
    },
    {
      "id": "extension-providers.go-client-emitter.v1",
      "version": 1,
      "from": {
        "domain": "go-framework",
        "export": "go-framework.application-runtime.v1"
      },
      "as": "extension-providers.go-client-emitter",
      "mode": "reference",
      "status": "active",
      "facts": [
        "go_application_runtime_api"
