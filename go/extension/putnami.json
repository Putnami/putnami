{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/go",
  "tags": [
    "go",
    "extension"
  ],
  "extensions": [
    "/go/extension",
    "/tooling/sdd-extension"
  ],
  "publish": [
    "archives"
  ],
  "options": {
    "@putnami/go": {
      "entrypoint": "./cmd/putnami-go",
      "buildvcs": false
    },
    "package": {
      "archives": true
    },
    "publish": {
      "archives": true
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    },
    "test": {
      "filePatterns": [
        "../../go.work",
        "git:**/go.mod",
        "git:**/putnami.extension.json",
        "../../tooling/contributor/putnami.json",
        "../../tooling/contributor/src/**",
        "../../typescript/framework/web/putnami.json",
        "../../cloud/extension/putnami.json",
        "../../cloud/extension/agent-src/**",
        "../../typescript/framework/web/agent-src/**",
        "../../typescript/extension/internal/pkg/manifest_contract.go",
        "git:../../typescript/extension/bin/**",
        "git:../../python/extension/bin/**",
        "git:README.md",
        "git:AI.md",
        "git:doc/**",
        "git:specs/**",
        "git:../../typescript/extension/README.md",
        "git:../../typescript/extension/AI.md",
        "git:../../typescript/extension/doc/**",
        "git:../../typescript/extension/specs/**",
        "git:../../protocols/transaction/**",
        "../../protocols/infra/fixtures/equivalence/secrets.golden.json",
        "internal/jobs/publish/testdata/recorded/**"
      ]
    }
  }
}
