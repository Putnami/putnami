{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "go.putnami.dev/api",
  "visibility": "public",
  "tags": [
    "go"
  ],
  "extensions": [
    "/go/extension",
    "/tooling/sdd-extension"
  ],
  "dependencies": [
    "/go/framework/app",
    "/go/framework/errors",
    "/go/framework/http",
    "/go/framework/inject",
    "/go/framework/logger",
    "/go/framework/schema"
  ],
  "publish": [
    "go"
  ],
  "disable": {
    "jobs": [
      "serve"
    ]
  },
  "options": {
    "test": {
      "filePatterns": [
        "../../../protocols/clientcontract/fixtures/**",
        "../client/*.go",
        "../client/go.mod",
        "../client/go.sum"
      ]
    },
    "publish": {
      "archives": false
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
