{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "go.putnami.dev/database",
  "visibility": "public",
  "tags": ["go"],
  "extensions": ["/go/extension", "/tooling/sdd-extension"],
  "dependencies": ["/go/framework/app", "/go/framework/config", "/go/framework/errors", "/go/framework/inject", "/go/framework/logger", "/protocols/infra", "/protocols/migration"],
  "publish": ["go"],
  "disable": {
    "jobs": ["serve"]
  },
  "options": {
    "test": {
      "filePatterns": ["../../../protocols/database/conformance/**"],
      "coverage-threshold": 60
    },
    "publish": {
      "archives": false
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
