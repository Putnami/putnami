  "main": "src/main.ts",
  "dependencies": {
    "@putnami/analytics": "workspace:*",
    "@putnami/application": "workspace:*",
    "@putnami/cloud": "0.0.0-20260929210146-c834161ac",
    "@putnami/database": "workspace:*",
    "@putnami/runtime": "workspace:*",
    "@putnami/ui": "workspace:*",
    "@putnami/utils": "workspace:*",
    "@putnami/web": "workspace:*",
    "marked": "^15.0.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@putnami/spectest": "workspace:*",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "shiki": "^3.21.0"
