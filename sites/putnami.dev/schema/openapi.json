              }
            }
          }
        },
        "description": "Serve a documentation page as raw source Markdown for LLMs and agents.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Docs URL path to fetch as raw Markdown, e.g. /docs/frameworks/typescript/overview."
