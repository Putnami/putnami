{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "putnami.dev",
  "tags": ["web", "ts"],
  "extensions": ["@putnami/typescript", "/tooling/sdd-extension"],
  "dependencies": ["/protocols/sitecontent"],
  "options": {
    "@putnami/web:generate": {
      "i18n": {
        "locales": ["en", "fr"],
        "defaultLocale": "en",
        "siteUrl": "https://putnami.dev",
        "exclude": ["/docs/**"],
        "paths": { "fr": { "/privacy": "/confidentialite" } },
        "suggestion": "locale-suggestion"
      }
    },
    "@putnami/cloud:publish-migration": { "namespace": "putnami" },
    "@putnami/cloud:publish-config": { "namespace": "putnami" },
    "package": {
      "docker": true,
      "deployment": true,
      "port": 8080
    },
    "publish": {
      "docker": true
    },
    "generate": {
      "capabilities": true,
      "assets": [
        {
          "from": "/tooling/cli/scripts/install.sh",
          "to": "public/install.sh"
        },
        {
          "from": "/tooling/cli/scripts/install-commands.txt",
          "to": "public/install-commands.txt"
        },
        {
          "from": "/tooling/cli/scripts/install.ps1",
          "to": "public/install.ps1"
        },
        {
          "from": "/sites/putnami.dev/doc",
          "to": "public/docs"
        },
        {
          "from": "/tooling/doc",
          "to": "public/docs/08-tooling-&-workspace"
        },
        {
          "from": "/tooling/observe/doc",
          "to": "public/docs/08-tooling-&-workspace/08-observe"
        },
        {
          "from": "/tooling/sdd-extension/doc",
          "to": "public/docs/07-spec-driven-development"
        },
        {
          "from": "/typescript/doc/framework",
          "to": "public/docs/09-frameworks/01-typescript"
        },
        {
          "from": "/go/doc/framework",
          "to": "public/docs/09-frameworks/02-go"
        },
        {
          "from": "/python/doc/framework",
          "to": "public/docs/09-frameworks/03-python"
        },
        {
          "from": "/dart/extension/doc/01-dart.md",
          "to": "public/docs/11-languages/dart.md"
        },
        {
          "from": "/dotnet/extension/doc/01-dotnet.md",
          "to": "public/docs/11-languages/dotnet.md"
        },
        {
          "from": "/java/extension/doc/01-java.md",
          "to": "public/docs/11-languages/java.md"
        },
        {
          "from": "/php/extension/doc/01-php.md",
          "to": "public/docs/11-languages/php.md"
        },
        {
          "from": "/ruby/extension/doc/01-ruby.md",
          "to": "public/docs/11-languages/ruby.md"
        },
        {
          "from": "/rust/extension/doc/01-rust.md",
          "to": "public/docs/11-languages/rust.md"
        },
        {
          "from": "/swift/extension/doc/01-swift.md",
          "to": "public/docs/11-languages/swift.md"
        },
        {
          "from": "/integrations/bazel/doc/01-bazel.md",
          "to": "public/docs/12-monorepo-tools/bazel.md"
        },
        {
          "from": "/integrations/moon/doc/01-moon.md",
          "to": "public/docs/12-monorepo-tools/moon.md"
        },
        {
          "from": "/integrations/nx/doc/01-nx.md",
          "to": "public/docs/12-monorepo-tools/nx.md"
        },
        {
          "from": "/integrations/pants/doc/01-pants.md",
          "to": "public/docs/12-monorepo-tools/pants.md"
        },
        {
          "from": "/integrations/rush/doc/01-rush.md",
          "to": "public/docs/12-monorepo-tools/rush.md"
        },
        {
          "from": "/integrations/turbo/doc/01-turbo.md",
          "to": "public/docs/12-monorepo-tools/turbo.md"
        },
        {
          "from": "/LICENSE.md",
          "to": "public/LICENSE.md"
        }
      ]
    },
    "/typescript/extension": {
      "filePatterns": ["doc/**/*", "content.lock.json", "../../putnami.support.json"]
    },
    "@putnami/cloud": {
      "deploy": {
        "enforceHttpRoutes": true,
        "enabled": true
      }
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
