# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
dist
tmp
.cache

# dependencies
node_modules
yarn.lock

# misc
/coverage

# System Files
.DS_Store
Thumbs.db

# python
__pycache__
.pytest_cache
.ruff_cache

# Go test coverage
*.out

# Go sample binaries (built locally, name = package dir)
go/samples/simple-api/simple-api
go/samples/task-api/task-api

# Go site-service binaries (built locally, name = package dir)
sites/telemetry.putnami.dev/telemetry.putnami.dev

# Putnami
.putnami
.gen
.gen.*
.generated
**/public/search/
**/public/schemas/
# Dev-serve copy of lock-pinned site-content bundles (content-bundle plugin);
# the build output lives under .gen/public/docs/.
/sites/putnami.dev/public/docs/

# Local data
.data

# Local agent state and release-operation context, at any depth. None of it is
# tracked or published.
.context/
.claude/worktrees/
.claude/settings.local.json

# Local dotenv files, which Bun loads (.env, .env.local, .env.production, and
# the rest), and the local and prod config overrides. The other conf/.env*.yaml
# files are configuration, not secrets, and stay tracked.
.env
.env.*
!.env*.yaml
.env.local.yaml
.env.prod.yaml

# Putnami samples
*.types.json
samples/bun.lock
**/clients/ts/
# The two service-to-service samples keep their TypeScript client projects
# tracked: the authored package.json, putnami.json and tsconfig.json make each
# one a workspace member. client-generate writes its src tree, which stays
# ignored, as do the install's node_modules and the .gen build stamp.
!/go/samples/service-to-service/clients/ts/
!/go/samples/service-to-service/clients/ts/**
/go/samples/service-to-service/clients/ts/node_modules/
/go/samples/service-to-service/clients/ts/.gen/
/go/samples/service-to-service/clients/ts/src/
!/typescript/samples/10-service-to-service/clients/ts/
!/typescript/samples/10-service-to-service/clients/ts/**
/typescript/samples/10-service-to-service/clients/ts/node_modules/
/typescript/samples/10-service-to-service/clients/ts/.gen/
/typescript/samples/10-service-to-service/clients/ts/src/

# Generated Go clients. client-generate writes client.gen.go from the provider's
# committed contract, and Git holds none
# (tooling/clientgen-extension/doc/adr/0007-a-generated-client-is-built-not-committed.md).
client.gen.go

