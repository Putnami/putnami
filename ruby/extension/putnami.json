{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/ruby",
  "tags": [
    "go",
    "extension"
  ],
  "extensions": [
    "/go/extension",
    "/tooling/sdd-extension"
  ],
  "publish": [
    "archives"
  ],
  "disable": {
    "jobs": [
      "serve"
    ]
  },
  "options": {
    "@putnami/go": {
      "entrypoint": "./cmd/putnami-ruby",
      "version-var": "main.runtimeVersion"
    },
    "package": {
      "archives": true
    },
    "publish": {
      "archives": true
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    },
    "test": {
      "filePatterns": [
        "putnami.extension.json",
        "profile.json"
      ]
    }
  }
}
