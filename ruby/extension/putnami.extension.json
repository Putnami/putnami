{
  "$schema": "https://putnami.dev/schemas/putnami-extension.json",
  "name": "@putnami/ruby",
  "cliContract": 14,
  "extensionDependencies": {
    "@putnami/dev": ""
  },
  "runtime": {
    "executable": "compiled/putnami-ruby",
    "toolchains": {
      "runtimeCompiler": {
        "lock": "go",
        "candidates": [
          {
            "from": "environment",
            "environment": "GOROOT",
            "path": "bin/go"
          },
          {
            "from": "path",
            "path": "go"
          },
          {
            "from": "putnami-home",
            "path": "toolchains/go/go-{version}/go/bin/go"
          }
        ],
        "probe": {
          "args": [
            "env",
            "GOVERSION"
          ],
          "expect": "go{version}",
          "unset": [
            "GOROOT"
          ],
          "environment": {
            "GOTOOLCHAIN": "local"
          }
        },
        "environment": {
          "GOROOT": {
            "from": "ancestor",
            "levels": 2
          },
          "GOTOOLCHAIN": {
            "from": "literal",
            "value": "local"
          }
        },
        "prependPath": true
      },
      "ruby": {
        "lock": "ruby",
        "optional": true,
        "candidates": [
          {
            "from": "path",
            "path": "ruby"
          },
          {
            "from": "provisioned"
          }
        ],
        "probe": {
          "args": [
            "-e",
            "print RUBY_VERSION"
          ],
          "expect": "{version}"
        },
        "environment": {
          "PUTNAMI_RUBY_EXECUTABLE": {
            "from": "executable"
          }
        }
      }
    },
    "resolves": [
      "ruby"
    ],
    "prepare": {
      "command": "{extensionRoot}/bin/prepare",
      "args": [
        "--output",
        "{runtimeOutput}"
      ],
      "inputs": [
        "bin/prepare",
        "cmd/**",
        "go.mod",
        "go.sum",
        "*.go",
        "profile.json"
      ],
      "toolchains": [
        "runtimeCompiler"
      ]
    },
    "inputSelectors": [
      "ruby:lint",
      "ruby:test"
    ]
  },
  "workspace": {
    "markers": [
      "Gemfile",
      "package.yml",
      "*.gemspec"
    ],
    "inputs": [
      "Gemfile",
      "package.yml",
      "*.gemspec",
      ".ruby-version",
      ".tool-versions",
      "Gemfile.lock",
      "spec/**/*.rb",
      "test/**/*.rb"
    ],
    "excludes": [
      "vendor",
      "node_modules",
      "tmp",
      "log",
      "coverage"
    ],
    "language": "ruby",
    "installInputs": [
      "Gemfile.lock"
    ]
  },
  "uses": [
    "oci"
  ],
  "commands": {
    "workspace-fetch": {
      "description": "Download the gems each stack root's Gemfile.lock names into the extension's gem cache, running none of their code.",
      "quiet": true,
      "run": [
        {
          "id": "workspace-fetch",
          "task": "workspace-fetch-exec"
        }
      ]
    },
    "workspace-install": {
      "description": "Install the bundle of each stack root of the workspace.",
      "quiet": true,
      "flags": {
        "force": {
          "type": "boolean",
          "default": false,
          "description": "Install a stack root even when bundle check accepts its bundle"
        }
      },
      "run": [
        {
          "id": "workspace-install",
          "task": "workspace-install-exec"
        }
      ]
    },
    "lint": {
      "description": "Lint the Ruby components with RuboCop.",
      "flags": {
        "docs-links": {
          "type": "boolean",
          "default": true,
          "description": "Check every relative link and anchor in the project's README.md files and doc/ trees; a broken one fails lint."
        }
      },
      "run": [
        {
          "id": "install",
          "task": "install-run"
        },
        {
          "id": "lint",
          "task": "lint-run",
          "dependsOn": [
            "install",
            "^lint"
          ]
        },
        {
          "id": "docs",
          "task": "lint-docs",
          "if": "params.docs-links"
        }
      ]
    },
    "test": {
      "description": "Test the Ruby components with RSpec, or Rails's Minitest runner, and read their JUnit and SimpleCov Cobertura reports.",
      "flags": {
        "test": {
          "type": "string",
          "short": "-t",
          "description": "Test filter to run, passed to RSpec as -e and to rails test as -n"
        }
      },
      "run": [
        {
          "id": "install",
          "task": "install-run"
        },
        {
          "id": "test",
          "heavy": true,
          "task": "test-run",
          "dependsOn": [
            "install",
            "^test"
          ]
        }
      ]
    },
    "serve": {
      "description": "Serve a Ruby application with rails server, or rackup for another Rack application.",
      "traits": {
        "requiresRunnable": true,
        "workload": "serve"
      },
      "flags": {
        "port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the server"
        },
        "args": {
          "type": "string",
          "description": "Arguments passed to the server program"
        }
      },
      "run": [
        {
          "id": "install",
          "task": "install-run"
        },
        {
          "id": "serve",
          "task": "serve-run",
          "dependsOn": [
            "install"
          ]
        }
      ]
    },
    "run": {
      "description": "Run a Ruby application once with bundle exec ruby and forward its exit code.",
      "traits": {
        "requiresRunnable": true,
        "workload": "once"
      },
      "flags": {
        "entrypoint": {
          "type": "string",
          "description": "Entry point to run (defaults to bin/rails)"
        },
        "args": {
          "type": "string",
          "description": "Additional arguments to pass to the entrypoint"
        }
      },
      "run": [
        {
          "id": "install",
          "task": "install-run"
        },
        {
          "id": "run",
          "task": "run-exec",
          "dependsOn": [
            "install"
          ]
        }
      ]
    },
    "package": {
      "description": "Assemble the image of an application for the docker publish channel.",
      "traits": {
        "injectPublishChannels": true
      },
      "flags": {
        "docker": {
          "type": "boolean",
          "default": false,
          "description": "Assemble the image"
        },
        "docker-tag": {
          "type": "string",
          "description": "Override the image tag"
        },
        "docker-base-image": {
          "type": "string",
          "description": "Replace the official Ruby image with a base pinned by digest (image@sha256:...)"
        },
        "docker-load": {
          "type": "boolean",
          "default": false,
          "description": "Also load the assembled image into the local docker daemon"
        },
        "platform": {
          "type": "string",
          "default": "linux/amd64",
          "description": "Target platform of the image"
        },
        "dry-run": {
          "type": "boolean",
          "default": false,
          "description": "Plan the image without assembling it"
        },
        "port": {
          "type": "number",
          "description": "Port the image exposes and sets as PORT, 8080 by default"
        }
      },
      "run": [
        {
          "id": "docker",
          "task": "package-docker",
          "if": "params.docker"
        }
      ]
    },
    "publish": {
      "dependsOn": [
        "package"
      ],
      "traits": {
        "injectPublishChannels": true,
        "sideEffects": "registry"
      },
      "description": "Push the image of an application to its OCI registry. A library reaches its gem registry through gem push.",
      "flags": {
        "docker": {
          "type": "boolean",
          "default": false,
          "description": "Push the image"
        },
        "docker-registry": {
          "type": "string",
          "description": "Registry to push the image to, above registries.oci.publish"
        },
        "dry-run": {
          "type": "boolean",
          "default": false,
          "description": "Push nothing; report what would be published"
        }
      },
      "run": [
        {
          "id": "docker",
          "task": "publish-docker",
          "if": "params.docker"
        }
      ]
    },
    "deps-upgrade": {
      "description": "Update the bundle of each stack root of the workspace.",
      "visibility": "internal",
      "quiet": true,
      "run": [
        {
          "id": "deps-upgrade",
          "task": "deps-upgrade-exec"
        }
      ]
    }
  },
  "tasks": {
    "install-run": {
      "description": "Run bundle check at the component's stack root, then bundle install when the bundle is incomplete; with offline dependencies, bundle install --local, which also reads the gem cache workspace-fetch fills.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "ruby"
      ],
      "args": [
        "install"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "cache": false,
      "declares": {
        "effects": [
          "network",
          "process",
          "toolchain-cache",
          "workspace-files"
        ]
      }
    },
    "lint-run": {
      "description": "Run the Ruby profile's lint step, bundle exec rubocop, on one component in its directory, after the Ruby and Bundler checks. Its inputs are the files the ruby:lint selector answers from the resolved profile, and the stack-root files of the profile.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "ruby"
      ],
      "args": [
        "lint",
        "--report-dir",
        "{outputRoot}"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "inputs": {
        "sources": {
          "from": "project",
          "files": [
            "ruby:lint"
          ]
        },
        "stackRoot": {
          "from": "workspace",
          "files": [
            ".rubocop.yml",
            ".rubocop_todo.yml",
            ".ruby-version",
            ".tool-versions",
            "Gemfile.lock"
          ]
        },
        "extensionVersion": {
          "from": "runtime"
        }
      },
      "outputs": {
        "data": {
          "description": "The task result."
        }
      },
      "cache": {
        "enabled": true
      },
      "declares": {
        "outputs": {
          "reports": {
            "kind": "directory",
            "root": "command-output",
            "path": "lint",
            "optionalEmpty": true,
            "description": "The task's output directory; lint reads no report."
          }
        },
        "effects": [
          "network",
          "toolchain-cache"
        ]
      }
    },
    "test-run": {
      "description": "Run the Ruby profile's test step on one component from its stack root, after the Ruby and Bundler checks: bundle exec rspec on its spec directory, or bundle exec rails test on its test directory for a component with only Minitest files, and nothing for a component with neither; then read the JUnit report and the SimpleCov Cobertura report, counting only the component's own files. A failed case, a step that exits non-zero, or a missing report fails the task.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "ruby"
      ],
      "args": [
        "test",
        "--report-dir",
        "{outputRoot}"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "inputs": {
        "test": {
          "from": "params"
        },
        "t": {
          "from": "params"
        },
        "sources": {
          "from": "project",
          "files": [
            "ruby:test"
          ]
        },
        "stackRoot": {
          "from": "workspace",
          "files": [
            "!spec/examples.txt",
            "!spec/reports/**",
            "!test/reports/**",
            ".rspec",
            ".ruby-version",
            ".simplecov",
            ".tool-versions",
            "Gemfile",
            "Gemfile.lock",
            "app/**",
            "config/**",
            "db/**/*.rb",
            "db/**/*.sql",
            "lib/**",
            "spec/**",
            "test/**"
          ]
        },
        "extensionVersion": {
          "from": "runtime"
        }
      },
      "outputs": {
        "data": {
          "description": "The task result: the test and coverage totals."
        }
      },
      "cache": {
        "enabled": true
      },
      "declares": {
        "outputs": {
          "reports": {
            "kind": "directory",
            "root": "command-output",
            "path": "test",
            "optionalEmpty": true,
            "description": "The reports the task wrote or copied: the JUnit report and a copy of the Cobertura report."
          }
        },
        "effects": [
          "network",
          "toolchain-cache"
        ]
      }
    },
    "lint-docs": {
      "description": "Documentation link check: every relative link and anchor in the project's README.md files and doc/ trees must resolve, with the exact case of the file's name. The task body is the SDK's docslinks.Job, shared with every language extension. A link may name any file of the workspace, so the check reads the workspace's Git candidate cut (the tracked files and the untracked files no ignore rule excludes) and its key is the workspace input `git:**`, which holds that cut: deleting or renaming a link target, or editing a heading an anchor names, moves the key, and an ignored file is neither read nor keyed. The project input names the README.md the check starts from, so the key does not fold the project's ignored build output. Outside a Git work tree the check reads the disk and the task has no key. It needs neither Ruby nor Bundler.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "lint-docs"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 120000,
      "inputs": {
        "readme": {
          "from": "project",
          "files": [
            "README.md"
          ]
        },
        "repository": {
          "from": "workspace",
          "files": [
            "git:**"
          ]
        },
        "docs-links": {
          "from": "params"
        }
      },
      "outputs": {
        "data": {
          "description": "Documentation link result with diagnostics"
        }
      },
      "reads": [
        "sources"
      ],
      "cache": {
        "noOutput": true,
        "enabled": true
      },
      "declares": {}
    },
    "workspace-fetch-exec": {
      "description": "Run bundle cache with no install, a frozen lockfile, a private install path and a private local configuration, which leaves the locked gems in the extension's gem cache and writes nothing in the repository.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "ruby"
      ],
      "args": [
        "workspace-fetch"
      ],
      "cwd": "{workspaceRoot}",
      "cache": false,
      "timeoutMs": 1800000,
      "declares": {
        "effects": [
          "network",
          "process",
          "toolchain-cache"
        ]
      }
    },
    "workspace-install-exec": {
      "description": "Run bundle install at each stack root of the workspace, except the projects disable.tags excludes and the roots whose bundle check passes, unless the force flag is set. With offline dependencies it runs bundle install --local, which also reads the gem cache workspace-fetch fills.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "ruby"
      ],
      "args": [
        "workspace-install"
      ],
      "cwd": "{workspaceRoot}",
      "cache": false,
      "timeoutMs": 1800000,
      "declares": {
        "effects": [
          "network",
          "process",
          "toolchain-cache",
          "workspace-files"
        ]
      }
    },
    "deps-upgrade-exec": {
      "description": "Run bundle update at each stack root of the workspace with the Ruby the toolchain check selects.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "ruby"
      ],
      "args": [
        "deps-upgrade"
      ],
      "cwd": "{workspaceRoot}",
      "cache": false,
      "timeoutMs": 1800000,
      "declares": {
        "effects": [
          "network",
          "process",
          "toolchain-cache",
          "workspace-files"
        ]
      }
    },
    "serve-run": {
      "description": "Run bundle exec rails server, or bundle exec rackup for an application without bin/rails, on 0.0.0.0 and the port flag in the application directory until the user stops it.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "ruby"
      ],
      "args": [
        "serve"
      ],
      "cwd": "{projectRoot}",
      "cache": false,
      "timeoutMs": -1,
      "declares": {
        "effects": [
          "network",
          "process"
        ]
      }
    },
    "run-exec": {
      "description": "Run bundle exec ruby with the entrypoint in the application directory and forward its exit code.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "ruby"
      ],
      "args": [
        "run"
      ],
      "cwd": "{projectRoot}",
      "cache": false,
      "timeoutMs": -1,
      "declares": {
        "effects": [
          "network",
          "process",
          "workspace-files"
        ]
      }
    },
    "package-docker": {
      "description": "Assemble a local OCI image of an application from its production bundle, installed on this Linux host, and its files, on a digest-pinned official Ruby slim base. Sole owner of <command-output>/docker.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "toolchains": [
        "ruby"
      ],
      "args": [
        "package-docker"
      ],
      "inputs": {
        "application": {
          "from": "project",
          "files": [
            "git:**/*",
            "**/*",
            ".*",
            "vendor/**/*",
            "!../**",
            "!.bundle/**",
            "!.gen/**",
            "!.git/**",
            "!.putnami/**",
            "!coverage/**",
            "!log/**",
            "!node_modules/**",
            "!spec/**",
            "!storage/**",
            "!test/**",
            "!tmp/**",
            "!vendor/bundle/**",
            "!config/master.key",
            "!config/credentials/*.key",
            "!**/.env*"
          ]
        },
        "extensionVersion": {
          "from": "runtime"
        }
      },
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "cache": {
        "versionAware": true
      },
      "declares": {
        "outputs": {
          "docker": {
            "kind": "directory",
            "root": "command-output",
            "path": "docker",
            "optionalEmpty": true,
            "description": "Local OCI candidate layout, its manifest and the docker channel record."
          }
        },
        "effects": [
          "network",
          "toolchain-cache"
        ]
      }
    },
    "publish-docker": {
      "description": "Push the packaged image to the container registry through the shared publisher.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "publish-docker"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 300000,
      "cache": false,
      "declares": {
        "outputs": {
          "published-image": {
            "kind": "file",
            "root": "command-output",
            "path": "docker/published-image.json",
            "optionalEmpty": true,
            "description": "Verified remote image record, written after the registry digest is read back."
          }
        },
        "effects": [
          "network",
          "registry"
        ],
        "publishChannels": [
          "docker"
        ]
      }
    }
  }
}
