{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "ruby",
  "features": [
    {
      "id": "ruby/stack-extension",
      "type": "feature",
      "name": "Run the components of a Ruby or Rails repository as Putnami tasks",
      "outcome": "A team with a Ruby or Rails repository adds @putnami/ruby and runs putnami install, lint and test over its packs and local gems with Putnami's runner and cache, without rewriting its build: each component is a project with its edges, lint runs RuboCop and test RSpec or Rails's Minitest runner after a Ruby and Bundler check and a bundle install, with the Ruby the workspace pins when the machine has none that fits, and a component overrides any profile value in its putnami.json",
      "owner": "ruby",
      "target": "coded",
      "requirements": [
        {
          "id": "components-become-projects",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-application-packs-and-gems-become-projects-with-their-edges"
            ]
          }
        },
        {
          "id": "tasks-run-the-profile",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-task-runs-the-profile-steps-after-the-ruby-and-bundler-checks"
            ]
          }
        },
        {
          "id": "test-runner-per-component",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-component-runs-rspec-or-rails-test-by-its-test-files"
            ]
          }
        },
        {
          "id": "reports-become-the-summary",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "junit-and-cobertura-become-the-component-summary"
            ]
          }
        },
        {
          "id": "lint-reads-the-ruby-files",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-test-only-change-keeps-the-lint-inputs"
            ]
          }
        },
        {
          "id": "overrides-are-honored",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-putnami-json-override-changes-the-steps-and-the-inputs"
            ]
          }
        },
        {
          "id": "manifest-follows-the-profile",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-manifest-conforms-to-the-stack-core"
            ]
          }
        },
        {
          "id": "installs-its-bundle",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
