#!/usr/bin/env bash
# putnamiw — Bootstrap wrapper for the Putnami CLI (like Gradle's gradlew).
#
# Ensures Go is available, builds the CLI from source if needed, and delegates.
# No external dependencies beyond bash, curl/wget, and tar.
#
# In a from-source workspace (tooling/cli present) the built CLI is cached in
# $PUTNAMI_HOME/artifacts/cli-source/<key>/, keyed by the CONTENT of the sources
# it was built from, so a second run at the same tree state reuses it and a
# sibling worktree at that state shares the same blob and the same build.
#
# Usage:
#   ./putnamiw build --impacted
#   ./putnamiw test --all
#   ./putnamiw --bootstrap --version   # force a rebuild, ignoring the cached key
#   ./putnamiw --download build --all  # consumer workspaces only: fetch a
#                                      # pre-built binary instead of compiling.
#                                      # Refused where tooling/cli is present.
#   ./putnamiw --print-engine          # build or reuse the from-source CLI, run
#                                      # only `putnami extensions prepare` with
#                                      # it, and print one JSON line:
#                                      # {"path":"…","key":"…","root":"…"}
#
# --print-engine is for a launcher that starts the engine itself. It writes
# nothing under .putnami/bin, takes no command, and accepts --bootstrap. It is
# refused where tooling/cli is absent, and where no content key can be computed
# (no git work tree, or no sha256sum or shasum). With the CLI it built or
# reused, it runs `putnami extensions prepare`, which prepares the runtimes of
# the workspace's path extensions that a hosted run starts as providers. That
# command needs the exact Go release the workspace lock pins, so the mode first
# installs that release under the Putnami home, unless the home holds it
# already, or $GOROOT/bin/go or the go on PATH runs as it. Progress, the output
# of that command and errors go to stderr; on failure it exits non-zero and
# prints nothing on stdout.
#
# A workspace whose lock records cli.source "workspace" admits the printed
# binary when the process that starts it sets:
#   PUTNAMI_FROM_SOURCE=<root>      the "root" field
#   PUTNAMI_FROM_SOURCE_KEY=<key>   the "key" field
#   PUTNAMI_HOME=<home>             the home this wrapper used, so that "path"
#                                   is <home>/artifacts/cli-source/<key>/putnami
# and runs it with its working directory inside <root>. Start "path" itself,
# not a copy of it. A hosted run reads the prepared runtimes from the artifact
# store, PUTNAMI_ARTIFACT_DIR, else $HOME/.putnami/artifacts, whatever
# PUTNAMI_HOME is, so also give it the HOME and PUTNAMI_ARTIFACT_DIR this
# wrapper had. PUTNAMI_NO_RELAUNCH has no effect in such a workspace. In a
# workspace whose lock pins a published CLI version, also set
# PUTNAMI_NO_RELAUNCH=1, as this wrapper does on its own from-source runs, or
# the binary relaunches into the pinned release.

set -euo pipefail

# --- Configuration ---

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# PUTNAMI_HOME is the machine-global root shared across all worktrees and repos
# (~/.putnami): the managed Go toolchain and any downloaded CLI live here once
# per machine, so a fresh worktree reuses them instead of re-downloading. When
# $HOME is unavailable (and no override is set) it degrades to the per-worktree
# .putnami, matching the Go CLI's $HOME-unavailable fallback.
if [ -n "${PUTNAMI_HOME:-}" ]; then
  :
elif [ -n "${HOME:-}" ]; then
  PUTNAMI_HOME="$HOME/.putnami"
else
  PUTNAMI_HOME="$SCRIPT_DIR/.putnami"
fi
export PUTNAMI_HOME

# Go's compiler and module caches are content-addressed/concurrent-safe, so one
# machine-global cache serves every repo and worktree. Export the Putnami-owned
# root before bootstrap compilation so building the CLI and running extension
# jobs warm the same cache. CI only needs to persist this one directory.
if [ -z "${PUTNAMI_GO_CACHE_DIR:-}" ]; then
  PUTNAMI_GO_CACHE_DIR="$PUTNAMI_HOME/cache/go"
fi
export PUTNAMI_GO_CACHE_DIR
export GOCACHE="$PUTNAMI_GO_CACHE_DIR/build"
export GOMODCACHE="$PUTNAMI_GO_CACHE_DIR/mod"
mkdir -p "$GOCACHE" "$GOMODCACHE"

# Bun already defines a concurrent machine-global package cache and projects
# materialize dependencies from it with clonefiles/hardlinks. Preserve Bun's
# official location (and its own override) while exporting a Putnami-owned name
# so the CLI, extension jobs, GC, and CI all agree on the exact same root.
#
# A machine that holds no Bun of its own (no bun on PATH and no $HOME/.bun) gets
# no default: the Bun that Putnami installs under $PUTNAMI_HOME keeps its cache
# under its own install directory, and nothing is written to $HOME/.bun.
if [ -z "${PUTNAMI_BUN_CACHE_DIR:-}" ]; then
  if [ -n "${BUN_INSTALL_CACHE_DIR:-}" ]; then
    PUTNAMI_BUN_CACHE_DIR="$BUN_INSTALL_CACHE_DIR"
  elif [ -n "${HOME:-}" ]; then
    if command -v bun >/dev/null 2>&1 || [ -d "$HOME/.bun" ]; then
      PUTNAMI_BUN_CACHE_DIR="$HOME/.bun/install/cache"
    fi
  else
    PUTNAMI_BUN_CACHE_DIR="$SCRIPT_DIR/.putnami/extensions/@putnami-typescript/cache"
  fi
fi
if [ -n "${PUTNAMI_BUN_CACHE_DIR:-}" ]; then
  export PUTNAMI_BUN_CACHE_DIR
  export BUN_INSTALL_CACHE_DIR="$PUTNAMI_BUN_CACHE_DIR"
  mkdir -p "$BUN_INSTALL_CACHE_DIR"
fi

CLI_BINARY="$SCRIPT_DIR/.putnami/bin/putnami"
# Provenance marker: present iff $CLI_BINARY is a from-source build (written by
# build_cli, removed by download_cli). The fast path consults it rather than
# inferring provenance from mtime, so a downloaded regular-file binary (the
# no-hashing-tool fallback) is never misread as a source build and wrongly
# suppressed — which would silently drop a workspace CLI pin.
#
# Its CONTENT is the source key that build produced (empty on the keyless mtime
# fallback), so the fast path can answer "is this binary still what these
# sources compile to?" by comparing two strings instead of comparing mtimes.
FROM_SOURCE_MARKER="$SCRIPT_DIR/.putnami/bin/.from-source"
CLI_SOURCE="$SCRIPT_DIR/tooling/cli/cmd/putnami"
GO_WORK="$SCRIPT_DIR/go.work"

# CLI_SOURCE_STORE holds one from-source CLI per source key, shared by every
# worktree on the machine: two worktrees at the same tree state resolve the same
# key, so they share one blob and one build. It lives under artifacts/ so the Go
# artifact GC sweeps it by recency and `cache clean --all` clears it.
CLI_SOURCE_STORE="$PUTNAMI_HOME/artifacts/cli-source"

# SOURCE_KEY_PATHS is the pathspec the from-source build key covers.
#
# It deliberately OVER-approximates: go/framework and go/samples are in it even
# though the CLI may not import them. Over-invalidating costs one warm relink;
# under-invalidating ships a stale engine while claiming it is the commit's own.
# That is the bug this replaces — the previous gate watched only tooling/cli, so
# an edit under protocols/ or tooling/extension-sdk left a stale binary running
# until somebody remembered `--bootstrap`.
SOURCE_KEY_PATHS=(go.work go.work.sum tooling protocols go)

# CLI_LDFLAGS are the exact link flags build_cli passes. They are part of the key
# because the same sources linked differently are different bytes.
CLI_LDFLAGS="-s -w"
# Managed Go toolchains are shared across worktrees: ~/.putnami/toolchains/go/go-<ver>/.
GO_MANAGED_DIR="$PUTNAMI_HOME/toolchains/go"
# GO_CHECKSUM_URL is where go.dev publishes the SHA-256 of each Go archive.
GO_CHECKSUM_URL="https://dl.google.com/go/"
RESOLVER_URL="${PUTNAMI_REGISTRY_URL:-https://putnami.dev/dl}"

# --- Colors ---

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Progress chatter goes to STDERR, never stdout. ./putnamiw is now the only
# supported entrypoint in this repository, which includes serving
# the MCP server over stdio and piping `--output=json` into a parser: a
# "Building putnami CLI..." line on stdout would corrupt the very first cold
# run of either. stdout belongs to the CLI this script exec's into.
info()    { echo -e "${CYAN}>${NC} $1" >&2; }
success() { echo -e "${GREEN}✓${NC} $1" >&2; }
warn()    { echo -e "${YELLOW}!${NC} $1" >&2; }
fail()    { echo -e "${RED}✗${NC} $1" >&2; exit 1; }

# --- Cleanup of staging temp dirs ---
#
# Staging dirs/archives are published by an atomic rename or explicitly removed
# on the success path, but an interrupt (Ctrl-C) or early failure between mktemp
# and that publish would otherwise orphan them — and the toolchain stage is a
# multi-hundred-MB partial Go extraction. Register each here so an EXIT/signal
# trap reclaims it; on the success path the path is already gone, so the rm is a
# harmless no-op. (exec at the end replaces the shell, so the EXIT trap does not
# fire after a successful run — by which point nothing is registered live.)
_CLEANUP_PATHS=()
register_cleanup() { _CLEANUP_PATHS+=("$1"); }
cleanup() {
  local p
  if [ "${#_CLEANUP_PATHS[@]}" -gt 0 ]; then
    for p in "${_CLEANUP_PATHS[@]}"; do
      [ -n "$p" ] && rm -rf "$p" 2>/dev/null
    done
  fi
  return 0
}
trap cleanup EXIT INT TERM

acquire_dir_lock() {
  local lock_dir="$1"
  local waits=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    waits=$((waits + 1))
    if [ "$waits" -ge 300 ]; then
      rm -rf "$lock_dir" 2>/dev/null || true
      waits=0
      continue
    fi
    sleep 0.1
  done
  register_cleanup "$lock_dir"
}

release_dir_lock() {
  local lock_dir="$1"
  rm -rf "$lock_dir" 2>/dev/null || true
}

# touch_recency stamps a store dir's `lastused` sidecar with the current time as
# unix-nanoseconds (second granularity, portable across GNU/BSD `date`) in the
# exact format the Go artifact GC reads, so an in-use blob is kept warm and not
# reaped by the idle sweep (a store dir's mtime never changes on plain reads).
# Best-effort: never fails the script.
touch_recency() {
  local dir="$1"
  # Only ever stamp an ABSOLUTE store path. A relative dir — notably "." , which
  # is what dirname yields for a slash-free relative symlink target (see
  # touch_cli_recency) — would drop `lastused` into the current working
  # directory, i.e. the worktree root, where it dirties `git status` and poisons
  # the version dirty-hash. Refuse anything not rooted at "/".
  case "$dir" in /*) ;; *) return 0 ;; esac
  [ -d "$dir" ] || return 0
  local secs tmp
  secs="$(date +%s 2>/dev/null)" || return 0
  [ -n "$secs" ] || return 0
  tmp="$dir/.lastused.$$"
  printf '%s000000000' "$secs" >"$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }
  mv -f "$tmp" "$dir/lastused" 2>/dev/null || rm -f "$tmp" 2>/dev/null
  return 0
}

# touch_cli_recency stamps recency on the CLI blob that a symlinked $CLI_BINARY
# points at, so an actively-used downloaded CLI is not reaped by the artifact
# GC's idle sweep. Best-effort.
#
# The link target may be ABSOLUTE (download_cli points $CLI_BINARY into
# ~/.putnami/artifacts) or a RELATIVE sibling (`putnami cli use` symlinks
# putnami -> putnami-<ver> in the same dir). For a relative target `dirname`
# alone yields ".", so anchor it at the link's own (absolute) directory — the
# stamp must land in the store dir, never in the current working directory.
touch_cli_recency() {
  local link="$1" target dir
  target="$(readlink "$link" 2>/dev/null || true)"
  [ -n "$target" ] || return 0
  case "$target" in
    /*) dir="$(dirname "$target")" ;;
    *)  dir="$(dirname "$link")/$(dirname "$target")" ;;
  esac
  touch_recency "$dir"
  return 0
}

# resolve_link_target prints the path a symlink names (one hop; a relative target
# is anchored at the link's own directory), or nothing for a non-symlink. The
# staleness gate compares a symlinked CLI against source by the TARGET binary's
# mtime: `find -newer <symlink>` reads the symlink's OWN (lstat) mtime, so a
# freshly created `cli use`/`upgrade` pin pointing at an OLD binary would
# falsely pass the check and keep running stale.
resolve_link_target() {
  local link="$1" target
  [ -L "$link" ] || return 1
  target="$(readlink "$link" 2>/dev/null || true)"
  [ -n "$target" ] || return 1
  case "$target" in
    /*) printf '%s' "$target" ;;
    *)  printf '%s/%s' "$(dirname "$link")" "$target" ;;
  esac
}

# sha256_of prints the lowercase-hex SHA-256 of a file with sha256sum, shasum
# or openssl, or nothing when none is available.
sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "$1" | awk '{print tolower($NF)}'
  fi
}

# Run the resolved CLI binary, preserving its exit code (empty plans must stay
# visible to CI). putnamiw is the authority on the binary it just built or
# selected, so a from-source build runs as-is: SUPPRESS_RELAUNCH=true exports
# PUTNAMI_NO_RELAUNCH to disable the binary's in-process workspace-pin launcher.
# Downloaded binaries are left relaunchable, so a workspace CLI pin is still
# honored for them.
#
# FROM_SOURCE_ROOT additionally names the tree a from-source binary was built
# from. A workspace whose lock records `cli.source: "workspace"` refuses every
# binary that cannot prove that provenance, and this export is the
# proof. It is set on the from-source paths ONLY, and actively UNSET otherwise,
# so an inherited value can never launder a downloaded or pinned binary into
# looking like this tree's own engine.
#
# FROM_SOURCE_KEY carries the source key of the blob this run selected, and is the
# other half of that proof: the workspace's EPHEMERAL ENGINE PIN, scoped to this
# process tree and immutable for its whole lifetime, because the store is
# content-addressed and published first-writer-wins. The CLI pairs it with the
# root and admits itself only when it IS $CLI_SOURCE_STORE/<key>/putnami.
#
# It replaces an identity check against $CLI_BINARY, which could not survive
# concurrency: $CLI_BINARY is a workspace-global symlink that this
# script re-points on every run whose key differs, so a second invocation in the
# same checkout retroactively un-proved a CLI that was still executing, and the
# re-entrant children of that CLI were refused while naming the correct engine.
# Set on the KEYED paths only; the keyless mtime fallback has no store blob to
# name, and there the CLI falls back to the $CLI_BINARY identity check.
run_cli() {
  if [ "${SUPPRESS_RELAUNCH:-false}" = "true" ]; then
    export PUTNAMI_NO_RELAUNCH=1
  fi
  if [ -n "${FROM_SOURCE_ROOT:-}" ]; then
    export PUTNAMI_FROM_SOURCE="$FROM_SOURCE_ROOT"
  else
    unset PUTNAMI_FROM_SOURCE
  fi
  if [ -n "${FROM_SOURCE_KEY:-}" ]; then
    export PUTNAMI_FROM_SOURCE_KEY="$FROM_SOURCE_KEY"
  else
    unset PUTNAMI_FROM_SOURCE_KEY
  fi
  exec "$@"
}

# exec_source_blob runs a keyed from-source CLI through its IMMUTABLE store path
# rather than through $CLI_BINARY. The distinction is the whole reason this exists:
# the process the kernel starts is what os.Executable() reports, it is what the
# CLI advertises to extensions that call back into it, and it is what every
# re-entrant child then presents as its own identity. Exec the symlink and that
# identity is a name whose meaning another run can change mid-flight; exec the
# blob and it is bytes nobody rewrites. $CLI_BINARY stays published for humans
# and for tools that put .putnami/bin on PATH.
exec_source_blob() {
  local key="$1"
  shift
  SUPPRESS_RELAUNCH="true"
  FROM_SOURCE_ROOT="$SCRIPT_DIR"
  FROM_SOURCE_KEY="$key"
  run_cli "$CLI_SOURCE_STORE/$key/putnami" "$@"
}

# link_cli points $CLI_BINARY at a store blob through an ABSOLUTE symlink,
# swapped by staged-link + atomic rename. The running binary's inode is never
# rewritten (the macOS code-sign vnode rule this script documents elsewhere).
link_cli() {
  local target="$1"
  mkdir -p "$(dirname "$CLI_BINARY")"
  rm -f "$CLI_BINARY.lnk.$$"
  ln -s "$target" "$CLI_BINARY.lnk.$$"
  mv -f "$CLI_BINARY.lnk.$$" "$CLI_BINARY"
}

# write_from_source_marker records the source key $CLI_BINARY was built from.
# It is written LAST, after the link is in place, so a crash mid-publish leaves
# a marker naming an older key — which fails the fast-path comparison and costs
# a rebuild, never a stale run. Best-effort: a marker that cannot be written
# just means the next run rebuilds.
write_from_source_marker() {
  local key="$1" tmp="$FROM_SOURCE_MARKER.tmp.$$"
  mkdir -p "$(dirname "$FROM_SOURCE_MARKER")"
  printf '%s\n' "$key" >"$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }
  mv -f "$tmp" "$FROM_SOURCE_MARKER" 2>/dev/null || rm -f "$tmp" 2>/dev/null
  return 0
}

# json_string prints $1 as a JSON string literal. It escapes the backslash and
# the double quote, and refuses a control character rather than encode one, so
# the line it builds is always a single valid JSON line.
json_string() {
  local s="$1"
  case "$s" in
    *[[:cntrl:]]*) return 1 ;;
  esac
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '"%s"' "$s"
}

# prepare_source_runtimes runs `putnami extensions prepare` with the store blob
# of key $1, the way exec_source_blob starts it: in the workspace root, with the
# key that names the blob. The command prepares, into the artifact store, the
# runtime of each path extension whose providers a hosted run of this tree
# starts from this build. Its output goes to stderr, so stdout keeps only the
# engine line.
prepare_source_runtimes() {
  local key="$1"
  (
    cd "$SCRIPT_DIR" &&
      PUTNAMI_NO_RELAUNCH=1 PUTNAMI_FROM_SOURCE="$SCRIPT_DIR" PUTNAMI_FROM_SOURCE_KEY="$key" \
        "$CLI_SOURCE_STORE/$key/putnami" extensions prepare </dev/null >&2
  ) || fail "putnami extensions prepare failed, so the extension runtimes a hosted run starts as providers are not prepared"
}

# print_engine writes the --print-engine result for the store blob of key $1:
# one JSON line on stdout naming the absolute blob path, the source key, and the
# absolute workspace root.
print_engine() {
  local key="$1" dir path key_json path_json root_json
  dir="$(cd "$CLI_SOURCE_STORE/$key" 2>/dev/null && pwd)" ||
    fail "The from-source putnami CLI for key $key is missing from $CLI_SOURCE_STORE"
  path="$dir/putnami"
  [ -x "$path" ] || fail "The from-source putnami CLI at $path is not executable"
  key_json="$(json_string "$key")" || fail "The source key is not printable: $key"
  path_json="$(json_string "$path")" || fail "The engine path contains a control character: $path"
  root_json="$(json_string "$SCRIPT_DIR")" || fail "The workspace root contains a control character: $SCRIPT_DIR"
  printf '{"path":%s,"key":%s,"root":%s}\n' "$path_json" "$key_json" "$root_json"
}

# --- Check for --bootstrap, --download and --print-engine flags ---

BOOTSTRAP="false"
DOWNLOAD="false"
PRINT_ENGINE="false"
SUPPRESS_RELAUNCH="false"
PASSTHROUGH_ARGS=()

for arg in "$@"; do
  if [ "$arg" = "--bootstrap" ]; then
    BOOTSTRAP="true"
  elif [ "$arg" = "--download" ]; then
    DOWNLOAD="true"
  elif [ "$arg" = "--print-engine" ]; then
    PRINT_ENGINE="true"
  else
    PASSTHROUGH_ARGS+=("$arg")
  fi
done

# --- Refuse --print-engine where there is no from-source engine to print ---
#
# --print-engine names the immutable store blob of a from-source build. A
# workspace without tooling/cli has no such build, and --download produces a
# published binary instead, so both are refused before any build or fetch.
if [ "$PRINT_ENGINE" = "true" ]; then
  if [ "$DOWNLOAD" = "true" ]; then
    fail "--print-engine builds the CLI from this tree, so it cannot be combined with --download."
  fi
  if [ ! -d "$SCRIPT_DIR/tooling/cli" ]; then
    fail "--print-engine needs the CLI sources under tooling/cli, and this workspace has none. A workspace without them runs a published CLI: install it, or run ./putnamiw --download <command>."
  fi
  if [ "${#PASSTHROUGH_ARGS[@]}" -gt 0 ]; then
    fail "--print-engine takes no command: got ${PASSTHROUGH_ARGS[*]}. It runs only putnami extensions prepare; run ./putnamiw --print-engine, then start the printed binary yourself."
  fi
fi

# --- Reject --download where the workspace builds its own CLI ---
#
# A workspace that carries the CLI sources builds its own engine, and this one
# declares that in its lock (`cli.source: "workspace"`). A
# downloaded binary is not built from this tree, so the CLI refuses it on the
# very next command. Say so HERE — before the download fast path can hand back an
# already-present binary, and before any fetch — instead of producing something
# that exits 2 on first use.
if [ "$DOWNLOAD" = "true" ] && [ -d "$SCRIPT_DIR/tooling/cli" ]; then
  fail "--download is for consumer workspaces. This one carries the CLI sources, so it builds its own engine: run ./putnamiw ${PASSTHROUGH_ARGS[*]:-<command>} instead (a downloaded binary is not built from this tree and would be refused). To run a published CLI here, pin one with \`putnami pin <version>\`."
fi

# --- Platform detection ---

detect_platform() {
  case "$(uname -s)" in
    Darwin)                    GO_OS="darwin" ;;
    Linux)                     GO_OS="linux" ;;
    MINGW*|MSYS*|CYGWIN*)      GO_OS="windows" ;;
    *) fail "Unsupported OS: $(uname -s)" ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64)   GO_ARCH="amd64" ;;
    aarch64|arm64)  GO_ARCH="arm64" ;;
    *) fail "Unsupported architecture: $(uname -m)" ;;
  esac
}

# --- Go version from go.work ---

# read_go_version prints the higher of the go and toolchain lines of go.work,
# the release the CLI pins in the lock from them.
read_go_version() {
  if [ -f "$GO_WORK" ]; then
    local version toolchain
    version="$(grep -m1 '^go ' "$GO_WORK" | awk '{print $2}')"
    toolchain="$(grep -m1 '^toolchain ' "$GO_WORK" | awk '{print $2}')"
    [ -n "$version" ] && version="$(normalize_go_version "$version")"
    [ -n "$toolchain" ] && toolchain="$(normalize_go_version "$toolchain")"
    if [ -n "$toolchain" ] && { [ -z "$version" ] || go_version_satisfies "$toolchain" "$version"; }; then
      version="$toolchain"
    fi
    if [ -n "$version" ]; then
      echo "$version"
      return 0
    fi
  fi
  return 1
}

# locked_go_sha256 prints the SHA-256 the workspace lock records for the Go
# release $1 on platform $2, such as darwin/arm64, and fails when the lock pins
# another release or records none for the platform. It reads the layout the CLI
# writes: two-space indentation, toolchains.go.{version,integrities}.
locked_go_sha256() {
  local lock="$SCRIPT_DIR/putnami.lock.json"
  [ -f "$lock" ] || return 1
  awk -v want="$1" -v platform="$2" '
    /^  "toolchains": [{]/ { in_toolchains = 1; next }
    in_toolchains && /^  [}]/ { in_toolchains = 0 }
    in_toolchains && /^    "go": [{]/ { in_go = 1; next }
    in_go && /^    [}]/ { in_go = 0 }
    in_go && /^      "version": / { version = $2; gsub(/[",]/, "", version) }
    in_go && index($0, "        \"" platform "\": ") == 1 { digest = $2; gsub(/[",]/, "", digest) }
    END {
      if (version == want && length(digest) == 64 && digest !~ /[^0-9a-f]/) { print digest; exit 0 }
      exit 1
    }
  ' "$lock"
}

# locked_go_version prints the Go release the workspace lock pins,
# toolchains.go.version, and fails when the lock pins none. It reads the layout
# locked_go_sha256 reads.
locked_go_version() {
  local lock="$SCRIPT_DIR/putnami.lock.json"
  [ -f "$lock" ] || return 1
  awk '
    /^  "toolchains": [{]/ { in_toolchains = 1; next }
    in_toolchains && /^  [}]/ { in_toolchains = 0 }
    in_toolchains && /^    "go": [{]/ { in_go = 1; next }
    in_go && /^    [}]/ { in_go = 0 }
    in_go && /^      "version": / { version = $2; gsub(/[",]/, "", version) }
    END {
      if (version ~ /^[0-9]+([.][0-9]+)+$/) { print version; exit 0 }
      exit 1
    }
  ' "$lock"
}

normalize_go_version() {
  local version="$1"
  version="${version#go}"
  if [[ "$version" =~ ^[0-9]+\.[0-9]+$ ]]; then
    version="${version}.0"
  fi
  echo "$version"
}

go_binary_version() {
  local binary="$1"
  local version
  version="$("$binary" env GOVERSION 2>/dev/null | sed 's/^go//')" || true
  if [ -z "$version" ]; then
    version="$("$binary" version 2>/dev/null | awk '{print $3}' | sed 's/^go//')" || true
  fi
  if [ -z "$version" ]; then
    return 1
  fi
  normalize_go_version "$version"
}

# Report the version a Go binary runs as under an explicit GOTOOLCHAIN mode.
# build_cli pins GOTOOLCHAIN=local, so the version that matters is the one under
# "local" (the base binary), not the toolchain it would switch to under "auto".
go_binary_version_mode() {
  local binary="$1"
  local mode="$2"
  local version
  version="$(GOTOOLCHAIN="$mode" "$binary" env GOVERSION 2>/dev/null | sed 's/^go//')" || true
  if [ -z "$version" ]; then
    return 1
  fi
  normalize_go_version "$version"
}

# go_toolchain_identity prints a stable string identifying the Go toolchain this
# script would build with, so switching toolchains does not silently reuse a
# binary another one produced.
#
# It is a pure function of the ENVIRONMENT — the `go` on PATH, or the workspace's
# declared version when there is none — rather than of the binary resolve_go ends
# up choosing. That is deliberate: the fast path and the build path must agree,
# and a managed toolchain installed under $PUTNAMI_HOME is never added to PATH,
# so "no go on PATH" keeps answering the same thing before and after an install.
# Deriving it from the chosen binary instead would make the key flip on the run
# that installs the toolchain and flip back on the next one, rebuilding forever.
#
# Cost: one `go env GOVERSION` (~17 ms measured on this repo) when go is on PATH,
# and no process at all when it is not. It never downloads or installs anything —
# that is resolve_go's job, and it runs on the build path only.
go_toolchain_identity() {
  local declared system_go version
  declared="$(read_go_version 2>/dev/null || true)"
  if command -v go >/dev/null 2>&1; then
    system_go="$(command -v go)"
    version="$(GOTOOLCHAIN=local "$system_go" env GOVERSION 2>/dev/null || true)"
    printf 'path=%s version=%s declared=%s' "$system_go" "$version" "$declared"
    return 0
  fi
  printf 'managed declared=%s' "$declared"
}

# compute_source_key sets SOURCE_KEY to the SHA-256 that identifies the exact CLI
# this tree would build, and returns non-zero (leaving SOURCE_KEY empty) when no
# key can be computed.
#
# CONTENT, not timestamps. Every component is content-addressed, so a checkout, a
# rebase, a `touch`, or clock skew cannot fake freshness, and two worktrees at
# the same state produce the same key — which is what lets them share one blob
# and one build.
#
# Preimage:
#   1. `git ls-tree HEAD -- <SOURCE_KEY_PATHS>` — one git call, a handful of
#      lines, each an exact content-addressed object id for a whole subtree or
#      blob. Nothing walks the file system.
#   2. The dirty overlay: `git status --porcelain=v1 -uall -z` over the same
#      pathspec, hashed raw (so renames, deletions and mode changes move the key
#      even when no working-tree file remains), plus one batched `git
#      hash-object` over the working-tree bytes of every regular file it names,
#      in status order (so uncommitted, staged and untracked edits move it too).
#      `git status` honors .gitignore, so
#      node_modules, .gen and .putnami are excluded by construction — verified on
#      this repository, where the pathspec reports zero entries on a clean tree.
#      A rename or copy (`R`/`C`) emits TWO records: `XY <new>` then a bare
#      `<origin>` with no status prefix. The loop consumes that second record
#      explicitly rather than stripping three bytes off it, so the origin path is
#      never silently mangled into some unrelated file that happens to exist.
#      The origin's CONTENT does not enter the key — the new path's does, and the
#      raw status bytes already record the move.
#   3. The Go toolchain identity and the exact ldflags, so a toolchain switch or
#      a link-flag change never reuses a foreign binary.
#
# No key is not an error. Git missing, $SCRIPT_DIR not a work tree, no sha256sum
# or shasum, or any call failing all mean "fall back to the mtime gate", so a
# tarball checkout still builds and runs.
compute_source_key() {
  SOURCE_KEY=""
  local hasher status_file key record path file paths_file blobs_file _origin
  if command -v sha256sum >/dev/null 2>&1; then
    hasher="sha256sum"
  elif command -v shasum >/dev/null 2>&1; then
    hasher="shasum -a 256"
  else
    return 1
  fi
  command -v git >/dev/null 2>&1 || return 1
  git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1

  local tree
  tree="$(git -C "$SCRIPT_DIR" ls-tree HEAD -- "${SOURCE_KEY_PATHS[@]}" 2>/dev/null)" || return 1
  [ -n "$tree" ] || return 1

  # `git status -z` separates records with NUL, and a shell variable cannot hold
  # a NUL byte, so the records go through a file rather than a substitution.
  status_file="$(mktemp "${TMPDIR:-/tmp}/putnami-srckey.XXXXXX" 2>/dev/null)" || return 1
  register_cleanup "$status_file"
  if ! git -C "$SCRIPT_DIR" status --porcelain=v1 --untracked-files=all -z \
       -- "${SOURCE_KEY_PATHS[@]}" >"$status_file" 2>/dev/null; then
    rm -f "$status_file"
    return 1
  fi

  # Hash every dirty working-tree file in ONE `git hash-object` call. This is a
  # hot path — it runs on every ./putnamiw invocation, including the fast path
  # that does no work at all — so one process per dirty file is not affordable:
  # on a 30-file working tree the per-file form cost ~0.6 s of pure fork/exec,
  # against ~0.02 s batched. xargs -0 chunks the list itself, so a working tree
  # with thousands of dirty files cannot blow ARG_MAX.
  paths_file="$status_file.paths"
  register_cleanup "$paths_file"
  : >"$paths_file"
  while IFS= read -r -d '' record; do
    case "$record" in
      [RC]*) IFS= read -r -d '' _origin || true ;; # consume the origin record
    esac
    path="${record:3}"
    [ -n "$path" ] || continue
    file="$SCRIPT_DIR/$path"
    if [ -f "$file" ] && [ ! -L "$file" ]; then
      printf '%s\0' "$file" >>"$paths_file"
    fi
  done <"$status_file"

  blobs_file="$status_file.blobs"
  register_cleanup "$blobs_file"
  : >"$blobs_file"
  # xargs runs its utility at least once even on empty input, and `git
  # hash-object --` with no paths is a usage error — so a CLEAN tree, the common
  # case, would fail here and lose the key entirely. Skip the call instead.
  if [ -s "$paths_file" ] &&
     ! xargs -0 git -C "$SCRIPT_DIR" hash-object -- <"$paths_file" >"$blobs_file" 2>/dev/null; then
    # A file that existed a moment ago is gone or unreadable: the tree is moving
    # under us. Report "no key" (the same answer as no git at all) rather than
    # invent one, so the caller falls back to the mtime gate and the next run —
    # against a settled tree — gets a real key.
    rm -f "$status_file" "$paths_file" "$blobs_file"
    return 1
  fi

  key="$(
    {
      printf 'putnamiw-source-key/1\0'
      printf 'ldflags=%s\0' "$CLI_LDFLAGS"
      printf 'toolchain=%s\0' "$(go_toolchain_identity)"
      printf 'tree=%s\0' "$tree"
      cat "$status_file"
      printf 'blobs\0'
      cat "$blobs_file"
    } | $hasher | awk '{print $1}'
  )" || { rm -f "$status_file" "$paths_file" "$blobs_file"; return 1; }

  rm -f "$paths_file" "$blobs_file"

  rm -f "$status_file"
  [ -n "$key" ] || return 1
  SOURCE_KEY="$key"
  return 0
}

# publish_source_cli moves a freshly built binary into the machine-global
# from-source store at cli-source/<key>/putnami and points $CLI_BINARY at it.
#
# Same discipline as download_cli: stage under artifacts/tmp/ (the directory the
# Go GC's staging sweep reclaims, so an interrupted publish never orphans bytes
# outside GC reach), publish under a mkdir-lock with one atomic rename,
# first-writer-wins, and stamp `lastused` so the artifact GC keeps the blob warm.
# The store is IMMUTABLE: a key is a hash of the sources, so an existing blob
# under it already has the bytes this build just produced. Publication is
# therefore always first-writer-wins, including under --bootstrap. An earlier
# draft let --bootstrap rm -rf the blob and republish; that raced the (unlocked)
# store-hit path in sibling worktrees, which could be pointing at the very
# directory being removed — and it bought nothing, because the replacement is
# byte-equivalent. To discard a blob you believe is damaged, remove it (or run
# `putnami cache clean --all`); do not overwrite one other worktrees may be
# executing.
publish_source_cli() {
  local key="$1" built="$2"
  local store_dir="$CLI_SOURCE_STORE/$key"
  local stage publish_dir publish_lock

  mkdir -p "$CLI_SOURCE_STORE" "$PUTNAMI_HOME/artifacts/tmp"
  stage="$(mktemp -d "$PUTNAMI_HOME/artifacts/tmp/cli-source.XXXXXX")"
  register_cleanup "$stage"
  publish_dir="$stage/publish"
  mkdir "$publish_dir"
  mv "$built" "$publish_dir/putnami"
  chmod +x "$publish_dir/putnami"

  publish_lock="$PUTNAMI_HOME/artifacts/.cli-source-$key.lock"
  acquire_dir_lock "$publish_lock"
  if [ -x "$store_dir/putnami" ]; then
    rm -rf "$publish_dir" "$stage" # a sibling published this exact key first
  else
    if [ -e "$store_dir" ]; then
      rm -rf "$store_dir" # a stale, incomplete dir from an interrupted publish
    fi
    if mv "$publish_dir" "$store_dir" 2>/dev/null; then
      rm -rf "$stage"
    else
      rm -rf "$publish_dir" "$stage"
      release_dir_lock "$publish_lock"
      fail "Failed to publish the from-source putnami CLI"
    fi
  fi
  release_dir_lock "$publish_lock"

  touch_recency "$store_dir" # keep this blob warm against the artifact GC
  # --print-engine publishes the blob only: .putnami/bin stays as it was.
  if [ "$PRINT_ENGINE" = "false" ]; then
    link_cli "$store_dir/putnami"
    write_from_source_marker "$key"
  fi
}

go_version_satisfies() {
  local have
  local want
  have="$(normalize_go_version "$1")"
  want="$(normalize_go_version "$2")"

  local have_major have_minor have_patch
  local want_major want_minor want_patch
  IFS=. read -r have_major have_minor have_patch <<< "$have"
  IFS=. read -r want_major want_minor want_patch <<< "$want"

  [[ "$have_major" =~ ^[0-9]+$ && "$have_minor" =~ ^[0-9]+$ && "$have_patch" =~ ^[0-9]+$ ]] || return 1
  [[ "$want_major" =~ ^[0-9]+$ && "$want_minor" =~ ^[0-9]+$ && "$want_patch" =~ ^[0-9]+$ ]] || return 1

  if (( have_major != want_major )); then
    (( have_major > want_major ))
    return
  fi
  if (( have_minor != want_minor )); then
    (( have_minor > want_minor ))
    return
  fi
  (( have_patch >= want_patch ))
}

# --- Resolve Go binary ---

resolve_go() {
  local version
  version="$(read_go_version || true)"

  # 1. System PATH, but only when it satisfies the workspace pin. Validate the
  # version Go runs as under GOTOOLCHAIN=local (build_cli pins local) — not the
  # version it would switch to under auto, which would let an older base binary
  # pass validation and then fail the build with "requires go >=".
  if command -v go >/dev/null 2>&1; then
    local system_go
    local system_version
    system_go="$(command -v go)"
    system_version="$(go_binary_version_mode "$system_go" "local" || true)"
    if [ -z "$version" ] || go_version_satisfies "$system_version" "$version"; then
      GO_BINARY="$system_go"
      return 0
    fi
    warn "System Go ${system_version:-unknown} is older than workspace Go $version; using managed Go"
  fi

  # 2. Managed install.
  install_managed_go "${version:-1.23.0}"
}

# install_managed_go sets GO_BINARY to Go release $1 under the Putnami home, the
# one place besides PATH and GOROOT where the CLI this script runs looks for the
# Go the lock pins. A Go only this script can find, such as a toolchain an older
# go downloads into its module cache, is never used. When the Putnami home holds
# no such release, it downloads and verifies it first.
install_managed_go() {
  local version="$1"
  local managed_bin="$GO_MANAGED_DIR/go-$version/go/bin/go"
  if [ -x "$managed_bin" ]; then
    GO_BINARY="$managed_bin"
    return 0
  fi

  # Download into the machine-global toolchain dir. Many worktrees may race
  # here, so extract into a unique staging dir and atomically rename it into
  # place (first-writer-wins) rather than extracting into the shared path —
  # in-place extraction would let two simultaneous downloads corrupt each other.
  detect_platform
  local ext=".tar.gz"
  [ "$GO_OS" = "windows" ] && ext=".zip"
  local url="https://go.dev/dl/go${version}.${GO_OS}-${GO_ARCH}${ext}"
  local install_dir="$GO_MANAGED_DIR/go-$version"

  info "Downloading Go $version from ${DIM}go.dev${NC}..."
  mkdir -p "$GO_MANAGED_DIR"
  local stage
  stage="$(mktemp -d "$GO_MANAGED_DIR/.stage.XXXXXX")"
  register_cleanup "$stage"
  local archive="$stage/go${ext}"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$archive" "$url" || { rm -rf "$stage"; fail "Failed to download Go $version"; }
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$archive" "$url" || { rm -rf "$stage"; fail "Failed to download Go $version"; }
  else
    rm -rf "$stage"
    fail "curl or wget is required to download Go"
  fi

  # The archive is installed only when its SHA-256 is the one the workspace
  # lock records for this release and platform, or, when the lock pins another
  # release, the one go.dev publishes beside the archive.
  local expected actual
  if ! expected="$(locked_go_sha256 "$version" "$GO_OS/$GO_ARCH")"; then
    local checksum_url="${GO_CHECKSUM_URL}go${version}.${GO_OS}-${GO_ARCH}${ext}.sha256"
    if command -v curl >/dev/null 2>&1; then
      expected="$(curl -fsSL "$checksum_url" 2>/dev/null | awk '{print $1}')" || expected=""
    else
      expected="$(wget -q -O - "$checksum_url" 2>/dev/null | awk '{print $1}')" || expected=""
    fi
    [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || expected=""
  fi
  actual="$(sha256_of "$archive")"
  if [ -z "$expected" ] || [ -z "$actual" ]; then
    rm -rf "$stage"
    fail "Cannot verify Go $version: no SHA-256 for $GO_OS/$GO_ARCH in putnami.lock.json or from go.dev, or no sha256sum, shasum or openssl"
  fi
  if [ "$actual" != "$expected" ]; then
    rm -rf "$stage"
    fail "Refusing Go $version from $url: SHA-256 $actual, want $expected"
  fi

  if [ "$ext" = ".zip" ]; then
    unzip -q "$archive" -d "$stage" || { rm -rf "$stage"; fail "Failed to extract Go archive"; }
  else
    tar -xzf "$archive" -C "$stage" || { rm -rf "$stage"; fail "Failed to extract Go archive"; }
  fi
  rm -f "$archive"

  if [ ! -x "$stage/go/bin/go" ]; then
    rm -rf "$stage"
    fail "Go binary not found after extraction"
  fi

  # Publish a complete directory only: prepare go-$version/go under staging,
  # then move that finished tree into place while a small mkdir-lock excludes
  # sibling wrappers. This avoids an externally visible empty go-$version/ dir.
  local publish_dir="$stage/publish"
  mkdir "$publish_dir"
  mv "$stage/go" "$publish_dir/go"

  local publish_lock="$GO_MANAGED_DIR/.go-$version.lock"
  acquire_dir_lock "$publish_lock"
  if [ -x "$install_dir/go/bin/go" ]; then
    rm -rf "$publish_dir" "$stage" # a sibling published it first; keep theirs
  else
    if [ -e "$install_dir" ]; then
      rm -rf "$install_dir" # stale incomplete dir from an interrupted publish
    fi
    if mv "$publish_dir" "$install_dir" 2>/dev/null; then
      rm -rf "$stage"
      success "Go $version installed"
    else
      rm -rf "$publish_dir" "$stage"
      release_dir_lock "$publish_lock"
      fail "Failed to install Go $version"
    fi
  fi
  release_dir_lock "$publish_lock"

  if [ ! -x "$install_dir/go/bin/go" ]; then
    fail "Go binary not found after extraction"
  fi
  GO_BINARY="$install_dir/go/bin/go"
}

# ensure_locked_go installs the Go release the workspace lock pins under the
# Putnami home, unless it is there already, or $GOROOT/bin/go or the go on PATH
# runs as that release. `putnami extensions prepare` resolves a prepare
# toolchain to exactly the locked release and installs none, while resolve_go
# accepts any Go at or above the go.work version and does not run when a cached
# CLI is reused. The probe matches the CLI's: in the workspace root, with
# GOROOT unset and GOTOOLCHAIN=local.
ensure_locked_go() {
  local locked want candidate version
  locked="$(locked_go_version)" || return 0
  [ -x "$GO_MANAGED_DIR/go-$locked/go/bin/go" ] && return 0
  want="$(normalize_go_version "$locked")"
  for candidate in "${GOROOT:+$GOROOT/bin/go}" "$(command -v go 2>/dev/null || true)"; do
    [ -n "$candidate" ] && [ -x "$candidate" ] || continue
    version="$(cd "$SCRIPT_DIR" && unset GOROOT && go_binary_version_mode "$candidate" "local" || true)"
    [ "$version" = "$want" ] && return 0
  done
  install_managed_go "$locked"
}

# --- Download pre-built CLI ---

download_cli() {
  detect_platform
  local url="${RESOLVER_URL}/putnami?version=latest&target=${GO_ARCH}&platform=${GO_OS}"

  info "Downloading putnami CLI from ${DIM}putnami.dev${NC}..."
  mkdir -p "$(dirname "$CLI_BINARY")"

  local tmp_archive
  tmp_archive="$(mktemp "${TMPDIR:-/tmp}/putnami-dl.XXXXXX")"
  register_cleanup "$tmp_archive"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$tmp_archive" "$url" || fail "Failed to download putnami CLI"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$tmp_archive" "$url" || fail "Failed to download putnami CLI"
  else
    fail "curl or wget is required to download putnami CLI"
  fi

  # Extract binary from the tar.gz archive
  local tmp_dir
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/putnami-extract.XXXXXX")"
  register_cleanup "$tmp_dir"
  tar -xzf "$tmp_archive" -C "$tmp_dir" || fail "Failed to extract putnami CLI archive"
  rm -f "$tmp_archive"

  local extracted_binary="$tmp_dir/compiled/putnami"
  if [ ! -f "$extracted_binary" ]; then
    rm -rf "$tmp_dir"
    fail "Binary not found in downloaded archive (expected compiled/putnami)"
  fi
  chmod +x "$extracted_binary"

  local sha
  sha="$(sha256_of "$extracted_binary" || true)"
  mkdir -p "$(dirname "$CLI_BINARY")"

  if [ -n "$sha" ]; then
    # Content-addressed shared store: keep one copy per machine and point the
    # worktree's $CLI_BINARY at it via a symlink, so sibling worktrees reuse the
    # same blob. The symlink is swapped via a staged link + atomic rename — the
    # running binary's inode is never rewritten (the macOS code-sign vnode rule).
    # The blob lives under cli/<sha>/, which the Go artifact GC sweeps by recency
    # (kept warm via touch_recency below) and `cache clean --all` clears, so it
    # does not leak unbounded in the shared root.
    local store_dir="$PUTNAMI_HOME/artifacts/cli/$sha"
    if [ ! -x "$store_dir/putnami" ]; then
      # Stage under artifacts/tmp/ — the same dir the Go GC's staging sweep
      # reclaims — so an interrupted publish never orphans bytes outside GC reach.
      mkdir -p "$PUTNAMI_HOME/artifacts/cli" "$PUTNAMI_HOME/artifacts/tmp"
      local stage
      stage="$(mktemp -d "$PUTNAMI_HOME/artifacts/tmp/cli.XXXXXX")"
      register_cleanup "$stage"
      local publish_dir="$stage/publish"
      mkdir "$publish_dir"
      mv "$extracted_binary" "$publish_dir/putnami"
      chmod +x "$publish_dir/putnami"

      local publish_lock="$PUTNAMI_HOME/artifacts/.cli-$sha.lock"
      acquire_dir_lock "$publish_lock"
      if [ -x "$store_dir/putnami" ]; then
        rm -rf "$publish_dir" "$stage" # a sibling won the race; keep theirs
      else
        if [ -e "$store_dir" ]; then
          rm -rf "$store_dir" # stale incomplete dir from an interrupted publish
        fi
        if mv "$publish_dir" "$store_dir" 2>/dev/null; then
          rm -rf "$stage"
        else
          rm -rf "$publish_dir" "$stage"
          release_dir_lock "$publish_lock"
          fail "Failed to publish putnami CLI"
        fi
      fi
      release_dir_lock "$publish_lock"
    fi
    touch_recency "$store_dir" # keep this blob warm against the artifact GC
    ln -s "$store_dir/putnami" "$CLI_BINARY.lnk.$$"
    mv -f "$CLI_BINARY.lnk.$$" "$CLI_BINARY"
  else
    # No hashing tool: fall back to a per-worktree regular file. The two-step
    # move keeps the final step an atomic same-filesystem rename (a cross-device
    # in-place copy would wedge macOS code-sign validation for a running binary).
    mv "$extracted_binary" "$CLI_BINARY.new.$$"
    chmod +x "$CLI_BINARY.new.$$"
    mv -f "$CLI_BINARY.new.$$" "$CLI_BINARY"
  fi
  rm -rf "$tmp_dir"
  rm -f "$FROM_SOURCE_MARKER" 2>/dev/null || true # a download is not a from-source build

  success "putnami CLI downloaded"
}

# --- Build CLI ---

# build_cli_package compiles the CLI into $1. Go resolves the main module and
# go.work from its working directory, not from the package path, so the build
# runs from this workspace: a caller in any other directory (a scratch
# repository, a temp dir) would otherwise get "cannot find main module". A
# relative output (a relative PUTNAMI_HOME) keeps meaning the caller's directory.
build_cli_package() {
  local out="$1"
  case "$out" in
    /*) ;;
    *) out="$PWD/$out" ;;
  esac
  # GOROOT, PATH and GOTOOLCHAIN name the resolved Go for the build command
  # alone. The CLI this script then runs receives the caller's environment,
  # the same on a run that builds and on a run that reuses the blob.
  #
  # GOROOT is the resolved Go binary's own, whatever the caller exports: cloud
  # shells and version managers may export the GOROOT of another installation.
  local go_root
  go_root="$(env -u GOROOT "$GO_BINARY" env GOROOT 2>/dev/null || true)"
  if [ -z "$go_root" ]; then
    go_root="$(cd "$(dirname "$GO_BINARY")/.." && pwd)"
  fi
  (cd "$SCRIPT_DIR" && GOROOT="$go_root" PATH="$go_root/bin:$PATH" GOTOOLCHAIN=local \
    "$GO_BINARY" build -o "$out" -ldflags="$CLI_LDFLAGS" "$CLI_SOURCE") >&2
}

build_cli() {
  info "Building putnami CLI..."

  if [ "$PRINT_ENGINE" = "false" ]; then
    mkdir -p "$(dirname "$CLI_BINARY")"
  fi

  # A FAILED BUILD IS A HARD FAILURE on every path below. There is deliberately
  # no fallback to a previously cached blob or to a downloaded binary: a gate
  # must never claim it tested with a tool other than the one in the commit,
  # and a "working" stale binary is the one failure mode that
  # looks exactly like success.
  if [ -n "${SOURCE_KEY:-}" ]; then
    # Keyed build: compile into staging, then publish content-addressed so
    # sibling worktrees at this tree state share the blob. Never build straight
    # into the store — a `go build -o` into a published path would rewrite a
    # blob other worktrees are running.
    local stage out
    mkdir -p "$PUTNAMI_HOME/artifacts/tmp"
    stage="$(mktemp -d "$PUTNAMI_HOME/artifacts/tmp/cli-build.XXXXXX")"
    register_cleanup "$stage"
    out="$stage/putnami"
    if ! build_cli_package "$out"; then
      rm -rf "$stage"
      fail "Failed to build putnami CLI"
    fi
    publish_source_cli "$SOURCE_KEY" "$out"
    rm -rf "$stage"
    success "putnami CLI built at ${DIM}${CLI_SOURCE_STORE}/${SOURCE_KEY}/putnami${NC}"
    return 0
  fi

  # No key (no git, not a work tree, or no sha256sum or shasum): per-worktree binary,
  # governed by the mtime gate, exactly as before.
  #
  # If a prior --download left $CLI_BINARY as a symlink into the shared store,
  # remove it first: `go build -o` follows the symlink and would rewrite the
  # shared blob in place, clobbering every worktree and re-opening the macOS
  # code-sign vnode wedge. Building then creates a fresh per-worktree inode.
  [ -L "$CLI_BINARY" ] && rm -f "$CLI_BINARY"

  if build_cli_package "$CLI_BINARY"; then
    : > "$FROM_SOURCE_MARKER" 2>/dev/null || true # mark this binary as from-source
    success "putnami CLI built at ${DIM}${CLI_BINARY}${NC}"
  else
    fail "Failed to build putnami CLI"
  fi
}

# --- From-source build key ---

# SOURCE_KEY identifies the exact CLI these sources compile to, or is empty when
# no key could be computed (see compute_source_key). It is resolved once, here,
# because both the fast path and the build path need the same answer.
SOURCE_KEY=""
if [ "$DOWNLOAD" = "false" ] && [ -d "$SCRIPT_DIR/tooling/cli" ]; then
  compute_source_key || SOURCE_KEY=""
fi

# --- Build-only mode: build or reuse the store blob, prepare, print it ---
#
# This path takes the same key, the same store and the same build as a normal
# run, and stops before anything touches .putnami/bin or execs the CLI. Without
# a key there is no immutable blob to name, only the per-worktree binary that
# the next run may rewrite, so the mode refuses instead of printing it. The
# only command it runs with the blob is `extensions prepare`.
if [ "$PRINT_ENGINE" = "true" ]; then
  if [ -z "$SOURCE_KEY" ]; then
    fail "--print-engine needs a content key for the CLI sources, and none could be computed: it needs git, a git work tree at $SCRIPT_DIR, and sha256sum or shasum."
  fi
  if [ "$BOOTSTRAP" = "true" ] || [ ! -x "$CLI_SOURCE_STORE/$SOURCE_KEY/putnami" ]; then
    resolve_go
    build_cli
  else
    touch_recency "$CLI_SOURCE_STORE/$SOURCE_KEY" # keep this blob warm against the artifact GC
  fi
  ensure_locked_go
  prepare_source_runtimes "$SOURCE_KEY"
  print_engine "$SOURCE_KEY"
  exit 0
fi

# --- Fast path: binary exists, not stale, no bootstrap requested ---

if [ "$BOOTSTRAP" = "false" ] && [ -x "$CLI_BINARY" ]; then
  if [ "$DOWNLOAD" = "true" ]; then
    # Download mode: binary exists, use it (no staleness check against source).
    touch_cli_recency "$CLI_BINARY"
    run_cli "$CLI_BINARY" "${PASSTHROUGH_ARGS[@]}"
  fi

  if [ -n "$SOURCE_KEY" ]; then
    # Content-keyed from-source fast path. Two things must agree before this
    # binary is accepted without a build: the marker records the key these
    # sources hash to, AND $CLI_BINARY actually points at that key's blob. The
    # second check is not redundant — `putnami cli use` and `upgrade
    # --from-source` both re-point $CLI_BINARY without touching the marker, so
    # the marker alone would vouch for a binary it never described. Anything
    # else — no marker, an older key, a re-pointed link, a blob the GC reaped —
    # falls through, and the store-hit branch below re-links or rebuilds.
    #
    # A from-source build is authoritative, so the in-process launcher is
    # suppressed and PUTNAMI_FROM_SOURCE/PUTNAMI_FROM_SOURCE_KEY name the tree it
    # came from and the blob it is: that is the evidence a source workspace's lock
    # requires (see internal/launch).
    if [ -f "$FROM_SOURCE_MARKER" ] &&
       [ "$(cat "$FROM_SOURCE_MARKER" 2>/dev/null || true)" = "$SOURCE_KEY" ] &&
       [ "$(resolve_link_target "$CLI_BINARY" 2>/dev/null || true)" = "$CLI_SOURCE_STORE/$SOURCE_KEY/putnami" ]; then
      touch_cli_recency "$CLI_BINARY"
      exec_source_blob "$SOURCE_KEY" "$@"
    fi
    # Key mismatch: fall through and rebuild.
  else
    # No key (no git, not a work tree, or no sha256sum or shasum — a tarball checkout).
    # Fall back to the historical mtime gate, unchanged.
    #
    # Staleness gate for BOTH a symlinked pin/download and a regular-file build:
    # ./putnamiw is the from-source bootstrap, so in a from-source workspace
    # (tooling/cli present) it must always run a binary that reflects those
    # sources. A binary older than the sources cannot, and running it silently
    # shadows local edits and merged fixes (the stale-binary trap — e.g. a
    # `cli use`/`upgrade` symlink surviving a `git pull`), so fall through and
    # rebuild. Compare against the resolved TARGET of a symlink, not the symlink
    # itself (find -newer reads the symlink's own mtime, which a just-created pin
    # over an old binary would falsely pass). In a consumer workspace tooling/cli
    # is absent, so nothing matches and the pinned/downloaded binary runs as-is,
    # governed by version. To deliberately run a pinned/released CLI, use the
    # global `putnami` launcher (it honors the workspace pin) rather than
    # ./putnamiw.
    STALE_REF="$CLI_BINARY"
    if [ -L "$CLI_BINARY" ]; then
      LINK_TARGET="$(resolve_link_target "$CLI_BINARY" || true)"
      if [ -n "$LINK_TARGET" ] && [ -e "$LINK_TARGET" ]; then
        STALE_REF="$LINK_TARGET"
      fi
    fi
    if ! find "$SCRIPT_DIR/tooling/cli" -name '*.go' -newer "$STALE_REF" -print -quit 2>/dev/null | grep -q .; then
      if [ -L "$CLI_BINARY" ]; then
        # Up-to-date symlinked pin/download: governed by version, left relaunchable
        # so a workspace CLI pin is still honored.
        touch_cli_recency "$CLI_BINARY"
        run_cli "$CLI_BINARY" "$@"
      fi
      # Up-to-date regular-file build, not stale vs source. Suppress relaunch only
      # if it is a from-source build (marker present); a downloaded regular-file
      # binary (the no-hashing-tool fallback) carries no marker and stays
      # relaunchable, so a workspace CLI pin is still honored.
      if [ -f "$FROM_SOURCE_MARKER" ]; then
        SUPPRESS_RELAUNCH="true"
        FROM_SOURCE_ROOT="$SCRIPT_DIR"
      fi
      run_cli "$CLI_BINARY" "$@"
    fi
    # Sources are newer than the selected binary → fall through and rebuild from
    # source (build_cli removes any symlink first, so a stale pin is replaced by a
    # fresh from-source build).
  fi
fi

# --- Store hit: this exact source key is already built on this machine ---
#
# This runs before any toolchain resolution, so a FRESH worktree (or one whose
# .putnami/bin was wiped) at a tree state some sibling worktree already built
# adopts that blob instead of compiling it a second time. That is the whole
# point of keying the store by content rather than by worktree: one build per
# tree state per machine. `--bootstrap` skips it deliberately.
if [ "$BOOTSTRAP" = "false" ] && [ -n "$SOURCE_KEY" ] &&
   [ -x "$CLI_SOURCE_STORE/$SOURCE_KEY/putnami" ]; then
  touch_recency "$CLI_SOURCE_STORE/$SOURCE_KEY"
  link_cli "$CLI_SOURCE_STORE/$SOURCE_KEY/putnami"
  write_from_source_marker "$SOURCE_KEY"
  exec_source_blob "$SOURCE_KEY" "$@"
fi

# --- Main ---

if [ "$DOWNLOAD" = "true" ]; then
  download_cli
else
  resolve_go
  build_cli
  # A keyed build published a store blob, so run it through its immutable path.
  # Without a key (no git, or no sha256sum or shasum) build_cli wrote a regular file into
  # $CLI_BINARY and there is no blob to exec; fall through to the identity check.
  if [ -n "$SOURCE_KEY" ]; then
    exec_source_blob "$SOURCE_KEY" "${PASSTHROUGH_ARGS[@]}"
  fi
  SUPPRESS_RELAUNCH="true" # ran a from-source build; it is authoritative
  FROM_SOURCE_ROOT="$SCRIPT_DIR" # ...and it came from THIS tree; see run_cli
fi
run_cli "$CLI_BINARY" "${PASSTHROUGH_ARGS[@]}"
