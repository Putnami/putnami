      "owner": "python",
      "target": "modeled",
      "requirements": [
        {
          "id": "clamp-bounds",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "clamp-clamps-out-of-range-values",
              "clamp-returns-a-value-already-inside-the-range"
            ]
          }
        }
      ]
    }
  ]
}
