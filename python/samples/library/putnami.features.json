{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "python",
  "features": [
    {
      "id": "python/example-library-utilities",
      "type": "feature",
      "name": "Python example library utilities",
