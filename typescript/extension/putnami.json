{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/typescript",
  "tags": [
    "go",
    "extension"
  ],
  "extensions": [
    "@putnami/go",
    "/tooling/sdd-extension"
  ],
  "dependencies": [
    "/protocols/http-routes"
  ],
  "publish": [
    "archives"
  ],
  "options": {
    "@putnami/go": {
      "entrypoint": "./cmd/putnami-ts",
      "buildvcs": false
    },
    "package": {
      "archives": true
    },
    "test": {
      "filePatterns": ["cmd/putnami-ts/testdata/recorded/**", "putnami.extension.json", "config/biome.json"]
    },
    "publish": {
      "archives": true
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
