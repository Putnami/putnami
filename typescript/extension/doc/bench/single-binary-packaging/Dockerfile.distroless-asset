# Proposed shape: one `bun build --compile --asset .gen/public --bytecode
# --format=esm` executable, with the static tree embedded in the binary instead
# of shipped as an image layer.
#
# PUTNAMI_ASSETS_DIR is the existing PutnamiConfig knob (assetsDir); it points
# StaticPlugin at the executable's virtual FS mount. The `\$` keeps Docker from
# expanding `$bunfs` as a build variable.
#
# Build context: $BENCH_WORK/ctx (see bench.sh prepare_ctx).
ARG BASE_IMAGE=gcr.io/distroless/base-debian12
FROM ${BASE_IMAGE}

WORKDIR /app
COPY srv-binary-asset-bytecode /app/server

ENV NODE_ENV=production
ENV PORT=3000
ENV PWD=/app
ENV PUTNAMI_ASSETS_DIR=/\$bunfs/root/public

EXPOSE 3000
ENTRYPOINT ["/app/server"]
