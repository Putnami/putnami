{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/typescript-doc-examples",
  "type": "library",
  "tags": ["ts"],
  "featureAuthority": {
    "owner": "putnami-dev/public-documentation"
  },
  "extensions": ["/typescript/extension"],
  "options": {
    "test": {
      "coverage": false,
      "coverage-threshold": 0,
      "filePatterns": [
        "examples.json",
        "../doc/**",
        "../extension/AI.md",
        "../extension/doc/**",
        "../framework/*/AI.md",
        "../framework/*/doc/**",
        "../../sites/putnami.dev/doc/**",
        "../../tooling/doc/**",
        "../../tooling/sdd-extension/doc/**",
        "../../tooling/observe/doc/**",
        "../extension/README.md",
        "../framework/*/README.md",
        "../../tooling/extension-sdk/doc/**"
      ]
    }
  }
}
