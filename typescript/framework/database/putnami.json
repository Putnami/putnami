{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/database",
  "visibility": "public",
  "type": "library",
  "tags": ["ts"],
  "extensions": ["/typescript/extension", "/tooling/sdd-extension"],
  "dependencies": ["/protocols/database", "/protocols/infra", "/protocols/transaction"],
  "options": {
    "test": {
      "filePatterns": [
        "../../../protocols/database/conformance/**",
        "../../../protocols/database/fixtures/**",
        "../../../protocols/infra/fixtures/equivalence/**",
        "../../../protocols/transaction/conformance/**"
      ],
      "coverage-threshold": 40
    },
    "package": {
      "npm": true
    },
    "publish": {
      "npm": true
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
