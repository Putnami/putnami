{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "typescript",
  "features": [
    {
      "id": "typescript/web-application-delivery",
      "type": "feature",
      "name": "TypeScript web application delivery",
      "outcome": "TypeScript applications deliver file-routed React pages through explicit SSR or static rendering, bounded hydration, server-owned data mutations, and fail-closed request security",
      "owner": "typescript",
      "target": "modeled",
      "requirements": [
        {
          "id": "browser-security-hint",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-guard-gated-requirement-is-indeterminate-and-denied-on-the-client",
              "the-client-evaluates-authentication-role-and-scope-facts",
              "the-serialized-context-is-what-react-consumers-read"
            ]
          }
        },
        {
          "id": "cache-isolation",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-loader-cache-key-serializes-its-params-in-a-stable-order",
              "a-loader-is-not-cached-without-a-ttl",
              "a-redirect-is-never-cached",
              "a-successful-action-evicts-both-static-and-computed-keys",
              "the-default-page-cache-key-includes-a-user-fingerprint",
              "the-default-page-cache-key-includes-the-query-string",
              "the-user-fingerprint-is-stable-for-equivalent-claims"
            ]
          }
        },
        {
