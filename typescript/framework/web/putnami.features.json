              "a-per-request-nonce-is-generated-per-call",
              "an-empty-nonce-emits-no-nonce-directive",
              "the-csrf-cookie-token-is-read-by-the-client",
              "the-default-policy-is-applied-when-no-options-are-given",
              "the-nonce-reaches-the-script-src-directive"
            ]
          }
        },
        {
          "id": "document-isolation",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": [
