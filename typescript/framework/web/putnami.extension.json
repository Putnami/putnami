{
  "$schema": "https://putnami.dev/schemas/putnami-extension.json",
  "cliContract": 8,
  "name": "@putnami/web",
  "extensionDependencies": ["@putnami/application"],
  "hooks": {
    "preBuild": {
      "kind": "command",
      "command": "bun",
      "args": ["run", "{extensionRoot}/bin/generate"],
      "cwd": "{projectRoot}",
      "timeoutMs": 120000
    }
  },
  "commands": {
    "web-i18n-sync": {
      "description": "Sync the translation catalogs of a localized web application",
      "visibility": "internal",
      "activationFiles": ["src/**/*.messages.ts", "src/**/*.messages.tsx"],
      "run": [
        {
          "id": "sync",
          "task": "web-i18n-sync-exec"
        }
      ]
    }
  },
  "commandGroups": {
    "i18n": {
      "description": "Keep the translation catalogs of a localized web application in step with its messages",
      "subcommands": {
        "sync": {
          "description": "Add an entry for each new message to locales/<locale>/<namespace>.json, remove the entries of deleted messages and the files of deleted namespaces, and mark stale each translation whose default text changed while keeping its text. Writes only the files that differ",
          "command": "web-i18n-sync",
          "examples": [
            {
              "command": "putnami i18n sync --projects /sites/putnami.dev"
            }
          ]
        }
      }
    }
  },
  "tasks": {
    "web-i18n-sync-exec": {
      "description": "Write locales/<locale>/<namespace>.json for each namespace whose synced catalog differs from its file, and delete the files of undeclared namespaces",
      "kind": "command",
      "command": "bun",
      "args": ["run", "{extensionRoot}/bin/i18n.ts", "sync"],
      "cwd": "{projectRoot}",
      "timeoutMs": 120000,
      "inputs": {
        "messages": {
          "from": "project",
          "files": ["src/**/*.messages.ts", "src/**/*.messages.tsx"]
        },
        "catalogs": {
          "from": "project",
          "files": ["locales/**/*.json"]
        },
        "config": {
          "from": "project",
          "files": ["putnami.json"]
        },
        "extensionVersion": {
          "from": "runtime"
        }
      },
      "writes": ["sources"],
      "cache": {
        "enabled": true,
        "noOutput": true
      },
      "declares": {
        "mutatesSources": true
      }
    }
  }
}
