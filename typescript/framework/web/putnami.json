{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/web",
  "visibility": "public",
  "type": "library",
  "tags": ["ts"],
  "extensions": ["/typescript/extension", "/tooling/sdd-extension"],
  "dependencies": ["/protocols/http-routes", "/protocols/i18n"],
  "options": {
    "package": {
      "npm": true
    },
    "publish": {
      "npm": true
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    },
    "test": {
      "filePatterns": ["../../../protocols/i18n/fixtures/**", "../../../protocols/i18n/schemas/**"]
    },
    "agent-artifact": {
      "forbiddenContent": ["password", "access token", "api key", "github.com"],
      "requiredSkills": ["i18n-translate"]
    }
  }
}
