{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/migration",
  "visibility": "public",
  "type": "library",
  "tags": ["ts"],
  "extensions": ["/typescript/extension", "/tooling/sdd-extension"],
  "dependencies": ["/protocols/infra", "/protocols/migration"],
  "options": {
    "test": {
      "filePatterns": ["../../../protocols/infra/fixtures/equivalence/**", "../../../protocols/migration/fixtures/**"]
    },
    "package": {
      "npm": true
    },
    "publish": {
      "npm": true
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
