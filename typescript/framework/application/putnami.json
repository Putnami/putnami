{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/application",
  "visibility": "public",
  "tags": ["ts"],
  "extensions": ["/typescript/extension", "/tooling/sdd-extension"],
  "dependencies": [
    "/protocols/capabilities",
    "/protocols/config",
    "/protocols/contracts",
    "/protocols/features",
    "/protocols/http-routes",
    "/protocols/identity",
    "/protocols/keyring",
    "/protocols/platform",
    "/protocols/telemetry"
  ],
  "options": {
    "test": {
      "filePatterns": [
        "../../../protocols/capabilities/fixtures/v2/equivalence/**",
        "../../../protocols/clientcontract/fixtures/**",
        "../../../protocols/clientcontract/schemas/**",
        "../../../protocols/config/fixtures/**",
        "../../../protocols/config/schemas/**",
        "../../../protocols/contracts/fixtures/**",
        "../../../protocols/contracts/testdata/**",
        "../../../protocols/features/fixtures/**",
        "../../../protocols/http-routes/fixtures/**",
        "../../../protocols/identity/schema/contracts.gen.ts",
        "../../../protocols/identity/schema/contracts.json",
        "../../../protocols/keyring/fixtures/**",
        "../../../protocols/platform/fixtures/envelope/**"
      ]
    },
    "package": {
      "npm": true
    },
    "publish": {
      "npm": true
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
