      "owner": "typescript",
      "target": "modeled",
      "requirements": [
        {
          "id": "sse-admission-and-bounds",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-request-body-is-refused-before-any-event",
              "an-invalid-query-reaches-the-caller-as-a-non-2xx",
              "the-declared-queue-depth-and-frame-size-bound-the-producer",
              "a-liveness-comment-carries-no-data"
