          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-construction-time-failure-logs-once-and-exits-non-zero",
              "a-re-thrown-primitive-is-not-double-logged",
              "a-start-phase-failure-is-not-double-logged",
              "a-successful-bootstrap-neither-logs-nor-exits",
              "an-async-factory-rejection-is-reported-the-same-way"
            ]
          }
        },
        {
          "id": "build-only-generation",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-plugin-without-generate-is-skipped",
              "build-runs-generate-on-every-plugin",
              "generate-runs-during-build",
              "post-generate-assets-and-exports-reach-the-build-result",
              "post-generate-runs-only-after-the-generate-barrier",
