            ]
          }
        },
        {
          "id": "composition-invalidation",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-module-mounted-after-the-context-was-read-is-still-present",
              "a-plugin-added-during-warmup-is-still-started",
              "a-plugin-added-via-ensure-is-not-warmed-up-twice",
