{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "typescript",
  "features": [
    {
      "id": "typescript/application-lifecycle",
      "type": "feature",
      "name": "TypeScript application lifecycle",
