  "errors": [
    {
      "name": "simplest-form-is-a-code-alone",
      "source": "\"The simplest form of Error contains just a code\"",
      "json": {
        "code": "unavailable"
      },
      "expect": {
        "code": "unavailable"
      }
    },
    {
      "name": "code-message-and-a-typed-detail",
      "source": "the published Error example carrying a google.rpc.RetryInfo detail",
      "json": {
        "code": "unavailable",
        "message": "overloaded: back off and retry",
        "details": [
          {
            "type": "google.rpc.RetryInfo",
            "value": "CgIIPA",
            "debug": {
              "retryDelay": "30s"
            }
          }
        ]
      },
      "expect": {
        "code": "unavailable",
        "message": "overloaded: back off and retry",
        "details": [
          {
            "type": "google.rpc.RetryInfo",
            "value": "CgIIPA",
            "debug": {
              "retryDelay": "30s"
            }
          }
        ]
      }
    },
    {
      "name": "empty-object-is-invalid",
      "source": "\"{\\\"code\\\": null} and {} are invalid\"",
      "json": {},
      "expect": null
    },
    {
      "name": "null-code-is-invalid",
      "source": "\"{\\\"code\\\": null} and {} are invalid\"",
      "json": {
        "code": null
      },
      "expect": null
    },
    {
      "name": "an-unlisted-code-is-invalid",
      "source": "\"Only the codes below are valid — there are no user-defined codes.\"",
      "json": {
        "code": "teapot",
        "message": "short and stout"
      },
      "expect": null
    },
    {
      "name": "grpc-uppercase-name-is-not-a-connect-code",
      "source": "\"Only the codes below are valid\"; the codes are lower-case snake case",
      "json": {
        "code": "NOT_FOUND"
      },
      "expect": null
    },
    {
      "name": "message-may-be-omitted",
      "source": "\"When message is omitted or the empty string, clients may synthesize a user-facing message\"",
      "json": {
        "code": "internal",
        "details": []
      },
      "expect": {
        "code": "internal"
      }
    },
    {
      "name": "a-detail-without-value-is-dropped",
      "source": "\"Each detail is an object with “type” and “value” properties\"",
      "json": {
        "code": "internal",
        "details": [
          {
            "type": "google.rpc.ErrorInfo"
          }
        ]
      },
      "expect": {
        "code": "internal"
      }
    }
  ],
  "endStream": [
    {
      "name": "successful-rpc-is-an-empty-object",
      "source": "\"After a successful RPC, EndStreamResponse can be as simple as {}\"",
      "json": {},
      "expect": {
        "ok": true
      }
    },
    {
      "name": "failure-carries-an-error",
      "source": "the published EndStreamResponse example",
      "json": {
        "error": {
          "code": "unavailable"
        },
        "metadata": {
          "acme-operation-cost": ["237"]
        }
      },
      "expect": {
        "ok": false,
        "code": "unavailable",
        "metadata": {
          "acme-operation-cost": ["237"]
        }
      }
    },
    {
      "name": "metadata-alone-is-a-success",
      "source": "\"successful RPCs must omit the property. The “metadata” property is optional.\"",
      "json": {
        "metadata": {
          "acme-operation-cost": ["237"]
        }
      },
      "expect": {
        "ok": true,
        "metadata": {
          "acme-operation-cost": ["237"]
        }
      }
    },
    {
      "name": "null-error-is-invalid",
      "source": "\"{\\\"error\\\": null}, {\\\"error\\\": {}}, and {\\\"error\\\": {\\\"code\\\": null}} are invalid\"",
      "json": {
        "error": null
      },
      "expect": null
    },
    {
      "name": "empty-error-is-invalid",
      "source": "\"{\\\"error\\\": null}, {\\\"error\\\": {}}, and {\\\"error\\\": {\\\"code\\\": null}} are invalid\"",
      "json": {
        "error": {}
      },
      "expect": null
    },
    {
      "name": "error-with-null-code-is-invalid",
      "source": "\"{\\\"error\\\": null}, {\\\"error\\\": {}}, and {\\\"error\\\": {\\\"code\\\": null}} are invalid\"",
      "json": {
        "error": {
          "code": null
        }
      },
      "expect": null
    },
    {
      "name": "grpc-web-trailers-are-not-an-end-stream-response",
      "source": "\"Note that this is not the same as the gRPC-Web protocol\"",
      "json": {
        "grpc-status": 14,
        "grpc-message": "overloaded"
      },
      "expect": {
        "ok": true
      }
    }
  ],
  "envelope": {
    "headerBytes": 5,
    "lengthEncoding": "4 byte unsigned integer, big-endian",
    "flags": [
      {
        "bit": 0,
        "mask": 1,
        "name": "compressed",
        "source": "\"If the least significant bit is 1, the Message is compressed\""
      },
      {
        "bit": 1,
        "mask": 2,
        "name": "endStream",
        "source": "\"If the next least significant bit is 1, the Message is an EndStreamResponse\""
      }
    ],
    "reservedMask": 252,
    "reservedSource": "\"The six most significant bits are reserved for future protocol extensions.\"",
    "golden": {
      "name": "published-failed-server-stream-terminal",
      "source": "\"< <flags: 2><length: 58>{\\\"error\\\": {\\\"code\\\": \\\"unavailable\\\", \\\"message\\\": \\\"overloaded\\\"}}\"",
      "flags": 2,
      "payload": "{\"error\": {\"code\": \"unavailable\", \"message\": \"overloaded\"}}",
      "payloadByteLength": 59,
      "publishedLength": 58,
      "bytesHex": "020000003b7b226572726f72223a207b22636f6465223a2022756e617661696c61626c65222c20226d657373616765223a20226f7665726c6f61646564227d7d"
    }
  },
  "streams": [
    {
      "name": "one-message-then-a-successful-terminal",
      "source": "\"server implementations must send an EndStreamResponse as the final message in the stream\"",
      "frames": [
        {
          "flags": 0,
          "json": {
            "seq": 1
          }
        },
        {
          "flags": 2,
          "json": {}
        }
      ],
      "expect": {
        "outcome": "complete",
        "messages": [
          {
            "seq": 1
          }
        ]
      }
    },
    {
      "name": "zero-messages-then-a-successful-terminal",
      "source": "\"Streaming-Response → Streaming-Response-Headers 1*Enveloped-Message\"",
      "frames": [
        {
          "flags": 2,
          "json": {}
        }
      ],
      "expect": {
        "outcome": "complete",
        "messages": []
      }
    },
    {
      "name": "terminal-carries-the-failure",
      "source": "the published failed server streaming RPC example",
      "frames": [
        {
          "flags": 2,
          "json": {
            "error": {
              "code": "unavailable",
              "message": "overloaded"
            }
          }
        }
      ],
      "expect": {
        "outcome": "error",
        "code": "unavailable",
        "message": "overloaded",
        "messages": []
      }
    },
    {
      "name": "messages-delivered-before-a-failing-terminal-are-kept",
      "source": "\"Failed RPCs must provide an Error in the “error” property\"",
      "frames": [
        {
          "flags": 0,
          "json": {
            "seq": 1
          }
        },
        {
          "flags": 2,
          "json": {
            "error": {
              "code": "aborted"
            }
          }
        }
      ],
      "expect": {
        "outcome": "error",
        "code": "aborted",
        "messages": [
          {
            "seq": 1
          }
        ]
      }
    },
    {
      "name": "a-stream-that-ends-without-a-terminal-is-a-failure",
      "source": "\"server implementations must send an EndStreamResponse as the final message in the stream\"",
      "frames": [
        {
          "flags": 0,
          "json": {
            "seq": 1
          }
        }
      ],
      "expect": {
        "outcome": "error",
        "code": "internal",
        "messages": [
          {
            "seq": 1
          }
        ]
      }
    },
    {
      "name": "a-second-terminal-is-refused",
      "source": "\"must not send an EndStreamResponse earlier in the stream\"",
      "frames": [
        {
          "flags": 2,
          "json": {}
        },
        {
          "flags": 2,
          "json": {}
        }
      ],
      "expect": {
        "outcome": "error",
        "code": "internal",
        "messages": []
      }
    },
    {
      "name": "a-message-after-the-terminal-is-refused",
      "source": "\"must not send an EndStreamResponse earlier in the stream\"",
      "frames": [
        {
          "flags": 2,
          "json": {}
        },
        {
          "flags": 0,
          "json": {
            "seq": 2
          }
        }
      ],
      "expect": {
        "outcome": "error",
        "code": "internal",
        "messages": []
      }
    },
    {
      "name": "a-reserved-flag-bit-is-refused",
      "source": "\"The six most significant bits are reserved for future protocol extensions.\"",
      "frames": [
        {
          "flags": 4,
          "json": {
            "seq": 1
          }
        }
      ],
      "expect": {
        "outcome": "error",
        "code": "internal",
        "messages": []
      }
    },
    {
      "name": "the-compressed-bit-without-a-declared-encoding-is-refused",
      "source": "\"If Streaming-Content-Encoding is omitted or “identity”, this bit must be 0.\"",
      "frames": [
        {
          "flags": 1,
          "json": {
            "seq": 1
          }
        }
      ],
      "expect": {
        "outcome": "error",
        "code": "internal",
        "messages": []
      }
    },
    {
      "name": "a-malformed-terminal-is-a-failure-not-a-success",
      "source": "\"{\\\"error\\\": {}} … are invalid\"",
      "frames": [
        {
          "flags": 2,
          "json": {
            "error": {}
          }
        }
      ],
      "expect": {
        "outcome": "error",
        "code": "internal",
        "messages": []
      }
    }
