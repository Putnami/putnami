{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/utils",
  "visibility": "public",
  "type": "library",
  "tags": ["ts"],
  "extensions": ["/typescript/extension", "/tooling/sdd-extension"],
  "options": {
    "test": {
      "filePatterns": [
        "../*/src/**/*.ts",
        "../*/src/**/*.tsx",
        "../*/src/**/*.mts",
        "../*/src/**/*.mjs",
        "../*/bin/**/*.ts",
        "../*/bin/**/*.tsx",
        "../*/bin/**/*.mts",
        "../*/bin/**/*.mjs"
      ]
    },
    "package": {
      "npm": true
    },
    "publish": {
      "npm": true
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
