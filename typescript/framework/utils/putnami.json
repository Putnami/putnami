{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/utils",
  "visibility": "public",
  "tags": ["ts"],
  "extensions": ["/typescript/extension", "/tooling/sdd-extension"],
  "options": {
    "test": {
      "filePatterns": ["../*/src/**", "../*/bin/**"]
    },
    "package": {
      "npm": true
    },
    "publish": {
      "npm": true
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
