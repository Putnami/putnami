{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/events",
  "visibility": "public",
  "tags": ["ts"],
  "extensions": ["/typescript/extension", "/tooling/sdd-extension"],
  "dependencies": ["/protocols/events", "/protocols/infra"],
  "options": {
    "test": {
      "filePatterns": [
        "../../../protocols/events/fixtures/**",
        "../../../protocols/infra/fixtures/equivalence/**"
      ]
    },
    "package": {
      "npm": true
    },
    "publish": {
      "npm": true
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
