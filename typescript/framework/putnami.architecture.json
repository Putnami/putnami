{
  "$schema": "https://putnami.dev/schemas/putnami-architecture.json",
  "protocolVersion": 1,
  "domain": "typescript-framework",
  "owner": "framework",
  "projects": [
    "/typescript/framework/analytics",
    "/typescript/framework/application",
    "/typescript/framework/cli-protocol",
    "/typescript/framework/client",
    "/typescript/framework/database",
    "/typescript/framework/document",
    "/typescript/framework/events",
    "/typescript/framework/migration",
    "/typescript/framework/runtime",
    "/typescript/framework/spectest",
    "/typescript/framework/storage",
    "/typescript/framework/ui",
    "/typescript/framework/utils",
    "/typescript/framework/web"
  ],
  "owns": [
    {
      "id": "typescript-framework.api-documentation",
      "kind": "fact",
      "description": "The authored TypeScript framework documentation tree under /typescript/doc/framework. This domain decides what the published TypeScript reference says; a site that publishes it copies the tree and never edits it."
    },
    {
      "id": "typescript-framework.application-runtime",
      "kind": "api",
      "description": "The TypeScript application runtime surface published as @putnami/*: the application container and lifecycle, HTTP and web rendering, the UI component set, database and storage access, events, and the client. This domain decides what a Putnami TypeScript application can express; a tenant application composes that surface and owns none of its shape."
    }
  ],
  "exports": [
    {
      "id": "typescript-framework.api-documentation.v1",
      "version": 1,
      "status": "active",
      "description": "The authored TypeScript framework documentation tree (/typescript/doc/framework): the markdown a publisher copies verbatim, addressed by a deterministic digest over its sorted (relative path, content digest) pairs. The carrier contract is putnami.documentation-tree.v1.",
      "facts": [
        {
          "name": "typescript_framework_documentation",
          "authority": "typescript-framework",
          "classification": "public",
          "personalData": "none"
        }
      ],
      "modes": [
        "snapshot"
      ],
      "compatibility": {
        "strategy": "additive",
        "minimumConsumerVersion": 1
      }
    },
    {
      "id": "typescript-framework.application-runtime.v1",
      "version": 1,
      "status": "active",
      "description": "The published @putnami/* runtime packages a Putnami TypeScript application links: the application container and lifecycle, web rendering, the UI component set, database, storage, events, analytics collection, and the client. A consumer holds a stable reference to the packages; this domain retains sole authority over their API.",
      "facts": [
        {
          "name": "typescript_application_runtime_api",
          "authority": "typescript-framework",
          "classification": "public",
          "personalData": "none"
        }
      ],
      "modes": [
        "reference"
      ],
      "compatibility": {
        "strategy": "additive",
        "minimumConsumerVersion": 1
      }
    }
  ],
  "imports": [
    {
      "id": "typescript-framework.protocol-contracts.v1",
      "version": 1,
      "from": {
        "domain": "protocols",
        "export": "protocols.wire-contracts.v1"
      },
      "as": "typescript-framework.protocol-contracts",
      "mode": "reference",
      "status": "active",
      "facts": [
        "wire_contract_definitions"
      ],
      "bindings": [
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/application",
          "producerProject": "/protocols/config"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/application",
          "producerProject": "/protocols/contracts"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/application",
          "producerProject": "/protocols/features"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/application",
          "producerProject": "/protocols/http-routes"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/application",
          "producerProject": "/protocols/identity"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/application",
          "producerProject": "/protocols/platform"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/application",
          "producerProject": "/protocols/telemetry"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/cli-protocol",
          "producerProject": "/protocols/cli"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/cli-protocol",
          "producerProject": "/protocols/qualify"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/database",
          "producerProject": "/protocols/database"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/database",
          "producerProject": "/protocols/transaction"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/events",
          "producerProject": "/protocols/events"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/migration",
          "producerProject": "/protocols/migration"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/runtime",
          "producerProject": "/protocols/runtime"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/spectest",
          "producerProject": "/protocols/features"
        },
        {
          "kind": "project-dependency",
          "consumerProject": "/typescript/framework/web",
          "producerProject": "/protocols/http-routes"
        }
      ],
      "justification": "The TypeScript framework packages implement wire contracts the protocols domain owns: they write, read or replay a protocol's shapes and fixtures, and their tests prove the protocol's requirements. Each protocol owns its contract; a package holds a reference to it and owns none of its meaning."
    }
  ]
}
