{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "@putnami/cli-protocol",
  "tags": ["ts"],
  "extensions": ["/typescript/extension", "/tooling/sdd-extension"],
  "dependencies": ["/protocols/cli"],
  "options": {
    "test": {
      "filePatterns": [
        "../../../protocols/cli/conformance/**",
        "../../../protocols/cli/schemas/**",
        "../../../protocols/qualify/fixtures/**",
        "../../../protocols/qualify/schemas/**"
      ]
    },
    "package": {
      "npm": true
    },
    "publish": {
      "npm": true
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
