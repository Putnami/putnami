{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "typescript",
  "features": [
    {
      "id": "typescript/cli-machine-output",
      "type": "feature",
      "name": "TypeScript CLI machine-output binding",
      "outcome": "A TypeScript program reads Putnami CLI machine output through typed, validated documents instead of guessing at JSON shapes",
      "owner": "typescript",
      "target": "modeled",
      "requirements": [
        {
          "id": "qualify-verdict-wire",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": { "kind": "acceptance", "checks": ["shared-qualify-corpus-and-digest"] }
        },
        {
          "id": "recorded-output-stays-readable",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": { "kind": "acceptance", "checks": ["the-version-1-envelope-stays-exported"] }
        },
        {
          "id": "violations-order-by-code-unit",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["paths-compare-by-code-unit", "array-indices-order-numerically"]
          }
        }
      ]
    }
  ]
}
