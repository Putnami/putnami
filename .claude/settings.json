{
  "permissions": {
    "allow": [
      "Bash(gh label create:*)"
    ],
    "additionalDirectories": [
      "./.claude/skills"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "PUTNAMI_SESSION_REPORTER": "@putnami/cloud"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PUTNAMI_NO_AUTO_INSTALL=1 \"$CLAUDE_PROJECT_DIR\"/putnamiw agent hook --engine claude-code || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite|TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "PUTNAMI_NO_AUTO_INSTALL=1 \"$CLAUDE_PROJECT_DIR\"/putnamiw agent hook --engine claude-code || true",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PUTNAMI_NO_AUTO_INSTALL=1 \"$CLAUDE_PROJECT_DIR\"/putnamiw agent hook --engine claude-code || true",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "PUTNAMI_NO_AUTO_INSTALL=1 \"$CLAUDE_PROJECT_DIR\"/putnamiw agent hook --engine claude-code --idle-wake; s=$?; [ \"$s\" -eq 75 ] && exit 2; exit 0",
            "timeout": 660,
            "asyncRewake": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PUTNAMI_NO_AUTO_INSTALL=1 \"$CLAUDE_PROJECT_DIR\"/putnamiw agent hook --engine claude-code || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PUTNAMI_NO_AUTO_INSTALL=1 \"$CLAUDE_PROJECT_DIR\"/putnamiw agent hook --engine claude-code || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
