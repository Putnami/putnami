{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://putnami.dev/schemas/putnami-support.json",
  "title": "Putnami public support catalog v1",
  "description": "The reviewed workspace-root authority for public support commitments. Support status is deliberately separate from feature maturity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "protocolVersion": {
      "$comment": "Readers require the exact JSON integer token 1; 1.0 and 1e0 are invalid.",
      "type": "integer",
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status"],
      "properties": {
        "id": {
          "description": "The stable public identifier of the classified subject.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z0-9@][a-z0-9@._/+:-]{0,255}$"
        },
        "kind": {
          "description": "The protocol, package, or feature identifier namespace used by id.",
          "type": "string",
          "enum": ["protocol", "package", "feature"]
        },
        "status": {
          "description": "The subject's current public support commitment.",
          "type": "string",
          "enum": ["stable", "preview", "experimental"]
        },
        "default": { "type": "boolean" },
        "parity": { "type": "string", "enum": ["unsupported"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "experimental" } },
            "required": ["status"]
          },
          "then": {
            "not": {
              "properties": { "default": { "const": true } },
              "required": ["default"]
            }
          }
        }
      ]
    }
  }
}
