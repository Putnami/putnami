{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "go.putnami.dev/protocol/support",
  "visibility": "public",
  "tags": ["go", "protocol"],
  "extensions": ["/go/extension", "/tooling/sdd-extension"],
  "publish": ["go"],
  "disable": {
    "jobs": ["serve"]
  },
  "options": {
    "publish": {
      "archives": false
    },
    "test": {
      "filePatterns": [
        "../../putnami.workspace.json",
        "../../putnami.support.json",
        "../*/README.md",
        "../*/go.mod",
        "../../tooling/cli/doc/21-compatibility-and-migration.md"
      ]
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
