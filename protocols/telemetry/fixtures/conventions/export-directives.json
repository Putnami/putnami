  "applyCases": [
    {
      "name": "a directive raises the ratio and the floor, and a lower level leaves the service's",
      "own": {"traces": {"budget": 100, "ratio": 0.01, "floorPerMinute": 1}, "logLevel": "info"},
      "directive": "trace-ratio=0.5, trace-floor=5, log-level=debug, ttl=60",
      "effective": {"traces": {"budget": 100, "ratio": 0.5, "floorPerMinute": 5}, "logLevel": "info"}
    },
    {
      "name": "a directive lowers the ratio and the floor and raises the level, and keeps the budget it leaves out",
      "own": {"traces": {"budget": 100, "ratio": 0.01, "floorPerMinute": 1}, "logLevel": "info"},
      "directive": "trace-ratio=0, trace-floor=0, log-level=warn, ttl=60",
      "effective": {"traces": {"budget": 100, "ratio": 0, "floorPerMinute": 0}, "logLevel": "warn"}
    },
    {
      "name": "a directive sets the budget and the parent policy",
      "own": {"traces": {"budget": 100, "ratio": 0.01, "floorPerMinute": 1, "parent": "follow"}, "logLevel": "info"},
      "directive": "trace-budget=1000, trace-parent=decide, ttl=60",
      "effective": {"traces": {"budget": 1000, "ratio": 0.01, "floorPerMinute": 1, "parent": "decide"}, "logLevel": "info"}
    },
    {
      "name": "a directive lowers the budget and sets the parent policy back to follow",
      "own": {"traces": {"budget": 100, "ratio": 1, "floorPerMinute": 0, "parent": "decide"}, "logLevel": "warn"},
      "directive": "trace-budget=0, trace-parent=follow, ttl=60",
      "effective": {"traces": {"budget": 0, "ratio": 1, "floorPerMinute": 0, "parent": "follow"}, "logLevel": "warn"}
    },
    {
      "name": "a directive without a trace setting keeps the settings",
      "own": {"traces": {"budget": 2, "ratio": 0.5, "floorPerMinute": 3}, "logLevel": "debug"},
      "directive": "ttl=60",
      "effective": {"traces": {"budget": 2, "ratio": 0.5, "floorPerMinute": 3}, "logLevel": "debug"}
    },
    {
      "name": "error is the highest level a directive sets",
      "own": {"traces": {"budget": 0, "ratio": 1, "floorPerMinute": 0}, "logLevel": "debug"},
      "directive": "log-level=error, ttl=60",
      "effective": {"traces": {"budget": 0, "ratio": 1, "floorPerMinute": 0}, "logLevel": "error"}
    }
  ],
