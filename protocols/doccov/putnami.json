{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "go.putnami.dev/protocol/doccov",
  "tags": ["go", "protocol"],
  "extensions": ["/go/extension"],
  "featureAuthority": {
    "none": "A documentation guard over the sibling protocol packages; it has no wire, no consumer and no user outcome."
  },
  "disable": {
    "jobs": ["serve"]
  },
  "options": {
    "test": {
      "coverage": false,
      "coverage-threshold": 0,
      "filePatterns": [
        "../*/go.mod",
        "../*/*.go",
        "../*/schemas/*.json",
        "../*/schema/*.go",
        "../*/schema/*.json"
      ]
    }
  }
}
