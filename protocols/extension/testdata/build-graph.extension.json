{
  "$schema": "https://putnami.dev/schemas/putnami-extension.json",
  "name": "@acme/delegated",
  "version": "1.0.0",
  "cliContract": 21,
  "commands": {
    "build": {
      "run": [{ "id": "build", "task": "build-exec" }]
    }
  },
  "tasks": {
    "build-exec": {
      "kind": "command",
      "command": "echo",
      "args": ["built"]
    }
  },
  "workspace": {
    "markers": ["BUILD"],
    "inputs": ["BUILD"],
    "dependencySources": true,
    "buildGraphEdges": true
  }
}
