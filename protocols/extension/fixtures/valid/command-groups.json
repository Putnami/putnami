{
  "$schema": "https://putnami.dev/schemas/putnami-extension.json",
  "name": "sample/command-groups",
  "commandGroups": {
    "cloud": {
      "description": "Interact with Putnami Cloud",
      "flags": {
        "env": {
          "type": "string",
          "default": "prod",
          "description": "Target deployment environment."
        }
      },
      "subcommands": {
        "status": {
          "command": "cloud-status",
          "description": "Show the deployment status of the current workspace.",
          "flags": {
            "detailed": {
              "type": "boolean",
              "short": "r",
              "description": "Include per-revision detail."
            }
          },
          "examples": [
            {
              "command": "putnami cloud status",
              "description": "Human-readable status table."
            },
            {
              "command": "putnami cloud status --output=jsonl",
              "description": "Machine-readable snapshot for an agent or CI."
            }
          ]
        }
      }
    }
  },
  "commands": {
    "cloud-status": {
      "description": "Show deployment status.",
      "run": [{ "id": "status", "task": "status-exec" }]
    }
  },
  "tasks": {
    "status-exec": {
      "kind": "command",
      "command": "echo",
      "args": ["status"]
    }
  }
}
