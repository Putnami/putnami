{
  "$schema": "https://putnami.dev/schemas/putnami-extension.json",
  "name": "sample/ecosystem-uses",
  "ecosystems": [
    {
      "id": "go",
      "coordinate": { "pattern": "^[a-z0-9.\\-/]+$" },
      "version": { "pattern": "^v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$", "ordering": "semver" },
      "channel": "none",
      "registries": {
        "type": "object",
        "properties": {
          "publish": { "type": "string" },
          "proxy": { "type": "string" }
        }
      },
      "publish": "publish-go"
    }
  ],
  "uses": ["oci"],
  "commands": {
    "publish-go": {
      "description": "Publish this module to the Go registry",
      "run": [{ "id": "publish", "task": "publish-go-exec" }]
    }
  },
  "tasks": {
    "publish-go-exec": {
      "kind": "command",
      "command": "echo",
      "args": ["published"]
    }
  }
}
