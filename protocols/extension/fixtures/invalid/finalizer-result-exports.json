{
  "$schema": "https://putnami.dev/schemas/putnami-extension.json",
  "name": "sample/finalizer-result-exports",
  "commands": {
    "test": {
      "run": [
        { "id": "setup", "task": "setup" },
        { "id": "run", "task": "run", "dependsOn": ["setup"] },
        {
          "id": "teardown",
          "task": "teardown",
          "runOn": "finally",
          "finalizes": { "producer": "setup", "consumers": ["run"] }
        }
      ],
      "outputs": {
        "summary": {
          "fromStep": "teardown",
          "path": "summary"
        }
      }
    }
  },
  "tasks": {
    "setup": {
      "kind": "command",
      "command": "echo",
      "cache": false,
      "declares": {
        "outputs": {
          "lease": {
            "kind": "file",
            "scope": "invocation",
            "path": "lease.json"
          }
        }
      }
    },
    "run": { "kind": "command", "command": "echo" },
    "teardown": {
      "kind": "command",
      "command": "echo",
      "outputs": {
        "summary": {
          "description": "A finalizer must not publish this."
        }
      }
    }
  }
}
