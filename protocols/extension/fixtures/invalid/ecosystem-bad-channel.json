{
  "$schema": "https://putnami.dev/schemas/putnami-extension.json",
  "name": "sample/ecosystem-bad-channel",
  "ecosystems": [
    {
      "id": "npm",
      "coordinate": { "pattern": "^[a-z0-9-]+$" },
      "version": { "pattern": "^v?\\d+$", "ordering": "semver" },
      "channel": "dist-tag",
      "registries": { "type": "object" },
      "publish": "publish-npm"
    }
  ],
  "commands": {
    "publish-npm": { "run": [{ "id": "publish", "task": "publish-exec" }] }
  },
  "tasks": {
    "publish-exec": { "kind": "command", "command": "echo", "args": ["published"] }
  }
}
