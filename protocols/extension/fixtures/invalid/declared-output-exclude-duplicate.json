{
  "$schema": "https://putnami.dev/schemas/putnami-extension.json",
  "commands": {
    "build": {
      "run": [{ "id": "generate", "task": "build-generate" }]
    }
  },
  "tasks": {
    "build-generate": {
      "kind": "command",
      "command": "echo",
      "declares": {
        "outputs": {
          "gen": {
            "kind": "directory",
            "path": ".gen",
            "excludes": [".gen/migration-bundle", ".gen/./migration-bundle/"],
            "description": "One subpath ceded twice, spelled differently, so the check is proven to compare normalized paths rather than raw strings."
          }
        }
      }
    }
  }
}
