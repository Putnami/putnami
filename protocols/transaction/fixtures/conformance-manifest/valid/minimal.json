{
  "protocol": "putnami.transaction.v1",
  "suite": "putnami.transaction.conformance.v1",
  "protocolVersion": 1,
  "cases": [
    {
      "id": "minimal.consume",
      "level": "required",
      "setup": {
        "tables": [
          {
            "name": "creds",
            "columns": [
              { "name": "id", "type": "text", "primaryKey": true },
              { "name": "consumed", "type": "boolean", "notNull": true, "default": "false" }
            ],
            "seed": [{ "id": "c1", "consumed": false }]
          }
        ]
      },
      "operations": [
        {
          "id": "claim",
          "table": "creds",
          "primitive": "consume-once",
          "args": { "keyColumn": "id", "key": "c1", "claimGuard": "consumed = false", "set": "consumed = true" },
          "expect": "applied"
        }
      ]
    }
  ]
}
