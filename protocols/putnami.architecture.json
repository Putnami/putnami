    "/protocols/transaction",
    "/protocols/workspace"
  ],
  "owns": [
    {
      "id": "protocols.wire-contracts",
      "kind": "schema",
      "description": "The strict wire formats, parsers, and validators every Putnami surface shares: one interpretation per document, reused by the CLI, extensions, and agents."
    }
  ],
  "exports": [
    {
      "id": "protocols.wire-contracts.v1",
      "version": 1,
      "status": "active",
      "description": "Strict contract types and validators for Putnami wire documents. Consumers hold a stable reference to the published contract packages; the protocols domain retains sole authority over document meaning.",
      "facts": [
        {
          "name": "wire_contract_definitions",
          "authority": "protocols"
        }
      ],
      "modes": [
        "reference"
      ],
      "compatibility": {
        "strategy": "additive",
        "minimumConsumerVersion": 1
      }
    }
  ],
  "imports": []
}
