{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "ports": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "tls": {
          "additionalProperties": false,
          "properties": {
            "cert": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "x-sensitive": true
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "app"
  ],
  "title": "nested-hash config",
  "type": "object"
}
