          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "canonical-digest-and-format-are-stable",
              "the-cloud-fmt-writes-or-checks-the-canonical-form"
            ]
          }
        },
        {
          "id": "review-is-guidance-without-authority",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "review-refuses-authority-and-malformed-input",
              "review-bounds-are-field-addressable",
              "review-guidance-enters-the-digest",
              "an-absent-review-keeps-the-canonical-bytes"
            ]
          }
        },
        {
          "id": "validating-commands-resolve-the-graph",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
