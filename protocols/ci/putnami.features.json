          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-deploy-binds-the-published-ref",
              "deployment-binding-fails-closed",
              "authored-intent-carries-no-release-set"
            ]
          }
        },
        {
          "id": "the-change-plan-v1-is-frozen",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-change-plan-v1-identity-is-pinned",
              "every-valid-change-plan-has-its-digest"
            ]
          }
        },
        {
          "id": "a-change-plan-is-admitted-only-when-canonical",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "every-invalid-change-plan-is-refused",
              "each-change-plan-defect-is-refused-alone",
              "transitive-dependents-keep-closure-order"
            ]
          }
        },
        {
          "id": "an-impact-plan-is-validated",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "every-impact-plan-fixture-gets-its-verdict",
              "each-impact-plan-defect-is-refused"
            ]
          }
        },
        {
          "id": "the-projection-is-one-change-plan",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
