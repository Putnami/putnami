{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "ci",
  "features": [
    {
      "id": "ci/ci-contract",
      "type": "feature",
      "name": "CI document, plan and verdict contract",
      "outcome": "A workspace declares its CI intent in a strict, versioned putnami.ci.json, and the commands that serve it, the CLI's impact plan and a CI plane's verdict each share one schema, one canonical form and one fixture corpus.",
      "owner": "tooling",
      "target": "coded",
      "requirements": [
        {
          "id": "the-document-is-version-3-and-strict",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "every-document-fixture-gets-its-verdict",
              "duplicate-keys-and-trailing-values-are-refused",
              "the-schema-is-closed-and-pinned-to-version-3"
            ]
          }
        },
        {
          "id": "commands-run-in-order-with-their-flags",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-workspace-fixture-carries-every-member",
              "authoring-shorthands-round-trip",
              "bad-references-and-bounds-are-refused"
            ]
          }
        },
        {
          "id": "the-runner-object-is-opaque",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-runner-is-kept-without-its-key-order"
            ]
          }
        },
        {
          "id": "rules-are-first-match",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-rule-has-exactly-one-trigger",
              "explain-takes-the-first-match",
              "a-tag-publishes-by-convention",
              "the-cloud-explain-names-the-rule-and-what-it-publishes"
            ]
          }
        },
        {
          "id": "branch-globs-are-slash-aware",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-glob-dialect-is-pinned"
            ]
          }
        },
        {
          "id": "distribution-is-a-closed-vocabulary",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "distribution-vocabulary-is-closed",
              "mirror-destinations-are-credential-free"
            ]
          }
        },
        {
          "id": "environments-follow-channels",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "environments-are-validated",
              "explain-lists-environments-per-channel"
            ]
          }
        },
        {
          "id": "retain-declares-a-channel-lifetime",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "retain-is-intent",
              "retain-spelling-and-placement-are-validated",
              "explain-reports-the-lifetime"
            ]
          }
        },
        {
          "id": "baseline-names-a-channel-the-rule-reads",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "baseline-is-intent",
              "baseline-placement-and-spelling-are-validated",
              "explain-reports-the-baseline"
            ]
          }
        },
        {
