            ]
          }
        },
        {
          "id": "the-verdict-corpus-is-the-conformance-case",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "every-verdict-fixture-gets-its-verdict",
              "the-verdict-corpus-covers-the-vocabulary",
              "a-verdict-round-trips"
            ]
          }
        },
        {
          "id": "the-answer-and-the-mark-are-folds",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "answers-fold-to-the-most-severe",
              "advisory-checks-never-change-the-answer",
              "the-mark-follows-the-answer-and-the-gaps"
            ]
          }
        },
        {
          "id": "gaps-name-what-is-missing-or-unknown",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "every-unapproved-declaration-is-a-gap",
              "unknown-evidence-keeps-a-passed-verdict-checked",
              "a-project-without-counts-is-unknown",
              "the-root-project-is-named"
            ]
          }
        },
        {
          "id": "a-verdict-is-validated",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "each-verdict-defect-is-refused",
              "the-verdict-bounds-are-admitted"
            ]
          }
        },
        {
          "id": "verdict-identities-are-canonical",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "project-ids-are-workspace-paths",
              "the-repository-is-a-credential-free-url",
              "the-reference-is-a-full-git-reference"
