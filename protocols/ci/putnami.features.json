          }
        },
        {
          "id": "verdicts-parse-strictly-against-one-schema",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "parse-verdict-is-strict-and-bounded",
              "the-verdict-schema-is-closed",
              "the-verdict-schema-tracks-the-go-types"
