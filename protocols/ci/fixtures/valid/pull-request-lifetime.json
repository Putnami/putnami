{
  "$schema": "https://putnami.dev/schemas/putnami-ci.json",
  "version": 3,
  "commands": [
    "lint",
    "test"
  ],
  "rules": [
    {
      "pullRequests": true,
      "publish": [
        "pr-{number}"
      ],
      "retain": "while-open"
    },
    {
      "branches": "release/*",
      "publish": [
        "rc"
      ],
      "retain": "30d"
    }
  ]
}
