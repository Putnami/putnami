{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "go.putnami.dev/protocol/ci",
  "visibility": "public",
  "tags": ["go", "protocol"],
  "extensions": ["/go/extension"],
  "publish": ["go"],
  "disable": {
    "jobs": ["serve"]
  },
  "options": {
    "test": {
