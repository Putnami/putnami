              "upload-results-are-validated",
              "an-upload-line-has-the-publication-bounds",
              "each-invalid-upload-fixture-fails-for-its-rule"
            ]
          }
        },
        {
          "id": "an-upload-is-refused-before-any-registry-request",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-cloud-provider-refuses-an-upload-before-any-registry-request",
