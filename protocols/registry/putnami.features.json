              "put-registry-members-are-planned-and-evidenced"
            ]
          }
        },
        {
          "id": "resolve-and-release-carry-distribution-documents",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-release-is-a-distribution-request",
              "null-is-deferred-only-inside-delegated-members"
            ]
          }
        },
        {
          "id": "plans-ancestry-and-evidence-are-validated",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-plan-is-validated",
              "an-ancestry-is-validated",
              "evidence-is-validated",
              "the-publication-parsers-refuse-malformed-input"
            ]
          }
        },
        {
          "id": "open-is-idempotent-and-release-final",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-cli-surfaces-plan-already-open-for-a-second-plan",
              "the-cli-sends-a-lost-release-once-more",
              "the-cloud-provider-opens-a-plan-once",
              "the-cloud-provider-releases-a-plan-once"
            ]
          }
        },
        {
          "id": "nothing-moves-before-an-open",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-cli-refuses-uploads-after-a-not-forward-open",
              "the-cli-moves-no-channel-on-a-not-forward-open",
              "the-cloud-provider-refuses-a-release-before-open"
            ]
          }
        },
        {
          "id": "uploader-v1-needs-publication-v1",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "upload-needs-both-capabilities",
              "uploader-v1-names-publication-v1",
              "the-cloud-provider-echoes-uploader-v1-only-beside-publication-v1"
            ]
          }
        },
        {
          "id": "the-uploader-tokens-are-pinned",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-uploader-tokens-are-pinned"
            ]
          }
        },
        {
          "id": "an-upload-carries-no-credential",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
