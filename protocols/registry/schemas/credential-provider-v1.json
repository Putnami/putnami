{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://putnami.dev/schemas/registry-credential-provider-v1.json",
  "title": "Registry credential provider version 1",
  "description": "One JSON line of the credential-provider RPC: an engine request or a provider response. Implementations must also enforce the rules documented in protocols/registry/README.md that this schema cannot express: the payload shape of a response, which depends on the op of the request it answers; sorted hosts; a port between 1 and 65535 and a host name of at most 253 bytes; the RFC 3339 UTC instant; a refusal message of at most 512 bytes, a providerName of at most 128 bytes and a runCredential of at most 16384 bytes of UTF-8, where maxLength counts characters; no U+FFFD replacement character; no null, no duplicate member, no trailing data, and the line size bound.",
  "oneOf": [{ "$ref": "#/definitions/request" }, { "$ref": "#/definitions/response" }],
  "definitions": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "id", "op"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "id": { "$ref": "#/definitions/id" },
        "op": { "enum": ["initialize", "credential", "shutdown"] },
        "payload": {
          "oneOf": [{ "$ref": "#/definitions/initializeParams" }, { "$ref": "#/definitions/credentialParams" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "initialize" } } },
          "then": { "required": ["payload"], "properties": { "payload": { "$ref": "#/definitions/initializeParams" } } }
        },
        {
          "if": { "properties": { "op": { "const": "credential" } } },
          "then": { "required": ["payload"], "properties": { "payload": { "$ref": "#/definitions/credentialParams" } } }
        },
        {
          "if": { "properties": { "op": { "const": "shutdown" } } },
          "then": { "not": { "required": ["payload"] } }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "id", "ok"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "id": { "$ref": "#/definitions/id" },
        "ok": { "type": "boolean" },
        "error": { "$ref": "#/definitions/refusal" },
        "payload": {
          "anyOf": [
            { "$ref": "#/definitions/initializeResult" },
            { "$ref": "#/definitions/credentialResult" }
          ]
        }
      },
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "required": ["error"], "not": { "required": ["payload"] } },
      "else": { "not": { "required": ["error"] } }
    },
    "id": { "type": "integer", "minimum": 1 },
    "capabilities": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" }
    },
    "initializeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "capabilities": { "$ref": "#/definitions/capabilities" },
        "runCredential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[^\t-\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]+$"
        }
      }
    },
    "initializeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "providerName": { "type": "string", "maxLength": 128, "pattern": "^[^\\x00-\\x1f\\x7f]*$" },
        "capabilities": { "$ref": "#/definitions/capabilities" }
      }
    },
    "credentialParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose"],
      "properties": {
        "purpose": { "enum": ["read", "publish"] }
      }
    },
    "credentialResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credential": { "$ref": "#/definitions/credential" }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bearer", "expiresAt", "hosts"],
      "properties": {
        "bearer": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[!-~]+$" },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 259,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*(:[1-9][0-9]{0,4})?$"
          }
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "message": { "type": "string", "maxLength": 512, "pattern": "^[^\\x00-\\x1f\\x7f]*$" }
      }
    }
  }
}
