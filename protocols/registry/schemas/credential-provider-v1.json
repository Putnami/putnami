{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://putnami.dev/schemas/registry-credential-provider-v1.json",
  "title": "Registry credential provider version 1",
  "description": "One JSON line of the credential-provider RPC: an engine request or a provider response. Implementations must also enforce the rules documented in protocols/registry/README.md that this schema cannot express: the payload shape of a response, which depends on the op of the request it answers; the ops resolve, open and release only on a session that negotiated publication-v1; the request and response members of resolve and release, which are distribution/release-set/v2 documents validated by that protocol; a planDigest equal to the digest of the plan; plan members unique, in (ecosystem, coordinate) order, that share the plan's sourceRevision; an immutableChannel listed in channels; ancestry channels that name the plan's or the release's channels in order, read from the plan's sourceRevision; ancestor true when headSourceRevision equals sourceRevision; no headSourceRevision for a release channel expected to have no head; evidence images unique, in project order, with a project without surrounding white space; evidence members unique, in (ecosystem, coordinate) order; sorted hosts; a port between 1 and 65535 and a host name of at most 253 bytes; the RFC 3339 UTC instant; a refusal message of at most 512 bytes, a providerName of at most 128 bytes, a runCredential of at most 16384 bytes, a coordinate or an evidence project of at most 512 bytes, and a version, publisher, command or step of at most 256 bytes of UTF-8, where maxLength counts characters; a plan of at most 1 MiB and evidence lists of at most 4 MiB each, encoded; no U+FFFD replacement character; no null outside the distribution documents, which admit null where that protocol does; no duplicate member, no trailing data, and the line size and nesting bounds of each op.",
  "oneOf": [{ "$ref": "#/definitions/request" }, { "$ref": "#/definitions/response" }],
  "definitions": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "id", "op"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "id": { "$ref": "#/definitions/id" },
        "op": { "enum": ["initialize", "credential", "shutdown", "resolve", "open", "release"] },
        "payload": {
          "oneOf": [
            { "$ref": "#/definitions/initializeParams" },
            { "$ref": "#/definitions/credentialParams" },
            { "$ref": "#/definitions/resolveParams" },
            { "$ref": "#/definitions/openParams" },
            { "$ref": "#/definitions/releaseParams" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "initialize" } } },
          "then": { "required": ["payload"], "properties": { "payload": { "$ref": "#/definitions/initializeParams" } } }
        },
        {
          "if": { "properties": { "op": { "const": "credential" } } },
          "then": { "required": ["payload"], "properties": { "payload": { "$ref": "#/definitions/credentialParams" } } }
        },
        {
          "if": { "properties": { "op": { "const": "shutdown" } } },
          "then": { "not": { "required": ["payload"] } }
        },
        {
          "if": { "properties": { "op": { "const": "resolve" } } },
          "then": { "required": ["payload"], "properties": { "payload": { "$ref": "#/definitions/resolveParams" } } }
        },
        {
          "if": { "properties": { "op": { "const": "open" } } },
          "then": { "required": ["payload"], "properties": { "payload": { "$ref": "#/definitions/openParams" } } }
        },
        {
          "if": { "properties": { "op": { "const": "release" } } },
          "then": { "required": ["payload"], "properties": { "payload": { "$ref": "#/definitions/releaseParams" } } }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "id", "ok"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "id": { "$ref": "#/definitions/id" },
        "ok": { "type": "boolean" },
        "error": { "$ref": "#/definitions/refusal" },
        "payload": {
          "anyOf": [
            { "$ref": "#/definitions/initializeResult" },
            { "$ref": "#/definitions/credentialResult" },
            { "$ref": "#/definitions/resolveResult" },
            { "$ref": "#/definitions/openResult" },
            { "$ref": "#/definitions/releaseResult" }
          ]
        }
      },
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "required": ["error"], "not": { "required": ["payload"] } },
      "else": { "not": { "required": ["error"] } }
    },
    "id": { "type": "integer", "minimum": 1 },
    "capabilities": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" }
    },
    "initializeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "capabilities": { "$ref": "#/definitions/capabilities" },
        "runCredential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[^\t-\r \u0085   -     　]+$"
        }
      }
    },
    "initializeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "providerName": { "type": "string", "maxLength": 128, "pattern": "^[^\\x00-\\x1f\\x7f]*$" },
        "capabilities": { "$ref": "#/definitions/capabilities" }
      }
    },
    "credentialParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose"],
      "properties": {
        "purpose": { "enum": ["read", "publish"] }
      }
    },
    "credentialResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credential": { "$ref": "#/definitions/credential" }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bearer", "expiresAt", "hosts"],
      "properties": {
        "bearer": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[!-~]+$" },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 259,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*(:[1-9][0-9]{0,4})?$"
          }
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "message": { "type": "string", "maxLength": 512, "pattern": "^[^\\x00-\\x1f\\x7f]*$" }
      }
    },
    "resolveParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": { "type": "object", "required": ["channels"], "not": { "required": ["releaseId"] } }
      }
    },
    "resolveResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response"],
      "properties": {
        "response": { "type": "object", "required": ["heads"], "not": { "required": ["release"] } }
      }
    },
    "openParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "ancestry"],
      "properties": {
        "plan": { "$ref": "#/definitions/plan" },
        "ancestry": { "$ref": "#/definitions/ancestry" }
      }
    },
    "openResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planDigest"],
      "properties": {
        "planDigest": { "$ref": "#/definitions/digest" }
      }
    },
    "releaseParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planDigest", "request", "ancestry", "evidence"],
      "properties": {
        "planDigest": { "$ref": "#/definitions/digest" },
        "request": { "type": "object" },
        "ancestry": { "$ref": "#/definitions/ancestry" },
        "evidence": { "$ref": "#/definitions/evidence" }
      }
    },
    "releaseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response"],
      "properties": {
        "response": { "type": "object" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "namespace", "sourceRevision", "channels", "members", "planDigest"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "sourceRevision": { "$ref": "#/definitions/sourceRevision" },
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/channel" }
        },
        "immutableChannel": { "$ref": "#/definitions/channel" },
        "members": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/definitions/planMember" } },
        "planDigest": { "$ref": "#/definitions/digest" }
      }
    },
    "planMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "coordinate", "version", "sourceRevision", "selectionFingerprint"],
      "properties": {
        "ecosystem": { "$ref": "#/definitions/ecosystem" },
        "coordinate": { "$ref": "#/definitions/coordinate" },
        "version": { "$ref": "#/definitions/version" },
        "sourceRevision": { "$ref": "#/definitions/sourceRevision" },
        "selectionFingerprint": { "$ref": "#/definitions/digest" }
      }
    },
    "ancestry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRevision", "snapshotCommits", "channels"],
      "properties": {
        "sourceRevision": { "$ref": "#/definitions/sourceRevision" },
        "snapshotCommits": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "channels": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/definitions/channelAncestry" } }
      }
    },
    "channelAncestry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ancestor"],
      "properties": {
        "name": { "$ref": "#/definitions/channel" },
        "headSourceRevision": { "$ref": "#/definitions/sourceRevision" },
        "ancestor": { "type": "boolean" }
      },
      "if": { "not": { "required": ["headSourceRevision"] } },
      "then": { "properties": { "ancestor": { "const": false } } }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "members"],
      "properties": {
        "images": { "type": "array", "items": { "$ref": "#/definitions/imageEvidence" } },
        "members": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/definitions/memberEvidence" } }
      }
    },
    "imageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "digest"],
      "properties": {
        "project": { "type": "string", "minLength": 1, "maxLength": 512 },
        "digest": { "$ref": "#/definitions/digest" }
      }
    },
    "memberEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "ecosystem", "coordinate", "version", "digest", "publisher", "command", "step"],
      "properties": {
        "project": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\x00-\\x1f\\x7f]*$" },
        "ecosystem": { "$ref": "#/definitions/ecosystem" },
        "coordinate": { "$ref": "#/definitions/coordinate" },
        "version": { "$ref": "#/definitions/version" },
        "digest": { "$ref": "#/definitions/digest" },
        "publisher": { "$ref": "#/definitions/routeName" },
        "command": { "$ref": "#/definitions/routeName" },
        "step": { "$ref": "#/definitions/routeName" }
      }
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "channel": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "ecosystem": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "coordinate": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\x00-\\x1f\\x7f]*$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1f\\x7f]*$" },
    "routeName": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1f\\x7f]*$" }
  }
}
