{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "go.putnami.dev/protocol/template",
  "visibility": "public",
  "tags": ["go", "protocol"],
  "extensions": ["/go/extension"],
  "publish": ["go"],
  "disable": {
    "jobs": ["serve"]
  },
  "options": {
    "publish": {
      "archives": false
    }
  },
  "featureAuthority": {
    "none": "A template manifest declares identity only; the scaffolding outcome belongs to `@putnami/scaffold`."
  }
}
