{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnami.dev/schemas/putnami-session-reporting.json",
  "title": "Native session reporting transport",
  "oneOf": [
    {
      "$ref": "#/$defs/chunk"
    },
    {
      "$ref": "#/$defs/ack"
    }
  ],
  "$defs": {
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "sessionId",
        "artifact",
        "offset",
        "sequence",
        "data",
        "sha256",
        "final"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
        },
        "artifact": {
          "enum": [
            "events.jsonl",
            "session.json"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 87384
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "final": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "final": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "data": {
                "minLength": 4
              }
            }
          }
        }
      ]
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "sessionId",
        "artifact",
        "offset",
        "sequence",
        "sha256",
        "final",
        "ok"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
        },
        "artifact": {
          "enum": [
            "events.jsonl",
            "session.json"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "final": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "retryable": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "code"
            ]
          },
          "else": {
            "properties": {
              "retryable": {
                "const": false
              }
            },
            "not": {
              "required": [
                "code"
              ]
            }
          }
        }
      ]
    }
  }
}
