{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnami.dev/schemas/putnami-session-reporting.json",
  "title": "Native session reporting transport",
  "oneOf": [
    {
      "$ref": "#/$defs/chunk"
    },
    {
      "$ref": "#/$defs/ack"
    },
    {
      "$ref": "#/$defs/handshake"
    },
    {
      "$ref": "#/$defs/handshakeResult"
    }
  ],
  "$defs": {
    "chunk": {
      "description": "One frame of a persisted session artifact. A plan.json frame starts at or before 16777216 decoded bytes; the Go and TypeScript parsers also refuse one whose offset plus decoded data length exceeds it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "sessionId",
        "artifact",
        "offset",
        "sequence",
        "data",
        "sha256",
        "final"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
        },
        "artifact": {
          "enum": [
            "events.jsonl",
            "session.json",
            "plan.json"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 87384
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "final": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "final": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "data": {
                "minLength": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact": {
                "const": "plan.json"
              }
            }
          },
          "then": {
            "properties": {
              "offset": {
                "maximum": 16777216
              }
            }
          }
        }
      ]
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "sessionId",
        "artifact",
        "offset",
        "sequence",
        "sha256",
        "final",
        "ok"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
        },
        "artifact": {
          "enum": [
            "events.jsonl",
            "session.json",
            "plan.json"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "final": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "retryable": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "code"
            ]
          },
          "else": {
            "properties": {
              "retryable": {
                "const": false
              }
            },
            "not": {
              "required": [
                "code"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact": {
                "const": "plan.json"
              }
            }
          },
          "then": {
            "properties": {
              "offset": {
                "maximum": 16777216
              }
            }
          }
        }
      ]
    },
    "handshake": {
      "description": "An engine line of the v2 handshake. initialize carries no credential; authenticate carries the run credential of a hosted run. maxLength bounds the credential in characters; the Go and TypeScript parsers also bound its UTF-8 encoding to 16384 bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "op"
      ],
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "op": {
          "enum": [
            "initialize",
            "authenticate"
          ]
        },
        "runCredential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[^\\t\\n\\u000b\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]+(?![\\s\\S])"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "authenticate"
              }
            }
          },
          "then": {
            "required": [
              "runCredential"
            ]
          },
          "else": {
            "not": {
              "required": [
                "runCredential"
              ]
            }
          }
        }
      ]
    },
    "handshakeResult": {
      "description": "A reporter's answer to one handshake line.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "op",
        "ok"
      ],
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "op": {
          "enum": [
            "initialize",
            "authenticate"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "code"
            ]
          },
          "else": {
            "not": {
              "required": [
                "code"
              ]
            }
          }
        }
      ]
    }
  }
}
