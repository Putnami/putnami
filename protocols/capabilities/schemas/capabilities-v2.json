{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://putnami.dev/schemas/putnami-capabilities-v2.json",
  "title": "Putnami Capability Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "project"],
  "properties": {
    "$schema": { "type": "string" },
    "protocolVersion": {
      "$comment": "Readers require the exact JSON integer token 2; numeric equivalents such as 2.0 and 2e0 are invalid.",
      "type": "integer",
      "const": 2
    },
    "project": { "type": "string", "minLength": 1 },
    "configDefinitions": { "type": "array", "items": { "$ref": "#/$defs/configDefinition" } },
    "schemas": { "type": "array", "items": { "$ref": "#/$defs/schemaContribution" } },
    "discoverers": { "type": "array", "items": { "$ref": "#/$defs/discoverer" } },
    "migrations": { "type": "array", "items": { "$ref": "#/$defs/migrationBundle" } },
    "infraRequirements": { "type": "array", "items": { "$ref": "#/$defs/infraRequirement" } },
    "healthContributors": { "type": "array", "items": { "$ref": "#/$defs/healthContributor" } },
    "lifecycleHooks": { "type": "array", "items": { "$ref": "#/$defs/lifecycleHook" } },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/package" } },
    "packageVersions": { "type": "array", "items": { "$ref": "#/$defs/packageVersion" }, "deprecated": true, "$comment": "Accepted for historical v2 manifests; current producers and canonicalizers omit resolved dependency state." },
    "requiredCapabilities": { "type": "array", "items": { "$ref": "#/$defs/requiredCapability" } },
    "domainAccess": { "type": "array", "items": { "$ref": "#/$defs/domainAccess" } }
  },
  "$defs": {
    "sourceKind": { "type": "string", "enum": ["framework", "manual", "generated"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerProject", "kind", "key"],
      "properties": {
        "ownerProject": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["config", "schema", "discoverer", "migration", "infra", "health", "lifecycle", "package", "requiredCapability"] },
        "subkind": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "root": { "type": "string", "enum": ["workspace", "project", "package"] },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path"],
      "properties": {
        "root": { "$ref": "#/$defs/root" },
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path"],
      "properties": {
        "root": { "$ref": "#/$defs/root" },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "sourceKind", "declaration"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "package": { "type": "string" },
        "version": { "type": "string", "deprecated": true, "$comment": "Accepted for historical v2 manifests; current producers and canonicalizers omit resolved dependency state." },
        "sourceKind": { "$ref": "#/$defs/sourceKind" },
        "sourceBinding": { "type": "string", "pattern": "^source-v1:sha256:[0-9a-f]{64}$", "deprecated": true },
        "declaration": { "$ref": "#/$defs/declaration" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "configField": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "sensitive": { "type": "boolean" } }
    },
    "configDefinition": {
      "type": "object", "additionalProperties": false, "required": ["identity", "path", "provenance"],
      "properties": { "identity": { "$ref": "#/$defs/identity" }, "path": { "type": "string" }, "fields": { "type": "array", "items": { "$ref": "#/$defs/configField" } }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "schemaContribution": {
      "type": "object", "additionalProperties": false, "required": ["identity", "name", "kind", "provenance"],
      "properties": { "identity": { "$ref": "#/$defs/identity" }, "name": { "type": "string" }, "kind": { "type": "string", "enum": ["route", "openapi", "proto"] }, "path": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "discoverer": {
      "type": "object", "additionalProperties": false, "required": ["identity", "name", "kind", "provenance"],
      "properties": { "identity": { "$ref": "#/$defs/identity" }, "name": { "type": "string" }, "kind": { "type": "string", "enum": ["source", "config"] }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "migrationBundle": {
      "type": "object", "additionalProperties": false, "required": ["identity", "name", "kind", "provenance"],
      "properties": { "identity": { "$ref": "#/$defs/identity" }, "name": { "type": "string" }, "kind": { "type": "string", "minLength": 1 }, "datasource": { "type": "string" }, "digest": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "infraRequirement": {
      "type": "object", "additionalProperties": false, "required": ["identity", "name", "kind", "provenance"],
      "properties": { "identity": { "$ref": "#/$defs/identity" }, "name": { "type": "string" }, "kind": { "type": "string", "enum": ["database", "events", "storage", "secret", "scheduledJob"] }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "healthContributor": {
      "type": "object", "additionalProperties": false, "required": ["identity", "name", "probe", "provenance"],
      "properties": { "identity": { "$ref": "#/$defs/identity" }, "name": { "type": "string" }, "probe": { "type": "string", "enum": ["health", "liveness", "readiness"] }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "lifecycleHook": {
      "type": "object", "additionalProperties": false, "required": ["identity", "name", "phase", "provenance"],
      "properties": { "identity": { "$ref": "#/$defs/identity" }, "name": { "type": "string" }, "phase": { "type": "string", "enum": ["starter", "stopper"] }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "package": {
      "type": "object", "additionalProperties": false, "required": ["identity", "package", "provenance"],
      "properties": { "identity": { "$ref": "#/$defs/identity" }, "package": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "packageVersion": {
      "type": "object", "additionalProperties": false, "required": ["identity", "package", "version", "provenance"],
      "properties": { "identity": { "$ref": "#/$defs/identity" }, "package": { "type": "string" }, "version": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "capabilityKind": { "type": "string", "enum": ["config", "schema", "discoverer", "migration", "datasource", "infra", "health", "liveness", "readiness", "lifecycle", "package"] },
    "requiredCapability": {
      "type": "object", "additionalProperties": false, "required": ["identity", "name", "requires", "provenance"],
      "properties": { "identity": { "$ref": "#/$defs/identity" }, "name": { "type": "string" }, "requires": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capabilityKind" } }, "provenance": { "$ref": "#/$defs/provenance" } }
    },
    "domainAccessTransport": {
      "$comment": "Carrier vocabulary is carried verbatim from protocols/architecture and stays unconstrained here; that protocol owns what a kind or an availability means.",
      "type": "object", "additionalProperties": false, "required": ["role", "kind", "availability"],
      "properties": { "role": { "type": "string" }, "kind": { "type": "string" }, "contract": { "type": "string" }, "availability": { "type": "string" } }
    },
    "domainAccessEnforcement": {
      "type": "object", "additionalProperties": false,
      "properties": { "maxStaleness": { "type": "string" }, "onMissing": { "type": "string" }, "onStale": { "type": "string" }, "ordering": { "type": "string" }, "lateEvents": { "type": "string" }, "deletion": { "type": "string" }, "writer": { "type": "string" }, "rebuild": { "type": "string" } }
    },
    "domainAccess": {
      "$comment": "Evidence that a running component enforces one Domain Access & Replication Contract. It never creates a permission: the contract itself is declared and reviewed in a putnami.architecture.json.",
      "type": "object", "additionalProperties": false, "required": ["identity", "import", "mode", "status", "provenance"],
      "properties": { "identity": { "$ref": "#/$defs/identity" }, "import": { "type": "string" }, "mode": { "type": "string" }, "status": { "type": "string" }, "transports": { "type": "array", "items": { "$ref": "#/$defs/domainAccessTransport" } }, "enforced": { "$ref": "#/$defs/domainAccessEnforcement" }, "provenance": { "$ref": "#/$defs/provenance" } }
    }
  }
}
