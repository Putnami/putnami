{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnami.dev/schemas/putnami-collaboration-proposals.v1.json",
  "title": "Putnami change proposals contract, version 1",
  "description": "Request (<operation>Input) and result (<operation>Result) documents of every proposals v1 operation. Required: find, upsert, status, review. Optional: comments, merge.",
  "$defs": {
    "proposalState": {
      "type": "string",
      "enum": ["closed", "draft", "merged", "open"]
    },
    "change": {
      "type": "object",
      "description": "The exact identity a proposal is associated with. A request may omit repository, and the provider then applies its configured repository; every proposal a provider returns names all three members.",
      "additionalProperties": false,
      "required": ["base", "head"],
      "properties": {
        "repository": { "$ref": "collaboration.json#/$defs/token" },
        "base": { "$ref": "collaboration.json#/$defs/token" },
        "head": { "$ref": "collaboration.json#/$defs/token" },
        "headCommit": { "$ref": "collaboration.json#/$defs/commit" }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "revision", "change", "title", "state"],
      "properties": {
        "ref": { "$ref": "collaboration.json#/$defs/ref" },
        "revision": { "$ref": "collaboration.json#/$defs/token" },
        "url": { "$ref": "collaboration.json#/$defs/url" },
        "change": { "$ref": "#/$defs/change" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "body": { "type": "string" },
        "state": { "$ref": "#/$defs/proposalState" },
        "providerState": { "type": "string", "maxLength": 64 },
        "labels": {
          "$ref": "collaboration.json#/$defs/labels",
          "description": "The proposal's labels, including those the provider applies from its settings. Absent: the provider does not report labels. Empty: the proposal carries none."
        },
        "assignees": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": { "$ref": "collaboration.json#/$defs/token" },
          "description": "The accounts assigned to the proposal, including one the provider assigns from its settings. Absent: the provider does not report assignees. Empty: nobody is assigned. Informational, never an exclusive lease."
        },
        "updatedAt": { "$ref": "collaboration.json#/$defs/timestamp" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["failing", "none", "passing", "pending", "unsupported"],
          "description": "none: checks are supported and none are reported. unsupported: the provider has no hosted checks, and detail says so."
        },
        "commit": { "$ref": "collaboration.json#/$defs/commit" },
        "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/check" } },
        "detail": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "state": { "type": "string", "enum": ["failing", "passing", "pending", "skipped"] },
        "url": { "$ref": "collaboration.json#/$defs/url" }
      }
    },
    "reviewVerdict": {
      "type": "string",
      "enum": ["approve", "comment", "request_changes"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "verdict"],
      "properties": {
        "ref": { "$ref": "collaboration.json#/$defs/ref" },
        "url": { "$ref": "collaboration.json#/$defs/url" },
        "verdict": { "$ref": "#/$defs/reviewVerdict" },
        "commit": { "$ref": "collaboration.json#/$defs/commit" },
        "author": { "$ref": "collaboration.json#/$defs/token" },
        "submittedAt": { "$ref": "collaboration.json#/$defs/timestamp" }
      }
    },
    "comment": {
      "type": "object",
      "description": "One text someone wrote on a proposal: a review's body, a comment on a file or on one line of it, or a comment on the proposal as a whole. A comment on no file has no path.",
      "additionalProperties": false,
      "required": ["ref", "body"],
      "properties": {
        "ref": { "$ref": "collaboration.json#/$defs/ref" },
        "url": { "$ref": "collaboration.json#/$defs/url" },
        "author": { "$ref": "collaboration.json#/$defs/token" },
        "submittedAt": { "$ref": "collaboration.json#/$defs/timestamp" },
        "review": { "$ref": "collaboration.json#/$defs/ref", "description": "The review the comment belongs to." },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "The repository-relative path of the file the comment is anchored to." },
        "line": { "type": "integer", "minimum": 1, "description": "The line of path, in the file at commit, the comment is anchored to; absent for a comment on the whole file, and when that line was deleted or is no longer in the change. Never present without path." },
        "commit": { "$ref": "collaboration.json#/$defs/commit", "description": "The commit whose file line refers to; not necessarily the commit the comment was written on." },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "findInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change"],
      "properties": {
        "change": { "$ref": "#/$defs/change" },
        "states": { "type": "array", "items": { "$ref": "#/$defs/proposalState" } },
        "page": { "$ref": "collaboration.json#/$defs/pageRequest" }
      }
    },
    "findResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "page"],
      "properties": {
        "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/proposal" } },
        "page": { "$ref": "collaboration.json#/$defs/page" }
      }
    },
    "upsertInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "title"],
      "properties": {
        "change": { "$ref": "#/$defs/change" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "body": { "type": "string" },
        "draft": { "type": "boolean" },
        "expectedRevision": { "$ref": "collaboration.json#/$defs/token" }
      }
    },
    "upsertResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal", "created"],
      "properties": {
        "proposal": { "$ref": "#/$defs/proposal" },
        "created": { "type": "boolean" }
      }
    },
    "statusInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "collaboration.json#/$defs/ref" }
      }
    },
    "statusResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal", "checks"],
      "properties": {
        "proposal": { "$ref": "#/$defs/proposal" },
        "checks": { "$ref": "#/$defs/checks" },
        "reviews": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/review" } }
      }
    },
    "reviewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "verdict", "body", "idempotencyKey"],
      "properties": {
        "ref": { "$ref": "collaboration.json#/$defs/ref" },
        "verdict": { "$ref": "#/$defs/reviewVerdict" },
        "body": { "type": "string" },
        "commit": { "$ref": "collaboration.json#/$defs/commit" },
        "idempotencyKey": { "$ref": "collaboration.json#/$defs/idempotencyKey" }
      }
    },
    "reviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review", "created"],
      "properties": {
        "review": { "$ref": "#/$defs/review" },
        "created": { "type": "boolean" }
      }
    },
    "commentsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "collaboration.json#/$defs/ref" },
        "page": { "$ref": "collaboration.json#/$defs/pageRequest" }
      }
    },
    "commentsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "page"],
      "properties": {
        "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/comment" } },
        "page": { "$ref": "collaboration.json#/$defs/page" }
      }
    },
    "mergeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "expectedHeadCommit"],
      "properties": {
        "ref": { "$ref": "collaboration.json#/$defs/ref" },
        "expectedHeadCommit": { "$ref": "collaboration.json#/$defs/commit" },
        "method": { "type": "string", "enum": ["merge", "rebase", "squash"] }
      }
    },
    "mergeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal"],
      "properties": {
        "proposal": { "$ref": "#/$defs/proposal" }
      }
    }
  }
}
