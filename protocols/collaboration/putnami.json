{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "go.putnami.dev/protocol/collaboration",
  "visibility": "public",
  "tags": ["go", "protocol"],
  "extensions": ["/go/extension", "/tooling/sdd-extension"],
  "publish": ["go"],
  "disable": {
    "jobs": ["serve"]
  },
  "options": {
    "publish": {
      "archives": false
    },
    "test": {
      "filePatterns": ["fixtures/**", "schemas/**"]
    },
    "sdd": {
      "verification": {
        "specs": "enforce"
      }
    }
  }
}
