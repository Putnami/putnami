{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://putnami.dev/schemas/runner-execution-request-v1.json",
  "title": "Runner execution request version 1",
  "description": "The bound portable execution request. Implementations must also enforce the semantic ordering, edge, identity, digest and strict JSON rules documented in protocols/runner/README.md; the schema describes the structural shape only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "protocol", "source", "invocation", "selection", "plan", "environment", "control"],
  "properties": {
    "version": { "const": 1 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "capabilities"],
      "properties": {
        "version": { "const": 1 },
        "capabilities": { "$ref": "#/definitions/sortedStrings" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "indexDigest", "git", "versions"],
      "properties": {
        "digest": { "$ref": "#/definitions/digest" },
        "indexDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "git": { "$ref": "runner-git-context-v1.json" },
        "tree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fingerprint", "dirty", "headSHA"],
          "properties": {
            "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "dirty": { "type": "boolean" },
            "headSHA": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
          }
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line", "base", "full", "sha", "branch", "suffix", "tag", "tagged", "dirty"],
            "properties": {
              "line": { "$ref": "#/definitions/text" },
              "base": { "$ref": "#/definitions/text" },
              "full": { "$ref": "#/definitions/text" },
              "sha": { "$ref": "#/definitions/text" },
              "branch": { "$ref": "#/definitions/text" },
              "suffix": { "$ref": "#/definitions/text" },
              "tag": { "$ref": "#/definitions/text" },
              "tagged": { "type": "boolean" },
              "dirty": { "type": "boolean" }
            }
          }
        },
        "bound": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": { "$ref": "#/definitions/path" },
          "description": "Sorted, unique workspace-relative paths the submitting engine admitted as required ignored inputs: each is ignored by Git in the source worktree, selected as an input by a planned task, and flagged bound in the manifest. Absent when none; an explicit empty list is rejected as non-canonical."
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "params", "flags", "cwd"],
      "properties": {
        "commands": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/definitions/identifier" } },
        "params": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "enum": ["string", "bool", "int", "float", "strings"] },
              "value": {}
            },
            "description": "value must match type: string, boolean, integer, finite number, or array of strings"
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["noCache", "noCacheExplicit", "retryFailed", "continueOnError", "impactedStrict", "verbose", "debug", "quiet", "retry", "maxParallel", "maxParallelMode", "cpuBudgetPolicy", "cacheTrust", "output", "profile", "resourceBudgets"],
          "properties": {
            "noCache": { "type": "boolean" },
            "noCacheExplicit": { "type": "boolean" },
            "retryFailed": { "type": "boolean" },
            "continueOnError": { "type": "boolean" },
            "impactedStrict": { "type": "boolean" },
            "verbose": { "type": "boolean" },
            "debug": { "type": "boolean" },
            "quiet": { "type": "boolean" },
            "retry": { "type": "integer", "minimum": 0 },
            "maxParallel": { "type": "integer", "minimum": 0 },
            "maxParallelMode": { "$ref": "#/definitions/text" },
            "cpuBudgetPolicy": { "$ref": "#/definitions/text" },
            "cacheTrust": { "$ref": "#/definitions/text" },
            "output": { "$ref": "#/definitions/text" },
            "profile": { "$ref": "#/definitions/text" },
            "resourceBudgets": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "integer", "minimum": 0 } }
          }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["install", "publish"] },
          "description": "sorted; absent when no provider is enabled, never an empty list"
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["barrier"],
          "properties": {
            "barrier": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/identifier" },
              "description": "sorted; each entry is one of invocation.commands and none is a publication command"
            }
          },
          "description": "required when the plan holds a task of a publication command (checked by the protocol); the executing engine, which classifies by declared effects, also refuses it over a plan with no registry or cloud effect; each publication task depends, transitively, on every task of every barrier command"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedMode", "mode", "scoped", "projects", "baseline", "baselineSource", "changedPaths", "diagnostics", "noCacheProjects"],
      "properties": {
        "requestedMode": { "enum": ["all", "impacted", "projects"] },
        "mode": { "enum": ["all", "impacted", "projects"] },
        "scoped": { "type": "boolean" },
        "projects": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
        "baseline": { "type": "string", "pattern": "^(?:|[0-9a-f]{40}|[0-9a-f]{64})$" },
        "baselineSource": { "$ref": "#/definitions/text" },
        "changedPaths": { "$ref": "#/definitions/sortedStrings" },
        "diagnostics": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "noCacheProjects": { "$ref": "#/definitions/sortedStrings" },
        "taskScopes": {
          "type": "object",
          "description": "selected project id → the sorted tasks of it the change reaches, each `[<extension-project-id>#]<command>~<step>` (a submitter that resolved no task declarations sends bare extension project ids instead); a project absent here runs every task",
          "additionalProperties": { "$ref": "#/definitions/sortedStrings", "minItems": 1 }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identity", "dependsOn", "serializeAfter", "contractDigest", "deadlineMs", "cacheable", "resources"],
            "properties": {
              "identity": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "scope", "project", "task", "provider"],
                "properties": {
                  "key": { "$ref": "#/definitions/text" },
                  "scope": { "enum": ["project", "workspace"] },
                  "project": { "type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": { "id": { "$ref": "#/definitions/text" }, "name": { "$ref": "#/definitions/text" } } },
                  "task": { "type": "object", "additionalProperties": false, "required": ["name", "command", "kind"], "properties": { "name": { "$ref": "#/definitions/text" }, "command": { "$ref": "#/definitions/text" }, "step": { "$ref": "#/definitions/text" }, "kind": { "$ref": "#/definitions/text" } } },
                  "provider": { "type": "object", "additionalProperties": false, "required": ["extension"], "properties": { "extension": { "$ref": "#/definitions/text" }, "version": { "$ref": "#/definitions/text" } } }
                }
              },
              "dependsOn": { "$ref": "#/definitions/sortedStrings" },
              "serializeAfter": { "$ref": "#/definitions/sortedStrings" },
              "contractDigest": { "type": "string", "pattern": "^(?:|[a-z0-9]{1,16}:[0-9a-f]{64})$" },
              "deadlineMs": { "type": "integer", "minimum": 1 },
              "cacheable": { "type": "boolean" },
              "resources": {
                "type": "object",
                "additionalProperties": false,
                "required": ["heavy", "cpuWeight", "reads", "writes"],
                "properties": {
                  "heavy": { "type": "boolean" },
                  "cpuWeight": { "type": "number", "exclusiveMinimum": 0 },
                  "reads": { "$ref": "#/definitions/resources" },
                  "writes": { "$ref": "#/definitions/resources" }
                }
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "extensions", "toolchains", "platform"],
      "properties": {
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "version"],
          "properties": {
            "source": { "enum": ["workspace", "published", "unpinned"] },
            "version": { "$ref": "#/definitions/text" }
          }
        },
        "extensions": { "$ref": "#/definitions/components" },
        "toolchains": { "$ref": "#/definitions/components" },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "arch"],
          "properties": { "os": { "$ref": "#/definitions/identifier" }, "arch": { "$ref": "#/definitions/identifier" } }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caller", "idempotencyKey", "deadline"],
      "properties": {
        "caller": { "const": "cli" },
        "idempotencyKey": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "deadline": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" }
      }
    }
  },
  "definitions": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\:*?\"<>|\\u0000-\\u001f\\u007f]+$",
      "description": "Canonical slash-separated relative source path, the source-manifest path rule."
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "text": { "type": "string", "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9._@/~-]+$" },
    "sortedStrings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 }, "description": "sorted by UTF-8 bytes, strictly increasing" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope"],
        "properties": { "id": { "$ref": "#/definitions/text" }, "scope": { "$ref": "#/definitions/text" } }
      },
      "description": "sorted by scope then id, strictly increasing"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": { "name": { "$ref": "#/definitions/text" }, "version": { "$ref": "#/definitions/text" } }
      },
      "description": "sorted by unique name"
    }
  }
}
