{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnami.dev/schemas/clientgen-external-v2.json",
  "title": "Putnami external client contract inventory v2",
  "description": "One project's clientgen.external.json, in the project directory. The directory names the project, so no entry does.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "contracts"],
  "properties": {
    "protocolVersion": {
      "const": 2
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    }
  },
  "$defs": {
    "workspacePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!/|.*(?:^|/)\\.\\.(?:/|$)|.*\\\\).+)$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "adapter", "callsites", "owner", "tests", "reason"],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1,
          "description": "Stable upstream authority for the third-party contract."
        },
        "adapter": {
          "$ref": "#/$defs/workspacePath",
          "description": "Workspace source file that adapts the external contract to the consumer."
        },
        "callsites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/callsite"
          },
          "description": "Sorted concrete transport expressions owned by this adapter authority."
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Team or person responsible for the adapter."
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workspacePath"
          },
          "description": "Sorted workspace paths to executable adapter contract tests."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why the upstream contract cannot use the first-party provider path."
        }
      }
    },
    "callsite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "transport", "symbol", "fingerprint"],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        },
        "transport": {
          "enum": ["connect", "http", "putnami-client", "sse", "websocket"]
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
