      "continuation": "cursor",
      "requested": true,
      "acknowledgment": ["putnami.sse.v2"],
      "query": {},
      "body": ["data: {\"cursor\":\"c1\",\"line\":\"a\"}\n\n", "event: complete\ndata: {}\n\n"],
      "end": "close",
      "expect": { "outcome": "contract-error", "messages": [], "deliveredCursor": null }
    },
    {
      "name": "an old runtime reads the legacy framing to its end",
      "continuation": "cursor",
      "requested": false,
      "acknowledgment": [],
      "query": {},
      "body": [
        "data: {\"cursor\":\"c1\",\"line\":\"a\"}\n\n",
        "data: {\"cursor\":\"c2\",\"line\":\"b\"}\n\n"
      ],
      "end": "close",
      "expect": {
        "outcome": "complete",
        "messages": [{ "cursor": "c1", "line": "a" }, { "cursor": "c2", "line": "b" }],
        "deliveredCursor": null
      }
    },
    {
      "name": "a legacy reset is a transport error",
      "continuation": "cursor",
      "requested": false,
      "acknowledgment": [],
      "query": {},
      "body": ["data: {\"cursor\":\"c1\",\"line\":\"a\"}\n\n"],
      "end": "reset",
      "expect": {
        "outcome": "transport-error",
        "messages": [{ "cursor": "c1", "line": "a" }],
        "deliveredCursor": null
      }
    },
    {
      "name": "a legacy incomplete event is a contract error",
      "continuation": "cursor",
      "requested": false,
      "acknowledgment": [],
      "query": {},
      "body": ["data: {\"cursor\":\"c1\",\"line\":\"a\"}\n\n", "data: {\"cursor\":\"c2\""],
      "end": "close",
      "expect": {
        "outcome": "contract-error",
        "messages": [{ "cursor": "c1", "line": "a" }],
        "deliveredCursor": null
      }
    },
    {
      "name": "a legacy typed error stays a terminal",
      "continuation": "cursor",
      "requested": false,
      "acknowledgment": [],
      "query": {},
      "body": ["event: error\ndata: {\"status\":403,\"code\":\"forbidden\",\"error\":\"Forbidden\",\"message\":\"denied\"}\n\n"],
      "end": "close",
      "expect": {
        "outcome": "error",
        "messages": [],
        "deliveredCursor": null,
        "error": { "status": 403, "code": "forbidden" }
      }
    },
    {
      "name": "a runtime that did not ask ignores an acknowledgment",
      "continuation": "cursor",
      "requested": false,
      "acknowledgment": ["putnami.sse.v1"],
      "query": {},
      "body": ["data: {\"cursor\":\"c1\",\"line\":\"a\"}\n\n"],
      "end": "close",
      "expect": {
        "outcome": "complete",
        "messages": [{ "cursor": "c1", "line": "a" }],
        "deliveredCursor": null
      }
    }
  ]
}
