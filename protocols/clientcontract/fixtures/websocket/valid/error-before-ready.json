{
  "operationId": "widgets.watch",
  "stream": "server",
  "encoding": "json",
  "idempotency": "safe",
  "resume": false,
  "maxFrameBytes": 4096,
  "maxBufferedMessages": 8,
  "steps": [
    {
      "direction": "server-to-client",
      "frame": {
        "v": 1,
        "type": "error",
        "error": {
          "status": 401,
          "code": "unauthorized",
          "retryable": false,
          "message": "the socket was refused before admission"
        }
      }
    }
  ]
}
