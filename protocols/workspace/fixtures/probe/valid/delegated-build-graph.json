{
  "version": 1,
  "extension": "@putnami/pants",
  "projects": [
    {
      "path": "src/python/api",
      "sourceName": "src/python/api",
      "sourceFile": "src/python/api/BUILD",
      "tags": ["pants"],
      "dependencies": ["3rdparty/python", "src/python/pricing"],
