{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://putnami.dev/schemas/putnami-agent-artifact.json",
  "title": "Putnami Agent-Workflow Artifact Manifest",
  "description": "Manifest for a platform-independent, registry-distributed set of agent workflow files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "name", "version", "files"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference."
    },
    "protocolVersion": {
      "type": "integer",
      "const": 1,
      "description": "Agent-artifact manifest protocol version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Registry artifact name."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Exact artifact version."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "Files authorized for non-destructive materialization, in canonical path order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Canonical slash-separated path relative to the workspace root."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the exact file bytes, as 64 lowercase hexadecimal characters."
          }
        }
      }
    }
  }
}
