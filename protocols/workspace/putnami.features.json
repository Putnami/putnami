          "id": "configuration-loads-in-a-fixed-precedence",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "load-merges-two-layers-and-never-the-current-project",
              "command-defaults-merge-in-a-fixed-order",
              "a-later-layer-overlays-what-it-authors"
            ]
          }
        },
        {
          "id": "configuration-parsing-is-strict",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
