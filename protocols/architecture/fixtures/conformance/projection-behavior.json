{
  "protocolVersion": 1,
  "comment": "What a projection contract DOES. Every case seeds the runtime clock from 'now', builds the contract by a shallow top-level merge over a named base, and runs ordered steps. The projected value is always a string so the corpus stays language-neutral.",
  "bases": {
    "projection": {
      "id": "consumer.producer-projection.v1",
      "version": 1,
      "from": {
        "domain": "producer",
        "export": "producer.facts.v1"
      },
      "as": "consumer.producer-copy",
      "mode": "projection",
      "status": "active",
      "facts": [
        "project_identity",
        "dependency_edges"
      ],
      "bootstrap": {
        "kind": "in-process",
        "contract": "putnami.probe.v1",
        "availability": "active"
      },
      "updates": {
        "kind": "in-process",
        "contract": "putnami.probe.v1",
        "availability": "active"
      },
      "consistency": {
        "maxStaleness": "1h",
        "onMissing": "fail-closed",
        "onStale": "use-stale",
        "ordering": "source-version",
        "sourceVersion": "probe_digest",
        "idempotencyKey": "identity_digest",
        "lateEvents": "ignore-older"
      },
      "localModel": {
        "name": "consumer.producer-copy",
        "kind": "projection",
        "sourceIdentity": "project_identity",
        "projectedFields": [
          "project_identity",
          "dependency_edges"
        ],
        "localFields": [],
        "provenanceField": "probe_digest",
        "observedAtField": "observed_at",
        "freshnessField": "freshness_state",
        "writer": "consumer.loader",
        "rebuildable": true,
        "rebuild": "bootstrap"
      },
      "deletion": {
        "strategy": "not-applicable"
      },
      "justification": "The consumer keeps a rebuildable local copy so read-only paths answer without paying a probe."
    }
  },
  "consistencyPresets": {
    "ignore-older": {
      "maxStaleness": "1h",
      "onMissing": "fail-closed",
      "onStale": "use-stale",
      "ordering": "source-version",
      "sourceVersion": "probe_digest",
      "idempotencyKey": "identity_digest",
      "lateEvents": "ignore-older"
    },
    "reject": {
      "maxStaleness": "1h",
      "onMissing": "fail-closed",
      "onStale": "use-stale",
      "ordering": "source-version",
      "sourceVersion": "probe_digest",
      "idempotencyKey": "identity_digest",
      "lateEvents": "reject"
    },
    "apply": {
      "maxStaleness": "1h",
      "onMissing": "fail-closed",
      "onStale": "use-stale",
      "ordering": "source-version",
      "sourceVersion": "probe_digest",
      "idempotencyKey": "identity_digest",
      "lateEvents": "apply"
    },
    "stale-fail-closed": {
      "maxStaleness": "1h",
      "onMissing": "fail-closed",
      "onStale": "fail-closed",
      "ordering": "source-version",
      "sourceVersion": "probe_digest",
      "idempotencyKey": "identity_digest",
      "lateEvents": "ignore-older"
    },
    "missing-fail-open": {
      "maxStaleness": "1h",
      "onMissing": "fail-open",
      "onStale": "use-stale",
      "ordering": "source-version",
      "sourceVersion": "probe_digest",
      "idempotencyKey": "identity_digest",
      "lateEvents": "ignore-older"
    }
  },
  "cases": [
    {
      "name": "a newer source version replaces the local copy",
      "base": "projection",
      "now": "2026-01-01T00:00:00Z",
      "sources": {
        "bootstrap": []
      },
      "steps": [
        {
          "op": "apply",
          "id": "a",
          "value": "v1",
          "sourceVersion": "1",
          "idempotencyKey": "k1",
          "expect": {
            "changed": true
          }
        },
        {
          "op": "apply",
          "id": "a",
          "value": "v2",
          "sourceVersion": "2",
          "idempotencyKey": "k2",
          "expect": {
            "changed": true
          }
        },
        {
          "op": "get",
          "id": "a",
          "expect": {
            "found": true,
            "value": "v2",
            "freshness": "fresh"
          }
        }
      ]
    },
