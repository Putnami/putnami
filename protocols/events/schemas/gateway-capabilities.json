{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putnami.dev/schemas/events/gateway-capabilities.json",
  "title": "Putnami Events Event Server Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "transports", "features", "endpoints"],
  "properties": {
    "protocol": { "const": "putnami.events.v1" },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["sse", "websocket", "http", "grpc"]
      }
    },
    "deliveryProfiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["pull", "stream", "push"]
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replay", "publish", "ack", "payload"],
      "properties": {
        "replay": { "type": "boolean" },
        "publish": { "type": "boolean" },
        "ack": { "type": "boolean" },
        "auth": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["none", "bearer", "headers", "cookie", "serviceAccount", "workloadIdentity"] }
        },
        "cursor": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["latest", "earliest", "message-id", "broker-cursor"] }
        },
        "payload": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["json"] }
        }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sse": { "$ref": "#/$defs/pathEndpoint" },
        "websocket": { "$ref": "#/$defs/pathEndpoint" },
        "publish": { "$ref": "#/$defs/pathEndpoint" },
        "health": { "$ref": "#/$defs/pathEndpoint" },
        "grpc": { "$ref": "#/$defs/serviceEndpoint" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPayloadBytes": { "type": "integer", "minimum": 0 },
        "maxFrameBytes": { "type": "integer", "minimum": 0 },
        "maxSubscriptions": { "type": "integer", "minimum": 0 },
        "maxTopicsPerSubscription": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "pathEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "enum": ["GET", "POST"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "serviceEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service"],
      "properties": {
        "service": { "type": "string", "minLength": 1 }
      }
    }
  }
}
