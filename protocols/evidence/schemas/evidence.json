{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://putnami.dev/schemas/putnami-change-evidence.json",
  "title": "Putnami Change Evidence",
  "description": "One change in a repository that keeps its own CI, as one CI job observed it: the files it touches, the components they belong to and the components that depend on them, tests and coverage per component, the coverage of the changed lines and the dependency changes. The document is self-reported: it carries no verdict and no trust claim. It is consistent (every reference resolves, every impact follows from the files and the edges, every count adds up) and bounded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "subject", "ci", "producer", "generatedAt", "changedFiles", "components"],
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 1,
      "description": "Document version. A reader refuses any other value."
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "sha"],
      "description": "The change: the repository and the commits.",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["github", "gitlab", "generic"],
          "description": "The code host."
        },
        "host": {
          "type": "string",
          "description": "The code host's lowercase hostname. Required for github and gitlab."
        },
        "projectId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "The code host's numeric id of the repository, the key that survives a rename or a transfer. Required for github and gitlab."
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "The repository's path or name, for display."
        },
        "sha": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "description": "The commit the document describes."
        },
        "baseSha": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "description": "The commit the change is measured against. Absent when no base was resolved."
        },
        "branch": {
          "type": "string",
          "description": "The branch the commit was built on."
        },
        "changeRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number"],
          "description": "The merge request (GitLab) or pull request (GitHub) the job built.",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1,
              "description": "The code host's number of the change request."
            }
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system"],
      "description": "The job that produced the document.",
      "properties": {
        "system": {
          "type": "string",
          "enum": ["github-actions", "gitlab-ci", "generic"],
          "description": "The CI system."
        },
        "runId": {
          "type": "string",
          "description": "The CI system's id of the run or pipeline."
        },
        "url": {
          "type": "string",
          "description": "The run's page: an https URL without credentials."
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "description": "The program that wrote the document.",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "When the document was written, RFC 3339 with a zone."
    },
    "changedFiles": {
      "type": "array",
      "maxItems": 20000,
      "description": "The diff between the base and the commit. Empty when no base was resolved.",
      "items": { "$ref": "#/$defs/changedFile" }
    },
    "components": {
      "type": "array",
      "maxItems": 5000,
      "description": "Every component the producer found.",
      "items": { "$ref": "#/$defs/component" }
    },
    "tests": {
      "type": "array",
      "maxItems": 5000,
      "description": "One entry per component whose test reports were read.",
      "items": { "$ref": "#/$defs/componentTests" }
    },
    "coverage": {
      "type": "array",
      "maxItems": 5000,
      "description": "One entry per component whose coverage was read.",
      "items": { "$ref": "#/$defs/componentCoverage" }
    },
    "changedLineCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coveredLines", "totalLines", "files"],
      "description": "The coverage of the lines the change added or modified that the coverage reports instrument. The totals are the sums of the files.",
      "properties": {
        "coveredLines": { "type": "integer", "minimum": 0 },
        "totalLines": { "type": "integer", "minimum": 0 },
        "files": {
          "type": "array",
          "maxItems": 20000,
          "items": { "$ref": "#/$defs/changedLineCoverageFile" }
        }
      }
    },
    "dependencyChanges": {
      "type": "array",
      "maxItems": 10000,
      "description": "The difference of the lockfiles between the base and the commit.",
      "items": { "$ref": "#/$defs/dependencyChange" }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 500,
      "description": "The producer's findings: a missing or malformed report, an unresolved base. They never make the document invalid.",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "A path relative to the repository root, slash-separated, with no leading slash, no backslash and no empty, dot or dot-dot segment."
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "status": {
          "type": "string",
          "enum": ["added", "modified", "deleted", "renamed"]
        },
        "previousPath": {
          "$ref": "#/$defs/path",
          "description": "The path at the base. Required for renamed, refused otherwise."
        },
        "component": {
          "type": "string",
          "description": "The id of the component the file belongs to, when one does."
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ecosystem", "source", "impact"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The component's directory relative to the repository root, or . for the whole repository."
        },
        "name": {
          "type": "string",
          "description": "The component's own name: package name, module path, project name."
        },
        "ecosystem": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "An open lowercase slug: node, composer, go, nx, ..."
        },
        "source": {
          "type": "string",
          "enum": ["orchestrator", "workspace", "manifest", "fallback", "declared"],
          "description": "How the component was found."
        },
        "impact": {
          "type": "string",
          "enum": ["changed", "dependent", "unaffected"],
          "description": "changed when a changed file belongs to it; dependent when it reaches a changed component through dependsOn; unaffected otherwise."
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The ids of the components this one depends on."
        }
      }
    },
    "componentTests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "passed", "failed", "skipped"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "failingCases": {
          "type": "array",
          "maxItems": 50,
          "description": "At most failed entries.",
          "items": { "$ref": "#/$defs/failingCase" }
        }
      }
    },
    "failingCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "suite": { "type": "string" },
        "file": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "componentCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "coveredLines", "totalLines"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "coveredLines": { "type": "integer", "minimum": 0 },
        "totalLines": { "type": "integer", "minimum": 0 }
      }
    },
    "changedLineCoverageFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "coveredLines", "totalLines"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "coveredLines": { "type": "integer", "minimum": 0 },
        "totalLines": { "type": "integer", "minimum": 0 },
        "uncoveredLines": {
          "type": "array",
          "maxItems": 200,
          "description": "The uncovered changed line numbers, strictly increasing.",
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "dependencyChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "lockfile", "name", "change"],
      "properties": {
        "ecosystem": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "An open lowercase slug: npm, composer, go, ..."
        },
        "lockfile": { "$ref": "#/$defs/path" },
        "name": { "type": "string", "minLength": 1 },
        "change": {
          "type": "string",
          "enum": ["added", "removed", "upgraded", "downgraded", "changed"],
          "description": "added has only to; removed has only from; the others have two different versions."
        },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "component": {
          "type": "string",
          "description": "The id of the component whose lockfile it is, when one does."
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info"]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "message": { "type": "string" },
        "field": { "type": "string" }
      }
    }
  }
}
