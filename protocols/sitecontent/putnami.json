{
  "$schema": "https://putnami.dev/schemas/putnami-project.json",
  "name": "go.putnami.dev/protocol/sitecontent",
  "tags": ["go", "protocol"],
  "extensions": ["/go/extension"],
  "publish": ["go"],
  "disable": {
    "jobs": ["serve"]
  },
  "options": {
    "publish": {
      "archives": false
    }
  },
  "featureAuthority": {
    "none": "A content-bundle manifest travels inside a bundle; the outcome belongs to the site that serves it."
  }
}
