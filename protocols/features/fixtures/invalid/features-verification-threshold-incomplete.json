{
  "protocolVersion": 2,
  "namespace": "billing",
  "features": [
    {
      "id": "billing/invoice-export",
      "type": "feature",
      "name": "Invoice export",
      "outcome": "Customers can export issued invoices",
      "owner": "billing",
      "target": "coded",
      "requirements": [
        {
          "id": "export-latency",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "threshold",
            "checks": ["export-benchmark"],
            "metric": "export.duration",
            "aggregation": "p95",
            "operator": "lte",
            "unit": "ms"
          }
        }
      ]
    }
  ]
}
