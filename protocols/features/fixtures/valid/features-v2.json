{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "billing",
  "features": [
    {
      "id": "billing/invoice-export",
      "type": "feature",
      "name": "Invoice export",
      "outcome": "Customers can export issued invoices",
      "owner": "billing",
      "target": "coded",
      "requirements": [
        {
          "id": "export-format",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["export-states-content-type", "export-never-guesses-from-filename"]
          }
        },
        { "id": "retention", "stage": "coded", "evidenceKinds": ["artifact"] }
      ]
    }
  ]
}
