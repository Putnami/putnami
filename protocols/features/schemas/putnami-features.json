{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://putnami.dev/schemas/putnami-features.json",
  "title": "Putnami authored feature intent v1 and v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "namespace", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "protocolVersion": {
      "$comment": "Readers require an exact JSON integer token, 1 or 2; 1.0 and 1e0 are invalid. Only version 2 may carry a requirement verification criterion.",
      "type": "integer",
      "enum": [1, 2]
    },
    "namespace": { "$ref": "#/$defs/segmentID" },
    "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
  },
  "allOf": [
    {
      "$comment": "A version 1 manifest cannot carry the version 2 verification criterion.",
      "if": {
        "required": ["protocolVersion"],
        "properties": { "protocolVersion": { "const": 1 } }
      },
      "then": {
        "properties": {
          "features": {
            "items": {
              "properties": {
                "requirements": {
                  "items": { "not": { "required": ["verification"] } }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "segmentID": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "checkID": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semanticCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "featureID": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)+$"
    },
    "maturityStage": {
      "type": "string",
      "enum": ["modeled", "coded", "wired", "default-on", "live-verified", "design-partner-proven", "ga"]
    },
    "requirementStage": {
      "type": "string",
      "enum": ["coded", "wired", "default-on", "live-verified", "design-partner-proven", "ga"]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "type": "string", "enum": ["parent", "dependsOn", "includes"] },
        "target": { "$ref": "#/$defs/featureID" }
      }
    },
    "verificationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["invocation", "rolling"] },
        "seconds": { "type": "integer", "minimum": 1, "maximum": 315360000 }
      },
      "oneOf": [
        {
          "$comment": "An invocation window is one run or benchmark and carries no duration.",
          "properties": { "kind": { "const": "invocation" } },
          "not": { "required": ["seconds"] }
        },
        {
          "properties": { "kind": { "const": "rolling" } },
          "required": ["seconds"]
        }
      ]
    },
    "verification": {
      "$comment": "The closed machine criterion that makes a same-ID textual spec requirement executable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "checks"],
      "properties": {
        "kind": { "type": "string", "enum": ["acceptance", "threshold"] },
        "checks": {
          "$comment": "The expected set: a renamed or no-longer-executed check becomes missing instead of leaving an old success green.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/checkID" }
        },
        "metric": { "$ref": "#/$defs/semanticCode" },
        "aggregation": {
          "type": "string",
          "enum": ["value", "count", "sum", "avg", "min", "max", "p50", "p95", "p99", "ratio"]
        },
        "operator": { "type": "string", "enum": ["eq", "lte", "gte"] },
        "target": { "type": "number" },
        "unit": { "$ref": "#/$defs/semanticCode" },
        "window": { "$ref": "#/$defs/verificationWindow" },
        "environment": { "$ref": "#/$defs/semanticCode" },
        "maxAgeSeconds": { "type": "integer", "minimum": 1, "maximum": 315360000 }
      },
      "oneOf": [
        {
          "$comment": "An acceptance criterion carries no measured objective.",
          "properties": { "kind": { "const": "acceptance" } },
          "not": {
            "anyOf": [
              { "required": ["metric"] },
              { "required": ["aggregation"] },
              { "required": ["operator"] },
              { "required": ["target"] },
              { "required": ["unit"] },
              { "required": ["window"] },
              { "required": ["environment"] },
              { "required": ["maxAgeSeconds"] }
            ]
          }
        },
        {
          "$comment": "A threshold objective declares exactly one check and one complete measured objective.",
          "properties": {
            "kind": { "const": "threshold" },
            "checks": { "maxItems": 1 }
          },
          "required": ["metric", "aggregation", "operator", "target", "unit", "window"],
          "allOf": [
            {
              "$comment": "Environment and freshness describe a rolling window only.",
              "if": {
                "required": ["window"],
                "properties": { "window": { "required": ["kind"], "properties": { "kind": { "const": "invocation" } } } }
              },
              "then": {
                "not": { "anyOf": [{ "required": ["environment"] }, { "required": ["maxAgeSeconds"] }] }
              }
            },
            {
              "if": {
                "required": ["window"],
                "properties": { "window": { "required": ["kind"], "properties": { "kind": { "const": "rolling" } } } }
              },
              "then": { "required": ["environment", "maxAgeSeconds"] }
            }
          ]
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "evidenceKinds"],
      "properties": {
        "id": { "$ref": "#/$defs/segmentID" },
        "stage": { "$ref": "#/$defs/requirementStage" },
        "evidenceKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["capability", "artifact", "attestation"] }
        },
        "verification": { "$ref": "#/$defs/verification" }
      },
      "allOf": [
        {
          "$comment": "An adapter records every observed check as an automated attestation, so a verified requirement must accept that evidence kind.",
          "if": { "required": ["verification"] },
          "then": {
            "properties": { "evidenceKinds": { "contains": { "const": "attestation" } } }
          }
        },
        {
          "$comment": "A rolling production objective is only observable where the feature is already live.",
          "if": {
            "required": ["verification"],
            "properties": {
              "verification": {
                "required": ["window"],
                "properties": {
                  "window": { "required": ["kind"], "properties": { "kind": { "const": "rolling" } } }
                }
              }
            }
          },
          "then": { "properties": { "stage": { "const": "live-verified" } } }
        }
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "outcome", "owner", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/featureID" },
        "type": { "type": "string", "enum": ["feature", "journey"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 512 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 512 },
        "target": { "$ref": "#/$defs/maturityStage" },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
      }
    }
  }
}
