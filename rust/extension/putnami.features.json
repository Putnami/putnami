{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "rust",
  "features": [
    {
      "id": "rust/stack-extension",
      "type": "feature",
      "name": "Run the crates of a Cargo workspace as Putnami tasks",
      "outcome": "A team with a Cargo workspace runs putnami lint, test and build over its crates through @putnami/rust with no putnami.json override: each crate is a project with its edges and stack root, nested Cargo workspaces included, each task reads only its own inputs, the test task attributes each case and coverage line to its crate, and a crate may override any profile value",
      "owner": "rust",
      "target": "coded",
      "requirements": [
        {
          "id": "crates-become-projects",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["the-crates-of-a-cargo-workspace-become-projects-with-their-edges"]
          }
        },
        {
          "id": "nested-roots-reach-the-key",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["a-nested-cargo-workspace-root-is-an-input-only-project"]
          }
        },
        {
          "id": "tasks-run-the-profile",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["a-task-runs-the-profile-steps-after-the-toolchain-check"]
          }
        },
        {
          "id": "reports-become-the-summary",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["junit-and-lcov-become-the-test-and-coverage-summary"]
          }
        },
        {
          "id": "cases-are-attributed",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["each-nextest-case-goes-to-the-crate-its-binary-names"]
          }
        },
        {
          "id": "coverage-is-attributed",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["each-coverage-file-goes-to-the-crate-that-holds-it"]
          }
        },
        {
          "id": "inputs-are-per-task",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["lint-does-not-read-the-lockfile-or-the-nextest-configuration"]
          }
        },
        {
          "id": "overrides-are-honored",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["a-putnami-json-override-changes-the-steps-and-the-inputs"]
          }
        },
        {
          "id": "manifest-follows-the-profile",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["the-manifest-conforms-to-the-stack-core"]
          }
        }
      ]
    }
  ]
}
