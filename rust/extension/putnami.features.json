{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "rust",
  "features": [
    {
      "id": "rust/stack-extension",
      "type": "feature",
      "name": "Run the crates of a Cargo workspace as Putnami tasks",
      "outcome": "A team with a Cargo workspace runs putnami lint, test and build over its crates through @putnami/rust with no putnami.json override: each crate is a project with its edges and stack root, nested Cargo workspaces included, each task reads only its own inputs, the test task attributes each case and coverage line to its crate, and a crate may override any profile value; putnami install fetches the locked crates, a hosted run tests offline, and a test filter reaches nextest",
      "owner": "rust",
      "target": "coded",
      "requirements": [
        {
          "id": "crates-become-projects",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["the-crates-of-a-cargo-workspace-become-projects-with-their-edges"]
          }
        },
        {
          "id": "nested-roots-reach-the-key",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["a-nested-cargo-workspace-root-is-an-input-only-project"]
          }
        },
        {
