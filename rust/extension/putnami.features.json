          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["a-task-runs-the-profile-steps-after-the-toolchain-check"]
          }
        },
        {
          "id": "reports-become-the-summary",
          "stage": "coded",
          "evidenceKinds": ["attestation"],
          "verification": {
            "kind": "acceptance",
            "checks": ["junit-and-lcov-become-the-test-and-coverage-summary"]
          }
        },
