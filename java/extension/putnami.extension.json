{
  "$schema": "https://putnami.dev/schemas/putnami-extension.json",
  "name": "@putnami/java",
  "cliContract": 14,
  "extensionDependencies": {
    "@putnami/dev": ""
  },
  "uses": [
    "oci"
  ],
  "runtime": {
    "executable": "compiled/putnami-java",
    "toolchains": {
      "runtimeCompiler": {
        "lock": "go",
        "candidates": [
          {
            "from": "environment",
            "environment": "GOROOT",
            "path": "bin/go"
          },
          {
            "from": "path",
            "path": "go"
          },
          {
            "from": "putnami-home",
            "path": "toolchains/go/go-{version}/go/bin/go"
          }
        ],
        "probe": {
          "args": [
            "env",
            "GOVERSION"
          ],
          "expect": "go{version}",
          "unset": [
            "GOROOT"
          ],
          "environment": {
            "GOTOOLCHAIN": "local"
          }
        },
        "environment": {
          "GOROOT": {
            "from": "ancestor",
            "levels": 2
          },
          "GOTOOLCHAIN": {
            "from": "literal",
            "value": "local"
          }
        },
        "prependPath": true
      }
    },
    "prepare": {
      "command": "{extensionRoot}/bin/prepare",
      "args": [
        "--output",
        "{runtimeOutput}"
      ],
      "inputs": [
        "bin/prepare",
        "cmd/**",
        "go.mod",
        "go.sum",
        "*.go",
        "profile.json"
      ],
      "toolchains": [
        "runtimeCompiler"
      ]
    },
    "inputSelectors": [
      "java:build",
      "java:lint",
      "java:test"
    ]
  },
  "workspace": {
    "markers": [
      "build.gradle.kts",
      "build.gradle",
      "pom.xml",
      "settings.gradle.kts",
      "settings.gradle"
    ],
    "inputs": [
      "build.gradle.kts",
      "build.gradle",
      "pom.xml",
      "settings.gradle.kts",
      "settings.gradle",
      ".java-version"
    ],
    "excludes": [
      "build",
      "target",
      ".gradle"
    ],
    "language": "java"
  },
  "commands": {
    "lint": {
      "description": "Lint the Gradle projects with check, without their tests, and the Maven modules with clean, then verify -DskipTests.",
      "flags": {
        "docs-links": {
          "type": "boolean",
          "default": true,
          "description": "Check every relative link and anchor in the project's README.md files and doc/ trees; a broken one fails lint."
        }
      },
      "run": [
        {
          "id": "lint",
          "task": "lint-run",
          "dependsOn": [
            "^lint"
          ]
        },
        {
          "id": "docs",
          "task": "lint-docs",
          "if": "params.docs-links"
        }
      ]
    },
    "test": {
      "description": "Test the Gradle projects and the Maven modules (clean, then verify), and read their JUnit and JaCoCo reports.",
      "flags": {
        "test": {
          "type": "string",
          "short": "-t",
          "description": "Test filter to run, applied to each Gradle test task as --tests and passed to Maven Surefire as -Dtest, with Failsafe's integration tests skipped"
        }
      },
      "run": [
        {
          "id": "test",
          "heavy": true,
          "task": "test-run",
          "dependsOn": [
            "^test"
          ]
        }
      ]
    },
    "build": {
      "description": "Build the Gradle projects with assemble and the Maven modules with clean, then package -DskipTests.",
      "run": [
        {
          "id": "build",
          "heavy": true,
          "task": "build-run",
          "dependsOn": [
            "^build"
          ]
        }
      ]
    },
    "workspace-install": {
      "description": "Prepare each Gradle and Maven build of the workspace: its JDKs, its Gradle or Maven, and its dependencies.",
      "quiet": true,
      "flags": {
        "force": {
          "type": "boolean",
          "default": false,
          "description": "Refresh the dependencies: Gradle's --refresh-dependencies, Maven's --update-snapshots"
        }
      },
      "run": [
        {
          "id": "workspace-install",
          "task": "workspace-install-exec"
        }
      ]
    },
    "serve": {
      "description": "Serve a Java application: build its runnable form with its own build, then run it on the port.",
      "traits": {
        "requiresRunnable": true,
        "workload": "serve"
      },
      "flags": {
        "port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the server, set as PORT and SERVER_PORT"
        }
      },
      "run": [
        {
          "id": "serve",
          "task": "serve-run"
        }
      ]
    },
    "run": {
      "description": "Run a Java application once and forward its exit code.",
      "traits": {
        "requiresRunnable": true,
        "workload": "once"
      },
      "flags": {
        "args": {
          "type": "string",
          "description": "Arguments to pass to the application"
        }
      },
      "run": [
        {
          "id": "run",
          "task": "run-exec"
        }
      ]
    },
    "package": {
      "description": "Assemble the image of an application for the docker publish channel.",
      "traits": {
        "injectPublishChannels": true
      },
      "flags": {
        "docker": {
          "type": "boolean",
          "default": false,
          "description": "Assemble the image"
        },
        "docker-tag": {
          "type": "string",
          "description": "Override the image tag"
        },
        "docker-base-image": {
          "type": "string",
          "description": "Replace the Temurin JRE image with a base pinned by digest (image@sha256:...)"
        },
        "docker-load": {
          "type": "boolean",
          "default": false,
          "description": "Also load the assembled image into the local docker daemon"
        },
        "platform": {
          "type": "string",
          "default": "linux/amd64",
          "description": "Target platform of the image"
        },
        "dry-run": {
          "type": "boolean",
          "default": false,
          "description": "Plan the image without assembling it"
        }
      },
      "run": [
        {
          "id": "docker",
          "task": "package-docker",
          "if": "params.docker"
        }
      ]
    },
    "publish": {
      "dependsOn": [
        "package"
      ],
      "traits": {
        "injectPublishChannels": true,
        "sideEffects": "registry"
      },
      "description": "Push the image of an application to its OCI registry. A library reaches its Maven repository through its own build.",
      "flags": {
        "docker": {
          "type": "boolean",
          "default": false,
          "description": "Push the image"
        },
        "docker-registry": {
          "type": "string",
          "description": "Registry to push the image to, above registries.oci.publish"
        },
        "dry-run": {
          "type": "boolean",
          "default": false,
          "description": "Push nothing; report what would be published"
        }
      },
      "run": [
        {
          "id": "docker",
          "task": "publish-docker",
          "if": "params.docker"
        }
      ]
    }
  },
  "tasks": {
    "lint-run": {
      "description": "Run the lint steps of the component's variant on one Gradle project or Maven module in its directory, after the Java toolchain check: gradlew check without the tests, or mvn clean of the module, then mvn verify -DskipTests. Its inputs are the files the java:lint selector answers from the resolved profile, and the stack-root files of every variant.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "lint",
        "--report-dir",
        "{outputRoot}"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "inputs": {
        "sources": {
          "from": "project",
          "files": [
            "java:lint"
          ]
        },
        "stackRoot": {
          "from": "workspace",
          "files": [
            "*/*/*/*/pom.xml",
            "*/*/*/pom.xml",
            "*/*/pom.xml",
            "*/pom.xml",
            ".editorconfig",
            ".java-version",
            ".mvn/extensions.xml",
            ".mvn/jvm.config",
            ".mvn/maven.config",
            ".mvn/wrapper/maven-wrapper.properties",
            "build-logic/**/build.gradle",
            "build-logic/**/build.gradle.kts",
            "build-logic/**/src/**",
            "build-logic/settings.gradle",
            "build-logic/settings.gradle.kts",
            "build.gradle",
            "build.gradle.kts",
            "buildSrc/build.gradle",
            "buildSrc/build.gradle.kts",
            "buildSrc/settings.gradle",
            "buildSrc/settings.gradle.kts",
            "buildSrc/src/**",
            "config/checkstyle/**",
            "config/detekt/**",
            "config/pmd/**",
            "config/spotbugs/**",
            "gradle.properties",
            "gradle/*.gradle",
            "gradle/*.gradle.kts",
            "gradle/*.versions.toml",
            "gradle/gradle-daemon-jvm.properties",
            "gradle/wrapper/gradle-wrapper.properties",
            "pom.xml",
            "settings.gradle",
            "settings.gradle.kts"
          ]
        },
        "extensionVersion": {
          "from": "runtime"
        }
      },
      "outputs": {
        "data": {
          "description": "The task result: the test and coverage totals of a test task."
        }
      },
      "cache": {
        "enabled": true
      },
      "declares": {
        "outputs": {
          "reports": {
            "kind": "directory",
            "root": "command-output",
            "path": "lint",
            "optionalEmpty": true,
            "description": "The reports the task wrote or copied: a copy of each JUnit and JaCoCo report of a test task."
          }
        },
        "effects": [
          "network",
          "toolchain-cache"
        ]
      }
    },
    "test-run": {
      "description": "Run the test steps of the component's variant on one Gradle project or Maven module in its directory, after the Java toolchain check (for Maven, clean of the module, then verify); with the test flag passed to Gradle or Maven as its test filter; then copy its JUnit and JaCoCo reports into the command output and read them. A failed case, a step that exits non-zero, or a missing report fails the task, except in a filtered run that selects no test, which reads zero tests.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "test",
        "--report-dir",
        "{outputRoot}"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "inputs": {
        "sources": {
          "from": "project",
          "files": [
            "java:test"
          ]
        },
        "stackRoot": {
          "from": "workspace",
          "files": [
            "*/*/*/*/pom.xml",
            "*/*/*/pom.xml",
            "*/*/pom.xml",
            "*/pom.xml",
            ".java-version",
            ".mvn/extensions.xml",
            ".mvn/jvm.config",
            ".mvn/maven.config",
            ".mvn/wrapper/maven-wrapper.properties",
            "build-logic/**/build.gradle",
            "build-logic/**/build.gradle.kts",
            "build-logic/**/src/**",
            "build-logic/settings.gradle",
            "build-logic/settings.gradle.kts",
            "build.gradle",
            "build.gradle.kts",
            "buildSrc/build.gradle",
            "buildSrc/build.gradle.kts",
            "buildSrc/settings.gradle",
            "buildSrc/settings.gradle.kts",
            "buildSrc/src/**",
            "gradle.lockfile",
            "gradle.properties",
            "gradle/*.gradle",
            "gradle/*.gradle.kts",
            "gradle/*.versions.toml",
            "gradle/gradle-daemon-jvm.properties",
            "gradle/wrapper/gradle-wrapper.properties",
            "pom.xml",
            "settings-gradle.lockfile",
            "settings.gradle",
            "settings.gradle.kts"
          ]
        },
        "test": {
          "from": "params"
        },
        "extensionVersion": {
          "from": "runtime"
        }
      },
      "outputs": {
        "data": {
          "description": "The task result: the test and coverage totals of a test task."
        }
      },
      "cache": {
        "enabled": true
      },
      "declares": {
        "outputs": {
          "reports": {
            "kind": "directory",
            "root": "command-output",
            "path": "test",
            "optionalEmpty": true,
            "description": "The reports the task wrote or copied: a copy of each JUnit and JaCoCo report of a test task."
          }
        },
        "effects": [
          "network",
          "toolchain-cache"
        ]
      }
    },
    "build-run": {
      "description": "Run the build steps of the component's variant on one Gradle project or Maven module in its directory, after the Java toolchain check: gradlew assemble, or mvn clean of the module, then mvn package -DskipTests.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "build",
        "--report-dir",
        "{outputRoot}"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "inputs": {
        "sources": {
          "from": "project",
          "files": [
            "java:build"
          ]
        },
        "stackRoot": {
          "from": "workspace",
          "files": [
            "*/*/*/*/pom.xml",
            "*/*/*/pom.xml",
            "*/*/pom.xml",
            "*/pom.xml",
            ".java-version",
            ".mvn/extensions.xml",
            ".mvn/jvm.config",
            ".mvn/maven.config",
            ".mvn/wrapper/maven-wrapper.properties",
            "build-logic/**/build.gradle",
            "build-logic/**/build.gradle.kts",
            "build-logic/**/src/**",
            "build-logic/settings.gradle",
            "build-logic/settings.gradle.kts",
            "build.gradle",
            "build.gradle.kts",
            "buildSrc/build.gradle",
            "buildSrc/build.gradle.kts",
            "buildSrc/settings.gradle",
            "buildSrc/settings.gradle.kts",
            "buildSrc/src/**",
            "gradle.lockfile",
            "gradle.properties",
            "gradle/*.gradle",
            "gradle/*.gradle.kts",
            "gradle/*.versions.toml",
            "gradle/gradle-daemon-jvm.properties",
            "gradle/wrapper/gradle-wrapper.properties",
            "pom.xml",
            "settings-gradle.lockfile",
            "settings.gradle",
            "settings.gradle.kts"
          ]
        },
        "extensionVersion": {
          "from": "runtime"
        }
      },
      "outputs": {
        "data": {
          "description": "The task result: the test and coverage totals of a test task."
        }
      },
      "cache": {
        "enabled": true
      },
      "declares": {
        "outputs": {
          "reports": {
            "kind": "directory",
            "root": "command-output",
            "path": "build",
            "optionalEmpty": true,
            "description": "The reports the task wrote or copied: a copy of each JUnit and JaCoCo report of a test task."
          }
        },
        "effects": [
          "network",
          "toolchain-cache"
        ]
      }
    },
    "lint-docs": {
      "description": "Documentation link check: every relative link and anchor in the project's README.md files and doc/ trees must resolve, with the exact case of the file's name. The task body is the SDK's docslinks.Job, shared with every language extension. A link may name any file of the workspace, so the check reads the workspace's Git candidate cut (the tracked files and the untracked files no ignore rule excludes) and its key is the workspace input `git:**`, which holds that cut: deleting or renaming a link target, or editing a heading an anchor names, moves the key, and an ignored file is neither read nor keyed. The project input names the README.md the check starts from, so the key does not fold the project's ignored build output. Outside a Git work tree the check reads the disk and the task has no key. It needs no JDK, Gradle or Maven.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "lint-docs"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 120000,
      "inputs": {
        "readme": {
          "from": "project",
          "files": [
            "README.md"
          ]
        },
        "repository": {
          "from": "workspace",
          "files": [
            "git:**"
          ]
        },
        "docs-links": {
          "from": "params"
        }
      },
      "outputs": {
        "data": {
          "description": "Documentation link result with diagnostics"
        }
      },
      "reads": [
        "sources"
      ],
      "cache": {
        "noOutput": true,
        "enabled": true
      },
      "declares": {}
    },
    "workspace-install-exec": {
      "description": "At each stack root of the workspace's Gradle and Maven builds, except the projects disable.tags excludes: install the Temurin JDK .java-version accepts and the pinned JDKs the build's Gradle toolchains ask for; install its Gradle, the wrapper's distribution through gradlew --version or the pinned Gradle of a build without a wrapper, or its Maven, the release its Maven wrapper states, else the mvn on PATH, else the pinned Maven; then fill the dependency cache: Gradle with an init script that resolves every resolvable configuration of every project, a configuration it cannot resolve whole being a warning, and Maven with dependency:go-offline, best effort, with a warning that names what it misses. The force flag refreshes the dependencies. With offline dependencies it installs nothing: a stack root whose JDK, Gradle or Maven is missing is left out with a warning, and the resolution runs offline.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "workspace-install"
      ],
      "cwd": "{workspaceRoot}",
      "cache": false,
      "timeoutMs": 3600000,
      "declares": {
        "effects": [
          "network",
          "process",
          "toolchain-cache",
          "workspace-files"
        ]
      }
    },
    "serve-run": {
      "description": "Build the application's runnable form (installDist, or the Spring Boot jar) and run it with PORT and SERVER_PORT set, until the user stops it; ready once the port accepts connections.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "serve"
      ],
      "cwd": "{projectRoot}",
      "cache": false,
      "timeoutMs": -1,
      "declares": {
        "effects": [
          "network",
          "process",
          "workspace-files"
        ]
      }
    },
    "run-exec": {
      "description": "Build the application's runnable form and run it once with the args flag, forwarding its exit code.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "run"
      ],
      "cwd": "{projectRoot}",
      "cache": false,
      "timeoutMs": -1,
      "declares": {
        "effects": [
          "network",
          "process",
          "workspace-files"
        ]
      }
    },
    "package-docker": {
      "description": "Assemble a local OCI image of an application from its runnable form, built by its own build, on a digest-pinned Temurin JRE. Sole owner of <command-output>/docker.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "package-docker"
      ],
      "inputs": {
        "application": {
          "from": "project",
          "files": [
            "**/*",
            "!build/**",
            "!target/**",
            "!.gradle/**",
            "!out/**",
            "!.putnami/**",
            "!../**",
            "!**/target/**",
            "!**/build/**",
            "!**/.gradle/**",
            "!**/.kotlin/**",
            "!**/.gen/**"
          ]
        },
        "upstream": {
          "from": "closure",
          "files": [
            "**/*",
            "!build/**",
            "!target/**",
            "!.gradle/**",
            "!out/**",
            "!.putnami/**",
            "!../**",
            "!**/target/**",
            "!**/build/**",
            "!**/.gradle/**",
            "!**/.kotlin/**",
            "!**/.gen/**"
          ]
        },
        "stackRoot": {
          "from": "workspace",
          "files": [
            "*/*/*/*/pom.xml",
            "*/*/*/pom.xml",
            "*/*/pom.xml",
            "*/pom.xml",
            ".java-version",
            ".mvn/extensions.xml",
            ".mvn/jvm.config",
            ".mvn/maven.config",
            ".mvn/wrapper/maven-wrapper.properties",
            "build-logic/**/build.gradle",
            "build-logic/**/build.gradle.kts",
            "build-logic/**/src/**",
            "build-logic/settings.gradle",
            "build-logic/settings.gradle.kts",
            "build.gradle",
            "build.gradle.kts",
            "buildSrc/build.gradle",
            "buildSrc/build.gradle.kts",
            "buildSrc/settings.gradle",
            "buildSrc/settings.gradle.kts",
            "buildSrc/src/**",
            "gradle.lockfile",
            "gradle.properties",
            "gradle/*.gradle",
            "gradle/*.gradle.kts",
            "gradle/*.versions.toml",
            "gradle/gradle-daemon-jvm.properties",
            "gradle/wrapper/gradle-wrapper.properties",
            "pom.xml",
            "settings-gradle.lockfile",
            "settings.gradle",
            "settings.gradle.kts"
          ]
        },
        "extensionVersion": {
          "from": "runtime"
        }
      },
      "cwd": "{projectRoot}",
      "timeoutMs": 1800000,
      "cache": {
        "versionAware": true
      },
      "declares": {
        "outputs": {
          "docker": {
            "kind": "directory",
            "root": "command-output",
            "path": "docker",
            "optionalEmpty": true,
            "description": "Local OCI candidate layout, its manifest and the docker channel record."
          }
        },
        "effects": [
          "network",
          "toolchain-cache"
        ]
      }
    },
    "publish-docker": {
      "description": "Push the packaged image to the container registry through the shared publisher.",
      "kind": "command",
      "command": "{extensionRuntime}",
      "args": [
        "publish-docker"
      ],
      "cwd": "{projectRoot}",
      "timeoutMs": 300000,
      "cache": false,
      "declares": {
        "outputs": {
          "published-image": {
            "kind": "file",
            "root": "command-output",
            "path": "docker/published-image.json",
            "optionalEmpty": true,
            "description": "Verified remote image record, written after the registry digest is read back."
          }
        },
        "effects": [
          "network",
          "registry"
        ],
        "publishChannels": [
          "docker"
        ]
      }
    }
  }
}
