{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "java",
  "features": [
    {
      "id": "java/stack-extension",
      "type": "feature",
      "name": "Run the Gradle projects and Maven modules of a Java or Kotlin build as Putnami tasks",
      "outcome": "A team with a Gradle build, Android included, or a Maven build adds @putnami/java and runs putnami lint, test and build over its components with Putnami's runner and cache, without rewriting its build and without a JDK on the machine: each component is a project with its edges, each task runs the steps of its build, the test task reads its JUnit and JaCoCo reports, an application serves, runs, and ships as an image, and a component overrides any profile value in its putnami.json",
      "owner": "java",
      "target": "coded",
      "requirements": [
        {
          "id": "components-become-projects",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-gradle-projects-and-maven-modules-become-projects-with-their-edges"
            ]
          }
        },
        {
          "id": "nested-builds-are-stack-roots",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "nested-gradle-and-maven-builds-are-their-components-stack-roots"
            ]
          }
        },
        {
          "id": "variants-follow-the-build",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "each-component-gets-the-variant-of-its-build"
            ]
          }
        },
        {
          "id": "toolchain-is-provided",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "install-pins-the-jdk-the-builds-state",
              "a-pinned-jdk-runs-when-the-machine-has-none",
              "a-maven-component-gets-maven-when-the-machine-has-none"
            ]
          }
        },
        {
          "id": "tasks-run-the-profile",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "a-task-runs-the-variant-steps-after-the-java-check"
            ]
          }
        },
        {
