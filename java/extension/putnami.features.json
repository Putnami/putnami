{
  "$schema": "https://putnami.dev/schemas/putnami-features.json",
  "protocolVersion": 2,
  "namespace": "java",
  "features": [
    {
      "id": "java/stack-extension",
      "type": "feature",
      "name": "Run the Gradle projects and Maven modules of a Java or Kotlin build as Putnami tasks",
      "outcome": "A team with a Gradle build, Android included, or a Maven build adds @putnami/java and runs putnami lint, test and build with Putnami's runner and cache, without rewriting its build, on a machine with no JDK, Gradle or Maven once putnami install prepared it: each component is a project, each task runs its build's steps, test reads JUnit and JaCoCo reports and filters tests, lint checks doc links, an application serves, runs and ships an image",
      "owner": "java",
      "target": "coded",
      "requirements": [
        {
          "id": "components-become-projects",
          "stage": "coded",
          "evidenceKinds": [
            "attestation"
          ],
          "verification": {
            "kind": "acceptance",
            "checks": [
              "the-gradle-projects-and-maven-modules-become-projects-with-their-edges"
            ]
          }
        },
        {
